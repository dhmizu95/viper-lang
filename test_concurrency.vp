# ============================================
# Viper Concurrency Test
# ============================================
# Test file for task/sync concurrency
# Run with: viper run test_concurrency.vp

def worker():
    result = 0
    for i in range(1000):
        result = result + i
    return result

def main():
    # Spawn 1 million concurrent tasks
    for i in range(1_000_000):
        task worker()
    
    # Wait for all to complete
    sync:
        pass
    
    print("all tasks complete")
