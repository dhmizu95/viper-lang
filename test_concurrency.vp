def heavy(n):
    # Example "complicated" work: sum of squares with some branching
    acc = 0
    for i in range(10_000):
        if (i ^ n) & 7 == 0:
            acc = acc + i * i
        else:
            acc = acc + i
    return acc

def worker(id):
    # Do the work and maybe log a small sample
    result = heavy(id)
    if id % 250 == 0:
        print("done", id, "result", result)

def main():
    for i in range(1000):
        task worker(i)
    sync:
        print("waiting for tasks...")
    print("all tasks complete")
