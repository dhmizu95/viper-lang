# Fibonacci - compute fib(1000000)
# Using iterative approach with modular arithmetic for large numbers

def main():
    n = 1000000
    a = 0
    b = 1
    i = 0
    
    # Use modular arithmetic to keep numbers manageable
    mod = 1000000007  # Large prime for modulo
    
    while i < n:
        temp = (a + b) % mod
        a = b
        b = temp
        i = i + 1
    
    print("fib(1000000) mod 1000000007 =")
    print(a)
