def test_arithmetic():
    a: int = 1000
    b: int = 2000
    
    print("Addition:")
    print(a + b)
    
    print("Subtraction:")
    print(a - b)
    
    print("Multiplication:")
    print(a * b)
    
    print("Division:")
    print(b / a)
    
    print("Modulo:")
    print(b % 300)
    
    print("Negation:")
    print(-a)
    
    print("Comparisons:")
    print(a < b)
    print(a > b)
    print(a == 1000)
    print(a != b)

    print("Large ops:")
    c: int = 2 ** 60
    d: int = 2 ** 10
    e: int = c * d
    print(e)
    print(e / c)

test_arithmetic()
