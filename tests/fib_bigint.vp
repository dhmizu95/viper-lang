# Fibonacci with bigint - Test large number computation

# Iterative Fibonacci using bigint
def fib(n: int) -> bigint:
    if n <= 0:
        return int("0")
    elif n == 1:
        return int("1")
    
    a = int("0")
    b = int("1")
    
    i = 2
    while i <= n:
        c = a + b
        a = b
        b = c
        i = i + 1
    
    return b

# Test with various sizes
def main():
    print("=== Fibonacci with bigint ===")
    print("")
    
    # Small test
    print("fib(10) = ")
    result = fib(10)
    print(str_int(result))
    print("")
    
    # Medium test
    print("fib(100) = ")
    result = fib(100)
    print(str_int(result))
    print("")
    
    # Large test
    print("fib(1000) = ")
    result = fib(1000)
    print(str_int(result))
    print("")
    
    # Very large test
    print("fib(10000) = ")
    result = fib(10000)
    print(str_int(result))
    print("")
    
    print("=== Test complete ===")
