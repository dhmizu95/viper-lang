# Test automatic bigint promotion
# Integers that exceed int range are automatically promoted to bigint

# Small integer (fits in int)
small = 42

# Large integer (exceeds int max, auto-promoted to bigint)
large = 9223372036854775808  # int::MAX + 1

# Explicit bigint with 'n' suffix
explicit = 123

# Very large integer (hundreds of digits)
huge = 1234567890123456789012345678901234567890123456789012345678901234567890

# Mixed arithmetic: int + bigint = bigint
result1 = small + large

# bigint arithmetic
result2 = large * 2

# Comparison between int and bigint
if small < large:
    print("large is larger")

# Test negative large numbers
neg_large = -9223372036854775808

# Test bigint in list
big_list = [1, 9223372036854775808, 1000000000000000000000]

# Test comparisons
print(small == 42)
print(large > small)
print(huge > large)

# Test arithmetic operations
print(large + 1)
print(large - 1)
print(large * 2)
print(large // 2)
print(large % 10)

# Test explicit bigint constructor
from_big = int("123456789012345678901234567890")

# Test bigint functions
abs_val = abs_int(neg_large)
print("abs worked")

# Test with function that explicitly returns bigint
def factorial_big(n: int) -> bigint:
    result = 1
    i = 1
    while i <= n:
        result = result * i
        i = i + 1
    return result

fact5 = factorial_big(5)
print(fact5)

print("All bigint tests passed!")
