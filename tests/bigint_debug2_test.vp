# Debug bigint Test 2

def main():
    print("=== Debug bigint Test 2 ===")
    
    # Test with n suffix (this works)
    x = 100
    print("x (100) =")
    print(x)
    
    # Test with int() constructor
    y = int("100")
    print("y (bigint) =")
    print(y)
    
    # Test str_bigint with n-suffix
    print("str(x):")
    sx = str(x)
    print(sx)
    
    # Test str_bigint with int()
    print("str(y):")
    sy = str(y)
    print(sy)
    
    print("=== Test complete ===")
