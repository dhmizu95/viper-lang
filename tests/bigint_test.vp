# bigint Test Suite for Viper
# Tests arbitrary precision integer operations using GMP

# Test 1: Basic bigint creation
def test_bigint_creation():
    print("Test 1: int creation")
    a = int("123456789012345678901234567890")
    b = int("987654321098765432109876543210")
    print("a = ")
    print(str(a))
    print("b = ")
    print(str(b))

# Test 2: int addition
def test_bigint_add():
    print("Test 2: int addition")
    a = int("123456789012345678901234567890")
    b = int("987654321098765432109876543210")
    c = a + b
    print("a + b = ")
    print(str(c))

# Test 3: int subtraction
def test_bigint_sub():
    print("Test 3: int subtraction")
    a = int("987654321098765432109876543210")
    b = int("123456789012345678901234567890")
    c = a - b
    print("a - b = ")
    print(str(c))

# Test 4: int multiplication
def test_bigint_mul():
    print("Test 4: int multiplication")
    a = int("123456789012345678")
    b = int("987654321098765432")
    c = a * b
    print("a * b = ")
    print(str(c))

# Test 5: int division
def test_bigint_div():
    print("Test 5: int division")
    a = int("98765432109876543210")
    b = int("123456789012345678")
    q = a / b
    print("a / b = ")
    print(str(q))

# Test 6: int modulo
def test_bigint_mod():
    print("Test 6: int modulo")
    a = int("98765432109876543210")
    b = int("123456789012345678")
    r = a % b
    print("a % b = ")
    print(str(r))

# Test 7: int comparison
def test_bigint_cmp():
    print("Test 7: int comparison")
    a = int("123456789012345678901234567890")
    b = int("987654321098765432109876543210")
    
    if a < b:
        print("a < b: True")
    else:
        print("a < b: False")
    
    if a > b:
        print("a > b: True")
    else:
        print("a > b: False")
    
    if a == b:
        print("a == b: True")
    else:
        print("a == b: False")

# Test 8: int bitwise operations
def test_bigint_bitwise():
    print("Test 8: int bitwise operations")
    a = int("0xFF00FF00FF00FF00")
    b = int("0x00FF00FF00FF00FF")
    
    c = a & b
    print("a & b = 0x")
    print(str(c))
    
    d = a | b
    print("a | b = 0x")
    print(str(d))
    
    e = a ^ b
    print("a ^ b = 0x")
    print(str(e))

# Test 9: int shifts
def test_bigint_shifts():
    print("Test 9: int shifts")
    a = int("1")
    b = int("10")
    
    c = a << b
    print("1 << 10 = ")
    print(str(c))
    
    d = c >> int("5")
    print("(1 << 10) >> 5 = ")
    print(str(d))

# Test 10: Very large numbers
def test_bigint_large():
    print("Test 10: Very large numbers")
    # 2^1000
    two = int("2")
    exp = int("1000")
    result = two ** exp
    print("2^1000 = ")
    print(str(result))

# Test 11: Mixed operations
def test_bigint_mixed():
    print("Test 11: Mixed operations")
    a = int("100")
    b = int("3")
    
    q = a / b
    r = a % b
    print("100 / 3 = ")
    print(str(q))
    print("100 % 3 = ")
    print(str(r))
    print("q * 3 + r = ")
    print(str(q * b + r))

# Run all tests
def main():
    print("=== Viper bigint Test Suite ===")
    print("")
    
    test_bigint_creation()
    print("")
    
    test_bigint_add()
    print("")
    
    test_bigint_sub()
    print("")
    
    test_bigint_mul()
    print("")
    
    test_bigint_div()
    print("")
    
    test_bigint_mod()
    print("")
    
    test_bigint_cmp()
    print("")
    
    test_bigint_bitwise()
    print("")
    
    test_bigint_shifts()
    print("")
    
    test_bigint_large()
    print("")
    
    test_bigint_mixed()
    print("")
    
    print("=== All tests completed ===")

main()
