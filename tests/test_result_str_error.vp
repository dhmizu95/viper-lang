# Test Result with string error type

def divide(a: int, b: int) -> Result[int, str]:
    if b == 0:
        return Err("Division by zero")
    return Ok(a / b)

def test_string_error():
    r1 = divide(10, 2)
    r2 = divide(10, 0)
    
    print("Testing is_ok with str error:")
    print(r1.is_ok())  # Should be True
    print(r2.is_ok())  # Should be False
    
    print("Testing unwrap with success:")
    val1 = r1.unwrap()
    print(val1)  # Should be 5
    
    print("Testing unwrap_or with error case:")
    val2 = r2.unwrap_or(999)
    print(val2)  # Should be 999
    
    print("All string error Result tests passed!")

test_string_error()
