# Test generic type annotations - lists

def test_list_generic():
    # list[T] syntax
    nums: list[int] = [1, 2, 3]
    names: list[str] = ["a", "b", "c"]
    print(len(nums))
    print(len(names))
    print(nums[0])
    print(names[0])

def test_nested_generics():
    # Nested generic types
    matrix: list[list[int]] = [[1, 2], [3, 4]]
    print(len(matrix))
    print(len(matrix[0]))

test_list_generic()
test_nested_generics()
print("Generic type annotations work!")
