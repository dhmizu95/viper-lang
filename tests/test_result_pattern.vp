# Test pattern matching with Result

def divide(a: int, b: int) -> Result[int, str]:
    if b == 0:
        return Err("Division by zero")
    return Ok(a / b)

def test_ok_pattern():
    r1 = divide(10, 2)
    
    match r1:
        case Ok(value):
            print("Success! Value is:")
            print(value)
        case Err(e):
            print("Error:")
            print(e)

def test_err_pattern():
    r2 = divide(10, 0)
    
    match r2:
        case Ok(value):
            print("Success! Value is:")
            print(value)
        case Err(e):
            print("Got error:")
            print(e)

test_ok_pattern()
test_err_pattern()
print("Done!")
