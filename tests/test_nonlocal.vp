# Test nonlocal keyword for closure support
# This tests that nested functions can modify variables from enclosing scope

def test_basic_nonlocal():
    """Test basic nonlocal variable modification"""
    x = 10
    
    def inner():
        nonlocal x
        x = 20
    
    inner()
    
    if x == 20:
        print("✓ test_basic_nonlocal passed: x =", x)
        return True
    else:
        print("✗ test_basic_nonlocal failed: expected 20, got", x)
        return False

def test_multiple_nonlocal():
    """Test multiple nonlocal variables"""
    a = 1
    b = 2
    c = 3
    
    def modifier():
        nonlocal a, b, c
        a = 10
        b = 20
        c = 30
    
    modifier()
    
    if a == 10 and b == 20 and c == 30:
        print("✓ test_multiple_nonlocal passed: a=", a, "b=", b, "c=", c)
        return True
    else:
        print("✗ test_multiple_nonlocal failed")
        return False

def test_nested_nonlocal():
    """Test deeply nested nonlocal"""
    outer_count = 0
    
    def middle():
        def inner():
            nonlocal outer_count
            outer_count = 42
        inner()
    
    middle()
    
    if outer_count == 42:
        print("✓ test_nested_nonlocal passed: count =", outer_count)
        return True
    else:
        print("✗ test_nested_nonlocal failed: expected 42, got", outer_count)
        return False

def test_nonlocal_in_loop():
    """Test nonlocal variable modified in loop"""
    total = 0
    
    def accumulator():
        nonlocal total
        i = 0
        while i < 5:
            total = total + 1
            i = i + 1
    
    accumulator()
    
    if total == 5:
        print("✓ test_nonlocal_in_loop passed: total =", total)
        return True
    else:
        print("✗ test_nonlocal_in_loop failed: expected 5, got", total)
        return False

def test_nonlocal_with_return():
    """Test nonlocal with return value"""
    counter = 0
    
    def increment():
        nonlocal counter
        counter = counter + 1
        return counter
    
    result1 = increment()
    result2 = increment()
    result3 = increment()
    
    if counter == 3 and result1 == 1 and result2 == 2 and result3 == 3:
        print("✓ test_nonlocal_with_return passed: counter =", counter)
        return True
    else:
        print("✗ test_nonlocal_with_return failed")
        return False

def main():
    """Run all nonlocal tests"""
    print("Running nonlocal tests...")
    print("")
    
    passed = 0
    failed = 0
    
    if test_basic_nonlocal():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_multiple_nonlocal():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_nested_nonlocal():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_nonlocal_in_loop():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_nonlocal_with_return():
        passed = passed + 1
    else:
        failed = failed + 1
    
    print("")
    print("=" * 50)
    print("Test Summary")
    print("=" * 50)
    print("Passed:", passed)
    print("Failed:", failed)
    print("Total:", passed + failed)
    
    if failed > 0:
        exit(1)
