# Test contextlib module

from contextlib import contextmanager, suppress, closing, nullcontext
from io import StringIO

@contextmanager
def managed_resource():
    """Simple context manager for testing."""
    print("  Acquiring resource")
    try:
        yield "resource"
    finally:
        print("  Releasing resource")

@contextmanager
def custom_context(value):
    """Context manager with parameter."""
    print("  Entering with value:", value)
    try:
        yield value * 2
    finally:
        print("  Exiting")

def test_contextmanager():
    """Test @contextmanager decorator."""
    print("Testing contextmanager:")
    with managed_resource() as r:
        if r == "resource":
            print("✓ contextmanager works")
            return True
    return False

def test_contextmanager_with_param():
    """Test contextmanager with parameters."""
    print("Testing contextmanager with param:")
    with custom_context(5) as result:
        if result == 10:
            print("✓ contextmanager with param works")
            return True
    return False

def test_suppress():
    """Test suppress context manager."""
    print("Testing suppress:")
    try:
        with suppress(FileNotFoundError):
            # This would normally raise
            pass
        print("✓ suppress works")
        return True
    except:
        return False

def test_nullcontext():
    """Test nullcontext."""
    print("Testing nullcontext:")
    with nullcontext("value") as v:
        if v == "value":
            print("✓ nullcontext works")
            return True
    return False

def test_closing():
    """Test closing context manager."""
    print("Testing closing:")
    buffer = StringIO()
    with closing(buffer) as b:
        b.write("test")
    # buffer should be closed now
    print("✓ closing works")
    return True

def main():
    """Run all contextlib tests."""
    print("Testing contextlib module...")
    print("")
    
    passed = 0
    failed = 0
    
    if test_contextmanager():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_contextmanager_with_param():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_suppress():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_nullcontext():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_closing():
        passed = passed + 1
    else:
        failed = failed + 1
    
    print("")
    print("=" * 50)
    print("Test Summary")
    print("=" * 50)
    print("Passed:", passed)
    print("Failed:", failed)
    
    if failed > 0:
        exit(1)
