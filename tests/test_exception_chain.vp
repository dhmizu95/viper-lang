# Test exception chaining (raise from)

def test_raise_from_basic() -> None:
    """Test basic exception chaining syntax - raise X from Y"""
    # This tests the raise...from syntax parsing and codegen
    # When executed, this will raise an exception with a cause chain
    raise Exception("outer error") from Exception("inner error")

def test_raise_from_nested() -> None:
    """Test nested exception chaining"""
    # Demonstrates the exception chain display
    raise Exception("level 2") from Exception("level 1")

def main() -> None:
    print("=== Exception Chaining Tests ===")
    print("Testing: raise Exception('outer') from Exception('inner')")
    test_raise_from_basic()
    print("All exception chaining tests passed!")

main()
