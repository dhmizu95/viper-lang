# bigint math functions test
def main():
    print("=== bigint math functions test ===")
    
    # Test pow_bigint
    a = 2n
    b = 100n
    p = pow_bigint(a, b)
    print("2^100 = ")
    print(p)
    print("")
    
    # Test sqrt_bigint
    # 2^100 sqrt should be 2^50
    s = sqrt_bigint(p)
    print("sqrt(2^100) = ")
    print(s)
    print("")
    
    expected_s = pow_bigint(2n, 50n)
    print("expected sqrt = ")
    print(expected_s)
    print("")
    
    if s == expected_s:
        print("sqrt(2^100) match expected! ✅")
    else:
        print("sqrt(2^100) mismatch! ❌")
        print("got: ")
        print(p)
        print("want: ")
        print(expected_s)
    print("")
    
    # Test abs_bigint
    neg_a = -1000000000000000000000000000000n
    abs_a = abs_bigint(neg_a)
    print("abs(-10^30) = ")
    print(abs_a)
    print("")
    
    if abs_a > 0n:
        print("abs(-10^30) is positive ✅")

main()
