# bigint math functions test
import math
def main():
    print("=== bigint math functions test ===")
    
    # Test pow_bigint
    a = 2
    b = 100
    p = pow(a, b)
    print("2^100 = ")
    print(p)
    print("")
    
    # Test sqrt_bigint
    # 2^100 sqrt should be 2^50
    s = math.isqrt(p)
    print("sqrt(2^100) = ")
    print(s)
    print("")
    
    expected_s = pow(2, 50)
    print("expected sqrt = ")
    print(expected_s)
    print("")
    
    if s == expected_s:
        print("sqrt(2^100) match expected! ✅")
    else:
        print("sqrt(2^100) mismatch! ❌")
        print("got: ")
        print(p)
        print("want: ")
        print(expected_s)
    print("")
    
    # Test abs_bigint
    neg_a = -1000000000000000000000000000000
    abs_a = abs(neg_a)
    print("abs(-10^30) = ")
    print(abs_a)
    print("")
    
    if abs_a > 0:
        print("abs(-10^30) is positive ✅")

main()
