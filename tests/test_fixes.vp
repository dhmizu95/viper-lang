# Test file for Viper compiler fixes

# Fix #5: Global constants
PI = 3.14159
MAX_VALUE = 100
NAME = "Viper"
ENABLED = True

# Fix #6: Python-style comments (# only)
# This is a hash comment

# Fix #4: Math builtins
result = sqrt(16.0)
print(result)  # Should print 4.0

abs_val = abs(-5.5)
print(abs_val)  # Should print 5.5

# Fix #3: Mixed int/float auto-conversion
x = 10 + 3.5  # int + float, should auto-convert to 13.5
print(x)

y = 2.0 * 5  # float * int, should auto-convert to 10.0
print(y)

# Fix #1: List indexing
numbers = [1, 2, 3, 4, 5]
first = numbers[0]
print(first)  # Should print 1

# Fix #2: Binary ops error on pointer values
# This would now produce an error:
# bad = numbers + [6, 7]

print("All tests passed!")
