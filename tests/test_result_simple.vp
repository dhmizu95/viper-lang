# Simple test for error propagation

def divide(a: int, b: int) -> Result[int, str]:
    if b == 0:
        return Err("Division by zero")
    return Ok(a / b)

def compute(a: int, b: int) -> Result[int, str]:
    x = divide(a, b)?
    return Ok(x)

print("Testing OK case...")
result = compute(10, 2)
if result.is_ok():
    print("Success: ", result.unwrap())
else:
    print("Error: ", result.unwrap_err())

print("Testing Error case...")
result2 = compute(10, 0)
if result2.is_ok():
    print("Success: ", result2.unwrap())
else:
    print("Error caught: ", result2.unwrap_err())

print("Done")
