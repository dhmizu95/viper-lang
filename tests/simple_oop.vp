# Simple OOP test for Viper

class Counter:
    def __init__(self):
        self.value = 0

    def increment(self) -> int:
        self.value = self.value + 1
        return self.value

    def get_value(self) -> int:
        return self.value

def test_counter() -> None:
    c1 = Counter()
    print(c1.increment())
    print(c1.increment())
    print(c1.get_value())
    
    c2 = Counter()
    print(c2.increment())

test_counter()
