# Test debugger (pdb)

import pdb

def buggy_function(x):
    """Function with a bug to debug."""
    pdb.set_trace()  # Set breakpoint
    result = x * 2
    return result

def factorial(n):
    """Calculate factorial."""
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def test_debug_session():
    """Test debug session."""
    print("Starting debug session...")
    print("Commands to try:")
    print("  n - Next line")
    print("  s - Step into")
    print("  c - Continue")
    print("  p <expr> - Print expression")
    print("  l - List code")
    print("  w - Where (stack trace)")
    print("  q - Quit")
    print("")
    
    result = buggy_function(21)
    print("Result:", result)

def test_factorial():
    """Test factorial with debugger."""
    print("Testing factorial...")
    for i in range(1, 6):
        result = factorial(i)
        print("factorial(", i, ") =", result)

def main():
    """Run debugger tests."""
    print("Testing debugger (pdb)...")
    print("")
    
    # Uncomment to run interactive debug session
    # test_debug_session()
    
    # Run non-interactive test
    test_factorial()
    
    print("")
    print("✓ Debugger test complete")
    print("")
    print("To test interactive debugging, uncomment test_debug_session() in this file")
