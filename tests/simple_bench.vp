# Simple bigint benchmark

def main():
    print("=== Simple bigint Benchmark ===")
    
    # Test 1: Factorial(100)
    print("1. Factorial(100)")
    result = int("1")
    i = int("1")
    n = int("100")
    while i <= n:
        result = result * i
        i = i + int("1")
    print("   Result: " + str(len(str(result))) + " digits")
    print()
    
    # Test 2: Fibonacci(1000)
    print("2. Fibonacci(1000)")
    a = int("0")
    b = int("1")
    i = int("0")
    n = int("1000")
    while i < n:
        temp = a + b
        a = b
        b = temp
        i = i + int("1")
    print("   Result: " + str(len(str(a))) + " digits")
    print()
    
    print("=== Done ===")
