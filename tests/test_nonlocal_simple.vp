# Test nonlocal keyword for closure support
# Simple test that works with current nested function support

def outer():
    """Test basic nonlocal variable modification"""
    x = 10
    
    def inner():
        nonlocal x
        x = 20
        return x
    
    # Call inner and check result
    result = inner()
    
    # Print for debugging
    print("x after inner:", x)
    print("result from inner:", result)
    
    return x

def main():
    """Run nonlocal test"""
    print("Running nonlocal test...")
    print("")
    
    result = outer()
    
    print("")
    if result == 20:
        print("✓ nonlocal test passed: outer returned", result)
    else:
        print("✗ nonlocal test failed: expected 20, got", result)
