# Test pathlib module

from pathlib import Path

def test_path_creation():
    """Test Path creation."""
    p = Path("/home/user/test.txt")
    
    if str(p) == "/home/user/test.txt":
        print("✓ Path creation works")
        return True
    return False

def test_path_name():
    """Test Path.name()."""
    p = Path("/home/user/test.txt")
    name = p.name()
    
    if name == "test.txt":
        print("✓ Path.name() works")
        return True
    return False

def test_path_suffix():
    """Test Path.suffix()."""
    p = Path("/home/user/test.txt")
    suffix = p.suffix()
    
    if suffix == ".txt":
        print("✓ Path.suffix() works")
        return True
    return False

def test_path_parent():
    """Test Path.parent()."""
    p = Path("/home/user/test.txt")
    parent = p.parent()
    
    if str(parent) == "/home/user":
        print("✓ Path.parent() works")
        return True
    return False

def test_path_join():
    """Test Path / operator."""
    p = Path("/home/user")
    new_p = p / "test" / "file.txt"
    
    if str(new_p) == "/home/user/test/file.txt":
        print("✓ Path join (/) works")
        return True
    return False

def test_path_exists():
    """Test Path.exists()."""
    p = Path("/tmp")
    
    if p.exists():
        print("✓ Path.exists() works")
        return True
    return False

def test_path_is_dir():
    """Test Path.is_dir()."""
    p = Path("/tmp")
    
    if p.is_dir():
        print("✓ Path.is_dir() works")
        return True
    return False

def test_path_is_file():
    """Test Path.is_file()."""
    p = Path("/nonexistent_file_xyz.txt")
    
    if not p.is_file():
        print("✓ Path.is_file() works")
        return True
    return False

def test_path_stem():
    """Test Path.stem()."""
    p = Path("/home/user/test.txt")
    stem = p.stem()
    
    if stem == "test":
        print("✓ Path.stem() works")
        return True
    return False

def test_path_absolute():
    """Test Path.absolute()."""
    p = Path("test.txt")
    abs_p = p.absolute()
    
    if abs_p.is_absolute():
        print("✓ Path.absolute() works")
        return True
    return False

def main():
    """Run all pathlib tests."""
    print("Testing pathlib module...")
    print("")
    
    passed = 0
    failed = 0
    
    if test_path_creation():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_path_name():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_path_suffix():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_path_parent():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_path_join():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_path_exists():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_path_is_dir():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_path_is_file():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_path_stem():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_path_absolute():
        passed = passed + 1
    else:
        failed = failed + 1
    
    print("")
    print("=" * 50)
    print("Test Summary")
    print("=" * 50)
    print("Passed:", passed)
    print("Failed:", failed)
    
    if failed > 0:
        exit(1)
