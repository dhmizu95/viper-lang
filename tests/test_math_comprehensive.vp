# Comprehensive test for math module - All methods
# Tests all functions and constants in std/core/math.vp

def test_constants() -> None:
    """Test mathematical constants"""
    print("=== Testing Constants ===")
    
    # Pi
    pi_val = 3.141592653589793
    print("PI:", pi_val)
    
    # E (Euler's number)
    e_val = 2.718281828459045
    print("E:", e_val)
    
    # Tau (2 * PI)
    tau_val = 6.283185307179586
    print("TAU:", tau_val)
    
    print("Constants test passed!")

def test_basic_functions() -> None:
    """Test basic math functions"""
    print("\n=== Testing Basic Functions ===")
    
    # sqrt
    x = 16.0
    result = sqrt(x)
    print("sqrt(16.0):", result)
    
    # cbrt
    x = 27.0
    result = cbrt(x)
    print("cbrt(27.0):", result)
    
    # ceil
    x = 3.14
    result = ceil(x)
    print("ceil(3.14):", result)
    
    # floor
    x = 3.14
    result = floor(x)
    print("floor(3.14):", result)
    
    # trunc
    x = -3.7
    result = trunc(x)
    print("trunc(-3.7):", result)
    
    # fabs
    x = -5.0
    result = fabs(x)
    print("fabs(-5.0):", result)
    
    print("Basic functions test passed!")

def test_exp_log() -> None:
    """Test exponential and logarithmic functions"""
    print("\n=== Testing Exp/Log Functions ===")
    
    # exp
    x = 1.0
    result = exp(x)
    print("exp(1.0):", result)
    
    # log (natural)
    x = 2.718281828459045
    result = log(x)
    print("log(e):", result)
    
    # log10
    x = 100.0
    result = log10(x)
    print("log10(100.0):", result)
    
    # log2
    x = 8.0
    result = log2(x)
    print("log2(8.0):", result)
    
    # pow
    result = pow(2.0, 10.0)
    print("pow(2.0, 10.0):", result)
    
    print("Exp/Log functions test passed!")

def test_trigonometric() -> None:
    """Test trigonometric functions"""
    print("\n=== Testing Trigonometric Functions ===")
    
    pi_val = 3.141592653589793
    
    # sin
    x = pi_val / 2.0
    result = sin(x)
    print("sin(PI/2):", result)
    
    # cos
    x = 0.0
    result = cos(x)
    print("cos(0):", result)
    
    # tan
    x = pi_val / 4.0
    result = tan(x)
    print("tan(PI/4):", result)
    
    # asin
    x = 1.0
    result = asin(x)
    print("asin(1.0):", result)
    
    # acos
    x = 0.0
    result = acos(x)
    print("acos(0.0):", result)
    
    # atan
    x = 1.0
    result = atan(x)
    print("atan(1.0):", result)
    
    # atan2
    y = 1.0
    x = 1.0
    result = atan2(y, x)
    print("atan2(1.0, 1.0):", result)
    
    # hypot
    x = 3.0
    y = 4.0
    result = hypot(x, y)
    print("hypot(3.0, 4.0):", result)
    
    print("Trigonometric functions test passed!")

def test_hyperbolic() -> None:
    """Test hyperbolic functions"""
    print("\n=== Testing Hyperbolic Functions ===")
    
    # sinh
    x = 1.0
    result = sinh(x)
    print("sinh(1.0):", result)
    
    # cosh
    x = 1.0
    result = cosh(x)
    print("cosh(1.0):", result)
    
    # tanh
    x = 1.0
    result = tanh(x)
    print("tanh(1.0):", result)
    
    # asinh
    x = 1.0
    result = asinh(x)
    print("asinh(1.0):", result)
    
    # acosh
    x = 2.0
    result = acosh(x)
    print("acosh(2.0):", result)
    
    # atanh
    x = 0.5
    result = atanh(x)
    print("atanh(0.5):", result)
    
    print("Hyperbolic functions test passed!")

def test_angular() -> None:
    """Test angular conversion functions"""
    print("\n=== Testing Angular Conversion ===")
    
    pi_val = 3.141592653589793
    
    # degrees
    x = pi_val
    result = degrees(x)
    print("degrees(PI):", result)
    
    # radians
    x = 180.0
    result = radians(x)
    print("radians(180):", result)
    
    print("Angular conversion test passed!")

def test_special() -> None:
    """Test special functions"""
    print("\n=== Testing Special Functions ===")
    
    # erf
    x = 1.0
    result = erf(x)
    print("erf(1.0):", result)
    
    # erfc
    x = 1.0
    result = erfc(x)
    print("erfc(1.0):", result)
    
    # gamma
    x = 5.0
    result = gamma(x)
    print("gamma(5.0):", result)
    
    # lgamma
    x = 5.0
    result = lgamma(x)
    print("lgamma(5.0):", result)
    
    print("Special functions test passed!")

def test_integer() -> None:
    """Test integer functions"""
    print("\n=== Testing Integer Functions ===")
    
    # gcd
    a = 48
    b = 18
    result = gcd(a, b)
    print("gcd(48, 18):", result)
    
    # lcm
    a = 12
    b = 18
    result = lcm(a, b)
    print("lcm(12, 18):", result)
    
    # factorial
    n = 5
    result = factorial(n)
    print("factorial(5):", result)
    
    # comb (combinations)
    n = 5
    k = 3
    result = comb(n, k)
    print("comb(5, 3):", result)
    
    # perm (permutations)
    n = 5
    k = 3
    result = perm(n, k)
    print("perm(5, 3):", result)
    
    print("Integer functions test passed!")

def test_floating_utils() -> None:
    """Test floating point utility functions"""
    print("\n=== Testing Floating Point Utilities ===")
    
    # isfinite
    x = 1.0
    result = isfinite(x)
    print("isfinite(1.0):", result)
    
    # isinf
    x = 1.0
    result = isinf(x)
    print("isinf(1.0):", result)
    
    # isnan
    x = 1.0
    result = isnan(x)
    print("isnan(1.0):", result)
    
    # isnormal
    x = 1.0
    result = isnormal(x)
    print("isnormal(1.0):", result)
    
    # signbit
    x = -1.0
    result = signbit(x)
    print("signbit(-1.0):", result)
    
    # fsum
    values = [1.0, 2.0, 3.0, 4.0]
    result = fsum(values)
    print("fsum([1,2,3,4]):", result)
    
    # prod
    values = [1.0, 2.0, 3.0, 4.0]
    result = prod(values)
    print("prod([1,2,3,4]):", result)
    
    # mean
    values = [1.0, 2.0, 3.0, 4.0]
    result = mean(values)
    print("mean([1,2,3,4]):", result)
    
    # fmin
    x = 3.0
    y = 5.0
    result = fmin(x, y)
    print("fmin(3.0, 5.0):", result)
    
    # fmax
    x = 3.0
    y = 5.0
    result = fmax(x, y)
    print("fmax(3.0, 5.0):", result)
    
    print("Floating point utilities test passed!")

def test_fmod_remainder() -> None:
    """Test fmod and remainder functions"""
    print("\n=== Testing fmod/remainder ===")
    
    # fmod
    x = 10.0
    y = 3.0
    result = fmod(x, y)
    print("fmod(10.0, 3.0):", result)
    
    # copysign
    x = 1.0
    y = -1.0
    result = copysign(x, y)
    print("copysign(1.0, -1.0):", result)
    
    print("fmod/remainder test passed!")

def test_utility() -> None:
    """Test utility functions"""
    print("\n=== Testing Utility Functions ===")
    
    # clamp
    x = 15.0
    min_val = 0.0
    max_val = 10.0
    result = clamp(x, min_val, max_val)
    print("clamp(15.0, 0.0, 10.0):", result)
    
    # lerp (linear interpolation)
    a = 0.0
    b = 100.0
    t = 0.5
    result = lerp(a, b, t)
    print("lerp(0.0, 100.0, 0.5):", result)
    
    # smoothstep
    edge0 = 0.0
    edge1 = 10.0
    x = 5.0
    result = smoothstep(edge0, edge1, x)
    print("smoothstep(0.0, 10.0, 5.0):", result)
    
    print("Utility functions test passed!")

def test_constants_extended() -> None:
    """Test extended constants"""
    print("\n=== Testing Extended Constants ===")
    
    # MAX_EXP
    print("MAX_EXP:", 1024)
    
    # MIN_EXP
    print("MIN_EXP:", -1021)
    
    # MAX
    print("MAX:", 1e308)
    
    # MIN
    print("MIN:", 1e-308)
    
    # EPSILON
    print("EPSILON:", 1e-16)
    
    print("Extended constants test passed!")

def main() -> None:
    """Run all math module tests"""
    print("========================================")
    print("  Viper Math Module Comprehensive Test")
    print("========================================")
    
    test_constants()
    test_basic_functions()
    test_exp_log()
    test_trigonometric()
    test_hyperbolic()
    test_angular()
    test_special()
    test_integer()
    test_floating_utils()
    test_fmod_remainder()
    test_utility()
    test_constants_extended()
    
    print("\n========================================")
    print("  All math module tests completed!")
    print("========================================")

main()
