class Circle:
    def __init__(self, radius):
        self._radius = radius
    
    @property
    def radius(self):
        return self._radius
    
    @radius.setter
    def radius(self, value):
        if value < 0:
            raise ValueError("Radius cannot be negative")
        self._radius = value
    
    @property
    def diameter(self):
        return self._radius * 2
    
    @property
    def area(self):
        return 3.14159 * self._radius * self._radius

def main():
    c = Circle(5)
    print(c.radius)
    print(c.diameter)
    print(c.area)
    
    c.radius = 10
    print(c.radius)
    print(c.diameter)
    print("Property tests completed")
