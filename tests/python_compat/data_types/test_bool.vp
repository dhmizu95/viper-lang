def test_bool_operations():
    print(True and True)
    print(True and False)
    print(True or False)
    print(not True)

def test_bool_conversion():
    print(True)
    print(False)

def test_bool_comparison():
    a = True
    b = False
    print(a == b)
    print(a != b)

def main():
    test_bool_operations()
    test_bool_conversion()
    test_bool_comparison()
    print("Bool tests completed")
