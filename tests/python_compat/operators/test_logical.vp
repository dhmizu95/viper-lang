def test_logical_and():
    print(True and True)
    print(True and False)
    print(False and True)
    print(False and False)

def test_logical_or():
    print(True or True)
    print(True or False)
    print(False or True)
    print(False or False)

def test_logical_not():
    print(not True)
    print(not False)

def test_logical_short_circuit():
    x = 5
    if x > 0 and x < 10:
        print("x is between 0 and 10")
    
    y = None
    if y is None or y > 0:
        print("y is None or positive")

def main():
    test_logical_and()
    test_logical_or()
    test_logical_not()
    test_logical_short_circuit()
    print("Logical tests completed")
