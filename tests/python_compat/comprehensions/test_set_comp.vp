def test_set_comprehension():
    squares = {x * x for x in range(10)}
    print(squares)
    
    unique_chars = {c for c in "hello world"}
    print(unique_chars)
    
    even_squares = {x * x for x in range(10) if x % 2 == 0}
    print(even_squares)

def test_nested_set():
    matrix = [[1, 2], [2, 3], [3, 4]]
    unique_elements = {x for row in matrix for x in row}
    print(unique_elements)

def main():
    test_set_comprehension()
    test_nested_set()
    print("Set comprehension tests completed")
