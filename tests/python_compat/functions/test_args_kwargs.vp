def test_args(*args):
    result = 0
    for arg in args:
        result += arg
    return result

def test_kwargs(**kwargs):
    return kwargs

def test_args_kwargs(*args, **kwargs):
    return args, kwargs

def test_mixed(a, b=2, *args, **kwargs):
    return a, b, args, kwargs

def main():
    print(test_args(1, 2, 3, 4, 5))
    print(test_kwargs(x=1, y=2))
    print(test_args_kwargs(1, 2, 3, name="test"))
    print(test_mixed(1))
    print(test_mixed(1, 3))
    print(test_mixed(1, 3, 4, 5, 6))
    print(test_mixed(1, 3, 4, 5, 6, key="value"))
    print("Args/Kwargs tests completed")
