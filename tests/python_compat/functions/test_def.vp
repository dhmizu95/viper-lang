def add(a, b):
    return a + b

def greet(name, greeting="Hello"):
    return greeting + ", " + name + "!"

def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def fibonacci(n):
    if n <= 1:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

def default_args(a, b=10, c=20):
    return a + b + c

def main():
    print(add(3, 5))
    print(greet("Alice"))
    print(greet("Bob", "Hi"))
    print(factorial(5))
    print(fibonacci(10))
    print(default_args(1))
    print(default_args(1, 2))
    print(default_args(1, 2, 3))
    print("Function tests completed")
