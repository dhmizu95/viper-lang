def count_up_to(n):
    i = 1
    while i <= n:
        yield i
        i += 1

def fibonacci_gen(n):
    a, b = 0, 1
    for _ in range(n):
        yield a
        a, b = b, a + b

def generator_with_return():
    yield 1
    yield 2
    yield 3

def main():
    for num in count_up_to(5):
        print(num)
    
    for num in fibonacci_gen(10):
        print(num)
    
    for num in generator_with_return():
        print(num)
    print("Generator tests completed")
