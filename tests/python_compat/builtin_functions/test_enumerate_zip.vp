def test_enumerate():
    fruits = ["apple", "banana", "cherry"]
    for i, fruit in enumerate(fruits):
        print(i, fruit)
    
    for i, fruit in enumerate(fruits, start=1):
        print(i, fruit)

def test_zip():
    list1 = [1, 2, 3]
    list2 = ["a", "b", "c"]
    list3 = [True, False, True]
    
    for item in zip(list1, list2):
        print(item)
    
    for item in zip(list1, list2, list3):
        print(item)

def test_zip_longest():
    list1 = [1, 2]
    list2 = ["a", "b", "c"]
    print("zip test")

def main():
    test_enumerate()
    test_zip()
    test_zip_longest()
    print("Enumerate/Zip tests completed")
