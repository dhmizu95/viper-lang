def test_fstring():
    name = "Alice"
    age = 30
    print(f"My name is {name} and I am {age} years old")
    
    x = 10
    y = 20
    print(f"{x} + {y} = {x + y}")
    
    value = 3.14159
    print(f"Value: {value:.2f}")

def test_format():
    print("{} {}".format("Hello", "World"))
    print("{1} {0}".format("World", "Hello"))
    print("{name} is {age}".format(name="Alice", age=30))

def test_percent():
    print("%s is %d years old" % ("Alice", 30))
    print("Value: %.2f" % 3.14159)

def main():
    test_fstring()
    test_format()
    test_percent()
    print("String formatting tests completed")
