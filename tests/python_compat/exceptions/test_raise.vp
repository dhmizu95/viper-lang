def test_raise_basic():
    def divide(a, b):
        if b == 0:
            raise ZeroDivisionError("Cannot divide by zero")
        return a / b
    
    try:
        divide(10, 0)
    except ZeroDivisionError as e:
        print("Caught:", e)

def test_raise_custom():
    class MyError(Exception):
        pass
    
    def raise_custom():
        raise MyError("Custom error")
    
    try:
        raise_custom()
    except MyError as e:
        print("Caught custom error:", e)

def test_raise_from():
    def inner():
        raise ValueError("inner error")
    
    def outer():
        try:
            inner()
        except ValueError as e:
            raise RuntimeError("outer error") from e
    
    try:
        outer()
    except RuntimeError as e:
        print("Caught runtime error")
        print("Cause:", e.__cause__)

def test_re_raise():
    def re_raise():
        try:
            x = 10 / 0
        except ZeroDivisionError:
            print("First catch")
            raise
    
    try:
        re_raise()
    except ZeroDivisionError:
        print("Second catch")

def main():
    test_raise_basic()
    test_raise_custom()
    test_raise_from()
    test_re_raise()
    print("Raise tests completed")
