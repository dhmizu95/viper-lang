# Test with statement - simple version

class SimpleContext:
    def __init__(self) -> None:
        self.value = 0

    def __enter__(self) -> int:
        print("Entering context")
        self.value = 42
        return 42

    def __exit__(self, exc_type, exc_val, exc_tb) -> bool:
        print("Exiting context")
        return False

def test_with_basic() -> None:
    with SimpleContext() as ctx:
        print("Inside context, value:", ctx)
    print("After context")

def main() -> None:
    test_with_basic()
    print("With statement test completed!")
