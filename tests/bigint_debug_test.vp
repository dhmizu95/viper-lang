# Debug bigint Test

def main():
    print("=== Debug bigint Test ===")
    
    # Test 1: Create bigint from string
    a = int("100")
    
    # Test 2: Print directly (should work)
    print("Direct print of a:")
    print(a)
    
    # Test 3: Print with str_bigint
    print("Print with str_bigint:")
    s = str(a)
    print(s)
    
    print("=== Test complete ===")
