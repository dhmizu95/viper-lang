# Fibonacci with BigInt - Python-like syntax

def fib(n):
    """
    Computes the nth Fibonacci number iteratively.
    Python handles large integers automatically.
    """
    if n <= 0:
        return 0
    if n == 1:
        return 1
    
    a = 0
    b = 1
    
    i = 2
    while i <= n:
        c = a + b
        a = b
        b = c
        i = i + 1
    
    return b

def main():
    print("=== Fibonacci with BigInt (Native Python) ===")
    print()
    
    # Test cases
    test_cases = [10, 100, 1000, 10000]
    
    for n in test_cases:
        print("fib(")
        print(n)
        print(") = ")
        result = fib(n)
        print(result)
        print("")
    
    print("=== Test complete ===")

main()
