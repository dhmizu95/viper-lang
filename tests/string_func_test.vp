# Test string functions

def main():
    print("=== String Function Test ===")
    
    # Test str() with int
    n = 12345
    s = str(n)
    print("str(12345) =")
    print(s)
    
    # Test str() with bigint
    a = bigint("99999")
    s2 = str(a)
    print("str(bigint) =")
    print(s2)
    
    print("=== Test complete ===")
