# Simple bigint Test with n suffix

def main():
    print("=== bigint n-suffix Test ===")
    
    # Test with n suffix
    a = 100n
    b = 50n
    
    print("a = ")
    print(a)
    print("b = ")
    print(b)
    
    # Test addition
    c = a + b
    print("a + b = ")
    print(c)
    
    print("=== Test complete ===")
