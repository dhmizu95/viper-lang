# Simple BigInt Math Test
import math

# Test GCD
a1: int = int("48")
b1: int = int("18")
result1: int = math.gcd(a1, b1)
print("gcd(48, 18) = ")
print(result1)
print("")
assert result1 == int("6")
print("GCD test: PASSED")

# Test LCM  
a2: int = int("4")
b2: int = int("6")
result2: int = math.lcm(a2, b2)
print("lcm(4, 6) = ")
print(result2)
print("")
assert result2 == int("12")
print("LCM test: PASSED")

# Test factorial
n1: int = int("5")
result3: int = math.factorial(n1)
print("5! = ")
print(result3)
print("")
assert result3 == int("120")
print("Factorial test: PASSED")

# Test isqrt
n2: int = int("100")
result4: int = math.isqrt(n2)
print("isqrt(100) = ")
print(result4)
print("")
assert result4 == int("10")
print("isqrt test: PASSED")

print("ALL SIMPLE TESTS PASSED!")
