# Simple BigInt Math Test
import math

# Test GCD
a1: bigint = bigint("48")
b1: bigint = bigint("18")
result1: bigint = math.gcd(a1, b1)
print("gcd(48, 18) = ")
print(result1)
print("")
assert result1 == bigint("6")
print("GCD test: PASSED")

# Test LCM  
a2: bigint = bigint("4")
b2: bigint = bigint("6")
result2: bigint = math.lcm(a2, b2)
print("lcm(4, 6) = ")
print(result2)
print("")
assert result2 == bigint("12")
print("LCM test: PASSED")

# Test factorial
n1: bigint = bigint("5")
result3: bigint = math.factorial(n1)
print("5! = ")
print(result3)
print("")
assert result3 == bigint("120")
print("Factorial test: PASSED")

# Test isqrt
n2: bigint = bigint("100")
result4: bigint = math.isqrt(n2)
print("isqrt(100) = ")
print(result4)
print("")
assert result4 == bigint("10")
print("isqrt test: PASSED")

print("ALL SIMPLE TESTS PASSED!")
