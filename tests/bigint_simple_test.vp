# Simple bigint Test

def main():
    print("=== Simple bigint Test ===")
    
    # Test 1: Create bigint from string
    a = int("100")
    b = int("50")
    
    print("a = ")
    print(str_int(a))
    print("b = ")
    print(str_int(b))
    
    # Test 2: Addition
    c = a + b
    print("a + b = ")
    print(str_int(c))
    
    # Test 3: Subtraction
    d = a - b
    print("a - b = ")
    print(str_int(d))
    
    # Test 4: Multiplication
    e = a * b
    print("a * b = ")
    print(str_int(e))
    
    # Test 5: Division
    f = a / b
    print("a / b = ")
    print(str_int(f))
    
    # Test 6: Modulo
    g = a % b
    print("a % b = ")
    print(str_int(g))
    
    print("=== Test complete ===")
