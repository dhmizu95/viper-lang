# Simple bigint Test

def main():
    print("=== Simple bigint Test ===")
    
    # Test 1: Create bigint from string
    a = bigint("100")
    b = bigint("50")
    
    print("a = ")
    print(str_bigint(a))
    print("b = ")
    print(str_bigint(b))
    
    # Test 2: Addition
    c = a + b
    print("a + b = ")
    print(str_bigint(c))
    
    # Test 3: Subtraction
    d = a - b
    print("a - b = ")
    print(str_bigint(d))
    
    # Test 4: Multiplication
    e = a * b
    print("a * b = ")
    print(str_bigint(e))
    
    # Test 5: Division
    f = a / b
    print("a / b = ")
    print(str_bigint(f))
    
    # Test 6: Modulo
    g = a % b
    print("a % b = ")
    print(str_bigint(g))
    
    print("=== Test complete ===")
