# Test: Null Coalescing Operator

def main():
    print("Test 1: Basic")
    a = 5
    b = 10
    result1 = a ?? b
    print(result1)
    
    print("Test 2: Left is zero")
    c = 0
    d = 20
    result2 = c ?? d
    print(result2)
    
    print("Test 3: Chained")
    g = 0
    h = 0
    i = 30
    result3 = g ?? h ?? i
    print(result3)
    
    print("Done")
