# Test: Assert statement
# Tests the assert keyword with various conditions and optional messages

def test_assert_basic():
    # Basic assert with True condition
    x = 10
    assert x > 5
    print("basic assert ok")

def test_assert_with_message():
    # Assert with a message
    y = 20
    assert y > 10, "y should be greater than 10"
    print("assert with message ok")

def test_assert_in_loop():
    # Assert inside a loop
    for i in range(5):
        assert i >= 0
    print("assert in loop ok")

def test_assert_expressions():
    # Assert with various expressions
    a = 5
    b = 10
    assert a + b == 15
    assert a * 2 == 10
    assert b - a == 5
    print("assert expressions ok")

def main():
    test_assert_basic()
    test_assert_with_message()
    test_assert_in_loop()
    test_assert_expressions()
    print("all assert tests passed")

main()
