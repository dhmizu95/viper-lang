# Bit Vector Test - Prime Sieve
# Tests the new bit vector implementation (1 bit per boolean, 8x memory savings)

def sieve_of_eratosthenes(n: i64) -> i64:
    """Count primes up to n using Sieve of Eratosthenes with bit vector"""
    # Create bit vector initialized to all True (1 bit per element!)
    is_prime = [True] * (n + 1)
    
    is_prime[0] = False
    is_prime[1] = False
    
    i = 2
    while i * i <= n:
        if is_prime[i]:
            j = i * i
            while j <= n:
                is_prime[j] = False
                j = j + i
        i = i + 1
    
    # Count primes
    count = 0
    i = 0
    while i <= n:
        if is_prime[i]:
            count = count + 1
        i = i + 1
    
    return count

def main():
    # Test with small values
    print(sieve_of_eratosthenes(10))  # Should be 4 (2,3,5,7)
    print(sieve_of_eratosthenes(100))  # Should be 25
    print(sieve_of_eratosthenes(1000))  # Should be 168
    
    # Larger test for performance
    print(sieve_of_eratosthenes(10000))  # Should be 1229
    
    # Test basic bit vector operations
    bools = [True, False, True, False, True]
    print(len(bools))  # Should be 5
    print(bools[0])  # Should be True (1)
    print(bools[1])  # Should be False (0)
    print(bools[-1])  # Should be True (1)
    
    # Test append
    bools.append(False)
    print(len(bools))  # Should be 6
    
    # Test slice
    sliced = bools[1:4]
    print(len(sliced))  # Should be 3
    
    # Test count
    print(bools.count(True))  # Should be 3
    print(bools.count(False))  # Should be 3
    
    print("Bit vector tests passed!")
