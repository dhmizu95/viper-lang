# Test: Function overloading

def sum(a: int, b: int) -> int:
    return a + b

def sum(a: float, b: float) -> float:
    return a + b

def sum(a: int, b: int, c: int) -> int:
    return a + b + c

def main():
    x = sum(3, 4)
    print(x)
    
    y = sum(1.5, 2.5)
    print(y)
    
    z = sum(1, 2, 3)
    print(z)
