# Test super() object semantics

class Base:
    def greet(self) -> str:
        return "Hello from Base"
    
    def introduce(self) -> str:
        return "I am Base"

class Child(Base):
    def greet(self) -> str:
        return "Hello from Child"
    
    def introduce_both(self) -> str:
        # Use super() to call parent method
        base_greeting = super().greet()
        return base_greeting + " and Child"

def test_super() -> None:
    child = Child()
    
    # Direct super() call
    print(child.greet())  # Should print "Hello from Child"
    
    # super() calling parent method
    print(child.introduce_both())  # Should print "Hello from Base and Child"

test_super()
