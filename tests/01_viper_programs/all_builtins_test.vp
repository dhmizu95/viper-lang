# Comprehensive builtin test

# Test sum, min, max
nums = [1, 2, 3, 4, 5]
print(sum(nums))  # Should print 15
print(min(nums))  # Should print 1
print(max(nums))  # Should print 5

# Test any, all
print(any([0, 0, 1]))  # Should print 1 (True)
print(all([1, 2, 3]))  # Should print 1 (True)
print(any([0, 0, 0]))  # Should print 0 (False)
print(all([1, 0, 3]))  # Should print 0 (False)

# Test round
print(round(3.14159, 2))  # Should print 3.14

# Test divmod
result = divmod(17, 5)
print(len(result))  # Should print 2 (tuple with 2 elements)

# Test pow
print(pow(2.0, 3.0))  # Should print 8.0

# Test bin, oct, hex
print(bin(10))  # Should print 0b1010
print(oct(10))  # Should print 0o12
print(hex(10))  # Should print 0xa

# Test chr, ord
print(chr(65))  # Should print A
print(ord("A"))  # Should print 65

# Test id
x = 42
id_x = id(x)
print(id_x)  # Should print positive number

# Test enumerate
for i in enumerate([10, 20, 30]):
    print(i)

# Test zip
for pair in zip([1, 2], [3, 4]):
    print(pair)

# Test dict
d = dict()
print(len(d))  # Should print 0

# Test repr
print(repr(42))
print(repr(3.14))
print(repr("hello"))

print("All builtin tests completed!")
