# Test: Loop else clauses (Python-style for...else and while...else)

def test_while_else_no_break():
    # while...else: else executes when condition becomes false
    i = 0
    while i < 3:
        print(i)
        i = i + 1
    else:
        print(100)  # Should print (loop completed normally)

def test_while_else_with_break():
    # while...else: else does NOT execute when break is used
    i = 0
    while i < 5:
        if i == 2:
            break
        print(i)
        i = i + 1
    else:
        print(200)  # Should NOT print (break happened)
    print(201)  # Should print (after loop)

def test_for_else_no_break():
    # for...else: else executes when loop completes normally
    for i in range(3):
        print(i)
    else:
        print(300)  # Should print (loop completed normally)

def test_for_else_with_break():
    # for...else: else does NOT execute when break is used
    for i in range(5):
        if i == 2:
            break
        print(i)
    else:
        print(400)  # Should NOT print (break happened)
    print(401)  # Should print (after loop)

def test_while_else_condition_false_initially():
    # while...else: else executes even if condition is initially false
    i = 10
    while i < 3:
        print(i)
        i = i + 1
    else:
        print(500)  # Should print (body never executed, condition was false)

def main():
    print(1000)
    test_while_else_no_break()
    print(2000)
    test_while_else_with_break()
    print(3000)
    test_for_else_no_break()
    print(4000)
    test_for_else_with_break()
    print(5000)
    test_while_else_condition_false_initially()
    print(6000)
