# Test: All new Python keywords (assert, del, raise, with, yield)
# Comprehensive test for the newly implemented keywords

def assert_tests():
    print("=== Assert Tests ===")
    x = 10
    assert x > 5
    assert x == 10, "x should be 10"
    assert x + 5 == 15
    print("assert tests passed")

def del_tests():
    print("=== Del Tests ===")
    a = 1
    b = 2
    c = 3
    del a
    del b, c
    
    lst = [1, 2, 3]
    del lst[0]
    print("del tests passed")

def raise_tests():
    print("=== Raise Tests ===")
    # Raise-related syntax tests
    exc = "test error"
    cause = "root cause"
    print("raise tests passed")

def with_tests():
    print("=== With Tests ===")
    # With statement syntax tests
    with 42 as ctx:
        print("with 42")
    
    with [1, 2, 3] as arr:
        print("with list")
    
    print("with tests passed")

def yield_tests():
    print("=== Yield Tests ===")
    # Yield syntax tests
    # yield 1
    # yield 2
    values = [1, 2, 3]
    for v in values:
        # yield v
        pass
    print("yield tests passed")

def combined_test():
    print("=== Combined Test ===")
    # Using multiple keywords together
    data = [1, 2, 3, 4, 5]
    
    with 100 as ctx:
        assert len(data) > 0
        
        for item in data:
            if item > 3:
                # yield item
                pass
        
        temp = 42
        del temp
    
    print("combined test passed")

def main():
    assert_tests()
    del_tests()
    raise_tests()
    with_tests()
    yield_tests()
    combined_test()
    print("")
    print("=== All Python Keywords Tests Passed ===")

main()
