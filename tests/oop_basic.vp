# Test 1: Basic class definition
class Animal:
    def __init__(self, name: str):
        self.name = name
    
    def speak(self) -> str:
        return "Some sound"

# Test 2: Inheritance
class Dog(Animal):
    def __init__(self, name: str, breed: str):
        self.name = name
        self.breed = breed
    
    def speak(self) -> str:
        return "Woof!"
    
    def fetch(self) -> str:
        return "Fetching..."

# Test 3: Multiple inheritance
class Flyable:
    def fly(self) -> str:
        return "Flying..."

class Bird(Animal, Flyable):
    def __init__(self, name: str, wingspan: float):
        self.name = name
        self.wingspan = wingspan
    
    def speak(self) -> str:
        return "Chirp!"

# Test 4: Class variables and instance variables
class Counter:
    count = 0
    
    def __init__(self):
        self.instance_count = 0
    
    def increment(self) -> None:
        Counter.count = Counter.count + 1
        self.instance_count = self.instance_count + 1

# Test 5: Static methods
class MathUtils:
    @staticmethod
    def add(a: int, b: int) -> int:
        return a + b
    
    @staticmethod
    def multiply(a: int, b: int) -> int:
        return a * b

# Test 6: Class methods
class MyClass:
    @classmethod
    def create(cls) -> MyClass:
        return cls()
    
    @classmethod
    def get_class_name(cls) -> str:
        return "MyClass"

# Test 7: Properties
class Person:
    def __init__(self, name: str, age: int):
        self._name = name
        self._age = age
    
    @property
    def name(self) -> str:
        return self._name
    
    @property
    def age(self) -> str:
        return self._age
    
    @age.setter
    def age(self, value: int) -> None:
        if value > 0:
            self._age = value

# Test 8: Special methods
class Vector:
    def __init__(self, x: int, y: int):
        self.x = x
        self.y = y
    
    def __str__(self) -> str:
        return "Vector"
    
    def __eq__(self, other: Vector) -> bool:
        return self.x == other.x and self.y == other.y
    
    def __add__(self, other: Vector) -> Vector:
        return Vector(self.x + other.x, self.y + other.y)
    
    def __len__(self) -> int:
        return 2

# Test 9: Using classes
def test_classes() -> None:
    # Basic instantiation
    animal = Animal("Generic")
    print(animal.speak())
    
    # Inheritance
    dog = Dog("Buddy", "Golden")
    print(dog.speak())
    print(dog.fetch())
    print(dog.name)
    
    # Multiple inheritance
    bird = Bird("Tweety", 0.5)
    print(bird.speak())
    print(bird.fly())
    
    # Class variables
    c1 = Counter()
    c1.increment()
    c2 = Counter()
    c2.increment()
    c2.increment()
    print(Counter.count)  # Should print 3
    
    # Static methods
    result = MathUtils.add(5, 3)
    print(result)  # Should print 8
    
    # Class methods
    obj = MyClass.create()
    print(MyClass.get_class_name())
    
    # Properties
    person = Person("Alice", 30)
    print(person.name)
    person.age = 31
    print(person.age)
    
    # Special methods
    v1 = Vector(1, 2)
    v2 = Vector(3, 4)
    v3 = v1 + v2
    print(len(v1))

test_classes()
