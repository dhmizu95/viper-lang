# Test collections module

from collections import namedtuple, OrderedDict, defaultdict, Counter, deque

def test_namedtuple():
    """Test namedtuple creation and usage."""
    Point = namedtuple('Point', ['x', 'y'])
    
    p = Point(1, 2)
    
    # Test attribute access
    if p.x != 1 or p.y != 2:
        print("✗ test_namedtuple failed: attribute access")
        return False
    
    # Test indexing
    if p[0] != 1 or p[1] != 2:
        print("✗ test_namedtuple failed: indexing")
        return False
    
    # Test repr
    repr_str = repr(p)
    if "x=1" not in repr_str or "y=2" not in repr_str:
        print("✗ test_namedtuple failed: repr")
        return False
    
    # Test _asdict
    d = p._asdict()
    if d['x'] != 1 or d['y'] != 2:
        print("✗ test_namedtuple failed: _asdict")
        return False
    
    # Test _replace
    p2 = p._replace(x=10)
    if p2.x != 10 or p.x != 1:
        print("✗ test_namedtuple failed: _replace")
        return False
    
    print("✓ test_namedtuple passed")
    return True

def test_ordered_dict():
    """Test OrderedDict."""
    d = OrderedDict()
    d['a'] = 1
    d['b'] = 2
    d['c'] = 3
    
    # Test order preservation
    keys = list(d.keys())
    if keys != ['a', 'b', 'c']:
        print("✗ test_ordered_dict failed: order preservation")
        return False
    
    # Test move_to_end
    d.move_to_end('a')
    keys = list(d.keys())
    if keys != ['b', 'c', 'a']:
        print("✗ test_ordered_dict failed: move_to_end")
        return False
    
    # Test popitem
    key, value = d.popitem(last=True)
    if key != 'a':
        print("✗ test_ordered_dict failed: popitem")
        return False
    
    print("✓ test_ordered_dict passed")
    return True

def test_defaultdict():
    """Test defaultdict."""
    d = defaultdict(int)
    d['a'] = 1
    
    # Test default value
    if d['b'] != 0:
        print("✗ test_defaultdict failed: default value")
        return False
    
    # Test with list factory
    d2 = defaultdict(list)
    d2['items'].append(1)
    d2['items'].append(2)
    
    if d2['items'] != [1, 2]:
        print("✗ test_defaultdict failed: list factory")
        return False
    
    print("✓ test_defaultdict passed")
    return True

def test_counter():
    """Test Counter."""
    c = Counter(['a', 'b', 'a', 'c', 'b', 'a'])
    
    # Test counts
    if c['a'] != 3 or c['b'] != 2 or c['c'] != 1:
        print("✗ test_counter failed: counts")
        return False
    
    # Test most_common
    mc = c.most_common(2)
    if mc[0][0] != 'a' or mc[1][0] != 'b':
        print("✗ test_counter failed: most_common")
        return False
    
    # Test total
    if c.total() != 6:
        print("✗ test_counter failed: total")
        return False
    
    # Test subtraction
    c2 = Counter(['a', 'b'])
    c3 = c - c2
    if c3['a'] != 2 or c3['b'] != 1:
        print("✗ test_counter failed: subtraction")
        return False
    
    print("✓ test_counter passed")
    return True

def test_deque():
    """Test deque."""
    d = deque([1, 2, 3])
    
    # Test append
    d.append(4)
    if d[-1] != 4:
        print("✗ test_deque failed: append")
        return False
    
    # Test appendleft
    d.appendleft(0)
    if d[0] != 0:
        print("✗ test_deque failed: appendleft")
        return False
    
    # Test pop
    val = d.pop()
    if val != 4:
        print("✗ test_deque failed: pop")
        return False
    
    # Test popleft
    val = d.popleft()
    if val != 0:
        print("✗ test_deque failed: popleft")
        return False
    
    # Test rotate
    d2 = deque([1, 2, 3, 4, 5])
    d2.rotate(2)
    if d2[0] != 4 or d2[-1] != 3:
        print("✗ test_deque failed: rotate")
        return False
    
    # Test maxlen
    d3 = deque([1, 2, 3], maxlen=2)
    d3.append(4)
    if len(d3) != 2 or d3[0] != 3:
        print("✗ test_deque failed: maxlen")
        return False
    
    print("✓ test_deque passed")
    return True

def main():
    """Run all collections tests."""
    print("Running collections tests...")
    print("")
    
    passed = 0
    failed = 0
    
    if test_namedtuple():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_ordered_dict():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_defaultdict():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_counter():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_deque():
        passed = passed + 1
    else:
        failed = failed + 1
    
    print("")
    print("=" * 50)
    print("Test Summary")
    print("=" * 50)
    print("Passed:", passed)
    print("Failed:", failed)
    print("Total:", passed + failed)
    
    if failed > 0:
        exit(1)
