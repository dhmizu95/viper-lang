# Test for OOP fixes:
# 1. super() object semantics (direct calls)
# 2. Complex inheritance (diamond, MRO)

# ============== Test 1: Diamond Inheritance ==============
class Base:
    def get_value(self) -> i64:
        return 1

class Left(Base):
    def get_value(self) -> i64:
        return 2

class Right(Base):
    def get_value(self) -> i64:
        return 3

# Diamond inheritance - should work with C3 MRO
class Diamond(Left, Right):
    def get_super_value(self) -> i64:
        return super().get_value()

# ============== Test 2: Complex MRO ==============
class A:
    def get_value(self) -> i64:
        return 10

class B(A):
    def get_value(self) -> i64:
        return 20

class C(A):
    def get_value(self) -> i64:
        return 30

class D(B, C):
    def get_value(self) -> i64:
        return 40
    
    def get_super_value(self) -> i64:
        return super().get_value()

# ============== Test 3: Multiple levels ==============
class GrandParent:
    def get_value(self) -> i64:
        return 1000

class Parent2(GrandParent):
    def get_value(self) -> i64:
        return 2000

class Child2(Parent2):
    def get_value(self) -> i64:
        return 3000
    
    def get_parent_value(self) -> i64:
        return super().get_value()

# ============== Test Runner ==============
def test_diamond() -> None:
    d = Diamond()
    val = d.get_super_value()
    print(val)

def test_mro() -> None:
    d = D()
    direct = d.get_value()
    via_super = d.get_super_value()
    print(direct)
    print(via_super)

def test_multi_level() -> None:
    c2 = Child2()
    direct = c2.get_value()
    via_super = c2.get_parent_value()
    print(direct)
    print(via_super)

print("=== Diamond Test ===")
test_diamond()

print("=== MRO Test ===")
test_mro()

print("=== Multi-level Test ===")
test_multi_level()

print("Done!")
