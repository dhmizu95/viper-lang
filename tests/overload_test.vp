# Test function overloading in Viper

# Overload 1: Takes int
def process(x: int) -> int:
    print("Processing integer")
    return x * 2

# Overload 2: Takes float
def process(x: float) -> float:
    print("Processing float")
    return x * 2.0

# Overload 3: Takes str
def process(x: str) -> str:
    print("Processing string")
    return x + x

# Overload 4: Takes two int arguments
def add(a: int, b: int) -> int:
    print("Adding integers")
    return a + b

# Overload 5: Takes two float arguments
def add(a: float, b: float) -> float:
    print("Adding floats")
    return a + b

# Main function
def main():
    # Test integer overload
    result_int = process(5)
    print(result_int)
    
    # Test float overload
    result_float = process(3.14)
    print(result_float)
    
    # Test string overload
    result_str = process("hello")
    print(result_str)
    
    # Test integer addition
    sum_int = add(10, 20)
    print(sum_int)
    
    # Test float addition
    sum_float = add(1.5, 2.5)
    print(sum_float)
    
    print("All overloads work correctly!")
