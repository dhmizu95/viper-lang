# Test bigint conversion functions

def main():
    print("=== bigint Conversion Test ===")
    
    a = int("12345")
    print("a =")
    print(a)
    
    # Test int_bigint
    print("int_int(a) =")
    n = int_int(a)
    print(n)
    
    # Test str_bigint
    print("str_int(a) =")
    s = str_int(a)
    print(s)
    
    print("=== Test complete ===")
