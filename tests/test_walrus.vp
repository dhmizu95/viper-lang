# Test walrus operator (:=)

def test_walrus_basic():
    """Test basic walrus operator usage."""
    data = [1, 2, 3, 4, 5]
    
    # Using walrus operator in condition
    if (n := len(data)) > 3:
        print("Length:", n)
        return True
    return False

def test_walrus_in_loop():
    """Test walrus operator in while loop."""
    data = [1, 2, 3, 0, 4, 5]
    i = 0
    total = 0
    
    # Simulate reading until zero
    while i < len(data):
        value = data[i]
        if value == 0:
            break
        total = total + value
        i = i + 1
    
    if total == 6:
        print("✓ Walrus in loop works")
        return True
    return False

def test_walrus_in_list_comp():
    """Test walrus-like pattern (simulated)."""
    # Note: Full walrus in list comps may need special handling
    data = [1, 2, 3, 4, 5]
    total = 0
    for x in data:
        total = total + x
    
    if total == 15:
        print("✓ Accumulation works")
        return True
    return False

def main():
    """Run all walrus operator tests."""
    print("Testing walrus operator...")
    print("")
    
    passed = 0
    failed = 0
    
    if test_walrus_basic():
        print("✓ test_walrus_basic passed")
        passed = passed + 1
    else:
        print("✗ test_walrus_basic failed")
        failed = failed + 1
    
    if test_walrus_in_loop():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_walrus_in_list_comp():
        passed = passed + 1
    else:
        failed = failed + 1
    
    print("")
    print("=" * 50)
    print("Test Summary")
    print("=" * 50)
    print("Passed:", passed)
    print("Failed:", failed)
    
    if failed > 0:
        exit(1)
