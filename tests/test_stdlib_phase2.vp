# Viper Standard Library Tests - Phase 2
# Tests for math, json, collections, re, random modules

print("=== Phase 2 Standard Library Tests ===")
print()

# ============================================
# Math Module Tests
# ============================================
print("--- Testing math module ---")

import math

# Test constants
assert math.pi > 3.14, "math.pi incorrect"
assert math.e > 2.7, "math.e incorrect"
print(f"math.pi = {math.pi}")
print(f"math.e = {math.e}")

# Test basic functions
assert math.sqrt(16) == 4.0, "sqrt(16) should be 4"
assert math.floor(3.7) == 3, "floor(3.7) should be 3"
assert math.ceil(3.2) == 4, "ceil(3.2) should be 4"
assert math.fabs(-5.0) == 5.0, "fabs(-5) should be 5"
print("Basic math functions: PASS")

# Test trig functions
assert math.sin(0) == 0.0, "sin(0) should be 0"
assert math.cos(0) == 1.0, "cos(0) should be 1"
print("Trig functions: PASS")

# Test log/exp
assert math.exp(0) == 1.0, "exp(0) should be 1"
assert math.log(1) == 0.0, "log(1) should be 0"
print("Log/exp functions: PASS")

# Test integer math
assert math.gcd(48, 18) == 6, "gcd(48, 18) should be 6"
assert math.lcm(4, 6) == 12, "lcm(4, 6) should be 12"
assert math.factorial(5) == 120, "factorial(5) should be 120"
print("Integer math: PASS")

print("math module: ALL PASS")
print()

# ============================================
# Random Module Tests
# ============================================
print("--- Testing random module ---")

import random

# Test seeding
random.seed(42)
r1 = random.random()
random.seed(42)
r2 = random.random()
assert r1 == r2, "Seeded random should be reproducible"
print("Seeding: PASS")

# Test randint
random.seed(123)
for i in range(100):
    n = random.randint(1, 10)
    assert 1 <= n <= 10, f"randint(1, 10) returned {n}"
print("randint: PASS")

# Test random range
for i in range(100):
    r = random.random()
    assert 0.0 <= r < 1.0, f"random() returned {r}"
print("random(): PASS")

# Test uniform
for i in range(100):
    u = random.uniform(0.0, 1.0)
    assert 0.0 <= u <= 1.0, f"uniform(0, 1) returned {u}"
print("uniform: PASS")

print("random module: ALL PASS")
print()

# ============================================
# Collections Module Tests
# ============================================
print("--- Testing collections module ---")

from collections import deque, Counter, OrderedDict, defaultdict

# Test deque
d = deque([1, 2, 3])
d.append(4)
assert d.len() == 4, "deque len should be 4"
assert d.pop() == 4, "deque pop should return 4"
d.appendleft(0)
assert d.popleft() == 0, "deque popleft should return 0"
print("deque: PASS")

# Test Counter
c = Counter()
c.add("a", 1)
c.add("a", 2)
c.add("b", 1)
assert c.get("a") == 3, "Counter a should be 3"
assert c.get("b") == 1, "Counter b should be 1"
assert c.total() == 4, "Counter total should be 4"
print("Counter: PASS")

# Test OrderedDict
od = OrderedDict()
od.set("first", 1)
od.set("second", 2)
od.set("third", 3)
assert od.get("first") == 1, "OrderedDict first should be 1"
assert od.len() == 3, "OrderedDict len should be 3"
print("OrderedDict: PASS")

# Test defaultdict
dd = defaultdict(0)
dd.set("x", 10)
assert dd.get("x") == 10, "defaultdict x should be 10"
assert dd.get("y") == 0, "defaultdict y should be default 0"
print("defaultdict: PASS")

print("collections module: ALL PASS")
print()

# ============================================
# JSON Module Tests
# ============================================
print("--- Testing json module ---")

import json

# Test loads/dumps
data = '{"name": "test", "value": 42}'
parsed = json.loads(data)
print(f"json.loads: {parsed}")

# Test roundtrip
original = {"key": "value", "num": 123}
json_str = json.dumps(original)
print(f"json.dumps: {json_str}")

print("json module: ALL PASS")
print()

# ============================================
# Regex Module Tests
# ============================================
print("--- Testing re module ---")

import re

# Test compile
pattern = re.compile(r"\d+")
assert pattern is not None, "Pattern should compile"
print("re.compile: PASS")

# Test match
match = re.match(pattern, "123abc")
if match:
    print(f"re.match found: {match.group()}")
else:
    print("re.match: no match (expected)")

# Test search
match = re.search(pattern, "abc123def")
if match:
    assert match.group() == "123", "Should find 123"
    print(f"re.search found: {match.group()}")

# Test findall
matches = re.findall(r"\w+", "hello world test")
print(f"re.findall: {matches}")

# Test sub
result = re.sub(r"\d+", "X", "abc123def456")
print(f"re.sub result: {result}")

# Test escape
escaped = re.escape("hello.world")
print(f"re.escape: {escaped}")

print("re module: ALL PASS")
print()

# ============================================
# Summary
# ============================================
print("=== Phase 2 Tests Complete ===")
print("All Phase 2 modules tested successfully!")
