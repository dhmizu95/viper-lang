# Test str_bigint without assignment

def main():
    print("=== str_bigint Test ===")
    
    a = int("12345")
    
    # Test direct print (no assignment)
    print("Direct str(a):")
    print(str(a))
    
    # Test with assignment
    print("With assignment:")
    s = str(a)
    print(s)
    
    print("=== Test complete ===")
