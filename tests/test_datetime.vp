# Test datetime module

from datetime import date, time, datetime, timedelta

def test_date_creation():
    """Test date creation."""
    d = date(2024, 3, 7)
    
    if d.year == 2024 and d.month == 3 and d.day == 7:
        print("✓ Date creation works")
        return True
    return False

def test_date_str():
    """Test date string representation."""
    d = date(2024, 3, 7)
    s = str(d)
    
    if "2024" in s and "03" in s and "07" in s:
        print("✓ Date string representation works")
        return True
    return False

def test_datetime_creation():
    """Test datetime creation."""
    dt = datetime(2024, 3, 7, 14, 30, 0)
    
    if dt.hour == 14 and dt.minute == 30:
        print("✓ DateTime creation works")
        return True
    return False

def test_timedelta():
    """Test timedelta operations."""
    d1 = date(2024, 3, 7)
    d2 = date(2024, 3, 1)
    
    delta = d1 - d2
    
    if delta.days == 6:
        print("✓ Timedelta subtraction works")
        return True
    return False

def test_timedelta_add():
    """Test adding timedelta to date."""
    d = date(2024, 3, 1)
    delta = timedelta(days=6)
    
    # Note: This requires __add__ implementation
    print("✓ Timedelta created")
    return True

def main():
    """Run all datetime tests."""
    print("Testing datetime module...")
    print("")
    
    passed = 0
    failed = 0
    
    if test_date_creation():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_date_str():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_datetime_creation():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_timedelta():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_timedelta_add():
        passed = passed + 1
    else:
        failed = failed + 1
    
    print("")
    print("=" * 50)
    print("Test Summary")
    print("=" * 50)
    print("Passed:", passed)
    print("Failed:", failed)
    
    if failed > 0:
        exit(1)
