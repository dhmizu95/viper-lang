# Test factorial loop

def main():
    print("Start")
    result = int("1")
    i = int("1")
    n = int("10")
    print("Before loop")
    while i <= n:
        print("i =")
        print(i)
        result = result * i
        i = i + int("1")
    print("After loop")
    print("result =")
    print(result)
    print("Done")
