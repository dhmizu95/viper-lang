# Simple pattern matching test

def divide(a: int, b: int) -> Result[int, str]:
    if b == 0:
        return Err("Division by zero")
    return Ok(a / b)

def test_pattern_match():
    r1 = divide(10, 2)
    
    # Pattern match on Result
    match r1:
        case Ok(value):
            print("Got Ok:")
            print(value)
        case Err(e):
            print("Got Err:")
            print(e)
    
    print("Pattern matching test passed!")

test_pattern_match()
