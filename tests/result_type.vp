# Test Result[T, E] type in Viper

# Error type for our functions
type Error = str

# Function that returns Result type
def divide(a: int, b: int) -> Result[int, Error]:
    if b == 0:
        return Err("Division by zero")
    return Ok(a / b)

# Function that returns Result with different error type
def parse_number(s: str) -> Result[int, str]:
    # Simplified - in real implementation would parse string
    if s == "invalid":
        return Err("Invalid number format")
    return Ok(42)

# Function that handles Result
def handle_result(r: Result[int, Error]) -> None:
    # Pattern matching on Result would be ideal
    # For now, we test the type annotation works
    print("Handling result")

def test_result_types():
    # Test Result type annotations
    r1: Result[int, Error] = divide(10, 2)
    r2: Result[int, Error] = divide(10, 0)
    
    # Test nested Result types
    r3: Result[Result[int, str], str] = Ok(Ok(42))
    
    print("Result type annotations work!")
    print(r1)
    print(r2)

# Test with list of Results
def test_result_list():
    results: list[Result[int, str]] = [Ok(1), Ok(2), Err("error"), Ok(3)]
    print(len(results))

test_result_types()
test_result_list()
print("All Result tests passed!")
