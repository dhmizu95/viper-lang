# Test generic type annotations

def test_list_generic():
    # list[T] syntax
    nums: list[int] = [1, 2, 3]
    names: list[str] = ["a", "b", "c"]
    print(len(nums))
    print(len(names))

def test_dict_generic():
    # dict[K, V] syntax  
    ages: dict[str, int] = {"alice": 30, "bob": 25}
    print(len(ages))

def test_nested_generics():
    # Nested generic types
    matrix: list[list[int]] = [[1, 2], [3, 4]]
    print(len(matrix))

test_list_generic()
test_dict_generic()
test_nested_generics()
print("Generic type annotations work!")
