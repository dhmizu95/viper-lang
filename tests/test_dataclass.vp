# Test @dataclass decorator

@dataclass
class Point:
    x: int
    y: int

@dataclass
class Person:
    name: str
    age: int
    email: str = ""

def main():
    # Test Point dataclass
    p1 = Point(10, 20)
    print("p1:", p1)
    
    p2 = Point(10, 20)
    print("p2:", p2)
    
    # Test equality
    if p1 == p2:
        print("p1 == p2: True")
    else:
        print("p1 == p2: False")
    
    p3 = Point(30, 40)
    if p1 == p3:
        print("p1 == p3: True")
    else:
        print("p1 == p3: False")
    
    # Test Person dataclass with default
    person1 = Person("Alice", 30)
    print("person1:", person1)
    
    person2 = Person("Bob", 25, "bob@example.com")
    print("person2:", person2)
    
    print("Dataclass tests complete!")
