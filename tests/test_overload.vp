# Test: Function overloading

def sum(a: i64, b: i64) -> i64:
    return a + b

def sum(a: f64, b: f64) -> f64:
    return a + b

def sum(a: i64, b: i64, c: i64) -> i64:
    return a + b + c

def main():
    x = sum(3, 4)
    print(x)
    
    y = sum(1.5, 2.5)
    print(y)
    
    z = sum(1, 2, 3)
    print(z)
