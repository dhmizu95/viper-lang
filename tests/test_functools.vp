# Test functools module

from functools import partial, reduce, lru_cache, wraps, singledispatch, total_ordering

def test_partial():
    """Test partial function application."""
    def multiply(x, y, z):
        return x * y * z
    
    # Create partial with first argument
    double = partial(multiply, 2)
    result = double(3, 4)
    
    if result == 24:
        print("✓ test_partial passed")
        return True
    else:
        print("✗ test_partial failed: expected 24, got", result)
        return False

def test_reduce():
    """Test reduce function."""
    def add(x, y):
        return x + y
    
    result = reduce(add, [1, 2, 3, 4, 5])
    
    if result == 15:
        print("✓ test_reduce passed")
        return True
    else:
        print("✗ test_reduce failed: expected 15, got", result)
        return False

def test_lru_cache():
    """Test LRU cache decorator."""
    call_count = [0]
    
    @lru_cache(maxsize=128)
    def fibonacci(n):
        call_count[0] = call_count[0] + 1
        if n <= 1:
            return n
        return fibonacci(n - 1) + fibonacci(n - 2)
    
    # First call - should compute
    result1 = fibonacci(10)
    calls_after_first = call_count[0]
    
    # Second call - should use cache
    result2 = fibonacci(10)
    calls_after_second = call_count[0]
    
    if result1 == 55 and result2 == 55 and calls_after_first == calls_after_second:
        print("✓ test_lru_cache passed")
        return True
    else:
        print("✗ test_lru_cache failed")
        return False

def test_wraps():
    """Test wraps decorator."""
    def original():
        """Original docstring"""
        pass
    
    @wraps(original)
    def wrapper():
        pass
    
    if wrapper.__doc__ == "Original docstring" and wrapper.__name__ == "original":
        print("✓ test_wraps passed")
        return True
    else:
        print("✗ test_wraps failed")
        return False

def test_singledispatch():
    """Test singledispatch decorator."""
    @singledispatch
    def process(arg):
        return "default: " + str(arg)
    
    @process.register(int)
    def _(arg):
        return "int: " + str(arg)
    
    @process.register(str)
    def _(arg):
        return "str: " + str(arg)
    
    result1 = process(42)
    result2 = process("hello")
    result3 = process(3.14)
    
    if result1 == "int: 42" and result2 == "str: hello" and result3 == "default: 3.14":
        print("✓ test_singledispatch passed")
        return True
    else:
        print("✗ test_singledispatch failed")
        return False

def test_total_ordering():
    """Test total_ordering decorator."""
    @total_ordering
    class Point:
        def __init__(self, x, y):
            self.x = x
            self.y = y
        
        def __eq__(self, other):
            return self.x == other.x and self.y == other.y
        
        def __lt__(self, other):
            return (self.x, self.y) < (other.x, other.y)
    
    p1 = Point(1, 2)
    p2 = Point(1, 3)
    p3 = Point(2, 1)
    
    # Test generated methods
    le_result = p1 <= p2  # Should use generated __le__
    gt_result = p3 > p1   # Should use generated __gt__
    ge_result = p2 >= p1  # Should use generated __ge__
    
    if le_result and gt_result and ge_result:
        print("✓ test_total_ordering passed")
        return True
    else:
        print("✗ test_total_ordering failed")
        return False

def main():
    """Run all functools tests."""
    print("Running functools tests...")
    print("")
    
    passed = 0
    failed = 0
    
    if test_partial():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_reduce():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_lru_cache():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_wraps():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_singledispatch():
        passed = passed + 1
    else:
        failed = failed + 1
    
    if test_total_ordering():
        passed = passed + 1
    else:
        failed = failed + 1
    
    print("")
    print("=" * 50)
    print("Test Summary")
    print("=" * 50)
    print("Passed:", passed)
    print("Failed:", failed)
    print("Total:", passed + failed)
    
    if failed > 0:
        exit(1)
