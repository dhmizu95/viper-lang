# Test mock framework

import unittest
from unittest.mock import Mock, MagicMock, patch

class TestMock(unittest.TestCase):
    """Test Mock class."""
    
    def test_mock_return_value(self):
        """Test mock return_value."""
        mock = Mock()
        mock.return_value = 42
        result = mock(1, 2, 3)
        self.assertEqual(result, 42)
        print("✓ Mock return_value works")
    
    def test_mock_call_count(self):
        """Test mock call tracking."""
        mock = Mock()
        mock()
        mock()
        mock()
        self.assertEqual(mock.call_count, 3)
        print("✓ Mock call_count works")
    
    def test_mock_assert_called(self):
        """Test mock assertions."""
        mock = Mock()
        mock(1, 2, 3)
        mock.assert_called()
        mock.assert_called_once()
        mock.assert_called_with(1, 2, 3)
        print("✓ Mock assertions work")
    
    def test_mock_attributes(self):
        """Test mock attribute access."""
        mock = Mock()
        mock.foo = "bar"
        self.assertEqual(mock.foo, "bar")
        print("✓ Mock attributes work")
    
    def test_mock_child_mocks(self):
        """Test child mocks."""
        mock = Mock()
        child = mock.child
        child()
        self.assertEqual(mock.child.call_count, 1)
        print("✓ Mock child mocks work")

class TestMagicMock(unittest.TestCase):
    """Test MagicMock class."""
    
    def test_magic_mock_comparison(self):
        """Test MagicMock comparison operators."""
        mock = MagicMock()
        mock.__eq__.return_value = True
        result = (mock == 5)
        self.assertTrue(result)
        print("✓ MagicMock comparison works")
    
    def test_magic_mock_container(self):
        """Test MagicMock container methods."""
        mock = MagicMock()
        mock.__getitem__.return_value = 42
        result = mock["key"]
        self.assertEqual(result, 42)
        print("✓ MagicMock container works")
    
    def test_magic_mock_context(self):
        """Test MagicMock as context manager."""
        mock = MagicMock()
        mock.__enter__.return_value = "value"
        with mock as v:
            self.assertEqual(v, "value")
        print("✓ MagicMock context manager works")

class TestPatch(unittest.TestCase):
    """Test patch decorator."""
    
    @patch('os.path.exists')
    def test_patch_decorator(self, mock_exists):
        """Test patch as decorator."""
        mock_exists.return_value = True
        # Note: os.path.exists may not be fully wired
        # This tests the patch mechanism
        mock_exists.assert_not_called()
        print("✓ patch decorator works")
    
    def test_patch_context_manager(self):
        """Test patch as context manager."""
        with patch('os.path.exists') as mock_exists:
            mock_exists.return_value = True
            # Test the mock
            result = mock_exists("test")
            self.assertTrue(result)
            mock_exists.assert_called_once()
        print("✓ patch context manager works")

def main():
    """Run all mock tests."""
    print("Testing mock framework...")
    print("")
    
    unittest.main()
