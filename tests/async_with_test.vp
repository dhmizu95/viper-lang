# Test async with statement

# Simple async with test
async def test_basic_async_with():
    print("Testing basic async with...")
    # Note: This is a simplified test since we don't have real async context managers yet
    # The async with statement should parse and generate code
    async with 42 as value:
        print("Inside async with, value = ")
        print(value)
    print("Exited async with")

# Async with multiple items
async def test_multiple_items():
    print("Testing async with multiple items...")
    async with 1 as a, 2 as b:
        print("a = ")
        print(a)
        print("b = ")
        print(b)
    print("Exited multiple async with")

# Async with without variable binding
async def test_no_binding():
    print("Testing async with without binding...")
    async with 100:
        print("Inside async with (no binding)")
    print("Exited")

# Main test function
async def main():
    print("=== Async With Tests ===")
    await test_basic_async_with()
    print("")
    await test_multiple_items()
    print("")
    await test_no_binding()
    print("")
    print("=== All tests passed ===")

# Run the tests
await main()
