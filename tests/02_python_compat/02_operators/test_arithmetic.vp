def test_arithmetic():
    print(10 + 5)
    print(10 - 5)
    print(10 * 5)
    print(10 / 5)
    print(10 % 3)
    print(10 // 3)
    print(2 ** 10)

def test_arithmetic_float():
    print(10.5 + 5.5)
    print(10.5 - 5.5)
    print(10.5 * 5.5)
    print(10.5 / 2.5)

def test_arithmetic_mixed():
    print(10 + 5.5)
    print(10 * 2.5)
    print(10 - 2.5)

def test_augmented_assignment():
    x = 10
    x += 5
    print(x)
    x -= 3
    print(x)
    x *= 2
    print(x)
    x //= 3
    print(x)

def main():
    test_arithmetic()
    test_arithmetic_float()
    test_arithmetic_mixed()
    test_augmented_assignment()
    print("Arithmetic tests completed")
