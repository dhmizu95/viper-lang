def test_comparison():
    print(5 == 5)
    print(5 == 3)
    print(5 != 3)
    print(5 > 3)
    print(5 < 10)
    print(5 >= 5)
    print(5 <= 5)

def test_chained_comparison():
    print(1 < 2 < 3)
    print(1 < 2 < 1)
    print(3 > 2 > 1)

def test_comparison_mixed():
    print(1 < 2)
    print(1.5 == 1.5)
    print("a" < "b")

def main():
    test_comparison()
    test_chained_comparison()
    test_comparison_mixed()
    print("Comparison tests completed")
