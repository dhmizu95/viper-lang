def test_dict_comprehension():
    squares = {x: x * x for x in range(5)}
    print(squares)
    
    word_lengths = {word: len(word) for word in ["hello", "world", "test"]}
    print(word_lengths)
    
    swapped = {v: k for k, v in {"a": 1, "b": 2}.items()}
    print(swapped)

def test_nested_dict_comp():
    d = {i: {j: i * j for j in range(3)} for i in range(3)}
    print(d)

def main():
    test_dict_comprehension()
    test_nested_dict_comp()
    print("Dict comprehension tests completed")
