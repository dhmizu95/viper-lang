class Person:
    def __init__(self, name, age):
        self.name = name
        self.age = age
    
    @classmethod
    def from_dict(cls, d):
        return cls(d["name"], d["age"])
    
    @classmethod
    def create_adult(cls, name):
        return cls(name, 18)
    
    def to_dict(self):
        return {"name": self.name, "age": self.age}

def main():
    p1 = Person("Alice", 30)
    p2 = Person.from_dict({"name": "Bob", "age": 25})
    p3 = Person.create_adult("Charlie")
    
    print(p1.name, p1.age)
    print(p2.name, p2.age)
    print(p3.name, p3.age)
    print("Classmethod tests completed")
