class Math:
    @staticmethod
    def add(a, b):
        return a + b
    
    @staticmethod
    def multiply(a, b):
        return a * b

class Counter:
    count = 0
    
    def __init__(self):
        Counter.count += 1
    
    @classmethod
    def get_count(cls):
        return cls.count
    
    @classmethod
    def reset(cls):
        cls.count = 0

def main():
    print(Math.add(3, 5))
    print(Math.multiply(4, 6))
    
    c1 = Counter()
    c2 = Counter()
    c3 = Counter()
    print(Counter.get_count())
    Counter.reset()
    print(Counter.get_count())
    print("Static/Class method tests completed")
