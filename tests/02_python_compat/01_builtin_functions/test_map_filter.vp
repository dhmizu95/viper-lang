def test_map():
    squares = list(map(lambda x: x * x, range(5)))
    print(squares)
    
    strings = list(map(str, [1, 2, 3]))
    print(strings)

def test_filter():
    evens = list(filter(lambda x: x % 2 == 0, range(10)))
    print(evens)
    
    positives = list(filter(lambda x: x > 0, [-1, 0, 1, 2]))
    print(positives)

def test_map_filter_combined():
    result = list(map(lambda x: x * 2, filter(lambda x: x > 2, [1, 2, 3, 4, 5])))
    print(result)

def test_any_all():
    print(any([False, True, False]))
    print(any([False, False, False]))
    print(all([True, True, True]))
    print(all([True, False, True]))

def main():
    test_map()
    test_filter()
    test_map_filter_combined()
    test_any_all()
    print("Map/Filter tests completed")
