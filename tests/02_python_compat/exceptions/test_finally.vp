def test_finally_basic():
    try:
        print("try")
    finally:
        print("finally")

def test_finally_with_return():
    def try_return():
        try:
            return "try"
        finally:
            print("finally")
    
    result = try_return()
    print(result)

def test_finally_with_exception():
    def try_exception():
        try:
            raise ValueError("error")
        finally:
            print("finally")
    
    try:
        try_exception()
    except ValueError:
        print("caught")

def test_finally_cleaning_up():
    x = 0
    try:
        x = 10 / 2
    finally:
        x = 0
    print(x)

def main():
    test_finally_basic()
    test_finally_with_return()
    test_finally_with_exception()
    test_finally_cleaning_up()
    print("Finally tests completed")
