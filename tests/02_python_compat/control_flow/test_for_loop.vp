def test_for_basic():
    for i in range(5):
        print(i)

def test_for_range():
    for i in range(1, 6):
        print(i)
    
    for i in range(0, 10, 2):
        print(i)
    
    for i in range(10, 0, -1):
        print(i)

def test_for_iterate_list():
    lst = ["a", "b", "c"]
    for item in lst:
        print(item)

def test_for_enumerate():
    lst = ["a", "b", "c"]
    for i, item in enumerate(lst):
        print(i, item)

def test_nested_for():
    for i in range(3):
        for j in range(3):
            print(i, j)

def main():
    test_for_basic()
    test_for_range()
    test_for_iterate_list()
    test_for_enumerate()
    test_nested_for()
    print("For loop tests completed")
