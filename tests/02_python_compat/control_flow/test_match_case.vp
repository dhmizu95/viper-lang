def test_match_basic(x):
    match x:
        case 1:
            print("one")
        case 2:
            print("two")
        case _:
            print("other")

def test_match_multiple(x):
    match x:
        case 1 | 2 | 3:
            print("one, two, or three")
        case 4 | 5:
            print("four or five")
        case _:
            print("other")

def test_match_with_guard(x):
    match x:
        case n if n > 0:
            print("positive")
        case n if n < 0:
            print("negative")
        case _:
            print("zero")

def test_match_sequence(lst):
    match lst:
        case [1, 2]:
            print("list starting with 1, 2")
        case [first, second]:
            print("two elements:", first, second)
        case _:
            print("other")

def test_match_mapping(d):
    match d:
        case {"name": name, "age": age}:
            print(name, age)
        case _:
            print("other")

def main():
    test_match_basic(1)
    test_match_basic(5)
    test_match_multiple(2)
    test_match_multiple(5)
    test_match_with_guard(10)
    test_match_with_guard(-5)
    test_match_with_guard(0)
    test_match_sequence([1, 2])
    test_match_sequence([10])
    test_match_mapping({"name": "Alice", "age": 30})
    test_match_mapping({})
    print("Match-case tests completed")
