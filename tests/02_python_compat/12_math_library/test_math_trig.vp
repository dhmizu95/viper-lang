import math

def test_sin():
    print(math.sin(0))
    print(math.sin(math.pi / 2))

def test_cos():
    print(math.cos(0))
    print(math.cos(math.pi))

def test_tan():
    print(math.tan(0))
    print(math.tan(math.pi / 4))

def test_asin_acos_atan():
    print(math.asin(0))
    print(math.acos(1))
    print(math.atan(0))

def test_degrees_radians():
    print(math.degrees(math.pi))
    print(math.radians(180))
    print(math.degrees(math.pi / 2))

def main():
    test_sin()
    test_cos()
    test_tan()
    test_asin_acos_atan()
    test_degrees_radians()
    print("Math trig tests completed")
