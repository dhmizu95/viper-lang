def test_list_basic():
    lst = [1, 2, 3, 4, 5]
    print(len(lst))
    print(lst[0])
    print(lst[-1])

def test_list_operations():
    lst = [1, 2, 3]
    lst.append(4)
    print(lst)

def test_list_methods():
    lst = [3, 1, 4, 1, 5]
    print(len(lst))

def main():
    test_list_basic()
    test_list_operations()
    test_list_methods()
    print("List tests completed")
