def test_if_else():
    x = 10
    if x > 0:
        print("positive")
    else:
        print("non-positive")
    
    y = -5
    if y > 0:
        print("positive")
    elif y < 0:
        print("negative")
    else:
        print("zero")

def test_if_elif_else():
    score = 85
    if score >= 90:
        print("A")
    elif score >= 80:
        print("B")
    elif score >= 70:
        print("C")
    elif score >= 60:
        print("D")
    else:
        print("F")

def test_nested_if():
    x = 10
    y = 20
    if x > 0:
        if y > 0:
            print("both positive")
        else:
            print("x positive, y non-positive")
    else:
        print("x non-positive")

def test_ternary():
    x = 5
    result = "positive" if x > 0 else "non-positive"
    print(result)
    
    y = -3
    result2 = "A" if y >= 90 else "B" if y >= 80 else "C"
    print(result2)

def main():
    test_if_else()
    test_if_elif_else()
    test_nested_if()
    test_ternary()
    print("If-else tests completed")
