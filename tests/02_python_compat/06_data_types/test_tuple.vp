def test_tuple_basic():
    t = (1, 2, 3, 4, 5)
    print(len(t))
    print(t[0])
    print(t[-1])

def test_tuple_operations():
    t1 = (1, 2, 3)
    t2 = (4, 5, 6)
    print(2 in t1)
    print(7 not in t1)

def test_tuple_unpacking():
    t = (1, 2, 3)
    a = t[0]
    b = t[1]
    c = t[2]
    print(a)
    print(b)
    print(c)

def main():
    test_tuple_basic()
    test_tuple_operations()
    test_tuple_unpacking()
    print("Tuple tests completed")
