def test_string_basic():
    s = "Hello World"
    print(len(s))
    print(s[0])
    print(s[0:5])

def test_string_concatenation():
    s1 = "Hello"
    s2 = "World"
    print(s1 + " " + s2)

def test_string_methods():
    s = "hello"
    print(s.upper())
    print(s.lower())

def main():
    test_string_basic()
    test_string_concatenation()
    test_string_methods()
    print("String tests completed")
