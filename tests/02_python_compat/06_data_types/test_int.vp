def test_int_operations():
    a = 10
    b = 3
    print(a + b)
    print(a - b)
    print(a * b)
    print(a // b)

def test_int_comparison():
    print(5 == 5)
    print(5 != 3)
    print(5 > 3)
    print(5 < 10)

def test_int_bitwise():
    print(5 & 3)
    print(5 | 3)
    print(5 ^ 3)
    print(5 << 2)
    print(20 >> 2)

def main():
    test_int_operations()
    test_int_comparison()
    test_int_bitwise()
    print("Int tests completed")
