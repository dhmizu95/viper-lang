from math import sqrt, pi, e, floor, ceil
from random import randint, random, choice
from builtins import len, print, range, abs

def test_from_math():
    print(sqrt(16))
    print(pi)
    print(e)
    print(floor(3.7))
    print(ceil(3.2))

def test_from_random():
    print(randint(1, 100))
    print(random())
    print(choice([1, 2, 3]))

def test_from_builtins():
    print(len([1, 2, 3]))
    print(abs(-5))
    print(list(range(5)))

def main():
    test_from_math()
    test_from_random()
    test_from_builtins()
    print("From import tests completed")
