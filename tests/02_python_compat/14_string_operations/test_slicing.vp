def test_string_slicing():
    s = "Hello, World!"
    print(s[0:5])
    print(s[7:])
    print(s[:5])
    print(s[::2])
    print(s[::-1])
    print(s[-5:])

def test_string_index():
    s = "Hello"
    print(s[0])
    print(s[-1])

def main():
    test_string_slicing()
    test_string_index()
    print("String slicing tests completed")
