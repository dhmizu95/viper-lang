def test_lambda_basic():
    add = lambda x, y: x + y
    print(add(3, 5))

def test_lambda_with_map():
    squares = list(map(lambda x: x * x, range(5)))
    print(squares)

def test_lambda_with_filter():
    evens = list(filter(lambda x: x % 2 == 0, range(10)))
    print(evens)

def test_lambda_with_sorted():
    pairs = [(1, "one"), (3, "three"), (2, "two")]
    sorted_pairs = sorted(pairs, key=lambda p: p[0])
    print(sorted_pairs)

def test_lambda_closure():
    make_adder = lambda n: lambda x: x + n
    add5 = make_adder(5)
    add10 = make_adder(10)
    print(add5(3))
    print(add10(3))

def main():
    test_lambda_basic()
    test_lambda_with_map()
    test_lambda_with_filter()
    test_lambda_with_sorted()
    test_lambda_closure()
    print("Lambda tests completed")
