import math
import random

def test_math_import():
    print(math.pi)
    print(math.e)
    print(math.sqrt(16))

def test_random_import():
    print(random.randint(1, 10))
    print(random.random())

def test_alias_import():
    import math as m
    print(m.sqrt(16))

def test_from_import():
    from math import sqrt, pi
    print(sqrt(16))
    print(pi)

def test_builtin_import():
    import builtins
    print(len([1, 2, 3]))

def main():
    test_math_import()
    test_random_import()
    test_alias_import()
    test_from_import()
    test_builtin_import()
    print("Import tests completed")
