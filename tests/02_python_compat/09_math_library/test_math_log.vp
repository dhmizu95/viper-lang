import math

def test_log():
    print(math.log(1))
    print(math.log(math.e))
    print(math.log(100, 10))

def test_log2_log10():
    print(math.log2(8))
    print(math.log10(100))

def test_exp():
    print(math.exp(0))
    print(math.exp(1))
    print(math.exp(2))

def test_sqrt():
    print(math.sqrt(4))
    print(math.sqrt(16))
    print(math.sqrt(2))

def test_pow():
    print(math.pow(2, 3))
    print(math.pow(4, 0.5))
    print(math.pow(-2, 2))

def main():
    test_log()
    test_log2_log10()
    test_exp()
    test_sqrt()
    test_pow()
    print("Math log tests completed")
