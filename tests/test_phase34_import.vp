# Quick test to verify Phase 3-4 modules can be imported

print("Testing Phase 3-4 module imports...")
print()

# Test socket import
print("Importing socket...")
import socket
print(f"  socket.AF_INET = {socket.AF_INET}")
print(f"  socket.SOCK_STREAM = {socket.SOCK_STREAM}")
print("  socket module: OK")
print()

# Test asyncio import
print("Importing asyncio...")
import asyncio
lock = asyncio.Lock()
print(f"  asyncio.Lock created: {lock is not None}")
print("  asyncio module: OK")
print()

# Test http import
print("Importing http...")
import http
print(f"  http.OK = {http.OK}")
print(f"  http.NOT_FOUND = {http.NOT_FOUND}")
print("  http module: OK")
print()

# Test hashlib import
print("Importing hashlib...")
import hashlib
h = hashlib.sha256("test")
print(f"  hashlib.sha256('test') = {h.hexdigest()}")
print("  hashlib module: OK")
print()

# Test decimal import
print("Importing decimal...")
import decimal
d = decimal.Decimal("3.14159")
print(f"  Decimal('3.14159') = {d}")
print("  decimal module: OK")
print()

# Test logging import
print("Importing logging...")
import logging
logging.basic_config(logging.INFO)
logger = logging.get_logger("test")
logger.info("Test message")
print("  logging module: OK")
print()

print("=== All Phase 3-4 modules imported successfully! ===")
