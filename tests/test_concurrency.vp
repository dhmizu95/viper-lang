# Phase 3 Concurrency Test for Viper
# Tests sync blocks, channels, and WaitGroup

def worker(id: i64, result_chan: Chan[i64]):
    """Worker function that sends ID to channel"""
    send(result_chan, id)

def counter_worker(wg: WaitGroup):
    """Worker that signals done"""
    done(wg)

def main():
    # Test 1: Channel-based communication
    print("Test 1: Channel communication")
    c = chan(10)
    
    sync:
        task worker(1, c)
        task worker(2, c)
        task worker(3, c)
    
    print("Received from channel:")
    v1 = recv(c)
    print(v1)
    v2 = recv(c)
    print(v2)
    v3 = recv(c)
    print(v3)
    
    # Test 2: WaitGroup synchronization
    print("Test 2: WaitGroup")
    wg = WaitGroup()
    add(wg, 3)
    
    sync:
        task counter_worker(wg)
        task counter_worker(wg)
        task counter_worker(wg)
    
    wait(wg)
    print("WaitGroup completed")
    
    print("All concurrency tests passed!")
