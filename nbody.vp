# Benchmark: N-body simulation (simplified)
# Simulates gravitational interactions between bodies

def main():
    n = 1000000
    sum = 0
    i = 0
    
    # Simple N-body-like computation
    while i < n:
        # Compute some gravitational-like formula
        dx = (i % 100) - 50
        dy = ((i / 100) % 100) - 50
        dz = ((i / 10000) % 100) - 50
        
        # Distance squared
        dist_sq = dx * dx + dy * dy + dz * dz
        
        # Force-like calculation (inverse square)
        if dist_sq > 0:
            force = 10000 / (dist_sq + 1)
            sum = sum + force
        
        i = i + 1
    
    print(sum)
