# Simplified prime sieve - use single element list repetition
import math

def prime_sieve(limit):
    if limit < 2:
        return []

    # Create sieve using single-element list repetition
    sieve = [1] * (limit + 1)
    sieve[0] = 0
    sieve[1] = 0

    i = 2
    while i * i <= limit:
        if sieve[i]:
            j = i * i
            while j <= limit:
                sieve[j] = 0
                j = j + i
        i = i + 1

    # Collect primes
    primes = []
    k = 0
    while k <= limit:
        if sieve[k]:
            primes.append(k)
        k = k + 1

    return primes

def main():
    limit = 1000

    print("Prime Sieve up to", limit)
    print("-" * 40)

    primes = prime_sieve(limit)

    print("Primes found:", len(primes))
    if len(primes) > 0:
        print("First prime:", primes[0])
        print("Last prime:", primes[len(primes)-1])

main()
