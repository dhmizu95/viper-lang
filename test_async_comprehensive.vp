# ============================================
# Viper Async/Await Comprehensive Test
# ============================================

# Test 1: Basic async function
async def test_basic():
    print("Test 1: Basic async")
    async def simple():
        return 42
    f = simple()
    result = await f
    print("  Result:", result)
    print("  PASS")

# Test 2: Async with parameters
async def test_params():
    print("Test 2: Async with params")
    async def add(a, b):
        return a + b
    result = await add(10, 20)
    print("  10 + 20 =", result)
    print("  PASS")

# Test 3: Multiple concurrent futures
async def test_concurrent():
    print("Test 3: Concurrent futures")
    async def worker(n):
        return n * 2
    f1 = worker(1)
    f2 = worker(2)
    f3 = worker(3)
    r1 = await f1
    r2 = await f2
    r3 = await f3
    print("  Results:", r1, r2, r3)
    print("  Sum:", r1 + r2 + r3)
    print("  PASS")

# Test 4: Async sleep
async def test_sleep():
    print("Test 4: Async sleep")
    async def delayed(n):
        await sleep(10)
        return n
    f = delayed(100)
    result = await f
    print("  Delayed result:", result)
    print("  PASS")

# Test 5: Nested async calls
async def inner(n):
    return n * 2

async def outer(n):
    r = await inner(n)
    return r + 1

async def test_nested():
    print("Test 5: Nested async")
    result = await outer(5)
    print("  Result:", result)
    print("  PASS")

# Test 6: Async in loop
async def test_loop():
    print("Test 6: Async in loop")
    async def square(n):
        return n * n
    total = 0
    for i in range(5):
        f = square(i)
        r = await f
        total = total + r
    print("  Sum of squares:", total)
    print("  PASS")

# Main test runner
async def main():
    print("========================================")
    print("Viper Async/Await Test Suite")
    print("========================================")
    print()
    
    await test_basic()
    print()
    
    await test_params()
    print()
    
    await test_concurrent()
    print()
    
    await test_sleep()
    print()
    
    await test_nested()
    print()
    
    await test_loop()
    print()
    
    print("========================================")
    print("All tests complete!")
    print("========================================")

# Run tests
main()
