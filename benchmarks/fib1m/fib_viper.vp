# Fibonacci(1,000,000) - Viper implementation with BigInt (GMP)

def fib(n: i64) -> BigInt:
    if n <= 0:
        return 0
    elif n == 1:
        return 1

    a: BigInt = 0
    b: BigInt = 1

    i = 2
    while i <= n:
        c = a + b
        a = b
        b = c
        i = i + 1

    return b

def main():
    n = 1000000

    result = fib(n)

    # Get digit count
    s = str(result)
    digits = len(s)

    print("=== Fibonacci(1,000,000) - Viper ===")
    print("Digits: ")
    print(digits)
    print("")
    print("First 50 digits: ")
    print(s[:50])
    print("")
    print("Last 50 digits: ")
    print(s[-50:])
