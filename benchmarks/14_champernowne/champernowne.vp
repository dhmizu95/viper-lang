# Benchmark 14: Champernowne Constant

def main():
    MAX_N = 50000
    
    buffer = ""
    i = 1
    while i <= MAX_N:
        buffer = buffer + str(i)
        i = i + 1
    
    count_0 = 0
    count_1 = 0
    count_2 = 0
    count_3 = 0
    count_4 = 0
    count_5 = 0
    count_6 = 0
    count_7 = 0
    count_8 = 0
    count_9 = 0
    
    i = 0
    while i < len(buffer):
        c = buffer[i]
        if c == "0":
            count_0 = count_0 + 1
        elif c == "1":
            count_1 = count_1 + 1
        elif c == "2":
            count_2 = count_2 + 1
        elif c == "3":
            count_3 = count_3 + 1
        elif c == "4":
            count_4 = count_4 + 1
        elif c == "5":
            count_5 = count_5 + 1
        elif c == "6":
            count_6 = count_6 + 1
        elif c == "7":
            count_7 = count_7 + 1
        elif c == "8":
            count_8 = count_8 + 1
        elif c == "9":
            count_9 = count_9 + 1
        i = i + 1
    
    print("Numbers concatenated: 1 to " + str(MAX_N))
    print("Total length: " + str(len(buffer)))
    print("Digit 0 count: " + str(count_0))
    print("Digit 1 count: " + str(count_1))
    print("Digit 2 count: " + str(count_2))
