# Benchmark 01: Prime Sieve (Eratosthenes)
# Category: Integer Arithmetic

def main():
    LIMIT = 100000
    
    # Initialize sieve array (True = prime)
    is_prime = [True] * (LIMIT + 1)
    is_prime[0] = False
    is_prime[1] = False
    
    # Sieve of Eratosthenes
    p = 2
    while p * p <= LIMIT:
        if is_prime[p]:
            i = p * p
            while i <= LIMIT:
                is_prime[i] = False
                i = i + p
        p = p + 1
    
    # Count primes
    count = 0
    i = 2
    while i <= LIMIT:
        if is_prime[i]:
            count = count + 1
        i = i + 1
    
    print("Primes up to 100000: " + str(count))
