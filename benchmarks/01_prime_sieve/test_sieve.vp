# Simple sieve test
def sieve(n: int) -> int:
    is_prime = [1] * (n + 1)
    is_prime[0] = 0
    is_prime[1] = 0
    count = 0
    i = 2
    while i <= n:
        if is_prime[i] == 1:
            count = count + 1
        i = i + 1
    return count

def main():
    print("Testing sieve...")
    result = sieve(100)
    print("Primes up to 100:", result)

