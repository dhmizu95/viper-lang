# Benchmark 04: QuickSort

def swap(arr, i, j):
    temp = arr[i]
    arr[i] = arr[j]
    arr[j] = temp

def partition(arr, low, high):
    pivot = arr[high]
    i = low - 1
    j = low
    
    while j < high:
        if arr[j] <= pivot:
            i = i + 1
            swap(arr, i, j)
        j = j + 1
    
    swap(arr, i + 1, high)
    return i + 1

def quickSort(arr, low, high):
    if low < high:
        pi = partition(arr, low, high)
        if pi > 0:
            quickSort(arr, low, pi - 1)
        quickSort(arr, pi + 1, high)

def main():
    SIZE = 5000
    
    # Initialize array
    arr = [0] * SIZE
    i = 0
    while i < SIZE:
        arr[i] = (SIZE - i) * 17 % SIZE
        i = i + 1
    
    # Sort
    quickSort(arr, 0, SIZE - 1)
    
    # Verify sorted
    sorted_flag = 1
    i = 1
    while i < SIZE:
        if arr[i] < arr[i - 1]:
            sorted_flag = 0
        i = i + 1
    
    print("Array size: " + str(SIZE))
    print("Sorted correctly: " + str(sorted_flag))
