# Benchmark 26: Monte Carlo Pi
# Floating Point Benchmark - Tests FP performance and random numbers
# Note: Uses reduced samples due to current Viper performance

def main():
    SAMPLES = 1000000  # 1M (reduced from 1B for feasibility)
    inside = 0
    
    print("Computing Pi using Monte Carlo with " + str(SAMPLES) + " samples...")
    
    # Simple LCG random number generator
    seed = 12345
    
    i = 0
    while i < SAMPLES:
        # Generate pseudo-random numbers using LCG
        seed = (seed * 1103515245 + 12345) % 2147483648
        x = (seed % 10000) / 10000.0
        
        seed = (seed * 1103515245 + 12345) % 2147483648
        y = (seed % 10000) / 10000.0
        
        if x * x + y * y <= 1.0:
            inside = inside + 1
        
        i = i + 1
    
    pi = 4.0 * inside / SAMPLES
    
    print("Estimated Pi: " + str(pi))
    print("Actual Pi:    3.141592653589793")
    print("Inside count: " + str(inside))
