# bigint Comparison Benchmark - Viper Version
# Focused comparison of core bigint operations using GMP
# Note: Uses inline code to avoid function parameter type annotation issues

def main():
    print("============================================================")
    print("Viper bigint Benchmark (using GMP)")
    print("============================================================")
    print()
    
    # Test 1: Factorial(5000)
    print("1. Factorial(5000)")
    result = int("1")
    i = int("1")
    n = int("5000")
    while i <= n:
        result = result * i
        i = i + int("1")
    print("   Result: " + str(len(str_int(result))) + " digits")
    print()
    
    # Test 2: Fibonacci(50000)
    print("2. Fibonacci(50000)")
    a = int("0")
    b = int("1")
    i = int("0")
    n = int("50000")
    while i < n:
        temp = a + b
        a = b
        b = temp
        i = i + int("1")
    print("   Result: " + str(len(str_int(a))) + " digits")
    print()
    
    # Test 3: Power 2^50000
    print("3. 2^50000")
    result = int("1")
    base = int("2")
    exp = int("50000")
    i = int("0")
    while i < exp:
        result = result * base
        i = i + int("1")
    print("   Result: " + str(len(str_int(result))) + " digits")
    print()
    
    # Test 4: Large Multiplication (1000! * 999!)
    print("4. Large Multiplication (1000! * 999!)")
    # Calculate 1000!
    fact1000 = int("1")
    i = int("1")
    while i <= int("1000"):
        fact1000 = fact1000 * i
        i = i + int("1")
    # Calculate 999!
    fact999 = int("1")
    i = int("1")
    while i <= int("999"):
        fact999 = fact999 * i
        i = i + int("1")
    product = fact1000 * fact999
    print("   Result: " + str(len(str_int(product))) + " digits")
    print()
    
    # Test 5: Large Division (1000! / 999!)
    print("5. Large Division (1000! / 999!)")
    q = fact1000 / fact999
    r = fact1000 % fact999
    print("   Quotient: " + str(len(str_int(q))) + " digits, Remainder: " + str_int(r))
    print()
    
    # Test 6: Modular Exponentiation
    print("6. Modular Exponentiation")
    base = int("123456789012345678901234567890")
    exp = int("123456789")
    mod = int("1000000007")
    result = int("1")
    base = base % mod
    while exp > int("0"):
        if exp % int("2") == int("1"):
            result = (result * base) % mod
        exp = exp >> int("1")
        base = (base * base) % mod
    print("   Result: " + str_int(result))
    print()
    
    # Test 7: Bitwise Operations
    print("7. Bitwise Operations")
    x = (int("1") << int("2048")) - int("1")
    y = (int("1") << int("1024")) - int("1")
    and_r = x & y
    or_r = x | y
    xor_r = x ^ y
    print("   AND result: " + str(len(str_int(and_r))) + " digits")
    print("   OR result: " + str(len(str_int(or_r))) + " digits")
    print("   XOR result: " + str(len(str_int(xor_r))) + " digits")
    print()
    
    # Test 8: Shift Operations
    print("8. Shift Operations")
    val = int("1") << int("10000")
    val = val >> int("5000")
    print("   (1 << 10000) >> 5000")
    print("   Result: " + str(len(str_int(val))) + " digits")
    print()
    
    print("============================================================")
    print("All benchmarks completed")
    print("============================================================")
