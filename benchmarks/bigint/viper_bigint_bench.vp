# BigInt Comparison Benchmark - Viper Version
# Focused comparison of core BigInt operations using GMP
# Note: Uses inline code to avoid function parameter type annotation issues

def main():
    print("============================================================")
    print("Viper BigInt Benchmark (using GMP)")
    print("============================================================")
    print()
    
    # Test 1: Factorial(5000)
    print("1. Factorial(5000)")
    result = BigInt("1")
    i = BigInt("1")
    n = BigInt("5000")
    while i <= n:
        result = result * i
        i = i + BigInt("1")
    print("   Result: " + str(len(str_bigint(result))) + " digits")
    print()
    
    # Test 2: Fibonacci(50000)
    print("2. Fibonacci(50000)")
    a = BigInt("0")
    b = BigInt("1")
    i = BigInt("0")
    n = BigInt("50000")
    while i < n:
        temp = a + b
        a = b
        b = temp
        i = i + BigInt("1")
    print("   Result: " + str(len(str_bigint(a))) + " digits")
    print()
    
    # Test 3: Power 2^50000
    print("3. 2^50000")
    result = BigInt("1")
    base = BigInt("2")
    exp = BigInt("50000")
    i = BigInt("0")
    while i < exp:
        result = result * base
        i = i + BigInt("1")
    print("   Result: " + str(len(str_bigint(result))) + " digits")
    print()
    
    # Test 4: Large Multiplication (1000! * 999!)
    print("4. Large Multiplication (1000! * 999!)")
    # Calculate 1000!
    fact1000 = BigInt("1")
    i = BigInt("1")
    while i <= BigInt("1000"):
        fact1000 = fact1000 * i
        i = i + BigInt("1")
    # Calculate 999!
    fact999 = BigInt("1")
    i = BigInt("1")
    while i <= BigInt("999"):
        fact999 = fact999 * i
        i = i + BigInt("1")
    product = fact1000 * fact999
    print("   Result: " + str(len(str_bigint(product))) + " digits")
    print()
    
    # Test 5: Large Division (1000! / 999!)
    print("5. Large Division (1000! / 999!)")
    q = fact1000 / fact999
    r = fact1000 % fact999
    print("   Quotient: " + str(len(str_bigint(q))) + " digits, Remainder: " + str_bigint(r))
    print()
    
    # Test 6: Modular Exponentiation
    print("6. Modular Exponentiation")
    base = BigInt("123456789012345678901234567890")
    exp = BigInt("123456789")
    mod = BigInt("1000000007")
    result = BigInt("1")
    base = base % mod
    while exp > BigInt("0"):
        if exp % BigInt("2") == BigInt("1"):
            result = (result * base) % mod
        exp = exp >> BigInt("1")
        base = (base * base) % mod
    print("   Result: " + str_bigint(result))
    print()
    
    # Test 7: Bitwise Operations
    print("7. Bitwise Operations")
    x = (BigInt("1") << BigInt("2048")) - BigInt("1")
    y = (BigInt("1") << BigInt("1024")) - BigInt("1")
    and_r = x & y
    or_r = x | y
    xor_r = x ^ y
    print("   AND result: " + str(len(str_bigint(and_r))) + " digits")
    print("   OR result: " + str(len(str_bigint(or_r))) + " digits")
    print("   XOR result: " + str(len(str_bigint(xor_r))) + " digits")
    print()
    
    # Test 8: Shift Operations
    print("8. Shift Operations")
    val = BigInt("1") << BigInt("10000")
    val = val >> BigInt("5000")
    print("   (1 << 10000) >> 5000")
    print("   Result: " + str(len(str_bigint(val))) + " digits")
    print()
    
    print("============================================================")
    print("All benchmarks completed")
    print("============================================================")
