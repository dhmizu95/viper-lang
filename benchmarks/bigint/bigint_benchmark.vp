# bigint Benchmark Suite for Viper
# Comprehensive arbitrary precision integer operations

# ============= Factorial =============
def factorial(n):
    """Calculate n! using bigint"""
    result = int("1")
    i = int("1")
    while i <= n:
        result = result * i
        i = i + int("1")
    return result

# ============= Fibonacci =============
def fibonacci(n):
    """Calculate nth Fibonacci number using bigint"""
    a = int("0")
    b = int("1")
    i = int("0")
    while i < n:
        temp = a + b
        a = b
        b = temp
        i = i + int("1")
    return a

# ============= Power =============
def power(base, exp):
    """Calculate base^exp using bigint"""
    result = int("1")
    i = int("0")
    while i < exp:
        result = result * base
        i = i + int("1")
    return result

# ============= GCD =============
def gcd(a, b):
    """Calculate GCD using Euclidean algorithm"""
    while b != int("0"):
        temp = b
        b = a % b
        a = temp
    return a

# ============= Prime Check =============
def is_prime(n):
    """Simple primality test"""
    if n < int("2"):
        return False
    if n == int("2"):
        return True
    if n % int("2") == int("0"):
        return False
    
    i = int("3")
    while i * i <= n:
        if n % i == int("0"):
            return False
        i = i + int("2")
    return True

# ============= Modular Exponentiation =============
def mod_pow(base, exp, mod):
    """Calculate (base^exp) % mod efficiently"""
    result = int("1")
    base = base % mod
    while exp > int("0"):
        if exp % int("2") == int("1"):
            result = (result * base) % mod
        exp = exp >> int("1")
        base = (base * base) % mod
    return result

# ============= Sum of Digits =============
def sum_of_digits(n):
    """Sum all digits of a bigint"""
    s = str_int(n)
    total = int("0")
    i = 0
    while i < len(s):
        c = s[i]
        if c >= "0" and c <= "9":
            digit = int(c)
            total = total + digit
        i = i + 1
    return total

# ============= Main Benchmark =============
def main():
    print("=== Viper bigint Benchmark Suite ===")
    print("")
    
    # Benchmark 1: Factorial
    print("Benchmark 1: Factorial(1000)")
    fact_1000 = factorial(int("1000"))
    fact_str = str_int(fact_1000)
    print("  Result has " + str(len(fact_str)) + " digits")
    print("  First 50 digits: " + fact_str[0:50])
    print("")
    
    # Benchmark 2: Fibonacci
    print("Benchmark 2: Fibonacci(10000)")
    fib_10000 = fibonacci(int("10000"))
    fib_str = str_int(fib_10000)
    print("  Result has " + str(len(fib_str)) + " digits")
    print("  First 50 digits: " + fib_str[0:50])
    print("")
    
    # Benchmark 3: Large Power
    print("Benchmark 3: 2^10000")
    pow_result = power(int("2"), int("10000"))
    pow_str = str_int(pow_result)
    print("  Result has " + str(len(pow_str)) + " digits")
    print("  First 50 digits: " + pow_str[0:50])
    print("")
    
    # Benchmark 4: GCD
    print("Benchmark 4: GCD of two large numbers")
    a = factorial(int("500"))
    b = factorial(int("499"))
    g = gcd(a, b)
    print("  GCD(500!, 499!) has " + str(len(str_int(g))) + " digits")
    print("")
    
    # Benchmark 5: Modular Exponentiation
    print("Benchmark 5: Modular Exponentiation")
    base = int("12345678901234567890")
    exp = int("987654321")
    mod = int("1000000007")
    mod_result = mod_pow(base, exp, mod)
    print("  (12345678901234567890 ^ 987654321) % 1000000007")
    print("  Result: " + str_int(mod_result))
    print("")
    
    # Benchmark 6: Prime Check
    print("Benchmark 6: Prime Check")
    large_prime = int("1234567890123456789012345678901234567891")
    if is_prime(large_prime):
        print("  " + str_int(large_prime) + " is prime")
    else:
        print("  " + str_int(large_prime) + " is composite")
    print("")
    
    # Benchmark 7: Sum of Digits
    print("Benchmark 7: Sum of digits of 1000!")
    digit_sum = sum_of_digits(fact_1000)
    print("  Sum of digits: " + str_int(digit_sum))
    print("")
    
    # Benchmark 8: Bitwise Operations
    print("Benchmark 8: Bitwise Operations")
    x = int("0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF")
    y = int("0x0000000000000000FFFFFFFFFFFFFFFF")
    and_result = x & y
    or_result = x | y
    xor_result = x ^ y
    print("  x & y = " + str_int(and_result))
    print("  x | y = " + str_int(or_result))
    print("  x ^ y = " + str_int(xor_result))
    print("")
    
    # Benchmark 9: Shift Operations
    print("Benchmark 9: Shift Operations")
    one = int("1")
    shifted_left = one << int("1000")
    print("  1 << 1000 has " + str(len(str_int(shifted_left))) + " digits")
    shifted_right = shifted_left >> int("500")
    print("  (1 << 1000) >> 500 has " + str(len(str_int(shifted_right))) + " digits")
    print("")
    
    # Benchmark 10: Large Multiplication
    print("Benchmark 10: Large Multiplication")
    num1 = factorial(int("300"))
    num2 = factorial(int("200"))
    product = num1 * num2
    print("  300! * 200! has " + str(len(str_int(product))) + " digits")
    print("")
    
    print("=== All benchmarks completed ===")
