# Benchmark 41: Matrix Multiplication 1000x1000
# Linear Algebra Benchmark - Tests memory bandwidth and vectorization
# Note: Uses reduced size for current Viper capabilities

def main():
    N = 200  # Reduced from 1000 for feasibility
    
    print("Computing matrix multiplication " + str(N) + "x" + str(N) + "...")
    
    # Initialize matrices
    A = [[0.0] * N] * N
    B = [[0.0] * N] * N
    C = [[0.0] * N] * N
    
    i = 0
    while i < N:
        j = 0
        while j < N:
            A[i][j] = ((i + j) % 100) / 100.0
            B[i][j] = ((i * j) % 100) / 100.0
            j = j + 1
        i = i + 1
    
    # Matrix multiplication with cache-friendly ordering
    i = 0
    while i < N:
        k = 0
        while k < N:
            a_ik = A[i][k]
            j = 0
            while j < N:
                C[i][j] = C[i][j] + a_ik * B[k][j]
                j = j + 1
            k = k + 1
        i = i + 1
    
    # Compute checksum for verification
    checksum = 0.0
    i = 0
    while i < N:
        j = 0
        while j < N:
            checksum = checksum + C[i][j]
            j = j + 1
        i = i + 1
    
    print("Checksum: " + str(checksum))
    print("Matrix size: " + str(N) + "x" + str(N))
