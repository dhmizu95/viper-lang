# Benchmark 86: FFT (Fast Fourier Transform)
# Signal Processing Benchmark - Tests FP math and arrays
# Note: Uses reduced size (N=256) for current Viper capabilities

def main():
    N = 256  # 2^8 (reduced from 2^20 for feasibility)
    
    print("Computing FFT with " + str(N) + " samples...")
    
    # Initialize data arrays (real and imaginary parts)
    data_real = [0.0] * N
    data_imag = [0.0] * N
    
    # Initialize with test signal
    i = 0
    while i < N:
        t = i / N
        # Simple sine wave
        data_real[i] = t  # Placeholder - Viper needs math functions
        i = i + 1
    
    print("Data initialized (simplified - needs math functions for full FFT)")
    print("Note: Viper needs sin/cos functions for complete FFT implementation")
    
    # Compute simple checksum
    checksum = 0.0
    i = 0
    while i < N:
        checksum = checksum + data_real[i]
        i = i + 1
    
    print("Data checksum: " + str(checksum))
