# String Operations Benchmark - Viper Implementation
# String concatenation and character scanning

def main():
    repeats = 400
    chunk = "alpha,beta,gamma,delta;"
    text = ""

    i = 0
    while i < repeats:
        text = text + chunk
        i = i + 1

    count_a = 0
    count_comma = 0
    count_semicolon = 0
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == "a":
            count_a = count_a + 1
        elif ch == ",":
            count_comma = count_comma + 1
        elif ch == ";":
            count_semicolon = count_semicolon + 1
        i = i + 1

    checksum = len(text) + count_a + count_comma + count_semicolon
    print(checksum)

main()
