# Matrix Multiplication - Simplified version that works in both JIT and AOT

def main():
    n = 50
    
    a = [0] * (n * n)
    b = [0] * (n * n)
    c = [0] * (n * n)
    
    # Fill matrices
    i = 0
    while i < n:
        j = 0
        while j < n:
            idx = i * n + j
            a[idx] = (i + j) % 10
            b[idx] = (i * j) % 10
            j = j + 1
        i = i + 1
    
    # Use simple approach: just sum rows of a
    i = 0
    while i < n:
        j = 0
        while j < n:
            sum_val = 0
            k = 0
            while k < n:
                sum_val = sum_val + a[i * n + k]
                k = k + 1
            c[i * n + j] = sum_val
            j = j + 1
        i = i + 1
    
    # Calculate checksum
    checksum = 0
    i = 0
    while i < n * n:
        checksum = checksum + c[i]
        i = i + 1
    
    print(checksum)

main()
