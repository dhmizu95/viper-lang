# Matrix Multiplication Benchmark - Viper Implementation
# Multiply two NxN matrices using arrays

def main():
    # Benchmark parameter
    n = 50
    
    # Initialize matrices
    a = [0] * (n * n)
    b = [0] * (n * n)
    c = [0] * (n * n)
    
    # Fill matrices with values
    i = 0
    while i < n:
        j = 0
        while j < n:
            idx = i * n + j
            a[idx] = (i + j) % 10
            b[idx] = (i * j) % 10
            j = j + 1
        i = i + 1
    
    # Matrix multiplication: C = A * B
    i = 0
    while i < n:
        j = 0
        while j < n:
            sum_val = 0
            k = 0
            while k < n:
                a_idx = i * n + k
                b_idx = k * n + j
                sum_val = sum_val + a[a_idx] * b[b_idx]
                k = k + 1
            c_idx = i * n + j
            c[c_idx] = sum_val
            j = j + 1
        i = i + 1
    
    # Calculate checksum
    checksum = 0
    i = 0
    while i < n * n:
        checksum = checksum + c[i]
        i = i + 1
    
    print(checksum)

main()
