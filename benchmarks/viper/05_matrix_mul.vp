# Matrix Multiplication Benchmark - Viper Implementation
# Multiply two NxN matrices using arrays

def main():
    n = 50

    a = [0] * (n * n)
    b = [0] * (n * n)
    c = [0] * (n * n)

    i = 0
    while i < n:
        j = 0
        while j < n:
            idx = i * n + j
            a[idx] = (i + j) % 10
            b[idx] = (i * j) % 10
            c[idx] = 0
            j = j + 1
        i = i + 1

    i = 0
    while i < n:
        j = 0
        while j < n:
            sum_val = 0
            k = 0
            while k < n:
                a_idx = i * n + k
                b_idx = k * n + j
                sum_val = sum_val + a[a_idx] * b[b_idx]
                k = k + 1
            c[i * n + j] = sum_val
            j = j + 1
        i = i + 1

    checksum = 0
    i = 0
    while i < n * n:
        checksum = checksum + c[i]
        i = i + 1

    print(checksum)

main()
