# Recursive List Sum Benchmark - Viper Implementation
# Recursive sum of a range (avoids list recursion GC issues)

def sum_range(n):
    if n <= 0:
        return 0
    return n + sum_range(n - 1)

def main():
    # Keep recursion depth comfortably below typical stack limits
    n = 200
    result = sum_range(n)
    print(result)

main()
