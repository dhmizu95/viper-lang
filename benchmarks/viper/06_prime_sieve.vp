# Prime Sieve Benchmark - Viper Implementation
# Sieve of Eratosthenes algorithm

def main():
    # Benchmark parameter - find primes up to n
    n = 10000
    
    # Initialize sieve array (1 = potentially prime, 0 = not prime)
    sieve = [1] * (n + 1)
    sieve[0] = 0
    sieve[1] = 0
    
    # Sieve of Eratosthenes
    p = 2
    while p * p <= n:
        if sieve[p] == 1:
            # Mark all multiples of p as not prime
            i = p * p
            while i <= n:
                sieve[i] = 0
                i = i + p
        p = p + 1
    
    # Count primes
    count = 0
    i = 0
    while i <= n:
        if sieve[i] == 1:
            count = count + 1
        i = i + 1
    
    print(count)

main()
