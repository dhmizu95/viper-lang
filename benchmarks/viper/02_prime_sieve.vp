# Prime Count Benchmark - Viper Implementation
# Count primes using trial division (no lists)

def is_prime(n):
    """Check if n is prime using trial division."""
    if n < 2:
        return 0
    if n == 2:
        return 1
    if n % 2 == 0:
        return 0
    i = 3
    while i * i <= n:
        if n % i == 0:
            return 0
        i = i + 2
    return 1

def count_primes(n):
    """Count primes up to n."""
    count = 0
    i = 2
    while i <= n:
        if is_prime(i) == 1:
            count = count + 1
        i = i + 1
    return count

def main():
    # Benchmark parameter
    n = 5000
    
    # Run and print result
    result = count_primes(n)
    print(result)

main()
