# Fixed-Width i64 Arithmetic Hot Loop Benchmark - Viper Implementation

def main():
    n: i64 = 2000000
    acc: i64 = 1
    i: i64 = 1

    while i <= n:
        acc = acc + i
        acc = acc - (i % 7)
        acc = acc + (i * 3) % 11
        if i % 5 == 0:
            acc = acc // 2 + 17
        i = i + 1

    print(acc)

main()
