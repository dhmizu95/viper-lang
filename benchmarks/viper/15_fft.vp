# Fast Fourier Transform (FFT) Benchmark - Viper Implementation
# Cooley-Tukey radix-2 FFT algorithm
# Tests: Floating point precision, Recursion performance, Memory allocation
#
# Examples:
#   Cooley-Tuk FFT
#   Polynomial multiplication
# Why complex:
#   FFT operates on complex numbers to represent magnitude and phase
# Recursive algorithm:
#   Divide-and-conquer approach splits DFT into smaller DFTs
# Numerical errors:
#   Floating point precision affects accuracy of results
#
# Implementation: Uses parallel arrays for real and imaginary parts
#   This avoids the need for complex number class and maximizes performance

import math

N = 256  # FFT size (must be power of 2)
PI = 3.14159265358979323846

def log2_int(n):
    """Compute integer log base 2."""
    bits = 0
    temp = n
    while temp > 1:
        bits += 1
        temp = temp >> 1
    return bits

def bit_reverse(n, bits):
    """Reverse the bits of n using 'bits' number of bits."""
    reversed_val = 0
    i = 0
    while i < bits:
        reversed_val = (reversed_val << 1) | (n & 1)
        n = n >> 1
        i += 1
    return reversed_val

def fft(real, imag, n, inverse: int):
    """
    Cooley-Tukey FFT (iterative, radix-2, decimation-in-time).
    Modifies real and imag arrays in-place.
    """
    bits = log2_int(n)
    
    # Bit-reversal permutation
    i = 0
    while i < n:
        rev = bit_reverse(i, bits)
        if i < rev:
            # Swap real
            temp = real[i]
            real[i] = real[rev]
            real[rev] = temp
            # Swap imag
            temp = imag[i]
            imag[i] = imag[rev]
            imag[rev] = temp
        i += 1
    
    # Cooley-Tukey iterative FFT
    length = 2
    while length <= n:
        length_f = float(length)
        angle = 2.0 * PI / length_f
        if inverse != 0:
            angle = -angle
        wlen_r = math.cos(angle)
        wlen_i = math.sin(angle)
        half_length = length >> 1
        
        i = 0
        while i < n:
            w_r = 1.0
            w_i = 0.0
            j = 0
            while j < half_length:
                # Butterfly operation
                idx1 = i + j
                idx2 = i + j + half_length
                
                # t = x[idx2] * w
                t_r = real[idx2] * w_r - imag[idx2] * w_i
                t_i = real[idx2] * w_i + imag[idx2] * w_r
                
                # u = x[idx1]
                u_r = real[idx1]
                u_i = imag[idx1]
                
                # x[idx1] = u + t
                real[idx1] = u_r + t_r
                imag[idx1] = u_i + t_i
                
                # x[idx2] = u - t
                real[idx2] = u_r - t_r
                imag[idx2] = u_i - t_i
                
                # w = w * wlen
                new_w_r = w_r * wlen_r - w_i * wlen_i
                w_i = w_r * wlen_i + w_i * wlen_r
                w_r = new_w_r
                
                j += 1
            i += length
        length = length << 1
    
    # Scale for inverse FFT
    if inverse != 0:
        n_inv = 1.0 / float(n)
        i = 0
        while i < n:
            real[i] = real[i] * n_inv
            imag[i] = imag[i] * n_inv
            i += 1

def generate_signal(real, imag, n):
    """Generate test signal: sum of two sinusoids."""
    freq1 = 2.0  # 2 Hz
    freq2 = 8.0  # 8 Hz
    sample_rate = 64.0
    two_pi = 2.0 * PI
    
    i = 0
    while i < n:
        t = float(i) / sample_rate
        arg1 = two_pi * freq1 * t
        arg2 = two_pi * freq2 * t
        real[i] = math.sin(arg1) + 0.5 * math.sin(arg2)
        imag[i] = 0.0
        i += 1

def total_magnitude(real, imag, n):
    """Calculate total magnitude of all frequency components."""
    total = 0.0
    i = 0
    while i < n:
        total += math.sqrt(real[i] * real[i] + imag[i] * imag[i])
        i += 1
    return total

def main():
    # Allocate memory for signal (SoA layout)
    real = [0.0] * N
    imag = [0.0] * N
    
    # Generate test signal
    generate_signal(real, imag, N)
    
    # Perform FFT
    fft(real, imag, N, 0)
    
    # Calculate and print result
    magnitude = total_magnitude(real, imag, N)
    print("{:.6f}".format(magnitude))
    
    # Perform inverse FFT to verify
    fft(real, imag, N, 1)
    
    # Print first sample of reconstructed signal (verification)
    print("{:.6f}".format(real[0]))

main()
