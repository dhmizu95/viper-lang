# Fast Fourier Transform (FFT) Benchmark - Viper Implementation
# Cooley-Tukey radix-2 FFT algorithm
# 100% Python syntax compatible

import math

N = 256  # FFT size (must be power of 2)
PI = 3.14159265358979323846

def bit_reverse(n, bits):
    """Reverse the bits of n using 'bits' number of bits."""
    reversed_val = 0
    for _ in range(bits):
        reversed_val = (reversed_val << 1) | (n & 1)
        n >>= 1
    return reversed_val

def fft(real, imag, inverse=False):
    """
    Cooley-Tukey FFT (iterative, radix-2, decimation-in-time).
    Modifies real and imag arrays in-place.
    """
    n = len(real)
    if n <= 1:
        return
    
    bits = int(math.log2(n))
    
    # Bit-reversal permutation
    for i in range(n):
        rev = bit_reverse(i, bits)
        if i < rev:
            # Swap real
            temp = real[i]
            real[i] = real[rev]
            real[rev] = temp
            # Swap imag
            temp = imag[i]
            imag[i] = imag[rev]
            imag[rev] = temp
    
    # Cooley-Tukey iterative FFT
    length = 2
    while length <= n:
        angle = 2.0 * PI / length
        if inverse:
            angle = -angle
        wlen_r = math.cos(angle)
        wlen_i = math.sin(angle)
        half_length = length // 2
        
        i = 0
        while i < n:
            w_r = 1.0
            w_i = 0.0
            j = 0
            while j < half_length:
                # Butterfly operation
                idx1 = i + j
                idx2 = i + j + half_length
                
                # t = x[idx2] * w
                t_r = real[idx2] * w_r - imag[idx2] * w_i
                t_i = real[idx2] * w_i + imag[idx2] * w_r
                
                # u = x[idx1]
                u_r = real[idx1]
                u_i = imag[idx1]
                
                # x[idx1] = u + t
                real[idx1] = u_r + t_r
                imag[idx1] = u_i + t_i
                
                # x[idx2] = u - t
                real[idx2] = u_r - t_r
                imag[idx2] = u_i - t_i
                
                # w = w * wlen
                new_w_r = w_r * wlen_r - w_i * wlen_i
                w_i = w_r * wlen_i + w_i * wlen_r
                w_r = new_w_r
                
                j += 1
            i += length
        length *= 2
    
    # Scale for inverse FFT
    if inverse:
        n_inv = 1.0 / n
        for i in range(n):
            real[i] = real[i] * n_inv
            imag[i] = imag[i] * n_inv

def generate_signal(n):
    """Generate test signal: sum of two sinusoids."""
    freq1 = 2.0  # 2 Hz
    freq2 = 8.0  # 8 Hz
    sample_rate = 64.0
    two_pi = 2.0 * PI
    
    real = []
    imag = []
    for i in range(n):
        t = i / sample_rate
        arg1 = two_pi * freq1 * t
        arg2 = two_pi * freq2 * t
        real.append(math.sin(arg1) + 0.5 * math.sin(arg2))
        imag.append(0.0)
    return real, imag

def total_magnitude(real, imag):
    """Calculate total magnitude of all frequency components."""
    total = 0.0
    n = len(real)
    for i in range(n):
        total += math.sqrt(real[i] * real[i] + imag[i] * imag[i])
    return total

def main():
    # Generate test signal
    real, imag = generate_signal(N)
    
    # Perform FFT
    fft(real, imag)
    
    # Calculate and print result
    magnitude = total_magnitude(real, imag)
    print("{:.6f}".format(magnitude))
    
    # Perform inverse FFT to verify
    fft(real, imag, inverse=True)
    
    # Print first sample of reconstructed signal (verification)
    print("{:.6f}".format(real[0]))

main()
