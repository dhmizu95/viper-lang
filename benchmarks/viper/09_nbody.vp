# N-body Simulation Benchmark - Viper Implementation
# Based on Computer Language Benchmarks Game n-body program
# Uses Struct of Arrays (SoA) layout to maximize performance and avoid nested lists

import math

def offset_momentum(nbodies, x, y, z, vx, vy, vz, mass):
    px = 0.0
    py = 0.0
    pz = 0.0
    i = 0
    while i < nbodies:
        px += vx[i] * mass[i]
        py += vy[i] * mass[i]
        pz += vz[i] * mass[i]
        i = i + 1
    # adjust sun velocity
    vx[0] = -px / mass[0]
    vy[0] = -py / mass[0]
    vz[0] = -pz / mass[0]

def energy(nbodies, x, y, z, vx, vy, vz, mass):
    e = 0.0
    i = 0
    while i < nbodies:
        e += 0.5 * mass[i] * (vx[i]*vx[i] + vy[i]*vy[i] + vz[i]*vz[i])
        j = i + 1
        while j < nbodies:
            dx = x[i] - x[j]
            dy = y[i] - y[j]
            dz = z[i] - z[j]
            dsq = dx*dx + dy*dy + dz*dz
            e -= (mass[i] * mass[j]) / math.sqrt(dsq)
            j = j + 1
        i = i + 1
    return e

def advance(nbodies, x, y, z, vx, vy, vz, mass, dt):
    i = 0
    while i < nbodies:
        j = i + 1
        while j < nbodies:
            dx = x[i] - x[j]
            dy = y[i] - y[j]
            dz = z[i] - z[j]
            dsq = dx*dx + dy*dy + dz*dz
            mag = dt / (dsq * math.sqrt(dsq))
            # update velocities
            mj = mass[j] * mag
            vx[i] -= dx * mj
            vy[i] -= dy * mj
            vz[i] -= dz * mj
            mi = mass[i] * mag
            vx[j] += dx * mi
            vy[j] += dy * mi
            vz[j] += dz * mi
            j = j + 1
        i = i + 1
    # update positions
    k = 0
    while k < nbodies:
        x[k] += vx[k] * dt
        y[k] += vy[k] * dt
        z[k] += vz[k] * dt
        k = k + 1

def nbody(n):
    # constants
    pi = 3.141592653589793
    SOLAR_MASS = 4.0 * pi * pi
    DAYS_PER_YEAR = 365.24

    x = [0.0, 4.84143144246472090e+00, 8.34336671824457987e+00, 1.28943695621391310e+01, 1.53796971148509165e+01]
    y = [0.0, -1.16032004402742839e+00, 4.12479856412430479e+00, -1.51111514016986312e+01, -2.59193146099879641e+01]
    z = [0.0, -1.03622044471123109e-01, -4.03523417114321381e-01, -2.23307578892655734e-01, 1.79258772950371181e-01]
    
    vx = [0.0, 1.66007664274403694e-03 * DAYS_PER_YEAR, -2.76742510726862411e-03 * DAYS_PER_YEAR,  2.96460137564761618e-03 * DAYS_PER_YEAR, 2.68067772490389322e-03 * DAYS_PER_YEAR]
    vy = [0.0, 7.69901118419740425e-03 * DAYS_PER_YEAR,  4.99852801234917238e-03 * DAYS_PER_YEAR,  2.37847173959480950e-03 * DAYS_PER_YEAR, 1.62824170038242295e-03 * DAYS_PER_YEAR]
    vz = [0.0, -6.90460016972063023e-05 * DAYS_PER_YEAR, 2.30417297573763929e-05 * DAYS_PER_YEAR, -2.96589568540237556e-05 * DAYS_PER_YEAR, -9.51592254519715870e-05 * DAYS_PER_YEAR]
    
    mass = [SOLAR_MASS, 9.54791938424326609e-04 * SOLAR_MASS, 2.85885980666130812e-04 * SOLAR_MASS, 4.36624404335156298e-05 * SOLAR_MASS, 5.15138902046611451e-05 * SOLAR_MASS]

    offset_momentum(5, x, y, z, vx, vy, vz, mass)
    print("{:.9f}".format(energy(5, x, y, z, vx, vy, vz, mass)))
    i = 0
    while i < n:
        advance(5, x, y, z, vx, vy, vz, mass, 0.01)
        i = i + 1
    print("{:.9f}".format(energy(5, x, y, z, vx, vy, vz, mass)))

def main():
    n = 1000
    nbody(n)

if __name__ == "__main__":
    main()
