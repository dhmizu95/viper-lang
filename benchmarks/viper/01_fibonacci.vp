# Fibonacci Benchmark - Viper Implementation
# Iterative Fibonacci for better performance

def fib(n):
    """Calculate nth Fibonacci number iteratively."""
    if n <= 1:
        return n
    a = 0
    b = 1
    i = 2
    while i <= n:
        c = a + b
        a = b
        b = c
        i = i + 1
    return b

def main():
    n = 35
    
    result = fib(n)
    print(result)

main()
