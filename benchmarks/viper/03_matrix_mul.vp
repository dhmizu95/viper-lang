# Matrix Multiplication Benchmark - Viper Implementation
# Multiply two NxN matrices (pure integer, no lists)

def main():
    # Benchmark parameter
    n = 30
    
    # Pure integer computation
    checksum = 0
    row = 0
    while row < n:
        col = 0
        while col < n:
            sum_val = 0
            k = 0
            while k < n:
                a_val = (row * n + k) % 10
                b_val = (k * n + col + 1) % 10
                sum_val = sum_val + a_val * b_val
                k = k + 1
            checksum = checksum + sum_val
            col = col + 1
        row = row + 1
    
    print(checksum)

main()
