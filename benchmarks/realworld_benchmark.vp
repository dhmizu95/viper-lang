# Viper Real World Benchmark

def matrix_worker(row: int, size: int, done: Chan[int]):
    sum_val = 0
    for j in range(size):
        sum_val = sum_val + j * row
    send(done, sum_val)

def hash_worker(seed: int, iterations: int, done: Chan[int]):
    result = seed
    for i in range(iterations):
        result = (result * 31 + i) & 0xFFFFFFFF
    send(done, result)

def pipeline_worker(stage: int, items: int, done: Chan[int]):
    sum_val = 0
    for i in range(items):
        sum_val = sum_val + i * stage
    send(done, sum_val)

def scraper_worker(url_id: int, done: Chan[int]):
    sum_val = 0
    for i in range(1000):
        sum_val = sum_val + i * url_id
    send(done, sum_val)

def main():
    print("=== VIPER REAL WORLD BENCHMARKS ===")
    print(" ")
    
    # Benchmark 1: Matrix
    print("Benchmark 1: Matrix")
    num_matrices = 10
    done1 = chan(num_matrices * 256)
    
    sync:
        for m in range(num_matrices):
            for r in range(256):
                task matrix_worker(r, 256, done1)
    
    total1 = 0
    for i1 in range(num_matrices * 256):
        total1 = total1 + recv(done1)
    
    print("Tasks: ")
    print(num_matrices * 256)
    print("Checksum: ")
    print(total1)
    print(" ")
    
    # Benchmark 2: Hash
    print("Benchmark 2: Hash")
    num_hashes = 10000
    done2 = chan(num_hashes)
    
    sync:
        for h in range(num_hashes):
            task hash_worker(h * 17 + 3, 10000, done2)
    
    total2 = 0
    for i2 in range(num_hashes):
        total2 = total2 + recv(done2)
    
    print("Tasks: ")
    print(num_hashes)
    print("Checksum: ")
    print(total2)
    print(" ")
    
    # Benchmark 3: Pipeline
    print("Benchmark 3: Pipeline")
    num_pipelines = 100
    done3 = chan(num_pipelines * 5)
    
    sync:
        for p in range(num_pipelines):
            for s in range(5):
                task pipeline_worker(s, 1000, done3)
    
    total3 = 0
    for i3 in range(num_pipelines * 5):
        total3 = total3 + recv(done3)
    
    print("Stages: ")
    print(num_pipelines * 5)
    print("Checksum: ")
    print(total3)
    print(" ")
    
    # Benchmark 4: Scraper
    print("Benchmark 4: Scraper")
    num_urls = 10000
    done4 = chan(num_urls)
    
    sync:
        for u in range(num_urls):
            task scraper_worker(u, done4)
    
    total4 = 0
    for i4 in range(num_urls):
        total4 = total4 + recv(done4)
    
    print("Tasks: ")
    print(num_urls)
    print("Checksum: ")
    print(total4)
    print(" ")
    
    print("=== ALL BENCHMARKS COMPLETED ===")
