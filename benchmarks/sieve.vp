# Prime Sieve of Eratosthenes - Viper Implementation
# Counts primes up to N using Sieve of Eratosthenes

def sieve(n: int) -> int:
    # Create sieve array using list comprehension pattern
    is_prime = []
    i = 0
    while i <= n:
        is_prime.append(1)
        i = i + 1
    
    is_prime[0] = 0
    is_prime[1] = 0
    
    # Sieve of Eratosthenes
    i = 2
    while i * i <= n:
        if is_prime[i] == 1:
            # Mark multiples as composite
            j = i * i
            while j <= n:
                is_prime[j] = 0
                j = j + i
        i = i + 1
    
    # Count primes
    count = 0
    i = 2
    while i <= n:
        if is_prime[i] == 1:
            count = count + 1
        i = i + 1
    
    return count

def main():
    print("Prime Sieve Benchmark")
    print("=====================")
    
    # Test with increasing sizes
    sizes = [100000, 500000, 1000000, 5000000, 10000000]
    
    i = 0
    while i < len(sizes):
        n = sizes[i]
        print(n)
        count = sieve(n)
        print(count)
        i = i + 1
    
    print("Benchmark complete!")
