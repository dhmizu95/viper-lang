# Prime Sieve Benchmark - Viper (100M)
def sieve_of_eratosthenes(n: i64) -> i64:
    is_prime = [True] * (n + 1)
    is_prime[0] = False
    is_prime[1] = False
    
    i = 2
    while i * i <= n:
        if is_prime[i]:
            j = i * i
            while j <= n:
                is_prime[j] = False
                j = j + i
        i = i + 1
    
    count = 0
    i = 0
    while i <= n:
        if is_prime[i]:
            count = count + 1
        i = i + 1
    
    return count

def main():
    print("N=100000000: ", sieve_of_eratosthenes(100000000), " primes")
