# Benchmark: Ackermann function (recursive) - intensive
def ackermann(m: i64, n: i64) -> i64:
    if m == 0:
        return n + 1
    if n == 0:
        return ackermann(m - 1, 1)
    return ackermann(m - 1, ackermann(m, n - 1))

def main():
    # Calculate ackermann(3, 10) - intensive
    result = ackermann(3, 10)
    print(result)
