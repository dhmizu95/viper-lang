# Test gather() function
async def worker(n):
    return n * 2

async def main():
    # Create multiple futures
    f1 = worker(1)
    f2 = worker(2)
    f3 = worker(3)
    
    # Use gather to wait for all at once
    results = gather(f1, f2, f3)
    
    print("Results:", results)
    print("Sum:", results[0] + results[1] + results[2])

main()
