def sieve(limit: int) -> int:
    primes = [True] * limit
    primes[0] = False
    primes[1] = False
    
    p: int = 2
    while p * p <= limit:
        if primes[p]:
            i: int = p * p
            while i < limit:
                primes[i] = False
                i = i + p
        p = p + 1
        
    count: int = 0
    i = 0
    while i < limit:
        if primes[i]:
            count = count + 1
        i = i + 1
        
    return count

print("Primes up to 1000000:")
res: int = sieve(1000000)
print(res)
