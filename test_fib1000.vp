# Fibonacci test with BigInt

def fib(n: int) -> int:
    if n <= 1:
        return n
    a: int = 0
    b: int = 1
    i: int = 2
    while i <= n:
        temp = a + b
        a = b
        b = temp
        i = i + 1
    return b

def main():
    print("Computing fib(1000)...")
    n: int = 1000
    result: int = fib(n)
    print("fib(1000) =")
    print(result)
    print("")
    print("Done!")

if __name__ == "__main__":
    main()
