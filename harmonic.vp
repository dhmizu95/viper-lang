# Calculate sum of harmonic series up to n terms
# H(n) = 1 + 1/2 + 1/3 + 1/4 + ... + 1/n

def harmonic_sum(n: f64) -> f64:
    sum = 0.0
    i = 1.0
    while i <= n:
        sum = sum + (1.0 / i)
        i = i + 1.0
    return sum

def main():
    # Test with different values
    result1 = harmonic_sum(10.0)
    print(result1)
    
    result2 = harmonic_sum(100.0)
    print(result2)
    
    result3 = harmonic_sum(1000.0)
    print(result3)
