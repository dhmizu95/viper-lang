class Point:
    def __init__(self, x: int, y: int):
        self.x = x
        self.y = y
        
    def __add__(self, other: Point) -> Point:
        return Point(self.x + other.x, self.y + other.y)
        
    def __eq__(self, other: Point) -> bool:
        return self.x == other.x and self.y == other.y

def main():
    p1 = Point(10, 20)
    p2 = Point(5, 15)
    
    p3 = p1 + p2
    print(p3.x)
    print(p3.y)
    
    print(p1 == p2)
    
    p4 = Point(10, 20)
    print(p1 == p4)

main()
