# Fractions module - rational number arithmetic

def gcd(a, b):
    while b != 0:
        temp = b
        b = a % b
        a = temp
    return a

def create_fraction(numerator, denominator):
    if denominator == 0:
        raise ZeroDivisionError("Fraction denominator cannot be zero")
    
    if denominator < 0:
        numerator = -numerator
        denominator = -denominator
    
    g = gcd(abs(numerator), denominator)
    return {"numerator": numerator // g, "denominator": denominator // g}

def fraction_from_int(value):
    return {"numerator": value, "denominator": 1}

def fraction_from_float(value):
    # Simple conversion - not arbitrary precision
    return {"numerator": int(value * 1000000), "denominator": 1000000}

def fraction_add(a, b):
    num = a["numerator"] * b["denominator"] + b["numerator"] * a["denominator"]
    den = a["denominator"] * b["denominator"]
    return create_fraction(num, den)

def fraction_sub(a, b):
    num = a["numerator"] * b["denominator"] - b["numerator"] * a["denominator"]
    den = a["denominator"] * b["denominator"]
    return create_fraction(num, den)

def fraction_mul(a, b):
    num = a["numerator"] * b["numerator"]
    den = a["denominator"] * b["denominator"]
    return create_fraction(num, den)

def fraction_div(a, b):
    if b["numerator"] == 0:
        raise ZeroDivisionError("Division by zero")
    num = a["numerator"] * b["denominator"]
    den = a["denominator"] * b["numerator"]
    return create_fraction(num, den)

def fraction_neg(a):
    return {"numerator": -a["numerator"], "denominator": a["denominator"]}

def fraction_abs(a):
    return {"numerator": abs(a["numerator"]), "denominator": a["denominator"]}

def fraction_to_float(a):
    return a["numerator"] / a["denominator"]

def fraction_to_string(a):
    if a["denominator"] == 1:
        return str(a["numerator"])
    return str(a["numerator"]) + "/" + str(a["denominator"])

def fraction_numerator(a):
    return a["numerator"]

def fraction_denominator(a):
    return a["denominator"]
