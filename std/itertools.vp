# Viper Standard Library - itertools module
# Functions creating iterators for efficient looping

# Module metadata
__name__ = "itertools"
__version__ = "0.4.7"

# ============================================
# Infinite iterators
# ============================================

def count(start: int = 0, step: int = 1):
    """Generate consecutive integers starting from start with given step.
    
    count(10, 2) --> 10 12 14 16 ...
    """
    current = start
    while True:
        yield current
        current = current + step

def cycle(iterable):
    """Cycle through iterable indefinitely.
    
    cycle('ABCD') --> A B C D A B C D ...
    """
    saved = []
    for element in iterable:
        yield element
        saved.append(element)
    
    while len(saved) > 0:
        for element in saved:
            yield element

def repeat(object, times: int = None):
    """Repeat object indefinitely or for a fixed number of times.
    
    repeat(5, 3) --> 5 5 5
    repeat('x') --> x x x ... (infinite)
    """
    if times is None:
        while True:
            yield object
    else:
        i = 0
        while i < times:
            yield object
            i = i + 1

# ============================================
# Finite iterators
# ============================================

def accumulate(iterable, func=None):
    """Generate accumulated results.
    
    accumulate([1,2,3,4]) --> 1 3 6 10
    accumulate([1,2,3,4], mul) --> 1 2 6 24
    """
    it = iter(iterable)
    try:
        total = next(it)
    except StopIteration:
        return
    
    yield total
    
    for element in it:
        if func is None:
            total = total + element
        else:
            total = func(total, element)
        yield total

def chain(*iterables):
    """Chain iterables together as one sequence.
    
    chain('ABC', 'DEF') --> A B C D E F
    """
    for iterable in iterables:
        for element in iterable:
            yield element

def chain.from_iterable(iterable):
    """Chain from a single iterable of iterables.
    
    chain.from_iterable(['AB', 'CD']) --> A B C D
    """
    for sub_iterable in iterable:
        for element in sub_iterable:
            yield element

def compress(data, selectors):
    """Select elements from data where selector is true.
    
    compress('ABCDEF', [1,0,1,0,1,1]) --> A C E F
    """
    for i, datum in enumerate(data):
        if selectors[i]:
            yield datum

def dropwhile(predicate, iterable):
    """Drop items while predicate is true, then yield rest.
    
    dropwhile(lambda x: x<5, [1,4,6,3,8]) --> 6 3 8
    """
    for x in iterable:
        if not predicate(x):
            yield x
            break
    
    for x in iterable:
        yield x

def filterfalse(predicate, iterable):
    """Filter elements where predicate is false.
    
    filterfalse(lambda x: x%2, range(10)) --> 0 2 4 6 8
    """
    for x in iterable:
        if not predicate(x):
            yield x

def groupby(iterable, key=None):
    """Group consecutive items by key function.
    
    groupby('AAAABBBCCDAABBB') --> A B C D A B
    """
    # Simplified implementation
    current_key = None
    current_group = []
    
    for item in iterable:
        if key is None:
            k = item
        else:
            k = key(item)
        
        if k != current_key:
            if current_group:
                yield (current_key, current_group)
            current_key = k
            current_group = [item]
        else:
            current_group.append(item)
    
    if current_group:
        yield (current_key, current_group)

def islice(iterable, *args):
    """Slice an iterator.
    
    islice('ABCDEFG', 2) --> A B
    islice('ABCDEFG', 2, 4) --> C D
    islice('ABCDEFG', 2, None) --> C D E F G
    islice('ABCDEFG', 0, None, 2) --> A C E G
    """
    # Parse arguments
    if len(args) == 1:
        stop = args[0]
        start = 0
        step = 1
    elif len(args) == 2:
        start = 0
        stop = args[0]
        step = args[1]
    else:
        start = args[0]
        stop = args[1]
        step = args[2] if len(args) > 2 else 1
    
    # Skip to start
    i = 0
    for x in iterable:
        if i >= start:
            break
        i = i + 1
    
    # Yield with step
    if i >= start:
        count = 0
        while stop is None or count < (stop - start):
            if count % step == 0:
                yield x
            try:
                x = next(iterable)
            except StopIteration:
                break
            count = count + 1

def pairwise(iterable):
    """Generate consecutive overlapping pairs.
    
    pairwise('ABCDEFG') --> AB BC CD DE EF FG
    """
    it = iter(iterable)
    try:
        prev = next(it)
    except StopIteration:
        return
    
    for curr in it:
        yield (prev, curr)
        prev = curr

def starmap(function, iterable):
    """Apply function to argument tuples from iterable.
    
    starmap(pow, [(2,5), (3,2), (10,3)]) --> 32 9 1000
    """
    for args in iterable:
        yield function(*args)

def takewhile(predicate, iterable):
    """Yield items while predicate is true.
    
    takewhile(lambda x: x<5, [1,4,6,3,8]) --> 1 4
    """
    for x in iterable:
        if not predicate(x):
            break
        yield x

def tee(iterable, n: int = 2):
    """Create n independent iterators from one iterable.
    
    tee('ABC', 2) --> iterator1, iterator2
    """
    # Simplified implementation - stores all values
    values = list(iterable)
    result = []
    for i in range(n):
        result.append(iter(values))
    return tuple(result)

def zip_longest(*iterables, fillvalue=None):
    """Zip iterables, filling missing values with fillvalue.
    
    zip_longest('ABCD', 'xy', fillvalue='-') --> Ax By C- D-
    """
    # Convert to iterators
    iterators = [iter(it) for it in iterables]
    num_active = len(iterators)
    
    if num_active == 0:
        return
    
    while True:
        values = []
        for i, it in enumerate(iterators):
            try:
                value = next(it)
            except StopIteration:
                num_active = num_active - 1
                if num_active <= 0:
                    return
                values.append(fillvalue)
            else:
                values.append(value)
        
        yield tuple(values)

# ============================================
# Combinatoric iterators
# ============================================

def product(*iterables, repeat: int = 1):
    """Cartesian product of iterables.
    
    product('ABCD', 'xy') --> Ax Ay Bx By Cx Cy Dx Dy
    product('AB', repeat=3) --> AAA AAB ABA ABB BAA BAB BBA BBB
    """
    # Collect all pools
    pools = [list(it) for it in iterables] * repeat
    
    if not pools:
        yield ()
        return
    
    # Start with first element from each pool
    result = [pool[0] for pool in pools]
    yield tuple(result)
    
    while True:
        # Find rightmost pool that can advance
        for i in range(len(pools) - 1, -1, -1):
            pool = pools[i]
            idx = result.index(pool[i]) if pool[i] in result else 0
            if idx < len(pool) - 1:
                result[i] = pool[idx + 1]
                # Reset all pools to the right
                for j in range(i + 1, len(pools)):
                    result[j] = pools[j][0]
                yield tuple(result)
                break
        else:
            # All pools exhausted
            return

def permutations(iterable, r: int = None):
    """Generate all permutations of length r.
    
    permutations('ABCD', 2) --> AB AC AD BA BC BD CA CB CD DA DB DC
    """
    pool = list(iterable)
    n = len(pool)
    r = n if r is None else r
    
    if r > n:
        return
    
    # Start with first r indices
    indices = list(range(n))
    cycles = list(range(n, n - r, -1))
    
    yield tuple(pool[i] for i in indices[:r])
    
    while True:
        for i in range(r - 1, -1, -1):
            cycles[i] = cycles[i] - 1
            if cycles[i] == 0:
                # Move index to end and reset cycle
                indices[i:] = indices[i+1:] + indices[i:i+1]
                cycles[i] = n - i
            else:
                # Swap with element at cycle position
                j = cycles[i]
                indices[i], indices[-j] = indices[-j], indices[i]
                yield tuple(pool[i] for i in indices[:r])
                break
        else:
            return

def combinations(iterable, r: int):
    """Generate all combinations of length r (no repeated elements).
    
    combinations('ABCD', 2) --> AB AC AD BC BD CD
    """
    pool = list(iterable)
    n = len(pool)
    
    if r > n:
        return
    
    # Start with first r indices
    indices = list(range(r))
    yield tuple(pool[i] for i in indices)
    
    while True:
        # Find rightmost index that can advance
        for i in range(r - 1, -1, -1):
            if indices[i] != i + n - r:
                break
        else:
            return
        
        # Advance this index
        indices[i] = indices[i] + 1
        
        # Reset all indices to the right
        for j in range(i + 1, r):
            indices[j] = indices[j-1] + 1
        
        yield tuple(pool[i] for i in indices)

def combinations_with_replacement(iterable, r: int):
    """Generate combinations with repeated elements allowed.
    
    combinations_with_replacement('ABC', 2) --> AA AB AC BB BC CC
    """
    pool = list(iterable)
    n = len(pool)
    
    if r == 0:
        yield ()
        return
    
    # Start with all zeros
    indices = [0] * r
    yield tuple(pool[i] for i in indices)
    
    while True:
        # Find rightmost index that can advance
        for i in range(r - 1, -1, -1):
            if indices[i] != n - 1:
                break
        else:
            return
        
        # Advance this index
        indices[i] = indices[i] + 1
        
        # Reset all indices to the right to same value
        for j in range(i + 1, r):
            indices[j] = indices[i]
        
        yield tuple(pool[i] for i in indices)
