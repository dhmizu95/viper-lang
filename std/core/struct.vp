# Viper Standard Library - struct module
# Pack and unpack binary data

# Module metadata
__name__ = "struct"
__version__ = "0.4.7"

# ============================================
# Exceptions
# ============================================

class error(Exception):
    """Exception raised for struct packing/unpacking errors."""
    pass


# ============================================
# Format Character Constants
# ============================================

# Byte order markers
NATIVE = '@'
NATIVE_STANDARD = '='
LITTLE_ENDIAN = '<'
BIG_ENDIAN = '>'
NETWORK = '!'  # Same as big-endian

# Format characters
FORMAT_CHAR = 'c'
FORMAT_UNSIGNED_CHAR = 'B'
FORMAT_SIGNED_CHAR = 'b'
FORMAT_BOOL = '?'
FORMAT_SHORT = 'h'
FORMAT_UNSIGNED_SHORT = 'H'
FORMAT_INT = 'i'
FORMAT_UNSIGNED_INT = 'I'
FORMAT_LONG = 'l'
FORMAT_UNSIGNED_LONG = 'L'
FORMAT_LONG_LONG = 'q'
FORMAT_UNSIGNED_LONG_LONG = 'Q'
FORMAT_FLOAT = 'f'
FORMAT_DOUBLE = 'd'
FORMAT_PAD = 'x'

# Size and alignment info
# (simplified - actual sizes depend on platform)
SIZE_CHAR = 1
SIZE_SHORT = 2
SIZE_INT = 4
SIZE_LONG = 4  # or 8 on 64-bit
SIZE_LONG_LONG = 8
SIZE_FLOAT = 4
SIZE_DOUBLE = 8


# ============================================
# Main Functions
# ============================================

def pack(format: str, *values) -> str:
    """Pack values into binary string.

    Args:
        format: Format string specifying layout
        *values: Values to pack

    Returns:
        Binary string (bytes)

    Example:
        pack('ii', 1, 2) -> 8-byte string
        pack('f', 3.14) -> 4-byte float
    """
    return _pack_unpack(format, values, pack_mode=True)


def unpack(format: str, buffer: str) -> tuple:
    """Unpack binary string to values.

    Args:
        format: Format string specifying layout
        buffer: Binary string to unpack

    Returns:
        Tuple of unpacked values

    Example:
        unpack('ii', data) -> (int, int)
        unpack('f', data) -> (float,)
    """
    result = _pack_unpack(format, buffer, pack_mode=False)
    if isinstance(result, tuple):
        return result
    return (result,)


def pack_into(format: str, buffer, offset: int, *values):
    """Pack values into buffer at offset.

    Args:
        format: Format string
        buffer: Writable buffer
        offset: Starting offset
        *values: Values to pack
    """
    packed = pack(format, *values)
    # Write to buffer at offset
    for i, char in enumerate(packed):
        buffer[offset + i] = char


def unpack_from(format: str, buffer, offset: int = 0) -> tuple:
    """Unpack from buffer at offset.

    Args:
        format: Format string
        buffer: Buffer to unpack from
        offset: Starting offset

    Returns:
        Tuple of unpacked values
    """
    # Read from buffer starting at offset
    size = calcsize(format)
    data = ""
    for i in range(size):
        data = data + buffer[offset + i]
    return unpack(format, data)


def calcsize(format: str) -> int:
    """Calculate size of packed data.

    Args:
        format: Format string

    Returns:
        Size in bytes
    """
    return _parse_format(format)[1]


# ============================================
# Internal Implementation
# ============================================

def _parse_format(format: str) -> tuple:
    """Parse format string.

    Returns:
        Tuple of (byte_order, total_size, format_items)
    """
    if len(format) == 0:
        raise error("Empty format string")

    # Determine byte order and alignment
    byte_order = NATIVE
    start = 0

    if format[0] in '<>@=!':
        byte_order = format[0]
        start = 1

    # Calculate total size and parse items
    total_size = 0
    items = []
    i = start

    while i < len(format):
        char = format[i]

        if char == 'x':
            # Pad byte
            total_size = total_size + 1
            items.append(('x', 1))
        elif char == 's':
            # String - need length prefix
            # Find the number before 's'
            num_str = ""
            j = i - 1
            while j >= start and format[j].isdigit():
                num_str = format[j] + num_str
                j = j - 1
            length = int(num_str) if num_str else 1
            total_size = total_size + length
            items.append(('s', length))
        elif char == 'p':
            # Pascal string - need length prefix
            num_str = ""
            j = i - 1
            while j >= start and format[j].isdigit():
                num_str = format[j] + num_str
                j = j - 1
            length = int(num_str) if num_str else 1
            total_size = total_size + length
            items.append(('p', length))
        elif char in 'cbB?hHiIlLqQfd':
            # Standard types
            size = _get_type_size(char)
            total_size = total_size + size
            items.append((char, size))
        else:
            raise error("Unknown format character: " + char)

        i = i + 1

    return (byte_order, total_size, items)


def _get_type_size(char: str) -> int:
    """Get size of a format character."""
    sizes = {
        'c': 1, 'b': 1, 'B': 1, '?': 1,
        'h': 2, 'H': 2,
        'i': 4, 'I': 4,
        'l': 4, 'L': 4,
        'q': 8, 'Q': 8,
        'f': 4, 'd': 8
    }
    return sizes.get(char, 1)


def _pack_unpack(format: str, data, pack_mode: bool):
    """Internal pack/unpack implementation.

    Args:
        format: Format string
        data: Values to pack or buffer to unpack
        pack_mode: True for pack, False for unpack

    Returns:
        Packed string or tuple of values
    """
    byte_order, total_size, items = _parse_format(format)

    if pack_mode:
        # Pack mode
        result = []
        value_idx = 0

        for item_type, size in items:
            if item_type == 'x':
                # Pad byte
                result.append('\x00')
            elif item_type == 's':
                # String
                if value_idx >= len(data):
                    raise error("Not enough values")
                s = str(data[value_idx])
                # Pad or truncate
                if len(s) < size:
                    s = s + '\x00' * (size - len(s))
                else:
                    s = s[:size]
                result.append(s)
                value_idx = value_idx + 1
            elif item_type == 'p':
                # Pascal string
                if value_idx >= len(data):
                    raise error("Not enough values")
                s = str(data[value_idx])
                # First byte is length
                length = min(len(s), size - 1)
                pascal = chr(length) + s[:length]
                if len(pascal) < size:
                    pascal = pascal + '\x00' * (size - len(pascal))
                result.append(pascal)
                value_idx = value_idx + 1
            elif item_type in 'cbB':
                # Character or byte
                if value_idx >= len(data):
                    raise error("Not enough values")
                val = data[value_idx]
                if item_type == 'c':
                    result.append(str(val)[0])
                elif item_type == 'B':
                    # Unsigned byte
                    result.append(chr(int(val) & 0xFF))
                elif item_type == 'b':
                    # Signed byte
                    v = int(val)
                    if v < 0:
                        v = v + 256
                    result.append(chr(v & 0xFF))
                value_idx = value_idx + 1
            elif item_type == '?':
                # Boolean
                if value_idx >= len(data):
                    raise error("Not enough values")
                val = 1 if data[value_idx] else 0
                result.append(chr(val))
                value_idx = value_idx + 1
            elif item_type in 'hH':
                # Short
                if value_idx >= len(data):
                    raise error("Not enough values")
                val = int(data[value_idx])
                if item_type == 'h' and val < 0:
                    val = val + 65536
                # Pack as 2 bytes
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    # Big endian
                    result.append(chr((val >> 8) & 0xFF))
                    result.append(chr(val & 0xFF))
                else:
                    # Little endian (default)
                    result.append(chr(val & 0xFF))
                    result.append(chr((val >> 8) & 0xFF))
                value_idx = value_idx + 1
            elif item_type in 'iI':
                # Int
                if value_idx >= len(data):
                    raise error("Not enough values")
                val = int(data[value_idx])
                if item_type == 'I' and val < 0:
                    val = val + 4294967296
                # Pack as 4 bytes
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    result.append(chr((val >> 24) & 0xFF))
                    result.append(chr((val >> 16) & 0xFF))
                    result.append(chr((val >> 8) & 0xFF))
                    result.append(chr(val & 0xFF))
                else:
                    result.append(chr(val & 0xFF))
                    result.append(chr((val >> 8) & 0xFF))
                    result.append(chr((val >> 16) & 0xFF))
                    result.append(chr((val >> 24) & 0xFF))
                value_idx = value_idx + 1
            elif item_type in 'f':
                # Float (simplified - uses int representation)
                if value_idx >= len(data):
                    raise error("Not enough values")
                val = float(data[value_idx])
                # Simplified float packing
                import math
                # Convert to int bits (simplified)
                bits = int(val * 1000000) & 0xFFFFFFFF
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    result.append(chr((bits >> 24) & 0xFF))
                    result.append(chr((bits >> 16) & 0xFF))
                    result.append(chr((bits >> 8) & 0xFF))
                    result.append(chr(bits & 0xFF))
                else:
                    result.append(chr(bits & 0xFF))
                    result.append(chr((bits >> 8) & 0xFF))
                    result.append(chr((bits >> 16) & 0xFF))
                    result.append(chr((bits >> 24) & 0xFF))
                value_idx = value_idx + 1
            elif item_type in 'd':
                # Double (simplified)
                if value_idx >= len(data):
                    raise error("Not enough values")
                val = float(data[value_idx])
                bits = int(val * 1000000000) & 0xFFFFFFFFFFFFFFFF
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    for shift in [56, 48, 40, 32, 24, 16, 8, 0]:
                        result.append(chr((bits >> shift) & 0xFF))
                else:
                    for shift in [0, 8, 16, 24, 32, 40, 48, 56]:
                        result.append(chr((bits >> shift) & 0xFF))
                value_idx = value_idx + 1
            elif item_type in 'lL':
                # Long (same as int for now)
                if value_idx >= len(data):
                    raise error("Not enough values")
                val = int(data[value_idx])
                if item_type == 'L' and val < 0:
                    val = val + 4294967296
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    result.append(chr((val >> 24) & 0xFF))
                    result.append(chr((val >> 16) & 0xFF))
                    result.append(chr((val >> 8) & 0xFF))
                    result.append(chr(val & 0xFF))
                else:
                    result.append(chr(val & 0xFF))
                    result.append(chr((val >> 8) & 0xFF))
                    result.append(chr((val >> 16) & 0xFF))
                    result.append(chr((val >> 24) & 0xFF))
                value_idx = value_idx + 1
            elif item_type in 'qQ':
                # Long long (8 bytes)
                if value_idx >= len(data):
                    raise error("Not enough values")
                val = int(data[value_idx])
                if item_type == 'Q' and val < 0:
                    val = val + (1 << 64)
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    for shift in [56, 48, 40, 32, 24, 16, 8, 0]:
                        result.append(chr((val >> shift) & 0xFF))
                else:
                    for shift in [0, 8, 16, 24, 32, 40, 48, 56]:
                        result.append(chr((val >> shift) & 0xFF))
                value_idx = value_idx + 1

        return "".join(result)

    else:
        # Unpack mode
        if isinstance(data, str):
            buffer = data
        else:
            buffer = str(data)

        if len(buffer) < total_size:
            raise error("Buffer too small: expected " + str(total_size) + " bytes")

        results = []
        offset = 0

        for item_type, size in items:
            if item_type == 'x':
                # Skip pad byte
                offset = offset + size
            elif item_type == 's':
                # String
                s = buffer[offset:offset + size]
                # Remove null terminator
                null_pos = s.find('\x00')
                if null_pos >= 0:
                    s = s[:null_pos]
                results.append(s)
                offset = offset + size
            elif item_type == 'p':
                # Pascal string
                length = ord(buffer[offset])
                s = buffer[offset + 1:offset + 1 + length]
                results.append(s)
                offset = offset + size
            elif item_type == 'c':
                results.append(buffer[offset])
                offset = offset + 1
            elif item_type == 'B':
                results.append(ord(buffer[offset]))
                offset = offset + 1
            elif item_type == 'b':
                val = ord(buffer[offset])
                if val >= 128:
                    val = val - 256
                results.append(val)
                offset = offset + 1
            elif item_type == '?':
                results.append(ord(buffer[offset]) != 0)
                offset = offset + 1
            elif item_type in 'hH':
                # Short
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    val = (ord(buffer[offset]) << 8) | ord(buffer[offset + 1])
                else:
                    val = ord(buffer[offset]) | (ord(buffer[offset + 1]) << 8)
                if item_type == 'h' and val >= 32768:
                    val = val - 65536
                results.append(val)
                offset = offset + 2
            elif item_type in 'iI':
                # Int
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    val = ((ord(buffer[offset]) << 24) |
                           (ord(buffer[offset + 1]) << 16) |
                           (ord(buffer[offset + 2]) << 8) |
                           ord(buffer[offset + 3]))
                else:
                    val = (ord(buffer[offset]) |
                           (ord(buffer[offset + 1]) << 8) |
                           (ord(buffer[offset + 2]) << 16) |
                           (ord(buffer[offset + 3]) << 24))
                if item_type == 'I' and val >= (1 << 31):
                    val = val - (1 << 32)
                results.append(val)
                offset = offset + 4
            elif item_type in 'lL':
                # Long (same as int)
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    val = ((ord(buffer[offset]) << 24) |
                           (ord(buffer[offset + 1]) << 16) |
                           (ord(buffer[offset + 2]) << 8) |
                           ord(buffer[offset + 3]))
                else:
                    val = (ord(buffer[offset]) |
                           (ord(buffer[offset + 1]) << 8) |
                           (ord(buffer[offset + 2]) << 16) |
                           (ord(buffer[offset + 3]) << 24))
                if item_type == 'L' and val >= (1 << 31):
                    val = val - (1 << 32)
                results.append(val)
                offset = offset + 4
            elif item_type in 'qQ':
                # Long long
                val = 0
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    for shift in [56, 48, 40, 32, 24, 16, 8, 0]:
                        val = (val << 8) | ord(buffer[offset])
                        offset = offset + 1
                else:
                    for shift in [0, 8, 16, 24, 32, 40, 48, 56]:
                        val = val | (ord(buffer[offset]) << shift)
                        offset = offset + 1
                if item_type == 'Q' and val >= (1 << 63):
                    val = val - (1 << 64)
                results.append(val)
            elif item_type == 'f':
                # Float (simplified)
                bits = 0
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    for shift in [24, 16, 8, 0]:
                        bits = (bits << 8) | ord(buffer[offset])
                        offset = offset + 1
                else:
                    for shift in [0, 8, 16, 24]:
                        bits = bits | (ord(buffer[offset]) << shift)
                        offset = offset + 1
                # Simplified conversion back to float
                results.append(float(bits) / 1000000.0)
            elif item_type == 'd':
                # Double (simplified)
                bits = 0
                if byte_order == '>' or byte_order == '!' or byte_order == '=':
                    for shift in [56, 48, 40, 32, 24, 16, 8, 0]:
                        bits = (bits << 8) | ord(buffer[offset])
                        offset = offset + 1
                else:
                    for shift in [0, 8, 16, 24, 32, 40, 48, 56]:
                        bits = bits | (ord(buffer[offset]) << shift)
                        offset = offset + 1
                results.append(float(bits) / 1000000000.0)

        return tuple(results)


# ============================================
# Itertools (for advanced usage)
# ============================================

class Struct:
    """Compiled struct format.

    Create once and reuse for better performance.

    Example:
        s = Struct('ii')
        data = s.pack(1, 2)
        values = s.unpack(data)
    """

    def __init__(self, format: str):
        self.format = format
        self.size = calcsize(format)

    def pack(self, *values) -> str:
        """Pack values."""
        return pack(self.format, *values)

    def unpack(self, buffer: str) -> tuple:
        """Unpack buffer."""
        return unpack(self.format, buffer)

    def pack_into(self, buffer, offset: int, *values):
        """Pack into buffer at offset."""
        pack_into(self.format, buffer, offset, *values)

    def unpack_from(self, buffer, offset: int = 0) -> tuple:
        """Unpack from buffer at offset."""
        return unpack_from(self.format, buffer, offset)

    def __repr__(self) -> str:
        return "Struct('" + self.format + "')"

    @property
    def format(self) -> str:
        return self._format

    @format.setter
    def format(self, value: str):
        self._format = value
        self.size = calcsize(value)


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test struct functionality."""
    print("Testing struct module...")

    # Test basic packing
    print("  Testing pack/unpack...")
    data = pack('ii', 1, 2)
    print("    pack('ii', 1, 2) -> " + str(len(data)) + " bytes")
    values = unpack('ii', data)
    print("    unpack('ii', data) -> " + str(values))

    # Test different types
    print("  Testing different types...")
    data = pack('bhi', -1, -100, -10000)
    values = unpack('bhi', data)
    print("    pack/unpack 'bhi': " + str(values))

    # Test calcsize
    print("  Testing calcsize...")
    print("    calcsize('ii') = " + str(calcsize('ii')))
    print("    calcsize('f') = " + str(calcsize('f')))
    print("    calcsize('d') = " + str(calcsize('d')))

    # Test Struct class
    print("  Testing Struct class...")
    s = Struct('if')
    data = s.pack(42, 3.14)
    values = s.unpack(data)
    print("    Struct('if'): " + str(values))

    # Test byte order
    print("  Testing byte order...")
    data_be = pack('>i', 0x12345678)
    data_le = pack('<i', 0x12345678)
    print("    Big endian: " + repr(data_be))
    print("    Little endian: " + repr(data_le))

    print("struct tests completed!")
