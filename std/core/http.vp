extern def vp_http_server_create(port: int, handler) 
extern def vp_http_server_free(server)
extern def vp_http_server_serve(server) -> int
extern def vp_http_server_stop(server)
extern def vp_http_server_is_running(server) -> int
extern def vp_http_urlencode(s: str) -> str
