# Viper Standard Library - http module
# HTTP client and server

__name__ = "http"
__version__ = "0.4.5"

# ============================================
# HTTP Status Codes
# ============================================

# 2xx Success
OK: int = 200
CREATED: int = 201
ACCEPTED: int = 202
NO_CONTENT: int = 204

# 3xx Redirection
MOVED_PERMANENTLY: int = 301
FOUND: int = 302
SEE_OTHER: int = 303
NOT_MODIFIED: int = 304
TEMPORARY_REDIRECT: int = 307
PERMANENT_REDIRECT: int = 308

# 4xx Client Error
BAD_REQUEST: int = 400
UNAUTHORIZED: int = 401
FORBIDDEN: int = 403
NOT_FOUND: int = 404
METHOD_NOT_ALLOWED: int = 405
CONFLICT: int = 409
GONE: int = 410
PRECONDITION_FAILED: int = 412
UNSUPPORTED_MEDIA_TYPE: int = 415
TOO_MANY_REQUESTS: int = 429

# 5xx Server Error
INTERNAL_SERVER_ERROR: int = 500
NOT_IMPLEMENTED: int = 501
BAD_GATEWAY: int = 502
SERVICE_UNAVAILABLE: int = 503
GATEWAY_TIMEOUT: int = 504

# ============================================
# HTTP Methods
# ============================================

GET: str = "GET"
POST: str = "POST"
PUT: str = "PUT"
DELETE: str = "DELETE"
PATCH: str = "PATCH"
HEAD: str = "HEAD"
OPTIONS: str = "OPTIONS"

# ============================================
# Response Class
# ============================================

class Response:
    """HTTP response object."""
    
    def __init__(self):
        """Create a new response."""
        self._response = None
        self._status_code = 0
        self._text = ""
        self._headers = {}
        self._json_data = None
    
    def _from_ptr(self, ptr):
        """Initialize from runtime pointer."""
        self._response = ptr
        if ptr:
            self._status_code = vp_http_response_status(ptr)
            self._text = vp_http_response_text(ptr)
    
    @property
    def status_code(self) -> int:
        """Get HTTP status code."""
        return self._status_code
    
    @property
    def text(self) -> str:
        """Get response body as text."""
        return self._text
    
    @property
    def content(self) -> str:
        """Get response body as bytes (alias for text)."""
        return self._text
    
    def json(self):
        """Parse response body as JSON."""
        if self._response:
            return vp_http_response_json(self._response)
        return None
    
    def header(self, name: str) -> str:
        """Get a response header."""
        if self._response:
            return vp_http_response_header(self._response, name)
        return ""
    
    def headers(self) -> dict:
        """Get all response headers."""
        return self._headers
    
    @property
    def ok(self) -> bool:
        """Check if request was successful."""
        return 200 <= self._status_code < 300
    
    def raise_for_status(self):
        """Raise exception for error status."""
        if self._status_code >= 400:
            raise HTTPError(self._status_code, self._text)
    
    def close(self):
        """Close the response."""
        if self._response:
            vp_http_response_free(self._response)
            self._response = None
    
    def __enter__(self):
        """Context manager entry."""
        return self
    
    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit."""
        self.close()
        return False

# ============================================
# HTTP Error
# ============================================

class HTTPError(Exception):
    """HTTP error exception."""
    
    def __init__(self, status_code: int, message: str = ""):
        self.status_code = status_code
        self.message = message
        super().__init__(f"HTTP {status_code}: {message}")

# ============================================
# Client Functions
# ============================================

def get(url: str, headers: dict = None, timeout: float = 30.0) -> Response:
    """Send a GET request."""
    resp_ptr = vp_http_get(url)
    resp = Response()
    resp._from_ptr(resp_ptr)
    return resp

def post(url: str, data: str = None, json_data: dict = None, 
         headers: dict = None, timeout: float = 30.0) -> Response:
    """Send a POST request."""
    body = data
    if json_data:
        # Simplified: would convert to JSON
        body = str(json_data)
    resp_ptr = vp_http_post(url, body)
    resp = Response()
    resp._from_ptr(resp_ptr)
    return resp

def put(url: str, data: str = None, headers: dict = None, 
        timeout: float = 30.0) -> Response:
    """Send a PUT request."""
    return request(PUT, url, data, headers)

def delete(url: str, headers: dict = None, 
           timeout: float = 30.0) -> Response:
    """Send a DELETE request."""
    return request(DELETE, url, None, headers)

def patch(url: str, data: str = None, headers: dict = None,
          timeout: float = 30.0) -> Response:
    """Send a PATCH request."""
    return request(PATCH, url, data, headers)

def head(url: str, headers: dict = None,
         timeout: float = 30.0) -> Response:
    """Send a HEAD request."""
    return request(HEAD, url, None, headers)

def options(url: str, headers: dict = None,
            timeout: float = 30.0) -> Response:
    """Send an OPTIONS request."""
    return request(OPTIONS, url, None, headers)

def request(method: str, url: str, data: str = None, 
            headers: dict = None, timeout: float = 30.0) -> Response:
    """Send a generic HTTP request."""
    body = data if data else ""
    resp_ptr = vp_http_request(method, url, body, headers)
    resp = Response()
    resp._from_ptr(resp_ptr)
    return resp

# ============================================
# Server
# ============================================

class Server:
    """HTTP server."""
    
    def __init__(self, port: int, handler=None):
        """Create a new HTTP server."""
        self._port = port
        self._handler = handler
        self._server = vp_http_server_create(port, handler)
        self._running = False
    
    def serve_forever(self):
        """Start serving requests."""
        self._running = True
        vp_http_server_serve(self._server)
    
    def shutdown(self):
        """Stop the server."""
        self._running = False
        vp_http_server_stop(self._server)
    
    def is_running(self) -> bool:
        """Check if server is running."""
        return vp_http_server_is_running(self._server) != 0
    
    @property
    def port(self) -> int:
        """Get server port."""
        return self._port

def create_server(port: int, handler=None) -> Server:
    """Create a new HTTP server."""
    return Server(port, handler)

# ============================================
# URL Utilities
# ============================================

def urlencode(query: dict) -> str:
    """Encode a dictionary as URL query string."""
    parts = []
    for key, value in query.items():
        encoded_key = vp_http_urlencode(key)
        encoded_value = vp_http_urlencode(str(value))
        parts.append(f"{encoded_key}={encoded_value}")
    return "&".join(parts)

def urldecode(query_string: str) -> dict:
    """Decode a URL query string to dictionary."""
    result = {}
    pairs = query_string.split("&")
    for pair in pairs:
        if "=" in pair:
            key, value = pair.split("=", 1)
            decoded_key = vp_http_urldecode(key)
            decoded_value = vp_http_urldecode(value)
            result[decoded_key] = decoded_value
    return result

def urljoin(base: str, path: str) -> str:
    """Join base URL with path."""
    if base.endswith("/"):
        base = base[:-1]
    if not path.startswith("/"):
        path = "/" + path
    return base + path

def urlparse(url: str) -> tuple:
    """Parse URL into components."""
    # Simplified parsing
    scheme = "http"
    host = ""
    port = 80
    path = "/"
    
    # Remove scheme
    if "://" in url:
        scheme, rest = url.split("://", 1)
    else:
        rest = url
    
    # Extract host and port
    if "/" in rest:
        host_port, path = rest.split("/", 1)
        path = "/" + path
    else:
        host_port = rest
        path = "/"
    
    if ":" in host_port:
        host, port_str = host_port.split(":", 1)
        port = int(port_str)
    else:
        host = host_port
    
    return (scheme, host, port, path)

# ============================================
# Headers Helper
# ============================================

class Headers:
    """HTTP headers container."""
    
    def __init__(self):
        self._headers = {}
    
    def set(self, name: str, value: str):
        """Set a header."""
        self._headers[name] = value
    
    def get(self, name: str, default: str = "") -> str:
        """Get a header."""
        return self._headers.get(name, default)
    
    def remove(self, name: str):
        """Remove a header."""
        if name in self._headers:
            del self._headers[name]
    
    def items(self) -> list:
        """Get all headers as list of tuples."""
        result = []
        for key, value in self._headers.items():
            result.append((key, value))
        return result
    
    def __getitem__(self, name: str) -> str:
        """Get header using subscript."""
        return self._headers[name]
    
    def __setitem__(self, name: str, value: str):
        """Set header using subscript."""
        self._headers[name] = value
    
    def __contains__(self, name: str) -> bool:
        """Check if header exists."""
        return name in self._headers

# ============================================
# Runtime Function Declarations
# ============================================

