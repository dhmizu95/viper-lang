# Viper Standard Library - contextlib module
# Utilities for creating and working with context managers

# Module metadata
__name__ = "contextlib"
__version__ = "0.4.7"

# ============================================
# contextmanager Decorator
# ============================================

class _GeneratorContextManager:
    """Helper class for contextmanager decorator."""

    def __init__(self, func, args, kwargs):
        self.gen = func(*args, **kwargs)
        self._state = "created"

    def __enter__(self):
        try:
            result = next(self.gen)
            self._state = "suspended"
            return result
        except StopIteration:
            raise ValueError("generator didn't yield")

    def __exit__(self, exc_type, exc_val, exc_tb):
        if exc_type is None:
            try:
                next(self.gen)
            except StopIteration:
                self._state = "finished"
                return False
            else:
                raise ValueError("generator didn't stop")
        else:
            try:
                # Send exception into generator
                self.gen.throw(exc_type, exc_val, exc_tb)
            except StopIteration:
                self._state = "finished"
                return True  # Exception handled
            except Exception as e:
                if e is exc_val:
                    # Re-raised same exception
                    self._state = "finished"
                    return False
                # Different exception
                self._state = "finished"
                raise
            else:
                raise ValueError("generator didn't stop after throw()")


def contextmanager(func):
    """Decorator to create context manager from generator function.

    The generator function should yield exactly once. The value
    yielded becomes the result of __enter__. Code after yield
    runs in __exit__.

    Example:
        @contextmanager
        def managed_resource():
            resource = acquire()
            try:
                yield resource
            finally:
                release(resource)

        with managed_resource() as r:
            use(r)
    """
    def helper(*args, **kwargs):
        return _GeneratorContextManager(func, args, kwargs)

    # Copy function metadata
    helper.__name__ = func.__name__
    helper.__doc__ = func.__doc__

    return helper


# ============================================
# closing Context Manager
# ============================================

class closing:
    """Context manager to ensure .close() is called.

    Useful for objects that have a close() method but don't
    support the context manager protocol.

    Example:
        with closing(urlopen('http://example.com')) as page:
            data = page.read()
    """

    def __init__(self, thing):
        """Initialize with object to close."""
        self.thing = thing

    def __enter__(self):
        """Return the wrapped object."""
        return self.thing

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Call close() on the wrapped object."""
        if hasattr(self.thing, 'close'):
            self.thing.close()
        return False

    def __repr__(self) -> str:
        return "closing(" + repr(self.thing) + ")"


# ============================================
# suppress Context Manager
# ============================================

class suppress:
    """Context manager to suppress specified exceptions.

    After the with block, exceptions of the specified type(s)
    will be silently ignored.

    Example:
        with suppress(FileNotFoundError):
            os.remove('nonexistent.txt')
        # No exception raised if file doesn't exist

        with suppress(KeyError, ValueError):
            del data[key]
    """

    def __init__(self, *exceptions):
        """Initialize with exception types to suppress.

        Args:
            *exceptions: Exception classes to suppress
        """
        self.exceptions = exceptions

    def __enter__(self):
        """Enter context."""
        return None

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Exit context, suppressing specified exceptions."""
        if exc_type is None:
            return False

        for exc in self.exceptions:
            if isinstance(exc_val, exc):
                return True  # Suppress this exception

        return False  # Don't suppress other exceptions

    def __repr__(self) -> str:
        exc_names = []
        for exc in self.exceptions:
            if hasattr(exc, '__name__'):
                exc_names.append(exc.__name__)
            else:
                exc_names.append(str(exc))
        return "suppress(" + ", ".join(exc_names) + ")"


# ============================================
# redirect_stdout Context Manager
# ============================================

class redirect_stdout:
    """Context manager to redirect stdout.

    Example:
        import io
        f = io.StringIO()
        with redirect_stdout(f):
            print("This goes to f, not console")
        output = f.getvalue()
    """

    def __init__(self, new_target):
        """Initialize with new stdout target.

        Args:
            new_target: Object with write() method
        """
        self.new_target = new_target
        self._old_stdout = None

    def __enter__(self):
        """Redirect stdout to new target."""
        # Store reference to original stdout
        import sys
        self._old_stdout = sys.stdout
        sys.stdout = self.new_target
        return self.new_target

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Restore original stdout."""
        import sys
        if self._old_stdout is not None:
            sys.stdout = self._old_stdout
        return False

    def __repr__(self) -> str:
        return "redirect_stdout(" + repr(self.new_target) + ")"


# ============================================
# redirect_stderr Context Manager
# ============================================

class redirect_stderr:
    """Context manager to redirect stderr.

    Example:
        import io
        f = io.StringIO()
        with redirect_stderr(f):
            print("Error message", file=sys.stderr)
        errors = f.getvalue()
    """

    def __init__(self, new_target):
        """Initialize with new stderr target.

        Args:
            new_target: Object with write() method
        """
        self.new_target = new_target
        self._old_stderr = None

    def __enter__(self):
        """Redirect stderr to new target."""
        import sys
        self._old_stderr = sys.stderr
        sys.stderr = self.new_target
        return self.new_target

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Restore original stderr."""
        import sys
        if self._old_stderr is not None:
            sys.stderr = self._old_stderr
        return False

    def __repr__(self) -> str:
        return "redirect_stderr(" + repr(self.new_target) + ")"


# ============================================
# nullcontext
# ============================================

class nullcontext:
    """Context manager that does nothing.

    Useful as a placeholder when a context manager is optional.

    Example:
        cm = open(filename) if filename else nullcontext(default_value)
        with cm as f:
            process(f)
    """

    def __init__(self, enter_result=None):
        """Initialize with optional result value.

        Args:
            enter_result: Value to return from __enter__
        """
        self.enter_result = enter_result

    def __enter__(self):
        """Return the stored result."""
        return self.enter_result

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Do nothing."""
        return False

    def __repr__(self) -> str:
        return "nullcontext(" + repr(self.enter_result) + ")"


# ============================================
# ExitStack
# ============================================

class ExitStack:
    """Stack of context managers and cleanup callbacks.

    Allows dynamic building of context managers at runtime.

    Example:
        with ExitStack() as stack:
            files = [stack.enter_context(open(f)) for f in filenames]
            # All files closed when ExitStack exits
    """

    def __init__(self):
        """Initialize empty exit stack."""
        self._exit_callbacks = []
        self._pushed = []

    def __enter__(self):
        """Enter context."""
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Exit context, calling all callbacks in reverse order."""
        # Call callbacks in reverse order (LIFO)
        success = True
        while self._exit_callbacks:
            callback = self._exit_callbacks.pop()
            try:
                result = callback(exc_type, exc_val, exc_tb)
                if result:
                    success = True
            except Exception:
                success = False

        # Also close pushed context managers
        while self._pushed:
            cm = self._pushed.pop()
            try:
                result = cm.__exit__(exc_type, exc_val, exc_tb)
                if result:
                    success = True
            except Exception:
                success = False

        return success

    def push(self, exit_callback):
        """Push a callback onto the stack.

        Callback signature: callback(exc_type, exc_val, exc_tb)
        Returns True to suppress exception, False to propagate.

        Args:
            exit_callback: Callback function

        Returns:
            The callback (for chaining)
        """
        self._exit_callbacks.append(exit_callback)
        return exit_callback

    def pop_all(self):
        """Pop all callbacks without calling them.

        Returns new ExitStack with all callbacks.
        """
        new_stack = ExitStack()
        new_stack._exit_callbacks = self._exit_callbacks
        new_stack._pushed = self._pushed
        self._exit_callbacks = []
        self._pushed = []
        return new_stack

    def callback(self, callback, *args, **kwargs):
        """Push a callback that takes no exception arguments.

        Args:
            callback: Function to call on exit
            *args: Arguments for callback
            **kwargs: Keyword arguments for callback

        Returns:
            The callback
        """
        def exit_callback(exc_type, exc_val, exc_tb):
            callback(*args, **kwargs)
            return False

        self.push(exit_callback)
        return callback

    def enter_context(self, cm):
        """Enter a context manager and push its __exit__.

        Args:
            cm: Context manager to enter

        Returns:
            Result of cm.__enter__()
        """
        result = cm.__enter__()
        self._pushed.append(cm)
        return result

    def close(self):
        """Immediately close the stack.

        Calls all callbacks and context managers.
        """
        self.__exit__(None, None, None)


# ============================================
# Async Context Managers (for future async support)
# ============================================

class AsyncExitStack:
    """Async version of ExitStack.

    For use with async context managers and coroutines.
    """

    def __init__(self):
        """Initialize empty async exit stack."""
        self._exit_callbacks = []
        self._pushed = []

    async def __aenter__(self):
        """Enter async context."""
        return self

    async def __aexit__(self, exc_type, exc_val, exc_tb):
        """Exit async context."""
        success = True
        while self._exit_callbacks:
            callback = self._exit_callbacks.pop()
            try:
                result = await callback(exc_type, exc_val, exc_tb)
                if result:
                    success = True
            except Exception:
                success = False

        while self._pushed:
            cm = self._pushed.pop()
            try:
                result = await cm.__aexit__(exc_type, exc_val, exc_tb)
                if result:
                    success = True
            except Exception:
                success = False

        return success

    def push_async_exit(self, exit_callback):
        """Push async callback onto stack."""
        self._exit_callbacks.append(exit_callback)
        return exit_callback

    def push_async_callback(self, callback, *args, **kwargs):
        """Push async callback without exception arguments."""
        async def exit_callback(exc_type, exc_val, exc_tb):
            await callback(*args, **kwargs)
            return False

        self.push_async_exit(exit_callback)
        return callback

    async def enter_async_context(self, cm):
        """Enter async context manager."""
        result = await cm.__aenter__()
        self._pushed.append(cm)
        return result

    async def close(self):
        """Close async stack."""
        await self.__aexit__(None, None, None)


def asynccontextmanager(func):
    """Async version of contextmanager decorator.

    For use with async generator functions.
    """
    class _AsyncGeneratorContextManager:
        def __init__(self, func, args, kwargs):
            self.gen = func(*args, **kwargs)

        async def __aenter__(self):
            try:
                return await self.gen.__anext__()
            except StopAsyncIteration:
                raise ValueError("generator didn't yield")

        async def __aexit__(self, exc_type, exc_val, exc_tb):
            if exc_type is None:
                try:
                    await self.gen.__anext__()
                except StopAsyncIteration:
                    return False
                else:
                    raise ValueError("generator didn't stop")
            else:
                try:
                    await self.gen.athrow(exc_type, exc_val, exc_tb)
                except StopAsyncIteration:
                    return True
                except Exception as e:
                    if e is exc_val:
                        return False
                    raise
                else:
                    raise ValueError("generator didn't stop after throw()")

    def helper(*args, **kwargs):
        return _AsyncGeneratorContextManager(func, args, kwargs)

    helper.__name__ = func.__name__
    helper.__doc__ = func.__doc__

    return helper


# ============================================
# Helper Functions
# ============================================

def _create_cm_from_methods(enter_method, exit_method):
    """Create context manager from enter/exit methods."""
    class _ContextManager:
        def __init__(self, enter, exit):
            self._enter = enter
            self._exit = exit

        def __enter__(self):
            return self._enter()

        def __exit__(self, exc_type, exc_val, exc_tb):
            return self._exit(exc_type, exc_val, exc_tb)

    return _ContextManager(enter_method, exit_method)


# ============================================
# Examples and Tests
# ============================================

def _test():
    """Test contextlib functionality."""
    print("Testing contextlib module...")

    # Test contextmanager
    @contextmanager
    def managed_list():
        lst = []
        print("  Created list")
        try:
            yield lst
        finally:
            print("  Cleaned up list")

    with managed_list() as lst:
        lst.append(1)
        lst.append(2)
        print("  List contents: " + str(lst))

    # Test closing
    import io
    sio = io.StringIO()
    with closing(sio) as f:
        f.write("test")
    print("  closing() test: " + ("closed" if sio.is_closed() else "open"))

    # Test suppress
    with suppress(ValueError):
        int("not a number")  # Would raise ValueError
    print("  suppress() caught ValueError")

    # Test nullcontext
    with nullcontext(42) as value:
        print("  nullcontext returned: " + str(value))

    # Test ExitStack
    with ExitStack() as stack:
        f1 = stack.enter_context(io.StringIO())
        f1.write("test1")
        stack.callback(lambda: print("  ExitStack callback called"))

    print("contextlib tests completed!")
