# ============================================
# Convenience Functions
# ============================================

def random_int(min_val: i64, max_val: i64) -> i64:
    """Generate a random integer in range [min_val, max_val]."""
    return randint(min_val, max_val)

def random_float(min_val: f64, max_val: f64) -> f64:
    """Generate a random float in range [min_val, max_val]."""
    return uniform(min_val, max_val)

def random_bool(probability: f64 = 0.5) -> bool:
    """Generate a random boolean with given probability of True."""
    return random() < probability

def random_element(items: [i64]):
    """Pick a random element from a list."""
    return choice(items)

def random_subset(items: [i64], size: i64) -> [i64]:
    """Pick a random subset of given size."""
    return sample(items, size)

def shuffle_copy(items: [i64]) -> [i64]:
    """Return a shuffled copy of the list."""
    result = items.copy()
    shuffle(result)
    return result
