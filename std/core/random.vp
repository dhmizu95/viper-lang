# Alternative Generators
# ============================================

class SystemRandom:
    """Random number generator using os.urandom()."""
    
    def random(self) -> float:
        """Return a random float in [0.0, 1.0)."""
        # Implemented in runtime
        return 0.0
    
    def randint(self, a: int, b: int) -> int:
        """Return a random integer in [a, b]."""
        return 0
    
    def choice(self, seq: [int]):
        """Return a random element from seq."""
        return 0
    
    def shuffle(self, x: [int]):
        """Shuffle x in place."""
        pass
    
    def sample(self, population: [int], k: int) -> [int]:
        """Return k unique elements from population."""
        return []

