# Viper Standard Library - pprint module
# Pretty-printing for data structures

# Module metadata
__name__ = "pprint"
__version__ = "0.4.7"

# ============================================
# PrettyPrinter Class
# ============================================

class PrettyPrinter:
    """Pretty-printer for data structures.

    Formats data structures for readable output.

    Args:
        indent: Indentation per level (default 1)
        width: Maximum line width (default 80)
        depth: Maximum nesting depth (None = unlimited)
        stream: Output stream (None = stdout)
        compact: Use compact representation
        sort_dicts: Sort dictionary keys

    Example:
        pp = PrettyPrinter(indent=2, width=60)
        pp.pprint(data)
    """

    def __init__(self, indent=1, width=80, depth=None,
                 stream=None, compact=False, sort_dicts=True):
        self.indent = indent
        self.width = width
        self.depth = depth
        self.stream = stream
        self.compact = compact
        self.sort_dicts = sort_dicts

    def pprint(self, object):
        """Pretty-print object."""
        self._format(object, self.stream, 0, 0, {})

    def pformat(self, object) -> str:
        """Format object as string."""
        import io
        output = io.StringIO()
        self._format(object, output, 0, 0, {})
        return output.getvalue()

    def isreadable(self, object) -> bool:
        """Check if object can be read in one line."""
        s = self.pformat(object)
        return len(s) <= self.width and '\n' not in s

    def isrecursive(self, object) -> bool:
        """Check if object contains recursive reference."""
        return self._is_recursive(object, [])

    def _is_recursive(self, obj, seen) -> bool:
        """Internal recursive check."""
        obj_id = id(obj)
        if obj_id in seen:
            return True

        if isinstance(obj, dict):
            seen.append(obj_id)
            for key, value in obj.items():
                if self._is_recursive(value, seen):
                    return True
            seen.pop()
        elif isinstance(obj, (list, tuple)):
            seen.append(obj_id)
            for item in obj:
                if self._is_recursive(item, seen):
                    return True
            seen.pop()

        return False

    def _format(self, object, stream, indent, allowance, context):
        """Format object to stream."""
        # Check depth
        if self.depth is not None:
            current_depth = len(context)
            if current_depth >= self.depth:
                stream.write("...")
                return

        # Handle different types
        if isinstance(object, dict):
            self._format_dict(object, stream, indent, allowance, context)
        elif isinstance(object, (list, tuple)):
            self._format_list(object, stream, indent, allowance, context)
        elif isinstance(object, str):
            stream.write(repr(object))
        elif isinstance(object, (int, float, bool)):
            stream.write(str(object))
        elif object is None:
            stream.write("None")
        else:
            stream.write(repr(object))

    def _format_dict(self, d: dict, stream, indent, allowance, context):
        """Format dictionary."""
        if len(d) == 0:
            stream.write("{}")
            return

        # Check for recursive reference
        obj_id = id(d)
        if obj_id in context:
            stream.write("...")
            return

        context[obj_id] = True

        # Get keys
        if self.sort_dicts:
            keys = sorted(d.keys())
        else:
            keys = list(d.keys())

        # Try single-line format
        items = []
        for key in keys:
            items.append(repr(key) + ": " + repr(d[key]))

        single_line = "{ " + ", ".join(items) + " }"
        if len(single_line) <= self.width - indent:
            stream.write(single_line)
            del context[obj_id]
            return

        # Multi-line format
        stream.write("{\n")
        new_indent = indent + self.indent

        for i, key in enumerate(keys):
            stream.write(" " * new_indent)
            stream.write(repr(key))
            stream.write(": ")
            self._format(d[key], stream, new_indent + 2,
                        allowance + 1 if i < len(keys) - 1 else allowance,
                        context)
            if i < len(keys) - 1:
                stream.write(",")
            stream.write("\n")

        stream.write(" " * indent + "}")
        del context[obj_id]

    def _format_list(self, lst, stream, indent, allowance, context):
        """Format list or tuple."""
        if len(lst) == 0:
            if isinstance(lst, tuple):
                stream.write("()")
            else:
                stream.write("[]")
            return

        # Check for recursive reference
        obj_id = id(lst)
        if obj_id in context:
            stream.write("...")
            return

        context[obj_id] = True

        # Try single-line format
        items = [repr(item) for item in lst]
        if isinstance(lst, tuple):
            single_line = "(" + ", ".join(items)
            if len(lst) == 1:
                single_line = single_line + ",)"
            else:
                single_line = single_line + ")"
        else:
            single_line = "[" + ", ".join(items) + "]"

        if len(single_line) <= self.width - indent:
            stream.write(single_line)
            del context[obj_id]
            return

        # Multi-line format
        if isinstance(lst, tuple):
            stream.write("(\n")
            open_bracket = ""
            close_bracket = ")"
        else:
            stream.write("[\n")
            open_bracket = ""
            close_bracket = "]"

        new_indent = indent + self.indent

        for i, item in enumerate(lst):
            stream.write(" " * new_indent)
            self._format(item, stream, new_indent,
                        allowance + 1 if i < len(lst) - 1 else allowance,
                        context)
            stream.write(",\n")

        stream.write(" " * indent + close_bracket)
        del context[obj_id]


# ============================================
# Convenience Functions
# ============================================

def pprint(object, stream=None, indent=1, width=80, depth=None,
           compact=False, sort_dicts=True):
    """Pretty-print object.

    Args:
        object: Object to print
        stream: Output stream (None = stdout)
        indent: Indentation per level
        width: Maximum line width
        depth: Maximum nesting depth
        compact: Use compact representation
        sort_dicts: Sort dictionary keys
    """
    pp = PrettyPrinter(indent=indent, width=width, depth=depth,
                       stream=stream, compact=compact, sort_dicts=sort_dicts)
    pp.pprint(object)


def pformat(object, indent=1, width=80, depth=None,
            compact=False, sort_dicts=True) -> str:
    """Format object as pretty string.

    Args:
        object: Object to format
        indent: Indentation per level
        width: Maximum line width
        depth: Maximum nesting depth
        compact: Use compact representation
        sort_dicts: Sort dictionary keys

    Returns:
        Formatted string
    """
    pp = PrettyPrinter(indent=indent, width=width, depth=depth,
                       compact=compact, sort_dicts=sort_dicts)
    return pp.pformat(object)


def isreadable(object) -> bool:
    """Check if object fits in one line."""
    pp = PrettyPrinter()
    return pp.isreadable(object)


def isrecursive(object) -> bool:
    """Check if object has recursive references."""
    pp = PrettyPrinter()
    return pp.isrecursive(object)


# ============================================
# Helper Functions
# ============================================

def _safe_repr(object, context, maxlevels, level) -> tuple:
    """Safely get repr with recursion limit."""
    obj_id = id(object)
    if obj_id in context:
        return ("...", True, False)

    if level >= maxlevels:
        return ("...", True, False)

    context[obj_id] = True

    try:
        if isinstance(object, dict):
            return _format_dict_repr(object, context, maxlevels, level + 1)
        elif isinstance(object, (list, tuple)):
            return _format_list_repr(object, context, maxlevels, level + 1)
        else:
            return (repr(object), True, False)
    finally:
        del context[obj_id]


def _format_dict_repr(d: dict, context, maxlevels, level) -> tuple:
    """Format dict repr with limits."""
    if len(d) == 0:
        return ("{}", True, True)

    items = []
    readable = True
    recursive = False

    for key, value in d.items():
        key_repr = repr(key)
        value_repr, val_readable, val_recursive = _safe_repr(
            value, context, maxlevels, level)
        items.append(key_repr + ": " + value_repr)
        readable = readable and val_readable
        recursive = recursive or val_recursive

    return ("{" + ", ".join(items) + "}", readable, recursive)


def _format_list_repr(lst, context, maxlevels, level) -> tuple:
    """Format list repr with limits."""
    if len(lst) == 0:
        if isinstance(lst, tuple):
            return ("()", True, True)
        return ("[]", True, True)

    items = []
    readable = True
    recursive = False

    for item in lst:
        item_repr, item_readable, item_recursive = _safe_repr(
            item, context, maxlevels, level)
        items.append(item_repr)
        readable = readable and item_readable
        recursive = recursive or item_recursive

    if isinstance(lst, tuple):
        if len(lst) == 1:
            return ("(" + items[0] + ",)", readable, recursive)
        return ("(" + ", ".join(items) + ")", readable, recursive)

    return ("[" + ", ".join(items) + "]", readable, recursive)


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test pprint functionality."""
    print("Testing pprint module...")

    # Test simple data
    print("  Testing simple data...")
    data = [1, 2, 3, 4, 5]
    print("    List:")
    pprint(data)

    # Test nested data
    print("  Testing nested data...")
    nested = {
        'name': 'test',
        'values': [1, 2, 3],
        'nested': {
            'a': 1,
            'b': 2
        }
    }
    pprint(nested)

    # Test pformat
    print("  Testing pformat...")
    formatted = pformat(nested, width=40)
    print("    Formatted:")
    for line in formatted.split('\n'):
        print("      " + line)

    # Test isreadable
    print("  Testing isreadable...")
    simple = [1, 2, 3]
    complex_data = {'a': 1, 'b': 2, 'c': 3, 'd': 4, 'e': 5, 'f': 6}
    print("    [1, 2, 3] readable: " + str(isreadable(simple)))
    print("    Large dict readable: " + str(isreadable(complex_data)))

    # Test with custom width
    print("  Testing custom width...")
    data = {'a': 1, 'b': 2, 'c': 3, 'd': 4, 'e': 5}
    print("    Width 20:")
    pprint(data, width=20)

    # Test depth limit
    print("  Testing depth limit...")
    deep = {'a': {'b': {'c': {'d': 1}}}}
    pprint(deep, depth=2)

    # Test recursive structure
    print("  Testing recursive structure...")
    recursive_list = [1, 2]
    recursive_list.append(recursive_list)
    print("    isrecursive: " + str(isrecursive(recursive_list)))
    pprint(recursive_list)

    # Test sorted dicts
    print("  Testing sorted dicts...")
    unsorted = {'z': 1, 'a': 2, 'm': 3}
    print("    Sorted:")
    pprint(unsorted, sort_dicts=True)
    print("    Unsorted:")
    pprint(unsorted, sort_dicts=False)

    print("pprint tests completed!")
