# Viper Standard Library - dataclasses module
# Automatic class generation for data containers

# Module metadata
__name__ = "dataclasses"
__version__ = "0.4.7"

# ============================================
# Field Definition
# ============================================

class Field:
    """Represents a field in a dataclass."""

    def __init__(self, default=None, default_factory=None, repr=True,
                 hash=None, compare=True, metadata=None):
        """Define a field with optional parameters.

        Args:
            default: Default value for the field
            default_factory: Zero-argument function to create default value
            repr: Include field in __repr__
            hash: Include field in __hash__ (None = use compare value)
            compare: Include field in comparison methods
            metadata: Dict for field metadata
        """
        self.default = default
        self.default_factory = default_factory
        self.repr = repr
        self.hash = hash
        self.compare = compare
        self.metadata = metadata if metadata else {}
        self.name = None
        self.type = None

    def __repr__(self) -> str:
        return "Field(default=" + repr(self.default) + ",default_factory=" + repr(self.default_factory) + ")"


# Sentinel value for missing default
_MISSING = object()


def field(*, default=_MISSING, default_factory=_MISSING, repr=True,
          hash=None, compare=True, metadata=None):
    """Define a field with custom parameters.

    Use this when you need to customize field behavior beyond
    simple type annotations.

    Args:
        default: Default value (cannot be mutable like list or dict)
        default_factory: Zero-argument function to create default value
        repr: Include in __repr__ (default True)
        hash: Include in __hash__ (default None = use compare value)
        compare: Include in comparison methods (default True)
        metadata: Dict for arbitrary metadata (default {})

    Returns:
        Field object

    Example:
        @dataclass
        class Item:
            name: str
            tags: list = field(default_factory=list)
    """
    if default is not _MISSING and default_factory is not _MISSING:
        raise ValueError("cannot specify both default and default_factory")

    return Field(default, default_factory, repr, hash, compare, metadata)


# ============================================
# Dataclass Decorator
# ============================================

def dataclass(cls=None, /, *, init=True, repr=True, eq=True,
              order=False, unsafe_hash=False, frozen=False):
    """Decorator to add special methods to a class.

    Automatically generates: __init__, __repr__, __eq__,
    and optionally comparison methods and __hash__.

    Args:
        cls: Class to decorate (positional, optional)
        init: Generate __init__ (default True)
        repr: Generate __repr__ (default True)
        eq: Generate __eq__ (default True)
        order: Generate __lt__, __le__, __gt__, __ge__ (default False)
        unsafe_hash: Generate __hash__ (default False)
        frozen: Make instances immutable (default False)

    Returns:
        Decorated class

    Example:
        @dataclass
        class Point:
            x: int
            y: int
            z: int = 0

        @dataclass(order=True)
        class Student:
            grade: int
            name: str
    """
    def wrap(cls):
        return _process_class(cls, init, repr, eq, order, unsafe_hash, frozen)

    # Handle both @dataclass and @dataclass() syntax
    if cls is None:
        return wrap
    return wrap(cls)


def _process_class(cls, init, repr, eq, order, unsafe_hash, frozen):
    """Process a class and add generated methods."""
    # Get field information from annotations
    fields_dict = {}
    if hasattr(cls, '__annotations__'):
        for name, type_ in cls.__annotations__.items():
            # Check for Field object as class attribute
            default = _MISSING
            default_factory = _MISSING
            field_repr = True
            field_compare = True
            field_hash = None
            field_metadata = {}

            if hasattr(cls, name):
                value = getattr(cls, name)
                if isinstance(value, Field):
                    default = value.default
                    default_factory = value.default_factory
                    field_repr = value.repr
                    field_compare = value.compare
                    field_hash = value.hash
                    field_metadata = value.metadata
                    # Remove Field object from class
                    delattr(cls, name)

            fields_dict[name] = {
                'name': name,
                'type': type_,
                'default': default,
                'default_factory': default_factory,
                'repr': field_repr,
                'compare': field_compare,
                'hash': field_hash,
                'metadata': field_metadata
            }

    # Store fields in class
    cls.__dataclass_fields__ = fields_dict
    cls.__dataclass_params__ = {
        'init': init,
        'repr': repr,
        'eq': eq,
        'order': order,
        'unsafe_hash': unsafe_hash,
        'frozen': frozen
    }

    # Generate __init__
    if init:
        cls.__init__ = _make_init(fields_dict, frozen)

    # Generate __repr__
    if repr:
        cls.__repr__ = _make_repr(fields_dict)

    # Generate __eq__
    if eq:
        cls.__eq__ = _make_eq(fields_dict)

    # Generate comparison methods
    if order:
        cls.__lt__ = _make_lt(fields_dict)
        cls.__le__ = _make_le(fields_dict)
        cls.__gt__ = _make_gt(fields_dict)
        cls.__ge__ = _make_ge(fields_dict)

    # Generate __hash__
    if unsafe_hash or (eq and frozen and not hasattr(cls, '__hash__')):
        cls.__hash__ = _make_hash(fields_dict, unsafe_hash)

    # Add __match_args__ for pattern matching
    field_names = [f for f in fields_dict if fields_dict[f]['repr']]
    cls.__match_args__ = tuple(field_names)

    # Add __slots__ if frozen (optional optimization)
    # if frozen:
    #     cls.__slots__ = ()

    return cls


def _make_init(fields_dict, frozen):
    """Create __init__ method."""
    def __init__(self, *args, **kwargs):
        # Process positional args
        field_names = list(fields_dict.keys())
        for i, value in enumerate(args):
            if i < len(field_names):
                name = field_names[i]
                setattr(self, name, value)

        # Process keyword args
        for name in field_names[len(args):]:
            field_info = fields_dict[name]
            if name in kwargs:
                setattr(self, name, kwargs[name])
            elif field_info['default_factory'] is not _MISSING:
                # Call factory function
                setattr(self, name, field_info['default_factory']())
            elif field_info['default'] is not _MISSING:
                setattr(self, name, field_info['default'])

        # Check for missing required fields
        for name in field_names:
            if not hasattr(self, name):
                field_info = fields_dict[name]
                if field_info['default'] is _MISSING and field_info['default_factory'] is _MISSING:
                    # Check if it was provided as kwarg
                    if name not in kwargs:
                        raise TypeError("Missing required argument: " + name)

    return __init__


def _make_repr(fields_dict):
    """Create __repr__ method."""
    def __repr__(self):
        parts = []
        for name in fields_dict:
            if fields_dict[name]['repr']:
                value = getattr(self, name, None)
                parts.append(name + "=" + repr(value))
        return type(self).__name__ + "(" + ", ".join(parts) + ")"

    return __repr__


def _make_eq(fields_dict):
    """Create __eq__ method."""
    def __eq__(self, other):
        if not isinstance(other, type(self)):
            return False
        for name in fields_dict:
            if fields_dict[name]['compare']:
                if getattr(self, name, None) != getattr(other, name, None):
                    return False
        return True

    return __eq__


def _make_lt(fields_dict):
    """Create __lt__ method."""
    def __lt__(self, other):
        if not isinstance(other, type(self)):
            return NotImplemented
        for name in fields_dict:
            if fields_dict[name]['compare']:
                self_val = getattr(self, name, None)
                other_val = getattr(other, name, None)
                if self_val != other_val:
                    return self_val < other_val
        return False

    return __lt__


def _make_le(fields_dict):
    """Create __le__ method."""
    def __le__(self, other):
        if not isinstance(other, type(self)):
            return NotImplemented
        for name in fields_dict:
            if fields_dict[name]['compare']:
                self_val = getattr(self, name, None)
                other_val = getattr(other, name, None)
                if self_val != other_val:
                    return self_val < other_val
        return True

    return __le__


def _make_gt(fields_dict):
    """Create __gt__ method."""
    def __gt__(self, other):
        if not isinstance(other, type(self)):
            return NotImplemented
        for name in fields_dict:
            if fields_dict[name]['compare']:
                self_val = getattr(self, name, None)
                other_val = getattr(other, name, None)
                if self_val != other_val:
                    return self_val > other_val
        return False

    return __gt__


def _make_ge(fields_dict):
    """Create __ge__ method."""
    def __ge__(self, other):
        if not isinstance(other, type(self)):
            return NotImplemented
        for name in fields_dict:
            if fields_dict[name]['compare']:
                self_val = getattr(self, name, None)
                other_val = getattr(other, name, None)
                if self_val != other_val:
                    return self_val > other_val
        return True

    return __ge__


def _make_hash(fields_dict, unsafe_hash):
    """Create __hash__ method."""
    def __hash__(self):
        hash_values = []
        for name in fields_dict:
            field_info = fields_dict[name]
            include = field_info['hash']
            if include is None:
                include = field_info['compare']
            if include:
                value = getattr(self, name, None)
                hash_values.append(hash(value))
        return hash(tuple(hash_values))

    return __hash__


# ============================================
# Helper Functions
# ============================================

def fields(class_or_instance):
    """Get tuple of Field objects for a dataclass.

    Args:
        class_or_instance: Dataclass class or instance

    Returns:
        Tuple of Field objects
    """
    if hasattr(class_or_instance, '__dataclass_fields__'):
        cls = class_or_instance
        if not isinstance(class_or_instance, type):
            cls = type(class_or_instance)
        return tuple(cls.__dataclass_fields__.values())
    raise TypeError("Not a dataclass: " + str(class_or_instance))


def asdict(obj):
    """Convert dataclass instance to dictionary.

    Recursively converts nested dataclasses.

    Args:
        obj: Dataclass instance

    Returns:
        Dictionary mapping field names to values
    """
    if not hasattr(obj, '__dataclass_fields__'):
        raise TypeError("Not a dataclass instance: " + str(obj))

    result = {}
    for name in obj.__dataclass_fields__:
        value = getattr(obj, name)
        if hasattr(value, '__dataclass_fields__'):
            result[name] = asdict(value)
        elif isinstance(value, (list, tuple)):
            new_items = []
            for item in value:
                if hasattr(item, '__dataclass_fields__'):
                    new_items.append(asdict(item))
                else:
                    new_items.append(item)
            result[name] = type(value)(new_items)
        elif isinstance(value, dict):
            new_dict = {}
            for k, v in value.items():
                if hasattr(v, '__dataclass_fields__'):
                    new_dict[k] = asdict(v)
                else:
                    new_dict[k] = v
            result[name] = new_dict
        else:
            result[name] = value

    return result


def astuple(obj):
    """Convert dataclass instance to tuple.

    Recursively converts nested dataclasses.

    Args:
        obj: Dataclass instance

    Returns:
        Tuple of field values
    """
    if not hasattr(obj, '__dataclass_fields__'):
        raise TypeError("Not a dataclass instance: " + str(obj))

    result = []
    for name in obj.__dataclass_fields__:
        value = getattr(obj, name)
        if hasattr(value, '__dataclass_fields__'):
            result.append(astuple(value))
        elif isinstance(value, (list, tuple)):
            new_items = []
            for item in value:
                if hasattr(item, '__dataclass_fields__'):
                    new_items.append(astuple(item))
                else:
                    new_items.append(item)
            result.append(type(value)(new_items))
        elif isinstance(value, dict):
            new_dict = {}
            for k, v in value.items():
                if hasattr(v, '__dataclass_fields__'):
                    new_dict[k] = astuple(v)
                else:
                    new_dict[k] = v
            result.append(new_dict)
        else:
            result.append(value)

    return tuple(result)


def make_dataclass(cls_name, fields, *, bases=(), namespace=None,
                   init=True, repr=True, eq=True, order=False,
                   unsafe_hash=False, frozen=False):
    """Create a new dataclass dynamically.

    Args:
        cls_name: Name for the new class
        fields: List of (name, type) or (name, type, Field) tuples
        bases: Base classes
        namespace: Optional namespace dict
        init, repr, eq, order, unsafe_hash, frozen: dataclass options

    Returns:
        New dataclass
    """
    # Build namespace
    if namespace is None:
        namespace = {}

    # Process fields
    annotations = {}
    for field_def in fields:
        if len(field_def) == 2:
            name, type_ = field_def
            namespace[name] = None
        else:
            name, type_, field_obj = field_def
            namespace[name] = field_obj
        annotations[name] = type_

    namespace['__annotations__'] = annotations

    # Create class
    cls = type(cls_name, bases, namespace)

    # Apply dataclass decorator
    return _process_class(cls, init, repr, eq, order, unsafe_hash, frozen)


def replace(obj, /, **changes):
    """Create new dataclass instance with replaced fields.

    Args:
        obj: Original dataclass instance
        **changes: Field values to replace

    Returns:
        New instance with updated values
    """
    if not hasattr(obj, '__dataclass_fields__'):
        raise TypeError("Not a dataclass instance: " + str(obj))

    # Get current values
    kwargs = {}
    for name in obj.__dataclass_fields__:
        kwargs[name] = getattr(obj, name)

    # Apply changes
    for name, value in changes.items():
        if name not in obj.__dataclass_fields__:
            raise ValueError("Unknown field: " + name)
        kwargs[name] = value

    # Create new instance
    return type(obj)(**kwargs)


def is_dataclass(obj) -> bool:
    """Check if object is a dataclass or dataclass instance.

    Args:
        obj: Object to check

    Returns:
        True if dataclass, False otherwise
    """
    return hasattr(obj, '__dataclass_fields__')


# ============================================
# Special Classes
# ============================================

class InitVar:
    """Descriptor for init-only fields.

    Fields wrapped in InitVar are only used in __init__
    and not stored as instance attributes.
    """

    def __init__(self, type_):
        self.type = type_
        self.name = None

    def __get__(self, obj, objtype=None):
        if obj is None:
            return self
        raise AttributeError("InitVar cannot be read")

    def __set__(self, obj, value):
        pass  # Value is only used in __init__

    def __delete__(self, obj):
        pass


# ============================================
# Constants
# ============================================

# Marker for missing default values
MISSING = _MISSING

# Field comparison markers
FIELD_COMPARE = True
FIELD_NO_COMPARE = False


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test dataclasses functionality."""
    print("Testing dataclasses module...")

    # Basic dataclass
    @dataclass
    class Point:
        x: int
        y: int
        z: int = 0

    p1 = Point(1, 2)
    p2 = Point(1, 2, 0)
    p3 = Point(3, 4, 5)

    print("  Point(1, 2): " + repr(p1))
    print("  Point(1, 2, 0): " + repr(p2))
    print("  p1 == p2: " + str(p1 == p2))
    print("  p1 == p3: " + str(p1 == p3))

    # Dataclass with order
    @dataclass(order=True)
    class Student:
        grade: int
        name: str

    s1 = Student(10, "Alice")
    s2 = Student(9, "Bob")
    print("  s1 < s2: " + str(s1 < s2))  # False, grade 10 > 9

    # Dataclass with default_factory
    @dataclass
    class Item:
        name: str
        tags: list = field(default_factory=list)

    item = Item("widget")
    item.tags.append("sale")
    print("  Item with tags: " + repr(item))

    # asdict
    d = asdict(p3)
    print("  asdict(p3): " + str(d))

    # replace
    p4 = replace(p1, x=10)
    print("  replace(p1, x=10): " + repr(p4))

    # is_dataclass
    print("  is_dataclass(Point): " + str(is_dataclass(Point)))
    print("  is_dataclass(p1): " + str(is_dataclass(p1)))

    print("dataclasses tests completed!")
