# Viper Standard Library - abc module
# Abstract Base Classes

# Module metadata
__name__ = "abc"
__version__ = "0.4.7"

# ============================================
# ABCMeta Metaclass
# ============================================

class ABCMeta(type):
    """Metaclass for defining Abstract Base Classes.

    Classes using this metaclass can define abstract methods
    that must be implemented by subclasses.

    Example:
        class MyABC(metaclass=ABCMeta):
            @abstractmethod
            def method(self):
                pass
    """

    def __new__(mcs, name, bases, namespace, **kwargs):
        cls = type.__new__(mcs, name, bases, namespace, **kwargs)

        # Track abstract methods
        cls._abstract_methods_ = set()

        for key, value in namespace.items():
            if hasattr(value, '__isabstractmethod__'):
                if value.__isabstractmethod__:
                    cls._abstract_methods_.add(key)

        return cls

    def __call__(cls, *args, **kwargs):
        # Check for unimplemented abstract methods
        if hasattr(cls, '_abstract_methods_'):
            unimplemented = set()
            for method_name in cls._abstract_methods_:
                method = getattr(cls, method_name, None)
                if method is None or hasattr(method, '__isabstractmethod__'):
                    unimplemented.add(method_name)

            if unimplemented:
                raise TypeError("Can't instantiate abstract class " +
                               cls.__name__ + " with abstract methods: " +
                               ", ".join(unimplemented))

        return type.__call__(cls, *args, **kwargs)


# ============================================
# ABC Base Class
# ============================================

class ABC:
    """Helper base class for Abstract Base Classes.

    Use this as a base class to get ABCMeta automatically.

    Example:
        class MyABC(ABC):
            @abstractmethod
            def method(self):
                pass
    """

    __metaclass__ = ABCMeta


# ============================================
# Abstract Method Decorator
# ============================================

def abstractmethod(func):
    """Decorator to mark method as abstract.

    Abstract methods must be implemented by concrete subclasses.

    Args:
        func: Function to mark as abstract

    Returns:
        Function with __isabstractmethod__ = True

    Example:
        class Shape(ABC):
            @abstractmethod
            def area(self):
                pass
    """
    func.__isabstractmethod__ = True
    return func


def abstractclassmethod(func):
    """Decorator to mark classmethod as abstract.

    Combines @classmethod and @abstractmethod.

    Args:
        func: Function to mark as abstract classmethod

    Returns:
        Classmethod with __isabstractmethod__ = True
    """
    func.__isabstractmethod__ = True
    return classmethod(func)


def abstractstaticmethod(func):
    """Decorator to mark staticmethod as abstract.

    Combines @staticmethod and @abstractmethod.

    Args:
        func: Function to mark as abstract staticmethod

    Returns:
        Staticmethod with __isabstractmethod__ = True
    """
    func.__isabstractmethod__ = True
    return staticmethod(func)


def abstractproperty(func):
    """Decorator to mark property as abstract.

    Combines @property and @abstractmethod.
    Deprecated in Python 3.3+, use @property with @abstractmethod.

    Args:
        func: Function to mark as abstract property

    Returns:
        Property with __isabstractmethod__ = True
    """
    func.__isabstractmethod__ = True
    return property(func)


# ============================================
# Helper Functions
# ============================================

def get_abstract_methods(cls) -> set:
    """Get set of abstract method names for class.

    Args:
        cls: Class to inspect

    Returns:
        Set of abstract method names
    """
    if hasattr(cls, '_abstract_methods_'):
        return set(cls._abstract_methods_)

    abstract_methods = set()

    for name in dir(cls):
        attr = getattr(cls, name)
        if hasattr(attr, '__isabstractmethod__'):
            if attr.__isabstractmethod__:
                abstract_methods.add(name)

    return abstract_methods


def is_abstract(cls) -> bool:
    """Check if class has unimplemented abstract methods.

    Args:
        cls: Class to check

    Returns:
        True if class is abstract
    """
    return len(get_abstract_methods(cls)) > 0


def is_concrete(cls) -> bool:
    """Check if class is concrete (no abstract methods).

    Args:
        cls: Class to check

    Returns:
        True if class is concrete
    """
    return len(get_abstract_methods(cls)) == 0


# ============================================
# Registration
# ============================================

def register(cls, subclass):
    """Register a virtual subclass.

    Args:
        cls: Abstract base class
        subclass: Class to register as subclass

    Returns:
        The subclass
    """
    if not hasattr(cls, '_virtual_subclasses_'):
        cls._virtual_subclasses_ = set()
    cls._virtual_subclasses_.add(subclass)
    return subclass


def is_registered_subclass(cls, potential_subclass) -> bool:
    """Check if class is registered as virtual subclass.

    Args:
        cls: Abstract base class
        potential_subclass: Class to check

    Returns:
        True if registered as subclass
    """
    if hasattr(cls, '_virtual_subclasses_'):
        return potential_subclass in cls._virtual_subclasses_

    # Check bases recursively
    for base in cls.__bases__:
        if is_registered_subclass(base, potential_subclass):
            return True

    return False


# ============================================
# Common Abstract Base Classes
# ============================================

class Hashable(ABC):
    """ABC for hashable objects."""

    @abstractmethod
    def __hash__(self) -> int:
        pass


class Awaitable(ABC):
    """ABC for awaitable objects."""

    @abstractmethod
    def __await__(self):
        pass


class Coroutine(Awaitable):
    """ABC for coroutine objects."""

    @abstractmethod
    def send(self, value):
        pass

    @abstractmethod
    def throw(self, typ, val=None, tb=None):
        pass

    @abstractmethod
    def close(self):
        pass


class AsyncIterable(ABC):
    """ABC for async iterable objects."""

    @abstractmethod
    def __aiter__(self):
        pass


class AsyncIterator(AsyncIterable):
    """ABC for async iterator objects."""

    @abstractmethod
    def __anext__(self):
        pass


class Iterable(ABC):
    """ABC for iterable objects."""

    @abstractmethod
    def __iter__(self):
        pass


class Iterator(Iterable):
    """ABC for iterator objects."""

    @abstractmethod
    def __next__(self):
        pass


class Sized(ABC):
    """ABC for sized objects."""

    @abstractmethod
    def __len__(self) -> int:
        pass


class Container(ABC):
    """ABC for container objects."""

    @abstractmethod
    def __contains__(self, item) -> bool:
        pass


class Collection(Sized, Iterable, Container):
    """ABC for collection objects."""
    pass


class Sequence(Collection):
    """ABC for sequence objects."""

    @abstractmethod
    def __getitem__(self, index):
        pass

    def index(self, value, start=0, stop=None) -> int:
        """Return index of first occurrence."""
        if stop is None:
            stop = len(self)
        for i in range(start, stop):
            if self[i] == value:
                return i
        raise ValueError(str(value) + " not in sequence")

    def count(self, value) -> int:
        """Count occurrences of value."""
        count = 0
        for item in self:
            if item == value:
                count = count + 1
        return count


class MutableSequence(Sequence):
    """ABC for mutable sequence objects."""

    @abstractmethod
    def __setitem__(self, index, value):
        pass

    @abstractmethod
    def __delitem__(self, index):
        pass

    def insert(self, index, value):
        """Insert value at index."""
        self.append(value)
        for i in range(len(self) - 1, index, -1):
            self[i] = self[i - 1]
        self[index] = value

    def append(self, value):
        """Append value to end."""
        self.insert(len(self), value)

    def extend(self, values):
        """Extend with values."""
        for value in values:
            self.append(value)

    def pop(self, index=-1):
        """Remove and return item at index."""
        value = self[index]
        del self[index]
        return value

    def remove(self, value):
        """Remove first occurrence of value."""
        del self[self.index(value)]

    def reverse(self):
        """Reverse in place."""
        for i in range(len(self) // 2):
            self[i], self[-(i + 1)] = self[-(i + 1)], self[i]


class Set(Collection):
    """ABC for set objects."""

    @abstractmethod
    def __contains__(self, item) -> bool:
        pass

    @abstractmethod
    def __iter__(self):
        pass

    @abstractmethod
    def __len__(self) -> int:
        pass

    def __le__(self, other):
        """Subset test."""
        for item in self:
            if item not in other:
                return False
        return True

    def __lt__(self, other):
        """Proper subset test."""
        return len(self) < len(other) and self <= other

    def __ge__(self, other):
        """Superset test."""
        return other <= self

    def __gt__(self, other):
        """Proper superset test."""
        return other < self

    def __eq__(self, other):
        """Equality test."""
        if len(self) != len(other):
            return False
        for item in self:
            if item not in other:
                return False
        return True

    def union(self, other):
        """Return union."""
        result = set(self)
        for item in other:
            result.add(item)
        return result

    def intersection(self, other):
        """Return intersection."""
        result = set()
        for item in self:
            if item in other:
                result.add(item)
        return result

    def difference(self, other):
        """Return difference."""
        result = set()
        for item in self:
            if item not in other:
                result.add(item)
        return result


class MutableSet(Set):
    """ABC for mutable set objects."""

    @abstractmethod
    def add(self, value):
        pass

    @abstractmethod
    def discard(self, value):
        pass

    def remove(self, value):
        """Remove value (raises if missing)."""
        if value not in self:
            raise KeyError(str(value))
        self.discard(value)

    def pop(self):
        """Remove and return arbitrary element."""
        for item in self:
            self.discard(item)
            return item
        raise KeyError("pop from empty set")

    def clear(self):
        """Remove all elements."""
        while len(self) > 0:
            self.pop()

    def update(self, *others):
        """Update with union of sets."""
        for other in others:
            for item in other:
                self.add(item)

    def intersection_update(self, other):
        """Update with intersection."""
        to_remove = []
        for item in self:
            if item not in other:
                to_remove.append(item)
        for item in to_remove:
            self.discard(item)

    def difference_update(self, other):
        """Update with difference."""
        for item in other:
            self.discard(item)

    def symmetric_difference_update(self, other):
        """Update with symmetric difference."""
        to_add = []
        to_remove = []
        for item in self:
            if item in other:
                to_remove.append(item)
        for item in other:
            if item not in self:
                to_add.append(item)
        for item in to_remove:
            self.discard(item)
        for item in to_add:
            self.add(item)


class Mapping(Collection):
    """ABC for mapping objects."""

    @abstractmethod
    def __getitem__(self, key):
        pass

    @abstractmethod
    def __iter__(self):
        pass

    @abstractmethod
    def __len__(self) -> int:
        pass

    def __contains__(self, key) -> bool:
        try:
            self[key]
            return True
        except:
            return False

    def keys(self):
        """Return keys."""
        return list(self.__iter__())

    def values(self):
        """Return values."""
        return [self[key] for key in self]

    def items(self):
        """Return items."""
        return [(key, self[key]) for key in self]

    def get(self, key, default=None):
        """Get value with default."""
        try:
            return self[key]
        except:
            return default


class MutableMapping(Mapping):
    """ABC for mutable mapping objects."""

    @abstractmethod
    def __setitem__(self, key, value):
        pass

    @abstractmethod
    def __delitem__(self, key):
        pass

    def pop(self, key, default=None):
        """Remove and return value."""
        try:
            value = self[key]
            del self[key]
            return value
        except:
            if default is None:
                raise KeyError(str(key))
            return default

    def popitem(self):
        """Remove and return arbitrary item."""
        for key in self:
            value = self[key]
            del self[key]
            return (key, value)
        raise KeyError("popitem from empty mapping")

    def clear(self):
        """Remove all items."""
        keys = list(self.keys())
        for key in keys:
            del self[key]

    def update(self, other=None, **kwargs):
        """Update with key-value pairs."""
        if other is not None:
            if hasattr(other, 'keys'):
                for key in other:
                    self[key] = other[key]
            else:
                for key, value in other:
                    self[key] = value
        for key, value in kwargs.items():
            self[key] = value

    def setdefault(self, key, default=None):
        """Get or set default value."""
        if key not in self:
            self[key] = default
        return self[key]


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test abc functionality."""
    print("Testing abc module...")

    # Test abstract class
    print("  Testing abstract class...")

    class Shape(ABC):
        @abstractmethod
        def area(self):
            pass

        @abstractmethod
        def perimeter(self):
            pass

    print("    Shape is abstract: " + str(is_abstract(Shape)))

    # Test concrete implementation
    print("  Testing concrete implementation...")

    class Rectangle(Shape):
        def __init__(self, width, height):
            self.width = width
            self.height = height

        def area(self):
            return self.width * self.height

        def perimeter(self):
            return 2 * (self.width + self.height)

    rect = Rectangle(3, 4)
    print("    Rectangle(3, 4).area() = " + str(rect.area()))
    print("    Rectangle(3, 4).perimeter() = " + str(rect.perimeter()))

    # Test abstract method enforcement
    print("  Testing abstract method enforcement...")

    class IncompleteShape(Shape):
        def area(self):
            return 0

    try:
        incomplete = IncompleteShape()
        print("    ERROR: Should have raised TypeError")
    except TypeError as e:
        print("    Correctly raised TypeError")

    # Test abstract classmethod
    print("  Testing abstract classmethod...")

    class Animal(ABC):
        @abstractclassmethod
        def species(cls):
            pass

    class Dog(Animal):
        @classmethod
        def species(cls):
            return "Canine"

    print("    Dog.species() = " + str(Dog.species()))

    # Test abstract property
    print("  Testing abstract property...")

    class Vehicle(ABC):
        @property
        @abstractmethod
        def wheels(self):
            pass

    class Car(Vehicle):
        @property
        def wheels(self):
            return 4

    car = Car()
    print("    Car().wheels = " + str(car.wheels))

    # Test get_abstract_methods
    print("  Testing get_abstract_methods...")
    methods = get_abstract_methods(Shape)
    print("    Shape abstract methods: " + str(methods))

    print("abc tests completed!")
