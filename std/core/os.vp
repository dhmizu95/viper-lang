# ============================================
# Path Operations
# ============================================

def path_join(a: str, b: str) -> str:
    """Join two path components."""
    # Implemented in runtime
    return ""

def path_abspath(path: str) -> str:
    """Get absolute path."""
    # Implemented in runtime
    return ""

def path_basename(path: str) -> str:
    """Get the basename (final component) of a path."""
    # Implemented in runtime
    return ""

def path_dirname(path: str) -> str:
    """Get the directory name of a path."""
    # Implemented in runtime
    return ""

def path_split(path: str) -> (str, str):
    """Split path into (dirname, basename)."""
    return (path_dirname(path), path_basename(path))

def path_splitext(path: str) -> (str, str):
    """Split path into (root, extension)."""
    base = path_basename(path)
    dir_name = path_dirname(path)
    
    dot_pos = -1
    for i in range(len(base) - 1, -1, -1):
        if base[i] == '.':
            dot_pos = i
            break
    
    if dot_pos > 0:
        return (dir_name + "/" + base[:dot_pos], base[dot_pos:])
    return (path, "")

def path_isabs(path: str) -> bool:
    """Check if path is absolute."""
    return len(path) > 0 and path[0] == '/'

def path_normpath(path: str) -> str:
    """Normalize a path (remove . and ..)."""
    # Simplified implementation
    return path

def path_relpath(path: str, start: str = ".") -> str:
    """Get relative path from start to path."""
    return path

def path_commonpath(paths: [str]) -> str:
    """Get the longest common sub-path of a list of paths."""
    if len(paths) == 0:
        return ""
    if len(paths) == 1:
        return paths[0]
    return ""

def path_expanduser(path: str) -> str:
    """Expand ~ to user's home directory."""
    if len(path) > 0 and path[0] == '~':
        return path_join(get_home(), path[1:])
    return path

