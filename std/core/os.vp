# ============================================
# Stat result
# ============================================

class stat_result:
    """Result of os.stat()."""
    def __init__(self):
        self.st_mode: i64 = 0
        self.st_ino: i64 = 0
        self.st_dev: i64 = 0
        self.st_nlink: i64 = 0
        self.st_uid: i64 = 0
        self.st_gid: i64 = 0
        self.st_size: i64 = 0
        self.st_atime: f64 = 0.0
        self.st_mtime: f64 = 0.0
        self.st_ctime: f64 = 0.0

def stat(path: str) -> stat_result:
    """Get file status."""
    # Implemented in runtime
    return stat_result()

def lstat(path: str) -> stat_result:
    """Get file status (don't follow symlinks)."""
    return stat(path)

