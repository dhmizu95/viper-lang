def lockf(fd: i64, cmd: i64, len: i64 = 0) -> i64:
    """Lock/unlock a file region."""
    return 0

# Lock commands
F_LOCK: i64 = 1   # Lock a region for writing
F_TLOCK: i64 = 2  # Test and lock a region
F_ULOCK: i64 = 0  # Unlock a region
F_TEST: i64 = 3   # Test a region
