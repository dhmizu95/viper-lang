F_OK: i64 = 0  # Test for existence
R_OK: i64 = 4  # Test for read permission
W_OK: i64 = 2  # Test for write permission
X_OK: i64 = 1  # Test for execute permission

def access(path: str, mode: i64) -> bool:
    """Check if path is accessible with given mode."""
    # Implemented in runtime
    return False

