# Viper Standard Library - os module
# Operating system interface: filesystem, paths, environment

# Module metadata
__name__ = "os"
__version__ = "0.4.1"

# Constants
sep: str = "/"
altsep: str = None  # Alternative separator (e.g., "\\" on Windows)
pathsep: str = ":"  # Path separator in PATH variable
linesep: str = "\n"
devnull: str = "/dev/null"

# Error classes
class OSError(Exception):
    """Base class for OS-related errors."""
    def __init__(self, errno: i64 = 0, message: str = ""):
        self.errno = errno
        self.message = message

class FileExistsError(OSError):
    """Raised when a file or directory already exists."""
    pass

class FileNotFoundError(OSError):
    """Raised when a file or directory is not found."""
    pass

class PermissionError(OSError):
    """Raised when permission is denied."""
    pass

class IsADirectoryError(OSError):
    """Raised when an operation requires a file but got a directory."""
    pass

class NotADirectoryError(OSError):
    """Raised when an operation requires a directory but got a file."""
    pass

