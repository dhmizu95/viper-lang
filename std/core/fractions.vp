# Viper Standard Library - fractions module
# Rational number arithmetic

# Module metadata
__name__ = "fractions"
__version__ = "0.4.7"

# ============================================
# Fraction Class
# ============================================

class Fraction:
    """Rational number representation.

    Represents numbers as numerator/denominator pairs.
    Always stored in lowest terms with positive denominator.

    Args:
        numerator: Numerator value (default 0)
        denominator: Denominator value (default 1)

    Example:
        f = Fraction(1, 2)  # 1/2
        f = Fraction(3)     # 3/1
        f = Fraction('1/4') # 1/4
    """

    def __init__(self, numerator=0, denominator=1):
        # Handle string input
        if isinstance(numerator, str):
            self._from_string(numerator)
            return

        # Handle Fraction input
        if isinstance(numerator, Fraction):
            self._numerator = numerator._numerator
            self._denominator = numerator._denominator
            return

        # Handle float input (limited precision)
        if isinstance(numerator, float):
            self._from_float(numerator)
            return

        # Handle integer input
        if denominator == 1:
            self._numerator = int(numerator)
            self._denominator = 1
        else:
            self._numerator = int(numerator)
            self._denominator = int(denominator)
            self._normalize()

    def _from_string(self, s: str):
        """Parse fraction from string."""
        s = s.strip()

        if '/' in s:
            parts = s.split('/')
            self._numerator = int(parts[0])
            self._denominator = int(parts[1])
        else:
            self._numerator = int(s)
            self._denominator = 1

        self._normalize()

    def _from_float(self, f: float):
        """Convert float to fraction (limited precision)."""
        # Handle special values
        if f != f:  # NaN
            raise ValueError("Cannot convert NaN to fraction")
        if f == float('inf') or f == float('-inf'):
            raise ValueError("Cannot convert infinity to fraction")

        # Simple conversion with limited precision
        precision = 1000000
        numerator = int(round(f * precision))
        denominator = precision

        self._numerator = numerator
        self._denominator = denominator
        self._normalize()

    def _normalize(self):
        """Normalize fraction to lowest terms."""
        if self._denominator == 0:
            raise ValueError("Denominator cannot be zero")

        # Handle negative denominator
        if self._denominator < 0:
            self._numerator = -self._numerator
            self._denominator = -self._denominator

        # Reduce to lowest terms
        gcd_val = self._gcd(abs(self._numerator), abs(self._denominator))
        if gcd_val > 0:
            self._numerator = self._numerator // gcd_val
            self._denominator = self._denominator // gcd_val

    def _gcd(self, a: int, b: int) -> int:
        """Greatest common divisor."""
        while b:
            a, b = b, a % b
        return a

    @property
    def numerator(self) -> int:
        """Return numerator."""
        return self._numerator

    @property
    def denominator(self) -> int:
        """Return denominator."""
        return self._denominator

    def __repr__(self) -> str:
        if self._denominator == 1:
            return "Fraction(" + str(self._numerator) + ")"
        return "Fraction(" + str(self._numerator) + ", " + str(self._denominator) + ")"

    def __str__(self) -> str:
        if self._denominator == 1:
            return str(self._numerator)
        return str(self._numerator) + "/" + str(self._denominator)

    def __float__(self) -> float:
        return self._numerator / self._denominator

    def __int__(self) -> int:
        return self._numerator // self._denominator

    def __bool__(self) -> bool:
        return self._numerator != 0

    def __abs__(self):
        return Fraction(abs(self._numerator), abs(self._denominator))

    def __neg__(self):
        return Fraction(-self._numerator, self._denominator)

    def __pos__(self):
        return Fraction(self._numerator, self._denominator)

    def __add__(self, other):
        """Add two fractions."""
        if isinstance(other, Fraction):
            num = self._numerator * other._denominator + other._numerator * self._denominator
            den = self._denominator * other._denominator
            return Fraction(num, den)
        if isinstance(other, int):
            return Fraction(self._numerator + other * self._denominator, self._denominator)
        if isinstance(other, float):
            return float(self) + other
        return NotImplemented

    def __radd__(self, other):
        return self.__add__(other)

    def __sub__(self, other):
        """Subtract two fractions."""
        if isinstance(other, Fraction):
            num = self._numerator * other._denominator - other._numerator * self._denominator
            den = self._denominator * other._denominator
            return Fraction(num, den)
        if isinstance(other, int):
            return Fraction(self._numerator - other * self._denominator, self._denominator)
        if isinstance(other, float):
            return float(self) - other
        return NotImplemented

    def __rsub__(self, other):
        if isinstance(other, int):
            return Fraction(other * self._denominator - self._numerator, self._denominator)
        if isinstance(other, float):
            return other - float(self)
        return NotImplemented

    def __mul__(self, other):
        """Multiply two fractions."""
        if isinstance(other, Fraction):
            return Fraction(self._numerator * other._numerator, self._denominator * other._denominator)
        if isinstance(other, int):
            return Fraction(self._numerator * other, self._denominator)
        if isinstance(other, float):
            return float(self) * other
        return NotImplemented

    def __rmul__(self, other):
        return self.__mul__(other)

    def __truediv__(self, other):
        """Divide two fractions."""
        if isinstance(other, Fraction):
            return Fraction(self._numerator * other._denominator, self._denominator * other._numerator)
        if isinstance(other, int):
            return Fraction(self._numerator, self._denominator * other)
        if isinstance(other, float):
            return float(self) / other
        return NotImplemented

    def __rtruediv__(self, other):
        if isinstance(other, int):
            return Fraction(other * self._denominator, self._numerator)
        if isinstance(other, float):
            return other / float(self)
        return NotImplemented

    def __floordiv__(self, other):
        """Floor division."""
        result = self / other
        return int(result)

    def __mod__(self, other):
        """Modulo operation."""
        if isinstance(other, Fraction):
            return self - (self // other) * other
        return NotImplemented

    def __pow__(self, exponent, modulus=None):
        """Raise to power."""
        if modulus is not None:
            raise TypeError("Fraction modulus not supported")

        if isinstance(exponent, int):
            if exponent >= 0:
                return Fraction(self._numerator ** exponent, self._denominator ** exponent)
            else:
                return Fraction(self._denominator ** (-exponent), self._numerator ** (-exponent))
        if isinstance(exponent, float):
            return float(self) ** exponent
        return NotImplemented

    def __eq__(self, other):
        """Check equality."""
        if isinstance(other, Fraction):
            return (self._numerator == other._numerator and
                    self._denominator == other._denominator)
        if isinstance(other, int):
            return self._denominator == 1 and self._numerator == other
        if isinstance(other, float):
            return float(self) == other
        return False

    def __lt__(self, other):
        """Less than."""
        if isinstance(other, Fraction):
            return (self._numerator * other._denominator <
                    other._numerator * self._denominator)
        if isinstance(other, (int, float)):
            return float(self) < other
        return NotImplemented

    def __le__(self, other):
        """Less than or equal."""
        return self == other or self < other

    def __gt__(self, other):
        """Greater than."""
        return not self <= other

    def __ge__(self, other):
        """Greater than or equal."""
        return not self < other

    def __hash__(self):
        return hash((self._numerator, self._denominator))

    def __round__(self, ndigits=None):
        """Round to nearest integer or ndigits."""
        if ndigits is None:
            return round(float(self))
        return round(float(self), ndigits)

    def __floor__(self):
        """Return floor."""
        import math
        return math.floor(float(self))

    def __ceil__(self):
        """Return ceiling."""
        import math
        return math.ceil(float(self))

    def __trunc__(self):
        """Return truncation."""
        return int(self)

    def limit_denominator(self, max_denominator: int = 1000000):
        """Return closest Fraction with denominator <= max_denominator.

        Args:
            max_denominator: Maximum allowed denominator

        Returns:
            Closest Fraction with limited denominator
        """
        if max_denominator < 1:
            raise ValueError("max_denominator must be >= 1")

        # Use continued fraction algorithm
        a = self._numerator // self._denominator
        r = Fraction(self._numerator - a * self._denominator, self._denominator)

        if r._denominator <= max_denominator:
            return self

        # Simplified: just return current fraction if already within limit
        if self._denominator <= max_denominator:
            return self

        # Find best approximation
        best_num = self._numerator
        best_den = self._denominator

        for den in range(1, min(max_denominator + 1, self._denominator)):
            num = round(self._numerator * den / self._denominator)
            if abs(num / den - float(self)) < abs(best_num / best_den - float(self)):
                best_num = num
                best_den = den

        return Fraction(best_num, best_den)


# ============================================
# Helper Functions
# ============================================

def gcd(a: int, b: int) -> int:
    """Greatest common divisor of a and b.

    Args:
        a: First integer
        b: Second integer

    Returns:
        Greatest common divisor
    """
    a = abs(a)
    b = abs(b)
    while b:
        a, b = b, a % b
    return a


def lcm(a: int, b: int) -> int:
    """Least common multiple of a and b.

    Args:
        a: First integer
        b: Second integer

    Returns:
        Least common multiple
    """
    if a == 0 or b == 0:
        return 0
    return abs(a * b) // gcd(a, b)


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test fractions functionality."""
    print("Testing fractions module...")

    # Test basic creation
    print("  Testing basic creation...")
    f1 = Fraction(1, 2)
    f2 = Fraction(3, 4)
    print("    Fraction(1, 2) = " + str(f1))
    print("    Fraction(3, 4) = " + str(f2))

    # Test normalization
    print("  Testing normalization...")
    f3 = Fraction(2, 4)
    print("    Fraction(2, 4) = " + str(f3))

    f4 = Fraction(-2, -4)
    print("    Fraction(-2, -4) = " + str(f4))

    # Test arithmetic
    print("  Testing arithmetic...")
    print("    1/2 + 3/4 = " + str(f1 + f2))
    print("    1/2 - 3/4 = " + str(f1 - f2))
    print("    1/2 * 3/4 = " + str(f1 * f2))
    print("    1/2 / 3/4 = " + str(f1 / f2))

    # Test comparison
    print("  Testing comparison...")
    print("    1/2 < 3/4: " + str(f1 < f2))
    print("    1/2 == 2/4: " + str(f1 == Fraction(2, 4)))

    # Test string parsing
    print("  Testing string parsing...")
    f5 = Fraction('3/8')
    print("    Fraction('3/8') = " + str(f5))

    f6 = Fraction('5')
    print("    Fraction('5') = " + str(f6))

    # Test float conversion
    print("  Testing float conversion...")
    print("    float(1/2) = " + str(float(f1)))
    print("    int(3/2) = " + str(int(Fraction(3, 2))))

    # Test GCD and LCM
    print("  Testing GCD and LCM...")
    print("    gcd(12, 8) = " + str(gcd(12, 8)))
    print("    lcm(4, 6) = " + str(lcm(4, 6)))

    # Test limit_denominator
    print("  Testing limit_denominator...")
    pi_approx = Fraction('3.14159')
    limited = pi_approx.limit_denominator(100)
    print("    pi approx limited to denom 100: " + str(limited))

    # Test negative fractions
    print("  Testing negative fractions...")
    f_neg = Fraction(-1, 2)
    print("    Fraction(-1, 2) = " + str(f_neg))
    print("    -Fraction(-1, 2) = " + str(-f_neg))

    # Test power
    print("  Testing power...")
    f_sq = f1 ** 2
    print("    (1/2)^2 = " + str(f_sq))

    print("fractions tests completed!")
