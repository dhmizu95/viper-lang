# Viper Standard Library - argparse module
# Command-line argument parsing

# Module metadata
__name__ = "argparse"
__version__ = "0.4.5"

from sys import argv

# ============================================
# Exceptions
# ============================================

class ArgumentError(Exception):
    """Base class for argument parsing errors."""
    def __init__(self, message: str = ""):
        self.message = message
    
    def __str__(self) -> str:
        return "ArgumentError: " + self.message

class ArgumentTypeError(ArgumentError):
    """Exception raised when an argument has invalid type."""
    pass

# ============================================
# Action Types
# ============================================

ACTION_STORE: i64 = 0
ACTION_STORE_TRUE: i64 = 1
ACTION_STORE_FALSE: i64 = 2
ACTION_APPEND: i64 = 3
ACTION_COUNT: i64 = 4
ACTION_HELP: i64 = 5
ACTION_VERSION: i64 = 6

# ============================================
# Argument Definition
# ============================================

class Argument:
    """Represents a single command-line argument."""
    
    def __init__(self, name: str, short: str = "", 
                 type_fn = str, default = None,
                 action: i64 = ACTION_STORE,
                 nargs: i64 = 1,
                 choices: [str] = None,
                 required: bool = False,
                 help: str = "",
                 metavar: str = None,
                 dest: str = None):
        self.name = name
        self.short = short
        self.type_fn = type_fn
        self.default = default
        self.action = action
        self.nargs = nargs
        self.choices = choices
        self.required = required
        self.help = help
        self.metavar = metavar if metavar else name
        self.dest = dest if dest else self._get_dest(name)
        self.count = 0  # For count action
    
    def _get_dest(self, name: str) -> str:
        """Convert argument name to destination attribute."""
        # Remove leading dashes and replace with underscore
        result = name
        if result.startswith("--"):
            result = result[2:]
        elif result.startswith("-"):
            result = result[1:]
        return result.replace("-", "_")
    
    def is_positional(self) -> bool:
        """Check if this is a positional argument."""
        return not (self.name.startswith("-"))
    
    def is_optional(self) -> bool:
        """Check if this is an optional argument."""
        return self.name.startswith("-")
    
    def matches(self, arg: str) -> bool:
        """Check if a command-line argument matches this definition."""
        if arg == self.name:
            return True
        if self.short and arg == self.short:
            return True
        return False

# ============================================
# Namespace
# ============================================

class Namespace:
    """Simple object for holding parsed arguments."""
    
    def __init__(self, **kwargs):
        for key, value in kwargs.items():
            setattr(self, key, value)
    
    def __repr__(self) -> str:
        items = []
        for key in dir(self):
            if not key.startswith("_"):
                value = getattr(self, key)
                items.append(key + "=" + str(value))
        return "Namespace(" + ", ".join(items) + ")"
    
    def __eq__(self, other) -> bool:
        if not isinstance(other, Namespace):
            return False
        # Compare all attributes
        for key in dir(self):
            if not key.startswith("_"):
                if getattr(self, key) != getattr(other, key, None):
                    return False
        return True
    
    def vars(self) -> {str: str}:
        """Return arguments as a dictionary."""
        result = {}
        for key in dir(self):
            if not key.startswith("_"):
                result[key] = getattr(self, key)
        return result

# ============================================
# ArgumentParser
# ============================================

class ArgumentParser:
    """Parser for command-line arguments."""
    
    def __init__(self, 
                 prog: str = None,
                 usage: str = None,
                 description: str = "",
                 epilog: str = "",
                 add_help: bool = True,
                 allow_abbrev: bool = True):
        self.prog = prog if prog else "program"
        self.usage = usage
        self.description = description
        self.epilog = epilog
        self.add_help = add_help
        self.allow_abbrev = allow_abbrev
        
        self._arguments: [Argument] = []
        self._groups: [ArgumentGroup] = []
        self._mutually_exclusive: [[Argument]] = []
        
        # Add default help argument
        if add_help:
            self.add_argument("-h", "--help", 
                            action=ACTION_HELP,
                            help="Show this help message and exit")
    
    def add_argument(self, *names, **kwargs) -> Argument:
        """Add an argument to the parser."""
        name = names[0] if names else ""
        short = names[1] if len(names) > 1 else ""
        
        arg = Argument(
            name=name,
            short=short,
            type_fn=kwargs.get("type", str),
            default=kwargs.get("default", None),
            action=kwargs.get("action", ACTION_STORE),
            nargs=kwargs.get("nargs", 1),
            choices=kwargs.get("choices", None),
            required=kwargs.get("required", False),
            help=kwargs.get("help", ""),
            metavar=kwargs.get("metavar", None),
            dest=kwargs.get("dest", None)
        )
        
        self._arguments.append(arg)
        return arg
    
    def add_argument_group(self, title: str = "", description: str = ""):
        """Add an argument group."""
        group = ArgumentGroup(title, description)
        self._groups.append(group)
        return group
    
    def add_mutually_exclusive_group(self, required: bool = False):
        """Add a mutually exclusive group."""
        group = MutuallyExclusiveGroup(required)
        self._mutually_exclusive.append(group)
        return group
    
    def add_subparsers(self, **kwargs):
        """Add subparser support."""
        # Simplified - would need SubParsers class
        return None
    
    def parse_args(self, args: [str] = None) -> Namespace:
        """Parse command-line arguments."""
        if args is None:
            # Skip program name
            args = argv[1:]
        
        namespace = Namespace()
        
        # Set defaults
        for arg in self._arguments:
            if arg.action == ACTION_STORE_TRUE:
                setattr(namespace, arg.dest, False)
            elif arg.action == ACTION_STORE_FALSE:
                setattr(namespace, arg.dest, True)
            elif arg.action == ACTION_COUNT:
                setattr(namespace, arg.dest, 0)
            elif arg.action == ACTION_APPEND:
                setattr(namespace, arg.dest, [])
            else:
                setattr(namespace, arg.dest, arg.default)
        
        # Parse arguments
        i = 0
        positional_idx = 0
        
        while i < len(args):
            arg_str = args[i]
            
            if arg_str.startswith("--"):
                # Long option
                matched = self._find_argument(arg_str)
                if matched:
                    i = self._parse_argument(matched, args, i, namespace)
                else:
                    raise ArgumentError("Unknown argument: " + arg_str)
            elif arg_str.startswith("-") and len(arg_str) > 1:
                # Short option or negative number
                matched = self._find_argument(arg_str)
                if matched:
                    i = self._parse_argument(matched, args, i, namespace)
                elif arg_str[1].isdigit() or arg_str[1] == '.':
                    # Negative number - treat as positional
                    if positional_idx < len(self._get_positional()):
                        pos_arg = self._get_positional()[positional_idx]
                        setattr(namespace, pos_arg.dest, pos_arg.type_fn(arg_str))
                        positional_idx += 1
                    i += 1
                else:
                    raise ArgumentError("Unknown argument: " + arg_str)
            else:
                # Positional argument
                if positional_idx < len(self._get_positional()):
                    pos_arg = self._get_positional()[positional_idx]
                    setattr(namespace, pos_arg.dest, pos_arg.type_fn(arg_str))
                    positional_idx += 1
                i += 1
        
        # Check required arguments
        for arg in self._arguments:
            if arg.required and getattr(namespace, arg.dest) is None:
                raise ArgumentError("Required argument missing: " + arg.name)
        
        return namespace
    
    def _find_argument(self, arg_str: str) -> Argument:
        """Find an argument definition matching the given string."""
        for arg in self._arguments:
            if arg.matches(arg_str):
                return arg
            
            # Allow abbreviation
            if self.allow_abbrev and arg.is_optional():
                if arg.name.startswith(arg_str):
                    return arg
                if arg.short and arg.short.startswith(arg_str):
                    return arg
        
        return None
    
    def _parse_argument(self, arg: Argument, args: [str], i: i64, namespace: Namespace) -> i64:
        """Parse a single argument and update namespace."""
        if arg.action == ACTION_HELP:
            self.print_help()
            # In real implementation, would exit
            return i + 1
        
        if arg.action == ACTION_VERSION:
            print(self.prog + " version 0.4.5")
            return i + 1
        
        if arg.action == ACTION_STORE_TRUE:
            setattr(namespace, arg.dest, True)
            return i + 1
        
        if arg.action == ACTION_STORE_FALSE:
            setattr(namespace, arg.dest, False)
            return i + 1
        
        if arg.action == ACTION_COUNT:
            current = getattr(namespace, arg.dest, 0)
            setattr(namespace, arg.dest, current + 1)
            return i + 1
        
        if arg.action == ACTION_APPEND:
            if i + 1 < len(args):
                value = arg.type_fn(args[i + 1])
                lst = getattr(namespace, arg.dest, [])
                lst.append(value)
                setattr(namespace, arg.dest, lst)
                return i + 2
            return i + 1
        
        # Default: STORE
        if arg.nargs > 0 and i + 1 < len(args):
            value = arg.type_fn(args[i + 1])
            
            # Check choices
            if arg.choices and str(value) not in arg.choices:
                raise ArgumentError("Invalid choice: " + str(value))
            
            setattr(namespace, arg.dest, value)
            return i + 2
        
        return i + 1
    
    def _get_positional(self) -> [Argument]:
        """Get list of positional arguments."""
        return [a for a in self._arguments if a.is_positional()]
    
    def print_help(self):
        """Print help message."""
        print("usage: " + self.prog, end="")
        
        if self.usage:
            print(" " + self.usage)
        else:
            for arg in self._arguments:
                if arg.is_optional():
                    print(" [" + arg.name + "]", end="")
                else:
                    print(" <" + arg.metavar + ">", end="")
            print()
        
        if self.description:
            print()
            print(self.description)
        
        print()
        print("Options:")
        
        for arg in self._arguments:
            names = arg.name
            if arg.short:
                names = arg.short + ", " + arg.name
            
            print("  " + names)
            if arg.help:
                print("    " + arg.help)
            if arg.default is not None and arg.is_optional():
                print("    (default: " + str(arg.default) + ")")
        
        if self.epilog:
            print()
            print(self.epilog)
    
    def error(self, message: str):
        """Print error message and exit."""
        print("Error: " + message)
        self.print_help()
        # Would exit with code 2
    
    def set_defaults(self, **kwargs):
        """Set default values for arguments."""
        # Would update defaults
        pass
    
    def get_default(self, dest: str):
        """Get default value for an argument."""
        for arg in self._arguments:
            if arg.dest == dest:
                return arg.default
        return None

# ============================================
# ArgumentGroup
# ============================================

class ArgumentGroup:
    """Group of related arguments."""
    
    def __init__(self, title: str = "", description: str = ""):
        self.title = title
        self.description = description
        self._arguments: [Argument] = []
    
    def add_argument(self, *names, **kwargs) -> Argument:
        arg = Argument(
            name=names[0] if names else "",
            short=names[1] if len(names) > 1 else "",
            type_fn=kwargs.get("type", str),
            default=kwargs.get("default", None),
            action=kwargs.get("action", ACTION_STORE),
            help=kwargs.get("help", ""),
            required=kwargs.get("required", False)
        )
        self._arguments.append(arg)
        return arg

# ============================================
# MutuallyExclusiveGroup
# ============================================

class MutuallyExclusiveGroup:
    """Group of mutually exclusive arguments."""
    
    def __init__(self, required: bool = False):
        self.required = required
        self._arguments: [Argument] = []
    
    def add_argument(self, *names, **kwargs) -> Argument:
        arg = Argument(
            name=names[0] if names else "",
            short=names[1] if len(names) > 1 else "",
            type_fn=kwargs.get("type", str),
            default=kwargs.get("default", None),
            action=kwargs.get("action", ACTION_STORE),
            help=kwargs.get("help", "")
        )
        self._arguments.append(arg)
        return arg

# ============================================
# Convenience Functions
# ============================================

def parse_args(*args) -> Namespace:
    """Quick argument parsing."""
    parser = ArgumentParser()
    for arg_def in args:
        parser.add_argument(**arg_def)
    return parser.parse_args()

def argument(name: str, **kwargs) -> {str: str}:
    """Create an argument definition."""
    kwargs["name"] = name
    return kwargs

# ============================================
# Type Converters
# ============================================

def filetype(mode: str = "r"):
    """Return a function that opens a file."""
    def converter(path: str):
        # Would open file
        return path
    return converter

def boolean(s: str) -> bool:
    """Convert string to boolean."""
    if s.lower() in ("true", "t", "1", "yes", "y"):
        return True
    if s.lower() in ("false", "f", "0", "no", "n"):
        return False
    raise ArgumentTypeError("Invalid boolean: " + s)

def positive_int(s: str) -> i64:
    """Convert string to positive integer."""
    value = int(s)
    if value <= 0:
        raise ArgumentTypeError("Must be positive: " + s)
    return value

def non_negative_int(s: str) -> i64:
    """Convert string to non-negative integer."""
    value = int(s)
    if value < 0:
        raise ArgumentTypeError("Must be non-negative: " + s)
    return value

# ============================================
# Constants
# ============================================

REMAINDER: i64 = -1
OPTIONAL: i64 = 0
ZERO_OR_MORE: i64 = -2
ONE_OR_MORE: i64 = -3
PARSER: i64 = -4
SUPPRESS: str = "==SUPPRESS=="
HELP: str = "==HELP=="
