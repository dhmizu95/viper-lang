# ============================================
# deque - Double-ended Queue
# ============================================

class deque:
    """A doubly-linked list optimized for appends and pops from both ends."""
    
    def __init__(self, iterable=None, maxlen: int = None):
        self._data = []  # Internal storage
        self.maxlen = maxlen
        if iterable:
            for item in iterable:
                self.append(item)
    
    def append(self, x):
        """Add x to the right side of the deque."""
        # Implemented in runtime
        pass
    
    def appendleft(self, x):
        """Add x to the left side of the deque."""
        # Implemented in runtime
        pass
    
    def pop(self):
        """Remove and return an element from the right side."""
        # Implemented in runtime
        return 0
    
    def popleft(self):
        """Remove and return an element from the left side."""
        # Implemented in runtime
        return 0
    
    def extend(self, iterable):
        """Extend the right side by appending elements from iterable."""
        for item in iterable:
            self.append(item)
    
    def extendleft(self, iterable):
        """Extend the left side by appending elements from iterable."""
        for item in iterable:
            self.appendleft(item)
    
    def rotate(self, n: int = 1):
        """Rotate the deque n steps to the right."""
        # Implemented in runtime
        pass
    
    def reverse(self):
        """Reverse the elements of the deque in-place."""
        # Implemented in runtime
        pass
    
    def remove(self, value):
        """Remove first occurrence of value."""
        # Implemented in runtime
        pass
    
    def clear(self):
        """Remove all elements from the deque."""
        # Implemented in runtime
        pass
    
    def count(self, x) -> int:
        """Count the number of deque elements equal to x."""
        # Implemented in runtime
        return 0
    
    def index(self, x, start: int = 0, stop: int = None) -> int:
        """Return index of first occurrence of x."""
        # Implemented in runtime
        return 0
    
    def insert(self, i: int, x):
        """Insert x at position i."""
        # Implemented in runtime
        pass
    
    def __len__(self) -> int:
        # Implemented in runtime
        return 0
    
    def __getitem__(self, index: int):
        # Implemented in runtime
        return 0
    
    def __setitem__(self, index: int, value):
        # Implemented in runtime
        pass
    
    def __delitem__(self, index: int):
        # Implemented in runtime
        pass
    
    def __iter__(self):
        # Return iterator
        pass
    
    def __reversed__(self):
        """Return a reverse iterator."""
        self.reverse()
        return self
    
    def __contains__(self, item) -> bool:
        """Return True if item is in the deque."""
        # Implemented in runtime
        return False
    
    def __bool__(self) -> bool:
        return self.__len__() > 0
    
    def __repr__(self) -> str:
        return "deque([...])"
    
    def copy(self):
        """Create a shallow copy of the deque."""
        return deque(self, self.maxlen)

# ============================================
# Counter - Dict subclass for counting
# ============================================

class Counter:
    """A dict subclass for counting hashable objects."""
    
    def __init__(self, iterable=None):
        self._counts = {}
        if iterable:
            for item in iterable:
                self[item] = self.get(item, 0) + 1
    
    def __getitem__(self, key) -> int:
        return self._counts.get(key, 0)
    
    def __setitem__(self, key, value: int):
        self._counts[key] = value
    
    def __delitem__(self, key):
        if key in self._counts:
            del self._counts[key]
    
    def __len__(self) -> int:
        return len(self._counts)
    
    def __iter__(self):
        return iter(self._counts.keys())
    
    def __contains__(self, key) -> bool:
        return key in self._counts
    
    def get(self, key, default: int = 0) -> int:
        return self._counts.get(key, default)
    
    def keys(self):
        return self._counts.keys()
    
    def values(self):
        return self._counts.values()
    
    def items(self):
        return self._counts.items()
    
    def most_common(self, n: int = None) -> [(str, int)]:
        """Return the n most common elements."""
        # Implemented in runtime
        return []
    
    def elements(self):
        """Return an iterator over elements repeating each as many times as its count."""
        result = []
        for key, count in self.items():
            for _ in range(count):
                result.append(key)
        return result
    
    def subtract(self, iterable=None, **kwargs):
        """Like dict.update() but subtracts counts instead of replacing them."""
        if iterable:
            for item in iterable:
                self[item] = self.get(item, 0) - 1
        for key, count in kwargs.items():
            self[key] = self.get(key, 0) - count
    
    def total(self) -> int:
        """Sum of the counts."""
        # Implemented in runtime
        return 0
    
    def copy(self):
        """Create a shallow copy."""
        c = Counter()
        c._counts = self._counts.copy()
        return c
    
    def __repr__(self) -> str:
        return "Counter({...})"
    
    def __add__(self, other):
        """Add counts from two counters."""
        result = Counter()
        for key in self.keys():
            result[key] = self[key]
        for key in other.keys():
            result[key] = result.get(key, 0) + other[key]
        return result
    
    def __sub__(self, other):
        """Subtract counts."""
        result = Counter()
        for key in self.keys():
            result[key] = self[key] - other.get(key, 0)
        return result
    
    def __and__(self, other):
        """Intersection: min(c[x], d[x])."""
        result = Counter()
        for key in self.keys():
            if key in other:
                result[key] = min(self[key], other[key])
        return result
    
    def __or__(self, other):
        """Union: max(c[x], d[x])."""
        result = Counter()
        for key in self.keys():
            result[key] = max(self[key], other.get(key, 0))
        for key in other.keys():
            if key not in result:
                result[key] = other[key]
        return result

# ============================================
# OrderedDict - Dict with insertion order
# ============================================

class OrderedDict:
    """A dict that remembers the order in which keys were inserted."""
    
    def __init__(self, **kwargs):
        self._data = {}
        self._order = []
        for key, value in kwargs.items():
            self[key] = value
    
    def __getitem__(self, key):
        return self._data[key]
    
    def __setitem__(self, key, value):
        if key not in self._data:
            self._order.append(key)
        self._data[key] = value
    
    def __delitem__(self, key):
        del self._data[key]
        self._order.remove(key)
    
    def __len__(self) -> int:
        return len(self._data)
    
    def __iter__(self):
        return iter(self._order)
    
    def __contains__(self, key) -> bool:
        return key in self._data
    
    def __eq__(self, other) -> bool:
        if len(self) != len(other):
            return False
        for key in self:
            if key not in other or self[key] != other[key]:
                return False
        return True
    
    def __repr__(self) -> str:
        return "OrderedDict({...})"
    
    def __reversed__(self):
        """Return a reverse iterator."""
        return reversed(self._order)
    
    def keys(self):
        return self._order
    
    def values(self):
        return [self._data[k] for k in self._order]
    
    def items(self):
        return [(k, self._data[k]) for k in self._order]
    
    def get(self, key, default=None):
        return self._data.get(key, default)
    
    def setdefault(self, key, default=None):
        if key not in self._data:
            self._order.append(key)
            self._data[key] = default
        return self._data[key]
    
    def update(self, other=None, **kwargs):
        if other:
            for key, value in other.items():
                self[key] = value
        for key, value in kwargs.items():
            self[key] = value
    
    def pop(self, key, default=None):
        if key in self._data:
            self._order.remove(key)
            return self._data.pop(key, default)
        return default
    
    def popitem(self, last: bool = True):
        """Remove and return (key, value) pair."""
        if not self._order:
            raise KeyError("popitem(): dictionary is empty")
        
        if last:
            key = self._order.pop()
        else:
            key = self._order.pop(0)
        
        return (key, self._data.pop(key))
    
    def clear(self):
        self._data.clear()
        self._order.clear()
    
    def copy(self):
        """Create a shallow copy."""
        od = OrderedDict()
        od._data = self._data.copy()
        od._order = self._order.copy()
        return od
    
    def move_to_end(self, key, last: bool = True):
        """Move an existing key to either end."""
        if key not in self._data:
            raise KeyError(key)
        
        self._order.remove(key)
        if last:
            self._order.append(key)
        else:
            self._order.insert(0, key)

# ============================================
# defaultdict - Dict with default factory
# ============================================

class defaultdict:
    """A dict subclass that calls a factory function to supply missing values."""
    
    def __init__(self, default_factory=None, **kwargs):
        self.default_factory = default_factory
        self._data = {}
        for key, value in kwargs.items():
            self._data[key] = value
    
    def __getitem__(self, key):
        if key not in self._data:
            if self.default_factory is not None:
                self._data[key] = self.default_factory()
            else:
                raise KeyError(key)
        return self._data[key]
    
    def __setitem__(self, key, value):
        self._data[key] = value
    
    def __delitem__(self, key):
        del self._data[key]
    
    def __len__(self) -> int:
        return len(self._data)
    
    def __iter__(self):
        return iter(self._data.keys())
    
    def __contains__(self, key) -> bool:
        return key in self._data
    
    def __repr__(self) -> str:
        return "defaultdict(" + str(self.default_factory) + ", {...})"
    
    def keys(self):
        return self._data.keys()
    
    def values(self):
        return self._data.values()
    
    def items(self):
        return self._data.items()
    
    def get(self, key, default=None):
        return self._data.get(key, default)
    
    def setdefault(self, key, default=None):
        if key not in self._data:
            if self.default_factory is not None:
                self._data[key] = self.default_factory()
            else:
                self._data[key] = default
        return self._data[key]
    
    def copy(self):
        """Create a shallow copy."""
        dd = defaultdict(self.default_factory)
        dd._data = self._data.copy()
        return dd

# ============================================
# namedtuple - Factory for tuple subclasses
# ============================================

def namedtuple(typename: str, field_names: str):
    """Factory function for creating tuple subclasses with named fields."""
    # Simplified implementation
    fields = field_names.split()
    
    class NamedTuple:
        def __init__(self, *args):
            for i, field in enumerate(fields):
                setattr(self, field, args[i] if i < len(args) else None)
        
        def __getitem__(self, index: int):
            return getattr(self, fields[index])
        
        def __len__(self) -> int:
            return len(fields)
        
        def __repr__(self) -> str:
            values = [str(getattr(self, f)) for f in fields]
            return typename + "(" + ", ".join(values) + ")"
        
        def _asdict(self) -> {str: str}:
            return {f: getattr(self, f) for f in fields}
        
        def _replace(self, **kwargs):
            for key, value in kwargs.items():
                setattr(self, key, value)
            return self
        
        def _fields(self) -> [str]:
            return fields
    
    return NamedTuple
