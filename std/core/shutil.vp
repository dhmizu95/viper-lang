# ============================================
# Exception Classes
# ============================================

class Error(Exception):
    """Base class for shutil exceptions."""
    pass


class SameFileError(Error):
    """Raised when source and destination are the same file."""
    pass


class SpecialFileError(Error):
    """Raised when trying to operate on a special file."""
    pass


class ExecError(Error):
    """Raised when a command cannot be executed."""
    pass


class ReadError(Error):
    """Raised when an archive cannot be read."""
    pass


class RegistryError(Exception):
    """Raised when registry operation fails."""
    pass


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test shutil functionality."""
    print("Testing shutil module...")

    # Test copyfile
    print("  Testing copyfile...")
    try:
        # Create test file
        f = open("/tmp/test_src.txt", 'w')
        f.write("Hello, World!")
        f.close()

        copyfile("/tmp/test_src.txt", "/tmp/test_dst.txt")

        f = open("/tmp/test_dst.txt", 'r')
        content = f.read()
        f.close()

        print("    Copied: '" + content + "'")
    except Exception as e:
        print("    Note: " + str(e))

    # Test copy
    print("  Testing copy...")
    try:
        copy("/tmp/test_src.txt", "/tmp/test_copy.txt")
        print("    Copy completed")
    except Exception as e:
        print("    Note: " + str(e))

    # Test disk_usage
    print("  Testing disk_usage...")
    try:
        usage = disk_usage("/")
        print("    Disk usage: total=" + str(usage[0]) + ", used=" + str(usage[1]) + ", free=" + str(usage[2]))
    except Exception as e:
        print("    Note: " + str(e))

    # Test which
    print("  Testing which...")
    cmd = which("python")
    if cmd:
        print("    python found at: " + cmd)
    else:
        print("    python not found in PATH")

    # Test get_terminal_size
    print("  Testing get_terminal_size...")
    size = get_terminal_size()
    print("    Terminal size: " + str(size[0]) + "x" + str(size[1]))

    # Test rmtree
    print("  Testing rmtree...")
    try:
        # Create test directory
        makedirs("/tmp/test_dir/subdir", exist_ok=True)
        f = open("/tmp/test_dir/file.txt", 'w')
        f.write("test")
        f.close()

        rmtree("/tmp/test_dir")
        print("    rmtree completed")
    except Exception as e:
        print("    Note: " + str(e))

    # Cleanup
    try:
        remove("/tmp/test_src.txt")
        remove("/tmp/test_dst.txt")
        remove("/tmp/test_copy.txt")
    except:
        pass

    print("shutil tests completed!")
