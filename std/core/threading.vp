# ============================================
# Test/Demo
# ============================================

def _test():
    """Test threading functionality."""
    print("Testing threading module...")

    # Test basic thread
    print("  Testing Thread...")
    results = []

    def worker(n):
        results.append(n)

    t = Thread(target=worker, args=(42,))
    t.start()
    t.join()
    print("    Thread result: " + str(results))

    # Test Lock
    print("  Testing Lock...")
    lock = Lock()
    with lock:
        print("    Lock acquired")
    print("    Lock released")

    # Test Event
    print("  Testing Event...")
    event = Event()

    def waiter():
        print("    Waiting for event...")
        event.wait()
        print("    Event received!")

    t = Thread(target=waiter)
    t.start()
    import time
    time.sleep(0.1)
    print("    Setting event...")
    event.set()
    t.join()

    # Test Semaphore
    print("  Testing Semaphore...")
    sem = Semaphore(2)
    sem.acquire()
    sem.acquire()
    print("    Acquired 2 permits")
    sem.release()
    print("    Released 1 permit")

    # Test Timer
    print("  Testing Timer...")
    timer_fired = [False]

    def timer_func():
        timer_fired[0] = True
        print("    Timer fired!")

    timer = Timer(0.1, timer_func)
    timer.start()
    timer.join()
    print("    Timer completed: " + str(timer_fired[0]))

    print("threading tests completed!")
