# Viper Standard Library - threading module
# Thread-based parallelism

# Module metadata
__name__ = "threading"
__version__ = "0.4.7"

# ============================================
# Constants
# ============================================

# Thread states
STATE_INITIAL = 0
STATE_STARTED = 1
STATE_STOPPED = 2

# Lock acquisition
LOCK_ACQUIRED = 1
LOCK_NOT_ACQUIRED = 0

# ============================================
# Thread Class
# ============================================

class Thread:
    """Thread of execution.

    Subclass and override run() to create a thread.

    Args:
        target: Callable to invoke
        args: Positional arguments for target
        kwargs: Keyword arguments for target
        name: Thread name
        daemon: Daemon thread (exits with main program)

    Example:
        def worker():
            print("working")

        t = Thread(target=worker)
        t.start()
        t.join()
    """

    def __init__(self, target=None, args=(), kwargs=None,
                 name=None, daemon=False):
        self._target = target
        self._args = args
        self._kwargs = kwargs if kwargs else {}
        self._name = name
        self._daemon = daemon
        self._ident = None
        self._native_id = None
        self._started = False
        self._stopped = False
        self._handle = None

    def start(self):
        """Start the thread."""
        if self._started:
            raise RuntimeError("Thread already started")

        self._started = True
        self._handle = vp_thread_start(self._target, self._args, self._kwargs)
        self._ident = vp_thread_ident(self._handle)
        self._native_id = vp_thread_native_id(self._handle)

    def run(self):
        """Execute the thread's target.

        Override this method in subclasses.
        """
        if self._target is not None:
            self._target(*self._args, **self._kwargs)

    def join(self, timeout=None):
        """Wait for thread to terminate.

        Args:
            timeout: Maximum time to wait in seconds
        """
        if not self._started:
            raise RuntimeError("Thread not started")

        vp_thread_join(self._handle, timeout)
        self._stopped = True

    def is_alive(self) -> bool:
        """Check if thread is still running."""
        if not self._started:
            return False
        if self._stopped:
            return False
        return vp_thread_is_alive(self._handle)

    def getName(self) -> str:
        """Get thread name."""
        if self._name:
            return self._name
        return "Thread-" + str(self._ident)

    def setName(self, name: str):
        """Set thread name."""
        self._name = name

    @property
    def name(self) -> str:
        """Thread name."""
        return self.getName()

    @name.setter
    def name(self, value: str):
        self.setName(value)

    @property
    def ident(self) -> int:
        """Thread identifier."""
        return self._ident

    @property
    def native_id(self) -> int:
        """Native thread ID."""
        return self._native_id

    @property
    def daemon(self) -> bool:
        """Daemon flag."""
        return self._daemon

    @daemon.setter
    def daemon(self, value: bool):
        if self._started:
            raise RuntimeError("Cannot set daemon after start")
        self._daemon = value

    def isDaemon(self) -> bool:
        """Check if thread is daemon (deprecated, use daemon property)."""
        return self.daemon

    def setDaemon(self, daemonic: bool):
        """Set daemon flag (deprecated, use daemon property)."""
        self.daemon = daemonic


# ============================================
# Lock Class
# ============================================

class Lock:
    """Mutual exclusion lock.

    Basic synchronization primitive.
    """

    def __init__(self):
        self._lock = vp_lock_create()
        self._owner = None

    def acquire(self, blocking=True, timeout=-1) -> bool:
        """Acquire the lock.

        Args:
            blocking: Wait for lock if True
            timeout: Maximum wait time in seconds

        Returns:
            True if acquired, False otherwise
        """
        result = vp_lock_acquire(self._lock, blocking, timeout)
        if result:
            self._owner = current_thread()
        return result

    def release(self):
        """Release the lock."""
        vp_lock_release(self._lock)
        self._owner = None

    def locked(self) -> bool:
        """Check if lock is held."""
        return vp_lock_locked(self._lock)

    def __enter__(self):
        self.acquire()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.release()
        return False


class RLock:
    """Reentrant lock.

    Can be acquired multiple times by same thread.
    """

    def __init__(self):
        self._lock = vp_rlock_create()
        self._owner = None
        self._count = 0

    def acquire(self, blocking=True, timeout=-1) -> bool:
        """Acquire the lock."""
        result = vp_rlock_acquire(self._lock, blocking, timeout)
        if result:
            self._count = self._count + 1
        return result

    def release(self):
        """Release the lock."""
        self._count = self._count - 1
        if self._count <= 0:
            vp_rlock_release(self._lock)
            self._owner = None

    def locked(self) -> bool:
        """Check if lock is held."""
        return vp_rlock_locked(self._lock)

    def __enter__(self):
        self.acquire()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.release()
        return False


# ============================================
# Semaphore Classes
# ============================================

class Semaphore:
    """Semaphore with counter.

    Allows limited number of acquirers.
    """

    def __init__(self, value=1):
        self._semaphore = vp_semaphore_create(value)
        self._value = value

    def acquire(self, blocking=True, timeout=None) -> bool:
        """Acquire semaphore."""
        return vp_semaphore_acquire(self._semaphore, blocking, timeout)

    def release(self, n=1):
        """Release semaphore."""
        for i in range(n):
            vp_semaphore_release(self._semaphore)

    def __enter__(self):
        self.acquire()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.release()
        return False


class BoundedSemaphore(Semaphore):
    """Semaphore that checks upper bound."""

    def __init__(self, value=1):
        super().__init__(value)
        self._initial_value = value
        self._current_value = value

    def release(self, n=1):
        """Release semaphore with bound check."""
        self._current_value = self._current_value + n
        if self._current_value > self._initial_value:
            raise ValueError("Semaphore released too many times")
        super().release(n)


# ============================================
# Event Class
# ============================================

class Event:
    """Event flag for thread communication."""

    def __init__(self):
        self._event = vp_event_create()
        self._flag = False

    def is_set(self) -> bool:
        """Check if flag is set."""
        return self._flag

    def isSet(self) -> bool:
        """Check if flag is set (deprecated)."""
        return self.is_set()

    def set(self):
        """Set the flag."""
        vp_event_set(self._event)
        self._flag = True

    def clear(self):
        """Clear the flag."""
        vp_event_clear(self._event)
        self._flag = False

    def wait(self, timeout=None) -> bool:
        """Wait for flag to be set."""
        result = vp_event_wait(self._event, timeout)
        return result


# ============================================
# Condition Class
# ============================================

class Condition:
    """Condition variable for complex synchronization."""

    def __init__(self, lock=None):
        self._lock = lock if lock else RLock()
        self._condition = vp_condition_create(self._lock._lock if hasattr(self._lock, '_lock') else None)
        self._waiters = 0

    def acquire(self, *args):
        """Acquire underlying lock."""
        return self._lock.acquire(*args)

    def release(self):
        """Release underlying lock."""
        self._lock.release()

    def wait(self, timeout=None) -> bool:
        """Wait for notification."""
        self._waiters = self._waiters + 1
        self.release()
        result = vp_condition_wait(self._condition, timeout)
        self.acquire()
        self._waiters = self._waiters - 1
        return result

    def wait_for(self, predicate, timeout=None) -> bool:
        """Wait until predicate is true."""
        end_time = None
        if timeout is not None:
            import time
            end_time = time.time() + timeout

        while not predicate():
            if timeout is not None:
                import time
                remaining = end_time - time.time()
                if remaining <= 0:
                    return predicate()
                if not self.wait(remaining):
                    return predicate()
            else:
                self.wait()

        return True

    def notify(self, n=1):
        """Wake up n waiting threads."""
        for i in range(n):
            vp_condition_notify(self._condition)

    def notify_all(self):
        """Wake up all waiting threads."""
        vp_condition_notify_all(self._condition)

    def __enter__(self):
        self.acquire()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.release()
        return False


# ============================================
# Thread-Local Data
# ============================================

class local:
    """Thread-local data storage.

    Each thread has independent copy of attributes.
    """

    def __init__(self):
        self._data = {}

    def __getattr__(self, name):
        ident = current_thread().ident
        if ident not in self._data:
            self._data[ident] = {}
        if name not in self._data[ident]:
            raise AttributeError("No attribute: " + name)
        return self._data[ident][name]

    def __setattr__(self, name, value):
        if name.startswith('_'):
            object.__setattr__(self, name, value)
            return
        ident = current_thread().ident
        if ident not in self._data:
            self._data[ident] = {}
        self._data[ident][name] = value

    def __delattr__(self, name):
        ident = current_thread().ident
        if ident in self._data and name in self._data[ident]:
            del self._data[ident][name]
        else:
            raise AttributeError("No attribute: " + name)


# ============================================
# Module Functions
# ============================================

def current_thread():
    """Get current Thread object."""
    return vp_thread_current()


def currentThread():
    """Get current Thread (deprecated)."""
    return current_thread()


def active_count() -> int:
    """Get number of active Thread objects."""
    return vp_thread_active_count()


def activeCount() -> int:
    """Get number of active threads (deprecated)."""
    return active_count()


def enumerate() -> [Thread]:
    """Get list of all active Thread objects."""
    return vp_thread_enumerate()


def get_ident() -> int:
    """Get current thread identifier."""
    return vp_thread_get_ident()


def get_native_id() -> int:
    """Get current thread native ID."""
    return vp_thread_get_native_id()


def main_thread() -> Thread:
    """Get main Thread object."""
    return vp_thread_main()


def setprofile(func):
    """Set profile function for all threads."""
    vp_thread_setprofile(func)


def settrace(func):
    """Set trace function for all threads."""
    vp_thread_settrace(func)


# ============================================
# Barrier Class
# ============================================

class Barrier:
    """Synchronization barrier.

    Blocks threads until all reach the barrier.
    """

    def __init__(self, parties: int, action=None, timeout=None):
        self.parties = parties
        self.action = action
        self.timeout = timeout
        self._barrier = vp_barrier_create(parties, action, timeout)
        self._count = 0

    def wait(self, timeout=None) -> int:
        """Wait at barrier.

        Returns:
            Index 0 to parties-1
        """
        result = vp_barrier_wait(self._barrier, timeout)
        self._count = self._count + 1
        return result

    def reset(self):
        """Reset barrier to initial state."""
        vp_barrier_reset(self._barrier)
        self._count = 0

    def abort(self):
        """Abort barrier, putting threads in error state."""
        vp_barrier_abort(self._barrier)

    @property
    def n_waiting(self) -> int:
        """Number of threads waiting."""
        return vp_barrier_n_waiting(self._barrier)

    @property
    def broken(self) -> bool:
        """Check if barrier is broken."""
        return vp_barrier_broken(self._barrier)


# ============================================
# Timer Class
# ============================================

class Timer(Thread):
    """Thread that runs function after delay."""

    def __init__(self, interval, function, args=(), kwargs=None):
        super().__init__(target=function, args=args, kwargs=kwargs)
        self.interval = interval
        self.finished = Event()

    def cancel(self):
        """Stop the timer."""
        self.finished.set()

    def run(self):
        """Wait then run function."""
        if not self.finished.wait(self.interval):
            self._target(*self._args, **self._kwargs)


# ============================================
# Local Proxy
# ============================================

class _ThreadLocalProxy:
    """Proxy for thread-local storage."""

    def __init__(self, name):
        self._name = name

    def __get__(self, obj, objtype=None):
        if obj is None:
            return self
        return getattr(local(), self._name)

    def __set__(self, obj, value):
        setattr(local(), self._name, value)


