
def time() -> float:
    return vp_time_time()

def monotonic() -> float:
    return vp_time_monotonic()

def perf_counter() -> float:
    return vp_time_perf_counter()

def sleep(seconds: float):
    vp_time_sleep(seconds)

def sleep_ms(milliseconds: int):
    vp_time_sleep(float(milliseconds) / 1000.0)

def sleep_us(microseconds: int):
    vp_time_sleep(float(microseconds) / 1000000.0)

extern "C" def vp_time_time() -> float
extern "C" def vp_time_monotonic() -> float
extern "C" def vp_time_perf_counter() -> float
extern "C" def vp_time_sleep(seconds: float)

struct struct_time:
    tm_year: int
    tm_mon: int
    tm_mday: int
    tm_hour: int
    tm_min: int
    tm_sec: int
    tm_wday: int
    tm_yday: int
    tm_isdst: int

def gmtime(timestamp: float) -> struct_time:
    return struct_time(0,0,0,0,0,0,0,0,0)

def localtime(timestamp: float) -> struct_time:
    return struct_time(0,0,0,0,0,0,0,0,0)

def mktime(t: struct_time) -> float:
    return 0.0

def strftime(format: str, t: struct_time) -> str:
    return ""

def strptime(string: str, format: str) -> struct_time:
    return struct_time(0,0,0,0,0,0,0,0,0)

def asctime(t: struct_time) -> str:
    return ""

def ctime(timestamp: float) -> str:
    return ""

def tzname() -> tuple[str, str]:
    return ("UTC", "UTC")
