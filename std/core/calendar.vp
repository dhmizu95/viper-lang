# Viper Standard Library - calendar module
# Calendar utilities and date calculations

# Module metadata
__name__ = "calendar"
__version__ = "0.4.7"

# ============================================
# Constants
# ============================================

# Day of week constants
MONDAY = 0
TUESDAY = 1
WEDNESDAY = 2
THURSDAY = 3
FRIDAY = 4
SATURDAY = 5
SUNDAY = 6

# Month constants
JANUARY = 1
FEBRUARY = 2
MARCH = 3
APRIL = 4
MAY = 5
JUNE = 6
JULY = 7
AUGUST = 8
SEPTEMBER = 9
OCTOBER = 10
NOVEMBER = 11
DECEMBER = 12

# Month names
month_name = [
    "",
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
]

month_abbr = [
    "",
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
]

# Day names
day_name = [
    "Monday", "Tuesday", "Wednesday", "Thursday",
    "Friday", "Saturday", "Sunday"
]

day_abbr = [
    "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"
]

# Days in months (non-leap year)
_days_in_month = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

# ============================================
# Year Functions
# ============================================

def isleap(year: int) -> bool:
    """Check if year is a leap year.

    Args:
        year: Year to check

    Returns:
        True if leap year

    Example:
        isleap(2000) -> True
        isleap(1900) -> False
        isleap(2024) -> True
    """
    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)


def leapdays(y1: int, y2: int) -> int:
    """Count leap years in range [y1, y2).

    Args:
        y1: Start year (inclusive)
        y2: End year (exclusive)

    Returns:
        Number of leap years
    """
    count = 0
    for year in range(y1, y2):
        if isleap(year):
            count = count + 1
    return count


def weekday(year: int, month: int, day: int) -> int:
    """Return day of week (0=Monday, 6=Sunday).

    Uses Zeller's congruence algorithm.

    Args:
        year: Year
        month: Month (1-12)
        day: Day of month

    Returns:
        Day of week (0-6)
    """
    # Adjust for January and February
    if month < 3:
        month = month + 12
        year = year - 1

    q = day
    m = month
    k = year % 100
    j = year // 100

    h = (q + (13 * (m + 1)) // 25 + k + k // 4 + j // 4 - 2 * j) % 7

    # Convert from Zeller (0=Saturday) to ISO (0=Monday)
    return (h + 5) % 7


def monthrange(year: int, month: int) -> tuple:
    """Return (weekday of first day, number of days) for month.

    Args:
        year: Year
        month: Month (1-12)

    Returns:
        Tuple of (weekday, days_in_month)
    """
    if month < 1 or month > 12:
        raise ValueError("month must be 1-12")

    days = _days_in_month[month]
    if month == 2 and isleap(year):
        days = days + 1

    first_weekday = weekday(year, month, 1)
    return (first_weekday, days)


def monthcalendar(year: int, month: int) -> [[int]]:
    """Return matrix of weeks in month.

    Args:
        year: Year
        month: Month (1-12)

    Returns:
        List of weeks, each week is list of 7 days
        Days outside month are 0
    """
    first_weekday, days_in_month = monthrange(year, month)

    # Build calendar
    calendar = []
    week = [0] * 7

    # Fill first week
    for i in range(first_weekday, 7):
        week[i] = i - first_weekday + 1
    calendar.append(week)

    # Fill remaining weeks
    day = 8 - first_weekday
    while day <= days_in_month:
        week = []
        for i in range(7):
            if day <= days_in_month:
                week.append(day)
                day = day + 1
            else:
                week.append(0)
        calendar.append(week)

    return calendar


# ============================================
# Calendar Formatting
# ============================================

def month(year: int, month: int, w=2, l=1, c=6) -> str:
    """Return month calendar as string.

    Args:
        year: Year
        month: Month (1-12)
        w: Date column width
        l: Lines per week
        c: Columns between months

    Returns:
        Formatted month calendar string
    """
    cal = monthcalendar(year, month)

    # Header
    header = month_name[month] + " " + str(year)
    header = header.center(7 * (w + 1) + c)

    # Day names
    days_header = " ".join(day_abbr[i] for i in range(7))

    # Build weeks
    weeks = []
    for week in cal:
        week_str = " ".join(
            str(d).rjust(w) if d != 0 else " " * w
            for d in week
        )
        weeks.append(week_str)

    return header + "\n" + days_header + "\n" + "\n".join(weeks)


def prmonth(year: int, month: int, w=2, l=1, c=6):
    """Print month calendar.

    Args:
        year: Year
        month: Month (1-12)
        w: Date column width
        l: Lines per week
        c: Columns between months
    """
    print(month(year, month, w, l, c))


def calendar(year: int, w=2, l=1, c=6, m=3) -> str:
    """Return year calendar as string.

    Args:
        year: Year
        w: Date column width
        l: Lines per week
        c: Columns between months
        m: Months per row

    Returns:
        Formatted year calendar string
    """
    months = []
    for month_num in range(1, 13):
        months.append(monthcalendar(year, month_num))

    # Build year calendar
    lines = [str(year).center(80)]
    lines.append("")

    for row in range(0, 12, m):
        # Month headers
        header_line = ""
        for col in range(m):
            if row + col < 12:
                month_num = row + col + 1
                header = month_name[month_num]
                header_line = header_line + header.center(22)
        lines.append(header_line)

        # Day headers
        days_header = " ".join(day_abbr[i].center(3) for i in range(7))
        lines.append(days_header)

        # Weeks
        max_weeks = max(len(months[row + col]) for col in range(m) if row + col < 12)
        for week_idx in range(max_weeks):
            week_line = ""
            for col in range(m):
                if row + col < 12:
                    month_cal = months[row + col]
                    if week_idx < len(month_cal):
                        week = month_cal[week_idx]
                        week_str = " ".join(
                            str(d).rjust(2) if d != 0 else "  "
                            for d in week
                        )
                        week_line = week_line + week_str + "  "
            lines.append(week_line)

        lines.append("")

    return "\n".join(lines)


def prcal(year: int, w=2, l=1, c=6, m=3):
    """Print year calendar.

    Args:
        year: Year
        w: Date column width
        l: Lines per week
        c: Columns between months
        m: Months per row
    """
    print(calendar(year, w, l, c, m))


# ============================================
# Date Calculations
# ============================================

def Easter(year: int) -> tuple:
    """Calculate Easter date for year.

    Uses Gauss's algorithm.

    Args:
        year: Year

    Returns:
        Tuple of (month, day)
    """
    a = year % 19
    b = year // 100
    c = year % 100
    d = b // 4
    e = b % 4
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i = c // 4
    k = c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * l) // 451

    month = (h + l - 7 * m + 114) // 31
    day = ((h + l - 7 * m + 114) % 31) + 1

    return (month, day)


def day_of_year(year: int, month: int, day: int) -> int:
    """Return day of year (1-366).

    Args:
        year: Year
        month: Month (1-12)
        day: Day of month

    Returns:
        Day of year
    """
    days = 0
    for m in range(1, month):
        days = days + _days_in_month[m]
        if m == 2 and isleap(year):
            days = days + 1
    days = days + day
    return days


def date_from_day_of_year(year: int, day_of_year: int) -> tuple:
    """Return (month, day) from day of year.

    Args:
        year: Year
        day_of_year: Day of year (1-366)

    Returns:
        Tuple of (month, day)
    """
    remaining = day_of_year
    for month in range(1, 13):
        days_in_month = _days_in_month[month]
        if month == 2 and isleap(year):
            days_in_month = days_in_month + 1

        if remaining <= days_in_month:
            return (month, remaining)
        remaining = remaining - days_in_month

    return (12, remaining)


# ============================================
# Calendar Class
# ============================================

class Calendar:
    """Calendar object for generating calendars.

    Args:
        firstweekday: First day of week (0=Monday, 6=Sunday)
    """

    def __init__(self, firstweekday=MONDAY):
        self.firstweekday = firstweekday

    def getfirstweekday(self) -> int:
        """Get first weekday."""
        return self.firstweekday

    def setfirstweekday(self, firstweekday: int):
        """Set first weekday."""
        self.firstweekday = firstweekday

    def iterweekdays(self):
        """Iterate over weekday numbers."""
        for i in range(7):
            yield (self.firstweekday + i) % 7

    def itermonthdates(self, year: int, month: int):
        """Iterate over all dates in month including padding.

        Yields:
            Tuples of (year, month, day)
        """
        first_weekday, days_in_month = monthrange(year, month)

        # Add padding days from previous month
        prev_month = month - 1
        prev_year = year
        if prev_month < 1:
            prev_month = 12
            prev_year = prev_year - 1

        _, prev_days = monthrange(prev_year, prev_month)

        for i in range(first_weekday - 1, -1, -1):
            yield (prev_year, prev_month, prev_days - i)

        # Add days in current month
        for day in range(1, days_in_month + 1):
            yield (year, month, day)

        # Add padding days from next month
        next_month = month + 1
        next_year = year
        if next_month > 12:
            next_month = 1
            next_year = next_year + 1

        total_days = first_weekday + days_in_month
        remaining = 7 - (total_days % 7)
        if remaining < 7:
            for day in range(1, remaining + 1):
                yield (next_year, next_month, day)

    def itermonthdays(self, year: int, month: int):
        """Iterate over day numbers in month.

        Days outside month are 0.

        Yields:
            Day numbers
        """
        cal = monthcalendar(year, month)
        for week in cal:
            for day in week:
                yield day

    def monthdatescalendar(self, year: int, month: int) -> [[tuple]]:
        """Return matrix of dates for month.

        Returns:
            List of weeks, each week is list of (year, month, day) tuples
        """
        return list(self.itermonthdates(year, month))

    def yeardatescalendar(self, year: int, width=3) -> [[[tuple]]]:
        """Return year calendar with dates.

        Args:
            year: Year
            width: Months per row

        Returns:
            List of rows, each row is list of months, each month is list of weeks
        """
        result = []
        for row in range(0, 12, width):
            row_data = []
            for col in range(width):
                if row + col < 12:
                    month_num = row + col + 1
                    row_data.append(monthcalendar(year, month_num))
            result.append(row_data)
        return result


# ============================================
# Helper Classes
# ============================================

class TextCalendar(Calendar):
    """Text calendar generator."""

    def __init__(self, firstweekday=MONDAY):
        super().__init__(firstweekday)
        self.w = 2  # Date width
        self.l = 1  # Lines per week
        self.c = 6  # Column spacing

    def formatmonth(self, year: int, month: int) -> str:
        """Format month as text."""
        return month(year, month, self.w, self.l, self.c)

    def formatyear(self, year: int, width=3) -> str:
        """Format year as text."""
        return calendar(year, self.w, self.l, self.c, width)

    def prmonth(self, year: int, month: int):
        """Print month."""
        print(self.formatmonth(year, month))

    def pryear(self, year: int, width=3):
        """Print year."""
        print(self.formatyear(year, width))


class HTMLCalendar(Calendar):
    """HTML calendar generator."""

    def __init__(self, firstweekday=MONDAY):
        super().__init__(firstweekday)

    def formatmonth(self, year: int, month: int, withyear=True) -> str:
        """Format month as HTML table."""
        cal = monthcalendar(year, month)

        html = ['<table class="calendar">']

        # Header
        header = month_name[month]
        if withyear:
            header = header + " " + str(year)
        html.append('<tr><th colspan="7">' + header + '</th></tr>')

        # Day names
        html.append('<tr>')
        for day in self.iterweekdays():
            html.append('<th>' + day_abbr[day] + '</th>')
        html.append('</tr>')

        # Weeks
        for week in cal:
            html.append('<tr>')
            for day in week:
                if day == 0:
                    html.append('<td class="empty"></td>')
                else:
                    html.append('<td>' + str(day) + '</td>')
            html.append('</tr>')

        html.append('</table>')
        return '\n'.join(html)

    def formatyear(self, year: int, width=3) -> str:
        """Format year as HTML."""
        html = ['<div class="year-calendar">']
        html.append('<h2>' + str(year) + '</h2>')

        for row in range(0, 12, width):
            html.append('<div class="year-row">')
            for col in range(width):
                if row + col < 12:
                    month_num = row + col + 1
                    html.append('<div class="month">')
                    html.append(self.formatmonth(year, month_num))
                    html.append('</div>')
            html.append('</div>')

        html.append('</div>')
        return '\n'.join(html)


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test calendar functionality."""
    print("Testing calendar module...")

    # Test isleap
    print("  Testing isleap...")
    print("    isleap(2000): " + str(isleap(2000)))
    print("    isleap(1900): " + str(isleap(1900)))
    print("    isleap(2024): " + str(isleap(2024)))

    # Test weekday
    print("  Testing weekday...")
    wd = weekday(2024, 1, 1)
    print("    weekday(2024, 1, 1): " + day_name[wd])

    # Test monthrange
    print("  Testing monthrange...")
    first, days = monthrange(2024, 2)
    print("    monthrange(2024, 2): first=" + day_name[first] + ", days=" + str(days))

    # Test monthcalendar
    print("  Testing monthcalendar...")
    cal = monthcalendar(2024, 1)
    print("    January 2024 has " + str(len(cal)) + " weeks")

    # Test month string
    print("  Testing month string...")
    month_str = month(2024, 1)
    for line in month_str.split('\n'):
        print("    " + line)

    # Test Easter
    print("  Testing Easter...")
    easter_month, easter_day = Easter(2024)
    print("    Easter 2024: " + month_name[easter_month] + " " + str(easter_day))

    # Test day_of_year
    print("  Testing day_of_year...")
    doy = day_of_year(2024, 3, 1)
    print("    March 1, 2024 is day " + str(doy))

    # Test Calendar class
    print("  Testing Calendar class...")
    cal = Calendar()
    print("    First weekday: " + str(cal.getfirstweekday()))

    # Test TextCalendar
    print("  Testing TextCalendar...")
    tc = TextCalendar()
    tc.prmonth(2024, 1)

    print("calendar tests completed!")
