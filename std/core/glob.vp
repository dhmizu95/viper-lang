# Viper Standard Library - glob module
# Unix pathname pattern matching

# Module metadata
__name__ = "glob"
__version__ = "0.4.7"

from os import listdir, path_isdir, path_exists
from os.path import join, basename, dirname

# ============================================
# Main Functions
# ============================================

def glob(pathname: str, recursive: bool = False) -> [str]:
    """Find pathnames matching pattern.

    Uses Unix shell-style wildcards:
    *       - matches everything except path separator
    **      - matches everything including directories (with recursive=True)
    ?       - matches any single character
    [seq]   - matches any character in seq
    [!seq]  - matches any character not in seq

    Args:
        pathname: Pattern to match
        recursive: If True, ** matches any subdirectories

    Returns:
        List of matching paths (sorted)

    Example:
        glob('*.txt') -> ['a.txt', 'b.txt']
        glob('**/*.py', recursive=True) -> ['a.py', 'dir/b.py']
    """
    results = _iglob(pathname, recursive)
    return sorted(results)


def iglob(pathname: str, recursive: bool = False):
    """Iterator yielding matching paths.

    Like glob() but returns an iterator for memory efficiency.

    Args:
        pathname: Pattern to match
        recursive: If True, ** matches any subdirectories

    Yields:
        Matching paths
    """
    dirname_part = dirname(pathname)
    basename_part = basename(pathname)

    # Handle absolute vs relative paths
    if dirname_part == '':
        dirname_part = '.'

    # Check if dirname has wildcards
    if _has_magic(dirname_part):
        if recursive and '**' in dirname_part:
            # Handle ** in directory part
            for dirpath in _glob2(dirname_part, recursive):
                for name in _glob1(dirpath, basename_part):
                    yield join(dirpath, name)
        else:
            for dirpath in _glob2(dirname_part, False):
                for name in _glob1(dirpath, basename_part):
                    yield join(dirpath, name)
    else:
        # Simple case - dirname is literal
        for name in _glob1(dirname_part, basename_part):
            yield join(dirname_part, name)


def escape(pathname: str) -> str:
    """Escape special characters in pathname.

    Adds backslash before *, ?, and [...] to treat them literally.

    Args:
        pathname: Pathname to escape

    Returns:
        Escaped pathname

    Example:
        escape('file*.txt') -> 'file[*].txt'
    """
    result = []
    for char in pathname:
        if char in '*?[':
            result.append('[')
            result.append(char)
            result.append(']')
        else:
            result.append(char)
    return "".join(result)


# ============================================
# Internal Functions
# ============================================

def _has_magic(s: str) -> bool:
    """Check if string contains wildcards."""
    i = 0
    while i < len(s):
        if s[i] == '*':
            return True
        elif s[i] == '?':
            return True
        elif s[i] == '[':
            # Find closing ]
            j = i + 1
            if j < len(s) and s[j] in '!^':
                j = j + 1
            if j < len(s) and s[j] == ']':
                j = j + 1
            while j < len(s) and s[j] != ']':
                j = j + 1
            if j < len(s):
                return True
        i = i + 1
    return False


def _glob1(dirname: str, pattern: str) -> [str]:
    """Match pattern against entries in directory."""
    if not path_exists(dirname):
        return []

    try:
        names = listdir(dirname)
    except:
        return []

    results = []
    for name in names:
        if _fnmatch(name, pattern):
            results.append(name)

    return results


def _glob2(dirname: str, pattern: str, recursive: bool = False) -> [str]:
    """Recursively find matching directories."""
    if not path_exists(dirname):
        return []

    results = []

    # Check if pattern contains **
    if '**' in pattern:
        parts = pattern.split('**', 1)
        prefix = parts[0]
        suffix = parts[1] if len(parts) > 1 else ''

        # Add current directory if prefix matches
        if prefix == '' or prefix == '/':
            results.append(dirname)

        # Recurse into subdirectories
        try:
            names = listdir(dirname)
        except:
            return results

        for name in names:
            if name.startswith('.'):
                continue  # Skip hidden directories
            subdir = join(dirname, name)
            if path_isdir(subdir):
                results.append(subdir)
                # Recurse
                new_pattern = '**' + suffix
                results.extend(_glob2(subdir, new_pattern, True))
    else:
        # Simple glob
        results = _glob1(dirname, pattern)

    return results


def _fnmatch(name: str, pattern: str) -> bool:
    """Match name against pattern using shell-style wildcards."""
    return _fnmatch_case(name, pattern)


def _fnmatch_case(name: str, pattern: str) -> bool:
    """Case-sensitive filename match."""
    return _fnmatch_impl(name, pattern, 0, 0)


def _fnmatch_impl(name: str, pattern: str, i: int, j: int) -> bool:
    """Recursive pattern matching implementation."""
    # Base cases
    if i >= len(pattern):
        return j >= len(name)

    if j >= len(name):
        # Check if remaining pattern can match empty string
        while i < len(pattern):
            if pattern[i] == '*':
                i = i + 1
            else:
                return False
        return True

    # Handle pattern characters
    pc = pattern[i]

    if pc == '*':
        # * matches zero or more characters
        # Try matching zero characters
        if _fnmatch_impl(name, pattern, i + 1, j):
            return True

        # Try matching one or more characters
        for k in range(j, len(name) + 1):
            if _fnmatch_impl(name, pattern, i + 1, k):
                return True

        return False

    elif pc == '?':
        # ? matches exactly one character
        return _fnmatch_impl(name, pattern, i + 1, j + 1)

    elif pc == '[':
        # Character class
        k = i + 1

        # Check for negation
        negate = False
        if k < len(pattern) and pattern[k] in '!^':
            negate = True
            k = k + 1

        # Find closing ]
        match = False
        chars = []
        while k < len(pattern) and pattern[k] != ']':
            c = pattern[k]

            # Check for range (a-z)
            if k + 2 < len(pattern) and pattern[k + 1] == '-' and pattern[k + 2] != ']':
                start = ord(c)
                end = ord(pattern[k + 2])
                for code in range(start, end + 1):
                    chars.append(chr(code))
                k = k + 3
            else:
                chars.append(c)
                k = k + 1

        if k < len(pattern):
            # Found closing ]
            if j < len(name):
                nc = name[j]
                match = nc in chars

            if negate:
                match = not match

            if match:
                return _fnmatch_impl(name, pattern, k + 1, j + 1)
            else:
                return False
        else:
            # No closing ] - treat [ as literal
            if j < len(name) and name[j] == pc:
                return _fnmatch_impl(name, pattern, i + 1, j + 1)
            return False

    else:
        # Literal character
        if j < len(name) and name[j] == pc:
            return _fnmatch_impl(name, pattern, i + 1, j + 1)
        return False


# ============================================
# Helper Functions
# ============================================

def _filter(names: [str], pattern: str) -> [str]:
    """Filter list of names by pattern."""
    results = []
    for name in names:
        if _fnmatch(name, pattern):
            results.append(name)
    return results


def _iterdir(path: str) -> [str]:
    """Iterate over directory entries."""
    try:
        return listdir(path)
    except:
        return []


def _isdir(path: str) -> bool:
    """Check if path is directory."""
    return path_isdir(path)


def _exists(path: str) -> bool:
    """Check if path exists."""
    return path_exists(path)


# ============================================
# Extended Pattern Matching
# ============================================

def translate(pattern: str) -> str:
    """Translate shell pattern to regex.

    Args:
        pattern: Shell pattern

    Returns:
        Regular expression string
    """
    i = 0
    n = len(pattern)
    result = ""

    while i < n:
        c = pattern[i]

        if c == '*':
            result = result + ".*"
        elif c == '?':
            result = result + "."
        elif c == '[':
            j = i + 1
            if j < n and pattern[j] in '!^':
                j = j + 1
            if j < n and pattern[j] == ']':
                j = j + 1
            while j < n and pattern[j] != ']':
                j = j + 1
            if j >= n:
                result = result + "\\["
            else:
                stuff = pattern[i + 1:j]
                if stuff[0] in '!^':
                    stuff = "^" + stuff[1:]
                stuff = stuff.replace("\\", "\\\\")
                result = result + "[" + stuff + "]"
                i = j
        else:
            result = result + (c if c.isalnum() or c in '._-/' else "\\" + c)

        i = i + 1

    return "^" + result + "$"


# ============================================
# Convenience Functions
# ============================================

def find_all(pattern: str, root: str = ".") -> [str]:
    """Find all matching files under root directory.

    Args:
        pattern: Pattern to match
        root: Root directory to search

    Returns:
        List of full paths to matching files
    """
    results = []

    def search(dirpath):
        try:
            names = listdir(dirpath)
        except:
            return

        for name in names:
            full_path = join(dirpath, name)
            if _fnmatch(name, pattern):
                results.append(full_path)
            if path_isdir(full_path):
                search(full_path)

    search(root)
    return sorted(results)


def find_first(pattern: str, root: str = ".") -> str:
    """Find first matching file.

    Args:
        pattern: Pattern to match
        root: Root directory to search

    Returns:
        First matching path or None
    """
    matches = find_all(pattern, root)
    if matches:
        return matches[0]
    return None


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test glob functionality."""
    print("Testing glob module...")

    # Test basic pattern matching
    print("  Testing _fnmatch...")
    tests = [
        ("test.txt", "*.txt", True),
        ("test.py", "*.txt", False),
        ("test.txt", "test.*", True),
        ("test.txt", "t?st.txt", True),
        ("test.txt", "t[aeiou]st.txt", True),
        ("test.txt", "t[!aeiou]st.txt", False),
        ("abc", "a*c", True),
        ("axbycz", "a*c", False),
        ("file1.txt", "file?.txt", True),
        ("file10.txt", "file?.txt", False),
    ]

    for name, pattern, expected in tests:
        result = _fnmatch(name, pattern)
        status = "OK" if result == expected else "FAIL"
        print("    " + status + ": '" + name + "' vs '" + pattern + "' = " + str(result))

    # Test escape
    print("  Testing escape...")
    escaped = escape("file*.txt")
    print("    escape('file*.txt') = '" + escaped + "'")

    # Test translate
    print("  Testing translate...")
    regex = translate("*.txt")
    print("    translate('*.txt') = '" + regex + "'")

    # Test glob on current directory
    print("  Testing glob on current directory...")
    try:
        matches = glob("*.vp")
        print("    *.vp files: " + str(len(matches)) + " found")
        if matches:
            print("      First: " + matches[0])
    except Exception as e:
        print("    Note: " + str(e))

    print("glob tests completed!")
