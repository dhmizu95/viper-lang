# Viper Standard Library - configparser module
# Configuration file parsing (INI format)

# Module metadata
__name__ = "configparser"
__version__ = "0.4.7"

# ============================================
# Exceptions
# ============================================

class Error(Exception):
    """Base class for configparser exceptions."""
    pass


class NoSectionError(Error):
    """Raised when section is not found."""
    def __init__(self, section):
        self.section = section
        super().__init__("No section: " + section)


class DuplicateSectionError(Error):
    """Raised when section is duplicated."""
    def __init__(self, section):
        self.section = section
        super().__init__("Section already exists: " + section)


class NoOptionError(Error):
    """Raised when option is not found."""
    def __init__(self, option, section):
        self.option = option
        self.section = section
        super().__init__("No option '" + option + "' in section '" + section + "'")


class DuplicateOptionError(Error):
    """Raised when option is duplicated."""
    def __init__(self, option, section):
        self.option = option
        self.section = section
        super().__init__("Duplicate option: " + option)


class InterpolationError(Error):
    """Raised when interpolation fails."""
    pass


class MissingInterpolationError(InterpolationError):
    """Raised when interpolation variable is missing."""
    pass


# ============================================
# ConfigParser Class
# ============================================

class ConfigParser:
    """Configuration file parser (INI format).

    Reads and writes INI-style configuration files.

    Args:
        defaults: Default values for all sections
        dict_type: Dict class to use (default dict)
        allow_no_value: Allow options without values
        delimiters: Option/value delimiters
        comment_prefixes: Comment prefixes
        inline_comment_prefixes: Inline comment prefixes
        strict: Raise on duplicates
        empty_lines_in_values: Allow empty lines in values
        interpolation: Interpolation method

    Example:
        config = ConfigParser()
        config.read('config.ini')
        value = config.get('section', 'option')
    """

    def __init__(self, defaults=None, dict_type=None,
                 allow_no_value=False, delimiters=('=', ':'),
                 comment_prefixes=('#', ';'),
                 inline_comment_prefixes=None,
                 strict=True, empty_lines_in_values=True,
                 interpolation='basic'):
        self._defaults = defaults if defaults else {}
        self._dict_type = dict_type if dict_type else dict
        self._allow_no_value = allow_no_value
        self._delimiters = delimiters
        self._comment_prefixes = comment_prefixes
        self._inline_comment_prefixes = inline_comment_prefixes
        self._strict = strict
        self._empty_lines_in_values = empty_lines_in_values
        self._interpolation = interpolation

        self._sections = self._dict_type()
        self._sections['DEFAULT'] = self._dict_type()

        # Copy defaults
        for key, value in self._defaults.items():
            self._sections['DEFAULT'][key] = value

    def defaults(self) -> dict:
        """Return default values."""
        return dict(self._defaults)

    def sections(self) -> [str]:
        """Return list of section names."""
        result = []
        for section in self._sections:
            if section != 'DEFAULT':
                result.append(section)
        return result

    def add_section(self, section: str):
        """Add a new section.

        Raises:
            DuplicateSectionError: If section exists
        """
        if section in self._sections:
            raise DuplicateSectionError(section)
        self._sections[section] = self._dict_type()

    def has_section(self, section: str) -> bool:
        """Check if section exists."""
        return section in self._sections and section != 'DEFAULT'

    def remove_section(self, section: str) -> bool:
        """Remove a section.

        Returns:
            True if section was removed
        """
        if section in self._sections and section != 'DEFAULT':
            del self._sections[section]
            return True
        return False

    def options(self, section: str) -> [str]:
        """Return list of options in section."""
        if section not in self._sections:
            raise NoSectionError(section)

        result = []
        for key in self._sections[section]:
            if key not in result:
                result.append(key)
        return result

    def has_option(self, section: str, option: str) -> bool:
        """Check if option exists in section."""
        if section not in self._sections:
            return False
        return option in self._sections[section]

    def set(self, section: str, option: str, value=None):
        """Set option value.

        Creates section if it doesn't exist.
        """
        if section not in self._sections:
            self.add_section(section)

        if option in self._sections[section] and self._strict:
            raise DuplicateOptionError(option, section)

        self._sections[section][option] = value if value else ""

    def get(self, section: str, option: str, fallback=None, **kwargs):
        """Get option value as string.

        Args:
            section: Section name
            option: Option name
            fallback: Default value if not found

        Returns:
            Option value or fallback
        """
        if section not in self._sections:
            if fallback is not None:
                return fallback
            raise NoSectionError(section)

        if option not in self._sections[section]:
            if fallback is not None:
                return fallback
            # Check DEFAULT section
            if option in self._sections['DEFAULT']:
                return self._sections['DEFAULT'][option]
            raise NoOptionError(option, section)

        value = self._sections[section][option]

        # Apply interpolation
        if self._interpolation == 'basic':
            value = self._interpolate(value, section, option)

        return value

    def _interpolate(self, value: str, section: str, option: str) -> str:
        """Interpolate variables in value."""
        if '%(' not in value:
            return value

        result = value
        max_iterations = 10
        iteration = 0

        while '%(' in result and iteration < max_iterations:
            iteration = iteration + 1
            start = result.find('%(')
            if start == -1:
                break

            end = result.find(')', start)
            if end == -1:
                break

            var_name = result[start + 2:end]

            # Find value
            if var_name in self._sections[section]:
                replacement = self._sections[section][var_name]
            elif var_name in self._sections['DEFAULT']:
                replacement = self._sections['DEFAULT'][var_name]
            else:
                raise MissingInterpolationError("Missing variable: " + var_name)

            result = result[:start] + replacement + result[end + 1:]

        return result

    def getint(self, section: str, option: str, fallback=None) -> int:
        """Get option value as integer."""
        value = self.get(section, option, fallback)
        if value is None:
            return fallback
        return int(value)

    def getfloat(self, section: str, option: str, fallback=None) -> float:
        """Get option value as float."""
        value = self.get(section, option, fallback)
        if value is None:
            return fallback
        return float(value)

    def getboolean(self, section: str, option: str, fallback=None) -> bool:
        """Get option value as boolean."""
        value = self.get(section, option, fallback)
        if value is None:
            return fallback

        value_lower = value.lower()
        if value_lower in ('true', 'yes', '1', 'on'):
            return True
        if value_lower in ('false', 'no', '0', 'off'):
            return False

        raise ValueError("Not a boolean: " + value)

    def items(self, section: str) -> [(str, str)]:
        """Return list of (option, value) pairs."""
        if section not in self._sections:
            raise NoSectionError(section)

        result = []
        for key in self._sections[section]:
            result.append((key, self._sections[section][key]))
        return result

    def read(self, filenames) -> [str]:
        """Read configuration from files.

        Args:
            filenames: Single filename or list of filenames

        Returns:
            List of successfully read files
        """
        if isinstance(filenames, str):
            filenames = [filenames]

        read_files = []
        for filename in filenames:
            if self._read(filename):
                read_files.append(filename)

        return read_files

    def _read(self, filename: str) -> bool:
        """Read single file."""
        try:
            f = open(filename, 'r')
        except:
            return False

        try:
            content = f.read()
        finally:
            f.close()

        self.read_string(content)
        return True

    def read_string(self, string: str):
        """Read configuration from string."""
        current_section = 'DEFAULT'
        current_option = None
        current_value = None

        for line in string.split('\n'):
            # Strip whitespace
            line = line.strip()

            # Skip empty lines and comments
            if not line or line.startswith(self._comment_prefixes):
                continue

            # Section header
            if line.startswith('[') and line.endswith(']'):
                section = line[1:-1].strip()
                if section not in self._sections:
                    self._sections[section] = self._dict_type()
                    # Copy defaults
                    for key, value in self._defaults.items():
                        self._sections[section][key] = value
                current_section = section
                continue

            # Option
            delimiter_pos = -1
            for delim in self._delimiters:
                pos = line.find(delim)
                if pos > 0:
                    delimiter_pos = pos
                    break

            if delimiter_pos > 0:
                option = line[:delimiter_pos].strip()
                value = line[delimiter_pos + 1:].strip()

                # Handle inline comments
                if self._inline_comment_prefixes:
                    for prefix in self._inline_comment_prefixes:
                        comment_pos = value.find(prefix)
                        if comment_pos > 0:
                            value = value[:comment_pos].strip()

                self._sections[current_section][option] = value

    def read_file(self, file_obj):
        """Read configuration from file object."""
        content = file_obj.read()
        self.read_string(content)

    def readfp(self, fp, filename=None):
        """Read from file pointer (deprecated, use read_file)."""
        self.read_file(fp)

    def write(self, file_obj, space_around_delimiters=True):
        """Write configuration to file.

        Args:
            file_obj: File object to write to
            space_around_delimiters: Add spaces around = delimiter
        """
        for section in self.sections():
            file_obj.write("[" + section + "]\n")
            for option, value in self.items(section):
                if space_around_delimiters:
                    file_obj.write(option + " = " + value + "\n")
                else:
                    file_obj.write(option + "=" + value + "\n")
            file_obj.write("\n")

    def write_file(self, filename):
        """Write configuration to file."""
        f = open(filename, 'w')
        try:
            self.write(f)
        finally:
            f.close()


# ============================================
# RawConfigParser (no interpolation)
# ============================================

class RawConfigParser(ConfigParser):
    """ConfigParser without interpolation."""

    def __init__(self, *args, **kwargs):
        kwargs['interpolation'] = None
        super().__init__(*args, **kwargs)


# ============================================
# SafeConfigParser (deprecated alias)
# ============================================

class SafeConfigParser(ConfigParser):
    """Deprecated alias for ConfigParser."""
    pass


# ============================================
# Interpolation Classes
# ============================================

class BasicInterpolation:
    """Basic interpolation using %(var)s syntax."""
    pass


class ExtendedInterpolation:
    """Extended interpolation using ${section:var} syntax."""
    pass


class LegacyInterpolation:
    """Legacy interpolation ($var and %(var)s)."""
    pass


# ============================================
# Convenience Functions
# ============================================

def parse(filename: str) -> ConfigParser:
    """Parse configuration file.

    Args:
        filename: Path to configuration file

    Returns:
        ConfigParser instance
    """
    config = ConfigParser()
    config.read(filename)
    return config


def read(filename: str) -> ConfigParser:
    """Read configuration file (alias for parse)."""
    return parse(filename)


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test configparser functionality."""
    print("Testing configparser module...")

    # Create test config
    config_content = """
# Database settings
[database]
host = localhost
port = 5432
name = mydb
enabled = true

[server]
host = 0.0.0.0
port = 8080
workers = 4
"""

    # Test parsing
    print("  Testing parse...")
    config = ConfigParser()
    config.read_string(config_content)

    print("    Sections: " + str(config.sections()))

    # Test get
    print("  Testing get...")
    host = config.get('database', 'host')
    print("    database.host = " + host)

    # Test getint
    print("  Testing getint...")
    port = config.getint('database', 'port')
    print("    database.port = " + str(port))

    # Test getboolean
    print("  Testing getboolean...")
    enabled = config.getboolean('database', 'enabled')
    print("    database.enabled = " + str(enabled))

    # Test has_option
    print("  Testing has_option...")
    has_host = config.has_option('database', 'host')
    print("    has database.host: " + str(has_host))

    # Test items
    print("  Testing items...")
    items = config.items('database')
    print("    database items: " + str(items))

    # Test interpolation
    print("  Testing interpolation...")
    interp_config = ConfigParser()
    interp_config.read_string("""
[paths]
base = /usr/local
bin = %(base)s/bin
lib = %(base)s/lib
""")
    bin_path = interp_config.get('paths', 'bin')
    print("    bin path = " + bin_path)

    # Test DEFAULT section
    print("  Testing DEFAULT section...")
    default_config = ConfigParser(defaults={'debug': 'false'})
    default_config.read_string("""
[app]
name = myapp
""")
    debug = default_config.get('app', 'debug')
    print("    app.debug (from DEFAULT) = " + debug)

    print("configparser tests completed!")
