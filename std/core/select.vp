# Viper Standard Library - select module
# I/O multiplexing (select/poll/epoll)

__name__ = "select"
__version__ = "0.4.5"

# ============================================
# Epoll Constants (Linux)
# ============================================

EPOLLIN: int = 0x001       # Readable
EPOLLOUT: int = 0x004      # Writable
EPOLLERR: int = 0x008      # Error
EPOLLHUP: int = 0x010      # Hang up
EPOLLET: int = 0x80000000  # Edge triggered

EPOLL_CTL_ADD: int = 1  # Add fd
EPOLL_CTL_MOD: int = 2  # Modify fd
EPOLL_CTL_DEL: int = 3  # Remove fd

# ============================================
# Poll Constants
# ============================================

POLLIN: int = 0x001     # Readable
POLLPRI: int = 0x002    # Priority readable
POLLOUT: int = 0x004    # Writable
POLLERR: int = 0x008    # Error
POLLHUP: int = 0x010    # Hang up
POLLNVAL: int = 0x020   # Invalid request

# ============================================
# FdSet (for select)
# ============================================

class FdSet:
    """File descriptor set for select()."""
    
    def __init__(self):
        """Create a new fd set."""
        self._fdset = vp_select_fdset_create()
        self._fds = []
    
    def add(self, fd: int):
        """Add a file descriptor."""
        vp_select_fdset_add(self._fdset, fd)
        if fd not in self._fds:
            self._fds.append(fd)
    
    def remove(self, fd: int):
        """Remove a file descriptor."""
        vp_select_fdset_remove(self._fdset, fd)
        if fd in self._fds:
            self._fds.remove(fd)
    
    def contains(self, fd: int) -> bool:
        """Check if fd is in set."""
        return vp_select_fdset_contains(self._fdset, fd) != 0
    
    def clear(self):
        """Clear all fds from set."""
        vp_select_fdset_clear(self._fdset)
        self._fds = []
    
    def get_fds(self) -> list:
        """Get list of fds in set."""
        return self._fds
    
    def __len__(self) -> int:
        """Get number of fds."""
        return len(self._fds)
    
    def __iter__(self):
        """Iterate over fds."""
        return iter(self._fds)
    
    def __contains__(self, fd: int) -> bool:
        """Check if fd is in set."""
        return self.contains(fd)
    
    def close(self):
        """Close the fd set."""
        vp_select_fdset_free(self._fdset)

def select_select(rlist: list, wlist: list, xlist: list, 
                  timeout: float = -1.0) -> tuple:
    """
    Wait for I/O completion.
    
    Args:
        rlist: List of fds to wait for readability
        wlist: List of fds to wait for writability
        xlist: List of fds to wait for exceptions
        timeout: Timeout in seconds (-1 for infinite)
    
    Returns:
        Tuple of (readable, writable, exceptional) fd lists
    """
    # Create fd sets
    read_fds = FdSet()
    write_fds = FdSet()
    error_fds = FdSet()
    
    for fd in rlist:
        read_fds.add(fd)
    for fd in wlist:
        write_fds.add(fd)
    for fd in xlist:
        error_fds.add(fd)
    
    # Call select
    result = vp_select_select(
        read_fds._fdset,
        write_fds._fdset,
        error_fds._fdset,
        timeout
    )
    
    # Extract ready fds (simplified)
    readable = []
    writable = []
    exceptional = []
    
    # In a full implementation, we would check which fds are ready
    # For now, return empty lists
    vp_select_result_free(result)
    
    return (readable, writable, exceptional)

def can_read(fd: int, timeout: float = 0.0) -> bool:
    """Check if fd is ready for reading."""
    return vp_select_can_read(fd, timeout) != 0

def can_write(fd: int, timeout: float = 0.0) -> bool:
    """Check if fd is ready for writing."""
    return vp_select_can_write(fd, timeout) != 0

# ============================================
# Poll
# ============================================

class Poll:
    """Poll object for I/O multiplexing."""
    
    def __init__(self):
        """Create a new poll object."""
        self._fds = {}  # fd -> events
    
    def register(self, fd: int, events: int = POLLIN | POLLOUT):
        """Register a file descriptor."""
        self._fds[fd] = events
    
    def unregister(self, fd: int):
        """Unregister a file descriptor."""
        if fd in self._fds:
            del self._fds[fd]
    
    def poll(self, timeout: float = -1.0) -> list:
        """
        Wait for events.
        
        Returns:
            List of (fd, events) tuples
        """
        # Simplified: return empty list
        # Full implementation would call vp_poll_poll
        return []
    
    def close(self):
        """Close the poll object."""
        self._fds = {}

def poll() -> Poll:
    """Create a new poll object."""
    return Poll()

# ============================================
# Epoll (Linux-specific)
# ============================================

class Epoll:
    """Epoll object for Linux I/O multiplexing."""
    
    def __init__(self, flags: int = 0):
        """Create a new epoll object."""
        self._epfd = vp_epoll_create()
        self._fds = {}  # fd -> events
    
    def fileno(self) -> int:
        """Get epoll file descriptor."""
        return self._epfd
    
    def register(self, fd: int, events: int = EPOLLIN):
        """Register a file descriptor."""
        vp_epoll_ctl(self._epfd, EPOLL_CTL_ADD, fd, events)
        self._fds[fd] = events
    
    def unregister(self, fd: int):
        """Unregister a file descriptor."""
        vp_epoll_ctl(self._epfd, EPOLL_CTL_DEL, fd, 0)
        if fd in self._fds:
            del self._fds[fd]
    
    def modify(self, fd: int, events: int):
        """Modify a file descriptor's events."""
        vp_epoll_ctl(self._epfd, EPOLL_CTL_MOD, fd, events)
        self._fds[fd] = events
    
    def poll(self, timeout: int = -1) -> list:
        """
        Wait for events.
        
        Args:
            timeout: Timeout in milliseconds (-1 for infinite)
        
        Returns:
            List of (fd, events) tuples
        """
        result = vp_epoll_wait(self._epfd, timeout)
        # Simplified: return empty list
        return []
    
    def close(self):
        """Close the epoll object."""
        vp_epoll_free(self._epfd)
        self._fds = {}
    
    def __enter__(self):
        """Context manager entry."""
        return self
    
    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit."""
        self.close()
        return False

def epoll(flags: int = 0) -> Epoll:
    """Create a new epoll object."""
    return Epoll(flags)

# ============================================
# Error Handling
# ============================================

class SelectError(Exception):
    """Select operation error."""
    
    def __init__(self, message: str = ""):
        self.message = message
        super().__init__(message)

def get_error() -> int:
    """Get last select error code."""
    return vp_select_get_error()

def strerror(errcode: int) -> str:
    """Get error message for error code."""
    return vp_select_strerror(errcode)

# ============================================
# Convenience Functions
# ============================================

def wait_for_read(fd: int, timeout: float = -1.0) -> bool:
    """Wait for a file descriptor to become readable."""
    return can_read(fd, timeout)

def wait_for_write(fd: int, timeout: float = -1.0) -> bool:
    """Wait for a file descriptor to become writable."""
    return can_write(fd, timeout)

def wait_for_multiple(fds: list, timeout: float = -1.0) -> list:
    """Wait for multiple fds to become readable."""
    ready = []
    for fd in fds:
        if can_read(fd, 0):
            ready.append(fd)
    if not ready and timeout > 0:
        # Sleep and check again
        import time
        time.sleep(timeout)
        for fd in fds:
            if can_read(fd, 0):
                ready.append(fd)
    return ready

