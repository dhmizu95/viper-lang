# Viper Standard Library - difflib module
# Sequence comparison utilities

# Module metadata
__name__ = "difflib"
__version__ = "0.4.7"

# ============================================
# SequenceMatcher Class
# ============================================

class SequenceMatcher:
    """Find longest matching blocks between sequences.

    Args:
        isjunk: Function to identify junk elements
        a: First sequence
        b: Second sequence
        autojunk: Automatically treat popular elements as junk

    Example:
        s = SequenceMatcher(None, "abc", "axc")
        ratio = s.ratio()
    """

    def __init__(self, isjunk=None, a='', b='', autojunk=True):
        self.isjunk = isjunk
        self.a = a
        self.b = b
        self.autojunk = autojunk
        self._matches = None

    def set_seqs(self, a, b):
        """Set sequences to compare."""
        self.a = a
        self.b = b
        self._matches = None

    def set_seq1(self, a):
        """Set first sequence."""
        self.a = a
        self._matches = None

    def set_seq2(self, b):
        """Set second sequence."""
        self.b = b
        self._matches = None

    def find_longest_match(self, alo=0, ahi=None, blo=0, bhi=None) -> tuple:
        """Find longest matching block.

        Returns:
            Tuple of (a_start, b_start, size)
        """
        if ahi is None:
            ahi = len(self.a)
        if bhi is None:
            bhi = len(self.b)

        best_size = 0
        best_a = alo
        best_b = blo

        # Build index for b
        b_index = {}
        for j in range(blo, bhi):
            elem = self.b[j]
            if self.isjunk and self.isjunk(elem):
                continue
            if elem not in b_index:
                b_index[elem] = []
            b_index[elem].append(j)

        # Find matches
        for i in range(alo, ahi):
            elem = self.a[i]
            if elem not in b_index:
                continue

            for j in b_index[elem]:
                # Count matching elements
                size = 0
                while (i + size < ahi and j + size < bhi and
                       self.a[i + size] == self.b[j + size]):
                    size = size + 1

                if size > best_size:
                    best_size = size
                    best_a = i
                    best_b = j

        return (best_a, best_b, best_size)

    def get_matching_blocks(self) -> [tuple]:
        """Get list of matching blocks.

        Returns:
            List of (a_start, b_start, size) tuples
        """
        if self._matches is not None:
            return self._matches

        matches = []
        self._find_matches(matches, 0, len(self.a), 0, len(self.b))

        # Sort and merge adjacent matches
        matches.sort()
        self._matches = matches
        return matches

    def _find_matches(self, matches, alo, ahi, blo, bhi):
        """Recursively find matches."""
        a_start, b_start, size = self.find_longest_match(alo, ahi, blo, bhi)

        if size > 0:
            # Recurse on left side
            if alo < a_start and blo < b_start:
                self._find_matches(matches, alo, a_start, blo, b_start)

            # Add this match
            matches.append((a_start, b_start, size))

            # Recurse on right side
            if a_start + size < ahi and b_start + size < bhi:
                self._find_matches(matches, a_start + size, ahi, b_start + size, bhi)

    def ratio(self) -> float:
        """Return similarity ratio.

        Returns:
            Float between 0 and 1
        """
        matches = self.get_matching_blocks()
        total_matches = sum(m[2] for m in matches)
        total_len = len(self.a) + len(self.b)

        if total_len == 0:
            return 1.0
        return (2.0 * total_matches) / total_len

    def quick_ratio(self) -> float:
        """Return quick similarity estimate."""
        # Simplified - uses character counts
        a_counts = {}
        b_counts = {}

        for elem in self.a:
            a_counts[elem] = a_counts.get(elem, 0) + 1
        for elem in self.b:
            b_counts[elem] = b_counts.get(elem, 0) + 1

        matches = 0
        for elem in a_counts:
            if elem in b_counts:
                matches = matches + min(a_counts[elem], b_counts[elem])

        total = len(self.a) + len(self.b)
        if total == 0:
            return 1.0
        return (2.0 * matches) / total

    def real_quick_ratio(self) -> float:
        """Return very quick ratio estimate."""
        len_a = len(self.a)
        len_b = len(self.b)
        total = len_a + len_b
        if total == 0:
            return 1.0
        return (2.0 * min(len_a, len_b)) / total

    def get_opcodes(self) -> [tuple]:
        """Get list of operations to transform a to b.

        Returns:
            List of (tag, i1, i2, j1, j2) tuples
            tag is one of: 'replace', 'delete', 'insert', 'equal'
        """
        matching = self.get_matching_blocks()
        opcodes = []

        i = 0
        j = 0
        for a_start, b_start, size in matching:
            # Tags for non-matching region before this match
            tag = ''
            if i < a_start and j < b_start:
                tag = 'replace'
            elif i < a_start:
                tag = 'delete'
            elif j < b_start:
                tag = 'insert'

            if tag:
                opcodes.append((tag, i, a_start, j, b_start))

            # Tag for matching region
            if size > 0:
                opcodes.append(('equal', a_start, a_start + size, b_start, b_start + size))

            i = a_start + size
            j = b_start + size

        # Handle trailing non-matching region
        if i < len(self.a) or j < len(self.b):
            tag = ''
            if i < len(self.a) and j < len(self.b):
                tag = 'replace'
            elif i < len(self.a):
                tag = 'delete'
            elif j < len(self.b):
                tag = 'insert'
            opcodes.append((tag, i, len(self.a), j, len(self.b)))

        return opcodes


# ============================================
# Differ Class
# ============================================

class Differ:
    """Compare sequences and produce human-readable diffs.

    Example:
        d = Differ()
        diff = d.compare(lines1, lines2)
    """

    def __init__(self, linejunk=None, charjunk=None):
        self.linejunk = linejunk
        self.charjunk = charjunk

    def compare(self, a, b) -> [str]:
        """Compare two sequences.

        Args:
            a: First sequence of lines
            b: Second sequence of lines

        Yields:
            Diff lines with prefixes:
            '  ' - common
            '- ' - only in a
            '+ ' - only in b
            '? ' - detail hint
        """
        matcher = SequenceMatcher(self.linejunk, a, b)

        for tag, i1, i2, j1, j2 in matcher.get_opcodes():
            if tag == 'equal':
                for line in a[i1:i2]:
                    yield '  ' + line
            elif tag == 'replace':
                for line in a[i1:i2]:
                    yield '- ' + line
                for line in b[j1:j2]:
                    yield '+ ' + line
            elif tag == 'delete':
                for line in a[i1:i2]:
                    yield '- ' + line
            elif tag == 'insert':
                for line in b[j1:j2]:
                    yield '+ ' + line


# ============================================
# HtmlDiff Class
# ============================================

class HtmlDiff:
    """Generate HTML diff table."""

    def __init__(self):
        self._styles = """
            table.diff { border-collapse: collapse; }
            table.diff td { padding: 4px 8px; }
            table.diff .diff_add { background-color: #afa; }
            table.diff .diff_chg { background-color: #fff7ba; }
            table.diff .diff_sub { background-color: #faa; }
        """

    def make_table(self, fromlines, tolines, fromdesc='', todesc='',
                   context=False, numlines=5) -> str:
        """Generate HTML diff table.

        Args:
            fromlines: Original lines
            tolines: New lines
            fromdesc: Description of original
            todesc: Description of new
            context: Show only changed lines with context
            numlines: Context lines to show

        Returns:
            HTML table string
        """
        differ = Differ()
        diff = list(differ.compare(fromlines, tolines))

        html = ['<table class="diff">',
                '<tr><th colspan="2">' + fromdesc + '</th>',
                '<th colspan="2">' + todesc + '</th></tr>']

        for line in diff:
            if line.startswith('  '):
                html.append('<tr><td colspan="2"></td><td colspan="2">' + line[2:] + '</td></tr>')
            elif line.startswith('- '):
                html.append('<tr><td class="diff_sub">' + line[2:] + '</td><td></td></tr>')
            elif line.startswith('+ '):
                html.append('<tr><td></td><td class="diff_add">' + line[2:] + '</td></tr>')

        html.append('</table>')
        return '\n'.join(html)


# ============================================
# Convenience Functions
# ============================================

def compare(a, b, fromfile='', tofile='', fromfiledate='', tofiledate='',
            n=3, lineterm='\n') -> [str]:
    """Compare two files and return diff lines.

    Args:
        a: First file lines
        b: Second file lines
        fromfile: Name of first file
        tofile: Name of second file
        fromfiledate: Date of first file
        tofiledate: Date of second file
        n: Context lines
        lineterm: Line terminator

    Returns:
        List of unified diff lines
    """
    differ = Differ()
    diff = list(differ.compare(a, b))

    result = []
    result.append('--- ' + fromfile + '\t' + fromfiledate + lineterm)
    result.append('+++ ' + tofile + '\t' + tofiledate + lineterm)

    for line in diff:
        result.append(line + lineterm)

    return result


def unified_diff(a, b, fromfile='', tofile='', fromfiledate='',
                 tofiledate='', n=3, lineterm='\n') -> [str]:
    """Generate unified diff."""
    return compare(a, b, fromfile, tofile, fromfiledate, tofiledate, n, lineterm)


def context_diff(a, b, fromfile='', tofile='', fromfiledate='',
                 tofiledate='', n=3, lineterm='\n') -> [str]:
    """Generate context diff."""
    return compare(a, b, fromfile, tofile, fromfiledate, tofiledate, n, lineterm)


def ndiff(a, b, linejunk=None, charjunk=None) -> [str]:
    """Generate ndiff-style diff."""
    differ = Differ(linejunk, charjunk)
    return list(differ.compare(a, b))


def restore(delta, which) -> [str]:
    """Restore original sequence from ndiff delta.

    Args:
        delta: List of diff lines
        which: 1 for first sequence, 2 for second

    Returns:
        Original sequence
    """
    result = []
    for line in delta:
        if which == 1 and (line.startswith('  ') or line.startswith('- ')):
            result.append(line[2:])
        elif which == 2 and (line.startswith('  ') or line.startswith('+ ')):
            result.append(line[2:])
    return result


def IS_LINE_JUNK(line) -> bool:
    """Check if line is junk (blank or comment)."""
    return line.strip() == '' or line.strip().startswith('#')


def IS_CHARACTER_JUNK(char) -> bool:
    """Check if character is whitespace."""
    return char in ' \t'


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test difflib functionality."""
    print("Testing difflib module...")

    # Test SequenceMatcher
    print("  Testing SequenceMatcher...")
    s = SequenceMatcher(None, "abcde", "axcde")
    print("    ratio('abcde', 'axcde') = " + str(s.ratio()))

    s = SequenceMatcher(None, "hello", "hallo")
    print("    ratio('hello', 'hallo') = " + str(s.ratio()))

    # Test get_opcodes
    print("  Testing get_opcodes...")
    s = SequenceMatcher(None, "abc", "axc")
    for op in s.get_opcodes():
        print("    " + str(op))

    # Test matching blocks
    print("  Testing get_matching_blocks...")
    s = SequenceMatcher(None, "abcdef", "axcdef")
    blocks = s.get_matching_blocks()
    print("    Matching blocks: " + str(blocks))

    # Test Differ
    print("  Testing Differ...")
    a = ["line 1\n", "line 2\n", "line 3\n"]
    b = ["line 1\n", "modified line 2\n", "line 3\n"]

    d = Differ()
    diff = d.compare(a, b)
    for line in diff:
        print("    " + line.strip())

    # Test ratio calculations
    print("  Testing ratio calculations...")
    s = SequenceMatcher(None, "test", "test")
    print("    identical ratio: " + str(s.ratio()))

    s = SequenceMatcher(None, "abcd", "wxyz")
    print("    different ratio: " + str(s.ratio()))

    s = SequenceMatcher(None, "", "")
    print("    empty ratio: " + str(s.ratio()))

    # Test IS_LINE_JUNK
    print("  Testing IS_LINE_JUNK...")
    print("    IS_LINE_JUNK('') = " + str(IS_LINE_JUNK('')))
    print("    IS_LINE_JUNK('# comment') = " + str(IS_LINE_JUNK('# comment')))
    print("    IS_LINE_JUNK('code') = " + str(IS_LINE_JUNK('code')))

    print("difflib tests completed!")
