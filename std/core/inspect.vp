# Viper Standard Library - inspect module
# Object inspection and introspection

# Module metadata
__name__ = "inspect"
__version__ = "0.4.7"

# ============================================
# Type Checking Functions
# ============================================

def ismodule(object) -> bool:
    """Check if object is a module."""
    return hasattr(object, '__name__') and hasattr(object, '__file__')


def isclass(object) -> bool:
    """Check if object is a class."""
    return hasattr(object, '__bases__') and hasattr(object, '__mro__')


def ismethod(object) -> bool:
    """Check if object is a bound method."""
    return hasattr(object, '__self__') and hasattr(object, '__func__')


def isfunction(object) -> bool:
    """Check if object is a function."""
    return hasattr(object, '__code__') or hasattr(object, '__call__')


def isgenerator(object) -> bool:
    """Check if object is a generator."""
    return hasattr(object, 'gi_frame') and hasattr(object, 'gi_code')


def isgeneratorfunction(object) -> bool:
    """Check if function is a generator function."""
    if not isfunction(object):
        return False
    code = getcode(object)
    if code:
        return hasattr(code, 'co_flags') and (code.co_flags & 0x20) != 0
    return False


def iscoroutine(object) -> bool:
    """Check if object is a coroutine."""
    return hasattr(object, 'cr_frame')


def iscoroutinefunction(object) -> bool:
    """Check if function is a coroutine function."""
    if not isfunction(object):
        return False
    code = getcode(object)
    if code:
        return hasattr(code, 'co_flags') and (code.co_flags & 0x80) != 0
    return False


def isawaitable(object) -> bool:
    """Check if object is awaitable."""
    return hasattr(object, '__await__')


def isasyncgen(object) -> bool:
    """Check if object is an async generator."""
    return hasattr(object, 'ag_frame')


def isasyncgenfunction(object) -> bool:
    """Check if function is an async generator function."""
    return False  # Simplified


def isbuiltin(object) -> bool:
    """Check if object is a built-in function."""
    return hasattr(object, '__module__') and object.__module__ == 'builtins'


def isroutine(object) -> bool:
    """Check if object is a function/method."""
    return isfunction(object) or ismethod(object) or isbuiltin(object)


def iscode(object) -> bool:
    """Check if object is a code object."""
    return hasattr(object, 'co_code') and hasattr(object, 'co_names')


def isframe(object) -> bool:
    """Check if object is a frame object."""
    return hasattr(object, 'f_locals') and hasattr(object, 'f_globals')


def istraceback(object) -> bool:
    """Check if object is a traceback."""
    return hasattr(object, 'tb_frame') and hasattr(object, 'tb_next')


# ============================================
# Source Code Functions
# ============================================

def getsource(object) -> str:
    """Get source code for object.

    Args:
        object: Function, class, or module

    Returns:
        Source code as string

    Raises:
        TypeError: If source cannot be retrieved
    """
    if hasattr(object, '__source__'):
        return object.__source__
    raise TypeError("Could not get source code")


def getsourcelines(object) -> ([str], int):
    """Get source lines and starting line number.

    Returns:
        Tuple of (lines, line_number)
    """
    source = getsource(object)
    lines = source.split('\n')
    return (lines, 1)


def getsourcefile(object) -> str:
    """Get source file path for object."""
    if hasattr(object, '__file__'):
        return object.__file__
    return None


def getfile(object) -> str:
    """Get file path for object."""
    return getsourcefile(object)


def getlineno(object) -> int:
    """Get line number where object was defined."""
    if hasattr(object, '__lineno__'):
        return object.__lineno__
    return 0


def getcode(object):
    """Get code object from function."""
    if hasattr(object, '__code__'):
        return object.__code__
    return None


def getcomments(object) -> str:
    """Get comments for object."""
    if hasattr(object, '__doc__'):
        return object.__doc__
    return None


# ============================================
# Signature Functions
# ============================================

def signature(object):
    """Get signature for callable.

    Returns:
        Signature object or None
    """
    if hasattr(object, '__signature__'):
        return object.__signature__

    # Build signature from __code__
    code = getcode(object)
    if code:
        return _build_signature(code, object)

    return None


def _build_signature(code, func):
    """Build signature from code object."""
    params = []

    if hasattr(code, 'co_varnames'):
        argcount = code.co_argcount if hasattr(code, 'co_argcount') else 0
        varnames = code.co_varnames[:argcount] if hasattr(code, 'co_varnames') else []

        for name in varnames:
            params.append(name)

    return Signature(params, func)


class Signature:
    """Function signature."""

    def __init__(self, parameters, func=None):
        self.parameters = parameters
        self.func = func
        self.return_annotation = None
        if func and hasattr(func, '__annotations__'):
            self.return_annotation = func.__annotations__.get('return')

    def __str__(self) -> str:
        return "(" + ", ".join(self.parameters) + ")"

    def __repr__(self) -> str:
        return "Signature" + str(self)

    def parameters_dict(self) -> dict:
        """Get parameters as dict."""
        result = {}
        for name in self.parameters:
            result[name] = Parameter(name)
        return result


class Parameter:
    """Function parameter."""

    POSITIONAL_ONLY = 0
    POSITIONAL_OR_KEYWORD = 1
    VAR_POSITIONAL = 2
    KEYWORD_ONLY = 3
    VAR_KEYWORD = 4

    def __init__(self, name, kind=1, default=None, annotation=None):
        self.name = name
        self.kind = kind
        self.default = default
        self.annotation = annotation

    def __repr__(self) -> str:
        return "Parameter('" + self.name + "')"


def getfullargspec(func) -> tuple:
    """Get full argument specification.

    Returns:
        Tuple of (args, varargs, varkw, defaults, kwonlyargs,
                  kwonlydefaults, annotations)
    """
    args = []
    varargs = None
    varkw = None
    defaults = None
    kwonlyargs = []
    kwonlydefaults = {}
    annotations = {}

    code = getcode(func)
    if code:
        if hasattr(code, 'co_varnames'):
            argcount = code.co_argcount if hasattr(code, 'co_argcount') else 0
            args = list(code.co_varnames[:argcount])

        if hasattr(code, 'co_kwonlyargcount'):
            kwonlycount = code.co_kwonlyargcount
            if kwonlycount > 0:
                kwonlyargs = list(code.co_varnames[argcount:argcount + kwonlycount])

    if hasattr(func, '__annotations__'):
        annotations = func.__annotations__

    if hasattr(func, '__defaults__'):
        defaults = func.__defaults__

    if hasattr(func, '__kwdefaults__'):
        kwonlydefaults = func.__kwdefaults__

    return (args, varargs, varkw, defaults, kwonlyargs, kwonlydefaults, annotations)


def getargspec(func) -> tuple:
    """Get argument specification (deprecated).

    Returns:
        Tuple of (args, varargs, keywords, defaults)
    """
    full = getfullargspec(func)
    return (full[0], full[1], full[2], full[3])


def getcallargs(func, *args, **kwargs) -> dict:
    """Get mapping of parameter names to values."""
    result = {}
    spec = getfullargspec(func)
    args_list = spec[0]

    # Positional args
    for i, arg in enumerate(args):
        if i < len(args_list):
            result[args_list[i]] = arg

    # Keyword args
    for key, value in kwargs.items():
        result[key] = value

    # Apply defaults
    if spec[3]:  # defaults
        defaults = spec[3]
        for i, default in enumerate(defaults):
            arg_name = args_list[-(len(defaults) - i)]
            if arg_name not in result:
                result[arg_name] = default

    return result


# ============================================
# Class Inspection
# ============================================

def getmembers(object, predicate=None) -> [(str, object)]:
    """Get all members of object.

    Args:
        object: Object to inspect
        predicate: Optional filter function

    Returns:
        List of (name, value) pairs
    """
    result = []

    for name in dir(object):
        try:
            value = getattr(object, name)
            if predicate is None or predicate(value):
                result.append((name, value))
        except:
            pass

    result.sort(key=lambda x: x[0])
    return result


def getmembers_dict(object, predicate=None) -> dict:
    """Get members as dictionary."""
    result = {}
    for name, value in getmembers(object, predicate):
        result[name] = value
    return result


def getclasstree(classes, unique=False) -> list:
    """Get class inheritance tree.

    Returns:
        Nested list representing tree
    """
    tree = []

    for cls in classes:
        bases = cls.__bases__ if hasattr(cls, '__bases__') else ()
        tree.append((cls, bases))

    return tree


def getmro(cls) -> tuple:
    """Get method resolution order.

    Returns:
        Tuple of classes in MRO
    """
    if hasattr(cls, '__mro__'):
        return cls.__mro__
    return (cls,)


def getmodule(object, filename=None):
    """Get module that defines object."""
    if hasattr(object, '__module__'):
        return object.__module__
    return None


def getmodulename(pathname: str) -> str:
    """Get module name from file path."""
    import os
    basename = os.path.basename(pathname)
    if basename.endswith('.vp') or basename.endswith('.py'):
        return basename[:-3]
    return basename


# ============================================
# Stack Inspection
# ============================================

def currentframe():
    """Get current frame object."""
    # Would use runtime function
    return None


def getframeinfo(frame, context=1):
    """Get information about frame.

    Returns:
        Traceback object
    """
    if frame is None:
        return None

    filename = frame.f_code.co_filename if hasattr(frame, 'f_code') else ""
    lineno = frame.f_lineno if hasattr(frame, 'f_lineno') else 0
    function = frame.f_code.co_name if hasattr(frame, 'f_code') else ""

    return Traceback(filename, lineno, function, "")


class Traceback:
    """Traceback information."""

    def __init__(self, filename, lineno, function, code_context):
        self.filename = filename
        self.lineno = lineno
        self.function = function
        self.code_context = code_context

    def __repr__(self) -> str:
        return "Traceback(filename='" + self.filename + "', lineno=" + str(self.lineno) + ")"


def getouterframes(frame, context=1) -> [Traceback]:
    """Get list of outer frames."""
    frames = []
    current = frame

    while current is not None:
        frames.append(getframeinfo(current, context))
        current = current.f_back if hasattr(current, 'f_back') else None

    return frames


def getinnerframes(tb, context=1) -> [Traceback]:
    """Get list of inner frames from traceback."""
    frames = []
    current = tb

    while current is not None:
        frames.append(getframeinfo(current.tb_frame if hasattr(current, 'tb_frame') else None, context))
        current = current.tb_next if hasattr(current, 'tb_next') else None

    return frames


def stack(context=1) -> [Traceback]:
    """Get stack of caller."""
    return getouterframes(currentframe(), context)


def trace(context=1) -> [Traceback]:
    """Get stack from exception."""
    return getinnerframes(None, context)  # Would use sys.exc_info()


# ============================================
# Attribute Inspection
# ============================================

def getattr_static(object, name, default=None):
    """Get attribute without triggering descriptors."""
    try:
        return getattr(object, name)
    except:
        return default


def classify_class_attrs(cls) -> [(str, str, class, object)]:
    """Classify attributes of class.

    Returns:
        List of (name, kind, cls, object) tuples
    """
    result = []

    for name, value in getmembers(cls):
        kind = "data"
        if ismethod(value):
            kind = "method"
        elif isfunction(value):
            kind = "function"
        elif isclass(value):
            kind = "class"

        result.append((name, kind, cls, value))

    return result


# ============================================
# Safe Evaluation
# ============================================

def saferepr(object) -> str:
    """Get repr that doesn't raise exceptions."""
    try:
        return repr(object)
    except:
        return "<repr() error>"


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test inspect functionality."""
    print("Testing inspect module...")

    # Test type checking
    print("  Testing type checking...")
    print("    isfunction(len): " + str(isfunction(len)))
    print("    isclass(str): " + str(isclass(str)))

    # Test signature
    print("  Testing signature...")

    def test_func(a, b, c=10):
        pass

    sig = signature(test_func)
    if sig:
        print("    signature: " + str(sig))

    # Test getfullargspec
    print("  Testing getfullargspec...")
    spec = getfullargspec(test_func)
    print("    args: " + str(spec[0]))
    print("    defaults: " + str(spec[3]))

    # Test getcallargs
    print("  Testing getcallargs...")
    call_args = getcallargs(test_func, 1, 2)
    print("    getcallargs(func, 1, 2): " + str(call_args))

    # Test getmembers
    print("  Testing getmembers...")
    members = getmembers(str, isfunction)
    print("    str functions: " + str(len(members)) + " found")

    # Test getmro
    print("  Testing getmro...")
    mro = getmro(str)
    print("    str MRO: " + str(len(mro)) + " classes")

    # Test isroutine
    print("  Testing isroutine...")
    print("    isroutine(len): " + str(isroutine(len)))
    print("    isroutine(42): " + str(isroutine(42)))

    print("inspect tests completed!")
