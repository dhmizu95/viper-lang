# Viper Standard Library - textwrap module
# Text wrapping and filling

# Module metadata
__name__ = "textwrap"
__version__ = "0.4.7"

# ============================================
# TextWrapper Class
# ============================================

class TextWrapper:
    """Text wrapping utility.

    Wraps single paragraphs of text, breaking lines at whitespace.

    Args:
        width: Maximum line width (default 70)
        initial_indent: String to prepend to first line
        subsequent_indent: String to prepend to subsequent lines
        expand_tabs: Expand tabs to spaces
        replace_whitespace: Replace whitespace with single space
        fix_sentence_endings: Fix sentence spacing
        break_long_words: Break words longer than width
        drop_whitespace: Drop trailing whitespace
        break_on_hyphens: Allow breaking on hyphens
        max_lines: Maximum number of lines (None = unlimited)
        placeholder: String to append when text is truncated

    Example:
        wrapper = TextWrapper(width=40)
        wrapped = wrapper.fill(text)
    """

    def __init__(self,
                 width: int = 70,
                 initial_indent: str = "",
                 subsequent_indent: str = "",
                 expand_tabs: bool = True,
                 replace_whitespace: bool = True,
                 fix_sentence_endings: bool = False,
                 break_long_words: bool = True,
                 drop_whitespace: bool = True,
                 break_on_hyphens: bool = True,
                 max_lines: int = None,
                 placeholder: str = " [...]"):
        self.width = width
        self.initial_indent = initial_indent
        self.subsequent_indent = subsequent_indent
        self.expand_tabs = expand_tabs
        self.replace_whitespace = replace_whitespace
        self.fix_sentence_endings = fix_sentence_endings
        self.break_long_words = break_long_words
        self.drop_whitespace = drop_whitespace
        self.break_on_hyphens = break_on_hyphens
        self.max_lines = max_lines
        self.placeholder = placeholder

    def wrap(self, text: str) -> [str]:
        """Wrap text into lines.

        Args:
            text: Text to wrap

        Returns:
            List of wrapped lines
        """
        # Preprocess text
        text = self._preprocess(text)

        # Split into chunks
        chunks = self._split(text)

        # Build lines
        lines = []
        current_line = ""
        current_indent = self.initial_indent

        for chunk in chunks:
            # Check if chunk fits
            test_line = current_line + chunk
            available_width = self.width - len(current_indent)

            if len(test_line) <= available_width:
                # Chunk fits
                current_line = test_line
            else:
                # Chunk doesn't fit
                if current_line:
                    lines.append(current_indent + current_line)
                    current_indent = self.subsequent_indent
                    current_line = ""

                # Check if chunk fits on empty line
                if len(chunk) <= self.width - len(current_indent):
                    current_line = chunk
                elif self.break_long_words:
                    # Break long chunk
                    while len(chunk) > self.width - len(current_indent):
                        # Add what fits
                        space = self.width - len(current_indent)
                        lines.append(current_indent + chunk[:space])
                        chunk = chunk[space:]
                        current_indent = self.subsequent_indent

                        # Check max_lines
                        if self.max_lines and len(lines) >= self.max_lines:
                            # Truncate with placeholder
                            last = lines[-1]
                            placeholder_space = len(self.placeholder)
                            if len(last) > placeholder_space:
                                lines[-1] = last[:-placeholder_space] + self.placeholder
                            return lines

                    current_line = chunk
                else:
                    # Don't break long words
                    current_line = chunk

        # Add remaining text
        if current_line:
            lines.append(current_indent + current_line)

        # Handle max_lines
        if self.max_lines and len(lines) > self.max_lines:
            last = lines[self.max_lines - 1]
            placeholder_space = len(self.placeholder)
            if len(last) > placeholder_space:
                lines[self.max_lines - 1] = last[:-placeholder_space] + self.placeholder
            lines = lines[:self.max_lines]

        return lines

    def fill(self, text: str) -> str:
        """Wrap text and join with newlines.

        Args:
            text: Text to wrap

        Returns:
            Wrapped text as single string
        """
        lines = self.wrap(text)
        return "\n".join(lines)

    def _preprocess(self, text: str) -> str:
        """Preprocess text according to options."""
        # Expand tabs
        if self.expand_tabs:
            text = text.replace("\t", "    ")

        # Replace whitespace
        if self.replace_whitespace:
            result = []
            prev_space = False
            for char in text:
                if char in " \t\n\r\f\v":
                    if not prev_space:
                        result.append(" ")
                        prev_space = True
                else:
                    result.append(char)
                    prev_space = False
            text = "".join(result)

        # Fix sentence endings
        if self.fix_sentence_endings:
            text = text.replace(".  ", ". ")
            text = text.replace("!  ", "! ")
            text = text.replace("?  ", "? ")

        return text

    def _split(self, text: str) -> [str]:
        """Split text into chunks."""
        chunks = []
        current = ""

        i = 0
        while i < len(text):
            char = text[i]

            if char == " ":
                if current:
                    chunks.append(current)
                    current = ""
                chunks.append(" ")
            elif char == "-" and self.break_on_hyphens:
                if current:
                    chunks.append(current)
                    current = ""
                chunks.append("-")
            else:
                current = current + char

            i = i + 1

        if current:
            chunks.append(current)

        return chunks


# ============================================
# Convenience Functions
# ============================================

def wrap(text: str, width: int = 70, **kwargs) -> [str]:
    """Wrap text into lines of specified width.

    Args:
        text: Text to wrap
        width: Maximum line width
        **kwargs: Additional TextWrapper options

    Returns:
        List of wrapped lines

    Example:
        lines = wrap("Long text here...", width=40)
    """
    wrapper = TextWrapper(width=width, **kwargs)
    return wrapper.wrap(text)


def fill(text: str, width: int = 70, **kwargs) -> str:
    """Wrap text and join with newlines.

    Args:
        text: Text to wrap
        width: Maximum line width
        **kwargs: Additional TextWrapper options

    Returns:
        Wrapped text as single string

    Example:
        wrapped = fill("Long text here...", width=40)
    """
    wrapper = TextWrapper(width=width, **kwargs)
    return wrapper.fill(text)


def shorten(text: str, width: int, placeholder: str = " [...]") -> str:
    """Shorten text to fit within width.

    Collapses whitespace and adds placeholder if truncated.

    Args:
        text: Text to shorten
        width: Maximum width
        placeholder: String to append when truncated

    Returns:
        Shortened text

    Example:
        shorten("Hello World", 8) -> "Hello [...]"
    """
    # Collapse whitespace
    words = text.split()
    if not words:
        return ""

    # Build result
    result = words[0]
    for word in words[1:]:
        if len(result) + 1 + len(word) <= width - len(placeholder):
            result = result + " " + word
        else:
            return result + placeholder

    return result


def dedent(text: str) -> str:
    """Remove common leading whitespace.

    Useful for removing indentation from multi-line strings.

    Args:
        text: Text to dedent

    Returns:
        Text with common leading whitespace removed

    Example:
        dedent("    hello\\n    world") -> "hello\\nworld"
    """
    lines = text.split("\n")

    # Find minimum indentation (excluding empty lines)
    min_indent = None
    for line in lines:
        stripped = line.lstrip()
        if stripped:  # Non-empty line
            indent = len(line) - len(stripped)
            if min_indent is None or indent < min_indent:
                min_indent = indent

    if min_indent is None:
        return text

    # Remove common indentation
    result = []
    for line in lines:
        if len(line) >= min_indent:
            result.append(line[min_indent:])
        else:
            result.append(line)

    return "\n".join(result)


def indent(text: str, prefix: str, predicate=None) -> str:
    """Add prefix to lines.

    Args:
        text: Text to indent
        prefix: String to prepend to each line
        predicate: Optional function to filter lines

    Returns:
        Indented text

    Example:
        indent("hello\\nworld", "> ") -> "> hello\\n> world"
    """
    lines = text.split("\n")
    result = []

    for line in lines:
        if predicate is None or predicate(line):
            result.append(prefix + line)
        else:
            result.append(line)

    return "\n".join(result)


# ============================================
# Helper Functions
# ============================================

def _split_words(text: str) -> [str]:
    """Split text into words."""
    return text.split()


def _count_leading_spaces(line: str) -> int:
    """Count leading spaces in line."""
    count = 0
    for char in line:
        if char == " ":
            count = count + 1
        else:
            break
    return count


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test textwrap functionality."""
    print("Testing textwrap module...")

    # Test wrap
    print("  Testing wrap...")
    text = "This is a long line of text that should be wrapped to multiple lines."
    lines = wrap(text, width=30)
    for line in lines:
        print("    '" + line + "'")

    # Test fill
    print("  Testing fill...")
    filled = fill(text, width=30)
    print("    " + repr(filled))

    # Test shorten
    print("  Testing shorten...")
    short = shorten("Hello World, this is a test", 15)
    print("    shorten('Hello World...', 15) = '" + short + "'")

    # Test dedent
    print("  Testing dedent...")
    indented = "    hello\n    world\n    test"
    dedented = dedent(indented)
    print("    dedent result: '" + dedented + "'")

    # Test indent
    print("  Testing indent...")
    text = "hello\nworld"
    indented = indent(text, "> ")
    print("    indent('hello\\nworld', '> ') = '" + indented + "'")

    # Test TextWrapper with options
    print("  Testing TextWrapper with options...")
    wrapper = TextWrapper(
        width=40,
        initial_indent="> ",
        subsequent_indent="  "
    )
    text = "This is a paragraph that will be wrapped with custom indentation."
    result = wrapper.fill(text)
    for line in result.split("\n"):
        print("    '" + line + "'")

    # Test max_lines
    print("  Testing max_lines...")
    wrapper = TextWrapper(width=30, max_lines=2, placeholder="...")
    text = "This is a very long text that should be truncated."
    result = wrapper.fill(text)
    print("    Result: '" + result + "'")

    print("textwrap tests completed!")
