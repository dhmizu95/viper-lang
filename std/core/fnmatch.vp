# Viper Standard Library - fnmatch module
# Unix filename pattern matching

# Module metadata
__name__ = "fnmatch"
__version__ = "0.4.7"

# ============================================
# Main Functions
# ============================================

def fnmatch(name: str, pat: str) -> bool:
    """Test if filename matches pattern.

    Uses Unix shell-style wildcards:
    *       - matches everything
    ?       - matches any single character
    [seq]   - matches any character in seq
    [!seq]  - matches any character not in seq

    Args:
        name: Filename to test
        pat: Pattern to match

    Returns:
        True if name matches pattern

    Example:
        fnmatch('test.txt', '*.txt') -> True
        fnmatch('test.py', '*.txt') -> False
    """
    return _fnmatch_case(name, pat)


def fnmatchcase(name: str, pat: str) -> bool:
    """Test if filename matches pattern (case-sensitive).

    Like fnmatch() but always case-sensitive.

    Args:
        name: Filename to test
        pat: Pattern to match

    Returns:
        True if name matches pattern
    """
    return _fnmatch_case(name, pat)


def filter(names: [str], pat: str) -> [str]:
    """Filter names by pattern.

    Args:
        names: List of filenames
        pat: Pattern to match

    Returns:
        List of matching names
    """
    result = []
    for name in names:
        if fnmatch(name, pat):
            result.append(name)
    return result


def translate(pat: str) -> str:
    """Translate shell pattern to regex.

    Args:
        pat: Shell pattern

    Returns:
        Regular expression string

    Example:
        translate('*.txt') -> '.*\\.txt$'
    """
    i = 0
    n = len(pat)
    result = ""

    while i < n:
        c = pat[i]

        if c == '*':
            result = result + ".*"
        elif c == '?':
            result = result + "."
        elif c == '[':
            j = i + 1
            # Skip ! or ^ at start
            if j < n and pat[j] in '!^':
                j = j + 1
            # Skip ] at start
            if j < n and pat[j] == ']':
                j = j + 1
            # Find closing ]
            while j < n and pat[j] != ']':
                j = j + 1

            if j >= n:
                # No closing ], treat [ as literal
                result = result + "\\["
            else:
                # Build character class
                stuff = pat[i + 1:j]
                # Convert ! to ^ for negation
                if stuff[0] in '!^':
                    stuff = "^" + stuff[1:]
                # Escape special regex chars
                stuff = stuff.replace("\\", "\\\\")
                result = result + "[" + stuff + "]"
                i = j
        else:
            # Escape special regex characters
            if c in '.^$+{}|()\\':
                result = result + "\\" + c
            else:
                result = result + c

        i = i + 1

    return "^" + result + "$"


# ============================================
# Internal Implementation
# ============================================

def _fnmatch_case(name: str, pat: str) -> bool:
    """Case-sensitive filename match."""
    return _fnmatch_impl(name, pat, 0, 0)


def _fnmatch_impl(name: str, pat: str, i: int, j: int) -> bool:
    """Recursive pattern matching implementation."""
    n = len(name)
    m = len(pat)

    # Base cases
    if i >= m:
        return j >= n

    if j >= n:
        # Check if remaining pattern can match empty string
        while i < m:
            if pat[i] == '*':
                i = i + 1
            else:
                return False
        return True

    # Handle pattern characters
    pc = pat[i]

    if pc == '*':
        # * matches zero or more characters
        # Skip multiple consecutive *
        while i < m and pat[i] == '*':
            i = i + 1

        # If * is at end, match everything
        if i >= m:
            return True

        # Try matching zero or more characters
        for k in range(j, n + 1):
            if _fnmatch_impl(name, pat, i, k):
                return True

        return False

    elif pc == '?':
        # ? matches exactly one character
        return _fnmatch_impl(name, pat, i + 1, j + 1)

    elif pc == '[':
        # Character class
        return _match_char_class(name, pat, i, j)

    else:
        # Literal character
        if j < n and name[j] == pc:
            return _fnmatch_impl(name, pat, i + 1, j + 1)
        return False


def _match_char_class(name: str, pat: str, i: int, j: int) -> bool:
    """Match character class [...]."""
    n = len(name)
    m = len(pat)

    if j >= n:
        return False

    # Find closing ]
    k = i + 1

    # Check for negation
    negate = False
    if k < m and pat[k] in '!^':
        negate = True
        k = k + 1

    # Find closing ]
    start_k = k
    while k < m and pat[k] != ']':
        k = k + 1

    if k >= m:
        # No closing ], treat [ as literal
        if j < n and name[j] == '[':
            return _fnmatch_impl(name, pat, i + 1, j + 1)
        return False

    # Extract character class content
    class_content = pat[start_k:k]

    # Check if character matches
    nc = name[j]
    match = _char_in_class(nc, class_content)

    if negate:
        match = not match

    if match:
        return _fnmatch_impl(name, pat, k + 1, j + 1)

    return False


def _char_in_class(char: str, class_content: str) -> bool:
    """Check if character is in character class."""
    i = 0
    n = len(class_content)

    while i < n:
        c = class_content[i]

        # Check for range (a-z)
        if i + 2 < n and class_content[i + 1] == '-' and class_content[i + 2] != ']':
            start_char = c
            end_char = class_content[i + 2]
            if ord(start_char) <= ord(char) <= ord(end_char):
                return True
            i = i + 3
        else:
            if c == char:
                return True
            i = i + 1

    return False


# ============================================
# Helper Functions
# ============================================

def _fnmatch_ignore_case(name: str, pat: str) -> bool:
    """Case-insensitive filename match."""
    return _fnmatch_case(name.lower(), pat.lower())


def _glob_to_regex(glob_pattern: str) -> str:
    """Convert glob pattern to regex (extended)."""
    return translate(glob_pattern)


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test fnmatch functionality."""
    print("Testing fnmatch module...")

    # Test basic patterns
    print("  Testing basic patterns...")
    tests = [
        ("test.txt", "*.txt", True),
        ("test.py", "*.txt", False),
        ("test.txt", "test.*", True),
        ("test.txt", "test.txt", True),
        ("test.txt", "test.tx", False),
    ]

    for name, pat, expected in tests:
        result = fnmatch(name, pat)
        status = "OK" if result == expected else "FAIL"
        print("    " + status + ": '" + name + "' vs '" + pat + "' = " + str(result))

    # Test ? wildcard
    print("  Testing ? wildcard...")
    tests = [
        ("test.txt", "t?st.txt", True),
        ("test.txt", "t??t.txt", True),
        ("test.txt", "t?t.txt", False),
    ]

    for name, pat, expected in tests:
        result = fnmatch(name, pat)
        status = "OK" if result == expected else "FAIL"
        print("    " + status + ": '" + name + "' vs '" + pat + "' = " + str(result))

    # Test character classes
    print("  Testing character classes...")
    tests = [
        ("test.txt", "t[aeiou]st.txt", True),
        ("test.txt", "t[!aeiou]st.txt", False),
        ("test.txt", "t[a-z]st.txt", True),
        ("t1st.txt", "t[0-9]st.txt", True),
    ]

    for name, pat, expected in tests:
        result = fnmatch(name, pat)
        status = "OK" if result == expected else "FAIL"
        print("    " + status + ": '" + name + "' vs '" + pat + "' = " + str(result))

    # Test filter
    print("  Testing filter...")
    names = ["test.txt", "test.py", "data.txt", "readme.md"]
    matches = filter(names, "*.txt")
    print("    filter(*.txt): " + str(matches))

    matches = filter(names, "test.*")
    print("    filter(test.*): " + str(matches))

    # Test translate
    print("  Testing translate...")
    regex = translate("*.txt")
    print("    translate('*.txt') = '" + regex + "'")

    regex = translate("test?.py")
    print("    translate('test?.py') = '" + regex + "'")

    # Test edge cases
    print("  Testing edge cases...")
    print("    fnmatch('', '*') = " + str(fnmatch('', '*')))
    print("    fnmatch('abc', '***') = " + str(fnmatch('abc', '***')))
    print("    fnmatch('abc', 'a*c') = " + str(fnmatch('abc', 'a*c')))
    print("    fnmatch('abc', 'a?c') = " + str(fnmatch('abc', 'a?c')))

    print("fnmatch tests completed!")
