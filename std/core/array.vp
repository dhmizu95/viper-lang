# Viper Standard Library - array module
# Space-efficient typed arrays

# Module metadata
__name__ = "array"
__version__ = "0.4.7"

# ============================================
# Type Codes
# ============================================

# Type code descriptions:
# 'b' - signed char (1 byte, -128 to 127)
# 'B' - unsigned char (1 byte, 0 to 255)
# 'h' - signed short (2 bytes)
# 'H' - unsigned short (2 bytes)
# 'i' - signed int (4 bytes)
# 'I' - unsigned int (4 bytes)
# 'l' - signed long (4 bytes)
# 'L' - unsigned long (4 bytes)
# 'q' - signed long long (8 bytes)
# 'Q' - unsigned long long (8 bytes)
# 'f' - float (4 bytes)
# 'd' - double (8 bytes)
# 'u' - Unicode character (2 or 4 bytes)

# Type sizes
TYPECODES = {
    'b': 1, 'B': 1,
    'h': 2, 'H': 2,
    'i': 4, 'I': 4,
    'l': 4, 'L': 4,
    'q': 8, 'Q': 8,
    'f': 4, 'd': 8,
    'u': 2
}

# Type ranges
TYPE_RANGES = {
    'b': (-128, 127),
    'B': (0, 255),
    'h': (-32768, 32767),
    'H': (0, 65535),
    'i': (-2147483648, 2147483647),
    'I': (0, 4294967295),
}


# ============================================
# Array Class
# ============================================

class array:
    """Typed array of numeric values.

    More space-efficient than lists for numeric data.

    Args:
        typecode: Type code character
        initializer: Optional initial values

    Example:
        a = array('i', [1, 2, 3])
        a.append(4)
    """

    def __init__(self, typecode: str, initializer=None):
        if typecode not in TYPECODES:
            raise ValueError("Unknown typecode: " + typecode)

        self.typecode = typecode
        self._data = []
        self._itemsize = TYPECODES[typecode]

        if initializer is not None:
            if isinstance(initializer, str):
                self.frombytes(initializer)
            elif isinstance(initializer, (list, tuple)):
                for item in initializer:
                    self.append(item)
            elif isinstance(initializer, array):
                if initializer.typecode != typecode:
                    raise TypeError("Typecode mismatch")
                self._data = list(initializer._data)

    def append(self, value):
        """Append value to array."""
        self._data.append(self._check_value(value))

    def extend(self, values):
        """Extend array with values."""
        for value in values:
            self.append(value)

    def insert(self, i: int, value):
        """Insert value at index."""
        self._data.insert(i, self._check_value(value))

    def remove(self, value):
        """Remove first occurrence of value."""
        self._data.remove(self._check_value(value))

    def pop(self, i=-1):
        """Remove and return item at index."""
        return self._data.pop(i)

    def index(self, value) -> int:
        """Return index of first occurrence."""
        return self._data.index(self._check_value(value))

    def count(self, value) -> int:
        """Count occurrences of value."""
        return self._data.count(self._check_value(value))

    def reverse(self):
        """Reverse array in place."""
        self._data.reverse()

    def __len__(self) -> int:
        return len(self._data)

    def __getitem__(self, key):
        """Get item or slice."""
        if isinstance(key, slice):
            result = array(self.typecode)
            result._data = self._data[key]
            return result
        return self._data[key]

    def __setitem__(self, key, value):
        """Set item or slice."""
        if isinstance(key, slice):
            if isinstance(value, array):
                self._data[key] = value._data
            else:
                self._data[key] = [self._check_value(v) for v in value]
        else:
            self._data[key] = self._check_value(value)

    def __delitem__(self, key):
        """Delete item."""
        del self._data[key]

    def __iter__(self):
        """Iterate over items."""
        for item in self._data:
            yield item

    def __repr__(self) -> str:
        return "array('" + self.typecode + "', " + repr(self._data) + ")"

    def __eq__(self, other) -> bool:
        if not isinstance(other, array):
            return False
        if self.typecode != other.typecode:
            return False
        return self._data == other._data

    def __add__(self, other):
        """Concatenate arrays."""
        if not isinstance(other, array):
            return NotImplemented
        if self.typecode != other.typecode:
            raise TypeError("Typecode mismatch")
        result = array(self.typecode)
        result._data = self._data + other._data
        return result

    def __iadd__(self, other):
        """Concatenate in place."""
        self.extend(other)
        return self

    def __mul__(self, n: int):
        """Repeat array."""
        result = array(self.typecode)
        result._data = self._data * n
        return result

    def __rmul__(self, n: int):
        """Repeat array (reverse)."""
        return self.__mul__(n)

    def __imul__(self, n: int):
        """Repeat in place."""
        self._data = self._data * n
        return self

    def _check_value(self, value):
        """Check and convert value to type."""
        tc = self.typecode

        # Type conversion and range checking
        if tc == 'b':
            return int(value)
        elif tc == 'B':
            v = int(value)
            if v < 0 or v > 255:
                raise OverflowError("Value out of range for 'B'")
            return v
        elif tc == 'h':
            return int(value)
        elif tc == 'H':
            v = int(value)
            if v < 0 or v > 65535:
                raise OverflowError("Value out of range for 'H'")
            return v
        elif tc == 'i' or tc == 'I':
            return int(value)
        elif tc == 'l' or tc == 'L':
            return int(value)
        elif tc == 'q' or tc == 'Q':
            return int(value)
        elif tc == 'f':
            return float(value)
        elif tc == 'd':
            return float(value)
        elif tc == 'u':
            if isinstance(value, str) and len(value) == 1:
                return value
            raise TypeError("Expected single character")

        return value

    # ============================================
    # Binary I/O
    # ============================================

    def tobytes(self) -> str:
        """Convert to bytes string."""
        result = []
        for value in self._data:
            if self.typecode in 'bB':
                result.append(chr(value & 0xFF))
            elif self.typecode in 'hH':
                v = int(value)
                result.append(chr(v & 0xFF))
                result.append(chr((v >> 8) & 0xFF))
            elif self.typecode in 'iIlL':
                v = int(value)
                for shift in [0, 8, 16, 24]:
                    result.append(chr((v >> shift) & 0xFF))
            elif self.typecode in 'qQ':
                v = int(value)
                for shift in [0, 8, 16, 24, 32, 40, 48, 56]:
                    result.append(chr((v >> shift) & 0xFF))
            elif self.typecode == 'f':
                # Simplified float conversion
                bits = int(value * 1000000) & 0xFFFFFFFF
                for shift in [0, 8, 16, 24]:
                    result.append(chr((bits >> shift) & 0xFF))
            elif self.typecode == 'd':
                bits = int(value * 1000000000) & 0xFFFFFFFFFFFFFFFF
                for shift in [0, 8, 16, 24, 32, 40, 48, 56]:
                    result.append(chr((bits >> shift) & 0xFF))
            elif self.typecode == 'u':
                result.append(value)

        return "".join(result)

    def frombytes(self, s: str):
        """Initialize from bytes string."""
        itemsize = self._itemsize
        n = len(s) // itemsize

        for i in range(n):
            offset = i * itemsize
            chunk = s[offset:offset + itemsize]
            value = self._bytes_to_value(chunk)
            self.append(value)

    def _bytes_to_value(self, chunk: str):
        """Convert bytes to value."""
        tc = self.typecode

        if tc == 'b':
            v = ord(chunk[0])
            if v >= 128:
                v = v - 256
            return v
        elif tc == 'B':
            return ord(chunk[0])
        elif tc == 'h':
            v = ord(chunk[0]) | (ord(chunk[1]) << 8)
            if v >= 32768:
                v = v - 65536
            return v
        elif tc == 'H':
            return ord(chunk[0]) | (ord(chunk[1]) << 8)
        elif tc in 'iIlL':
            v = 0
            for shift in [0, 8, 16, 24]:
                v = v | (ord(chunk[shift // 8]) << shift)
            return v
        elif tc in 'qQ':
            v = 0
            for shift in [0, 8, 16, 24, 32, 40, 48, 56]:
                v = v | (ord(chunk[shift // 8]) << shift)
            return v
        elif tc == 'f':
            bits = 0
            for shift in [0, 8, 16, 24]:
                bits = bits | (ord(chunk[shift // 8]) << shift)
            return float(bits) / 1000000.0
        elif tc == 'd':
            bits = 0
            for shift in [0, 8, 16, 24, 32, 40, 48, 56]:
                bits = bits | (ord(chunk[shift // 8]) << shift)
            return float(bits) / 1000000000.0
        elif tc == 'u':
            return chunk

        return 0

    def tolist(self) -> list:
        """Convert to list."""
        return list(self._data)

    def fromlist(self, lst: list):
        """Initialize from list."""
        self.extend(lst)

    def fromfile(self, f, n: int):
        """Read n items from file."""
        data = f.read(n * self._itemsize)
        self.frombytes(data)

    def tofile(self, f):
        """Write array to file."""
        f.write(self.tobytes())

    # ============================================
    # Buffer Protocol
    # ============================================

    def buffer_info(self) -> tuple:
        """Return (address, length) tuple."""
        # Simplified - would return actual buffer info
        return (id(self._data), len(self._data))

    def byteswap(self):
        """Swap bytes of all items."""
        # Simplified implementation
        pass

    @property
    def itemsize(self) -> int:
        """Size of each item in bytes."""
        return self._itemsize


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test array functionality."""
    print("Testing array module...")

    # Test basic array
    print("  Testing basic array...")
    a = array('i', [1, 2, 3, 4, 5])
    print("    array('i', [1,2,3,4,5]) = " + repr(a))

    # Test append
    print("  Testing append...")
    a.append(6)
    print("    After append(6): " + repr(a))

    # Test extend
    print("  Testing extend...")
    a.extend([7, 8])
    print("    After extend([7,8]): " + repr(a))

    # Test indexing
    print("  Testing indexing...")
    print("    a[0] = " + str(a[0]))
    print("    a[-1] = " + str(a[-1]))
    print("    a[2:5] = " + repr(a[2:5]))

    # Test operations
    print("  Testing operations...")
    b = array('i', [10, 20])
    c = a + b
    print("    a + b = " + repr(c))

    d = b * 3
    print("    b * 3 = " + repr(d))

    # Test methods
    print("  Testing methods...")
    print("    len(a) = " + str(len(a)))
    print("    a.count(3) = " + str(a.count(3)))
    print("    a.index(3) = " + str(a.index(3)))

    a.reverse()
    print("    After reverse: " + repr(a))

    # Test tobytes/frombytes
    print("  Testing tobytes/frombytes...")
    original = array('i', [1, 2, 3])
    data = original.tobytes()
    print("    tobytes() length: " + str(len(data)))

    restored = array('i')
    restored.frombytes(data)
    print("    frombytes restored: " + repr(restored))

    # Test tolist
    print("  Testing tolist...")
    lst = a.tolist()
    print("    tolist(): " + str(lst))

    # Test different typecodes
    print("  Testing different typecodes...")
    b_array = array('b', [1, -1, 127, -128])
    print("    array('b'): " + repr(b_array))

    f_array = array('f', [1.5, 2.5, 3.5])
    print("    array('f'): " + repr(f_array))

    # Test itemsize
    print("  Testing itemsize...")
    print("    'b' itemsize: " + str(array('b').itemsize))
    print("    'i' itemsize: " + str(array('i').itemsize))
    print("    'd' itemsize: " + str(array('d').itemsize))

    print("array tests completed!")
