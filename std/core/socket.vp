# Viper Standard Library - socket module
# Network socket interface

__name__ = "socket"
__version__ = "0.4.5"

# ============================================
# Address Family Constants
# ============================================

AF_INET: i64 = 2       # IPv4
AF_INET6: i64 = 10     # IPv6
AF_UNIX: i64 = 1       # Unix domain sockets
AF_UNSPEC: i64 = 0     # Unspecified

# ============================================
# Socket Type Constants
# ============================================

SOCK_STREAM: i64 = 1    # TCP
SOCK_DGRAM: i64 = 2     # UDP
SOCK_RAW: i64 = 3       # Raw socket

# ============================================
# Protocol Constants
# ============================================

SOL_SOCKET: i64 = 1     # Socket level
SO_REUSEADDR: i64 = 2   # Reuse address
SO_BROADCAST: i64 = 4   # Broadcast
TCP_NODELAY: i64 = 1    # Disable Nagle's algorithm

# ============================================
# Shutdown Constants
# ============================================

SHUT_RD: i64 = 0    # Shutdown receive
SHUT_WR: i64 = 1    # Shutdown send
SHUT_RDWR: i64 = 2  # Shutdown both

# ============================================
# Socket Class
# ============================================

class Socket:
    """Network socket for TCP/UDP communication."""
    
    def __init__(self, family: i64 = AF_INET, type: i64 = SOCK_STREAM, protocol: i64 = 0):
        """Create a new socket."""
        self._fd = vp_socket_create(family, type, protocol)
        self._family = family
        self._type = type
        self._protocol = protocol
        self._connected = False
    
    def connect(self, host: str, port: i64) -> i64:
        """Connect to a remote address."""
        result = vp_socket_connect(self._fd, host, port)
        if result == 0:
            self._connected = True
        return result
    
    def bind(self, host: str, port: i64) -> i64:
        """Bind to a local address."""
        return vp_socket_bind(self._fd, host, port)
    
    def listen(self, backlog: i64 = 128) -> i64:
        """Listen for incoming connections."""
        return vp_socket_listen(self._fd, backlog)
    
    def accept(self) -> tuple:
        """Accept an incoming connection."""
        new_fd = vp_socket_accept(self._fd)
        if new_fd >= 0:
            client = Socket.__new__(Socket)
            client._fd = new_fd
            client._connected = True
            return (client, None)
        return (None, "accept failed")
    
    def send(self, data: str) -> i64:
        """Send data to the socket."""
        return vp_socket_send(self._fd, data, len(data))
    
    def sendall(self, data: str) -> i64:
        """Send all data to the socket."""
        total = 0
        while total < len(data):
            sent = vp_socket_send(self._fd, data, len(data) - total)
            if sent < 0:
                return sent
            total += sent
        return total
    
    def recv(self, bufsize: i64) -> str:
        """Receive data from the socket."""
        # Simplified: returns empty string
        # Full implementation would use buffer
        return ""
    
    def recvfrom(self, bufsize: i64) -> tuple:
        """Receive data and address from UDP socket."""
        return ("", None)
    
    def sendto(self, data: str, address: tuple) -> i64:
        """Send data to a specific address (UDP)."""
        return -1  # Not implemented
    
    def close(self) -> i64:
        """Close the socket."""
        self._connected = False
        return vp_socket_close(self._fd)
    
    def setblocking(self, blocking: bool) -> i64:
        """Set blocking mode."""
        return vp_socket_setblocking(self._fd, 1 if blocking else 0)
    
    def setsockopt(self, level: i64, optname: i64, value: i64) -> i64:
        """Set socket option."""
        return vp_socket_setsockopt(self._fd, level, optname, value, 8)
    
    def getsockopt(self, level: i64, optname: i64) -> i64:
        """Get socket option."""
        value = 0
        len_ptr = 0
        vp_socket_getsockopt(self._fd, level, optname, value, len_ptr)
        return value
    
    def fileno(self) -> i64:
        """Get file descriptor."""
        return vp_socket_fileno(self._fd)
    
    def getpeername(self) -> tuple:
        """Get remote address."""
        return (None, None)
    
    def getsockname(self) -> tuple:
        """Get local address."""
        return (None, None)
    
    def shutdown(self, how: i64 = SHUT_RDWR) -> i64:
        """Shutdown socket."""
        return 0  # Simplified
    
    @property
    def family(self) -> i64:
        """Get address family."""
        return self._family
    
    @property
    def type(self) -> i64:
        """Get socket type."""
        return self._type
    
    @property
    def connected(self) -> bool:
        """Check if connected."""
        return self._connected

# ============================================
# Convenience Functions
# ============================================

def create_connection(address: tuple, timeout: f64 = -1.0) -> Socket:
    """Create a connection to a remote address."""
    host = address[0]
    port = address[1]
    sock = Socket(AF_INET, SOCK_STREAM)
    sock.connect(host, port)
    return sock

def gethostbyname(hostname: str) -> str:
    """Get IP address for hostname."""
    # Simplified: return hostname as-is
    return hostname

def gethostname() -> str:
    """Get current hostname."""
    return "localhost"

# ============================================
# Runtime Function Declarations
# ============================================

extern def vp_socket_create(family: i64, type: i64, protocol: i64) -> i64
extern def vp_socket_connect(fd: i64, host: str, port: i64) -> i64
extern def vp_socket_bind(fd: i64, host: str, port: i64) -> i64
extern def vp_socket_listen(fd: i64, backlog: i64) -> i64
extern def vp_socket_accept(fd: i64) -> i64
extern def vp_socket_send(fd: i64, data: str, len: i64) -> i64
extern def vp_socket_recv(fd: i64, buffer: str, maxlen: i64) -> i64
extern def vp_socket_close(fd: i64) -> i64
extern def vp_socket_setblocking(fd: i64, blocking: i64) -> i64
extern def vp_socket_setsockopt(fd: i64, level: i64, optname: i64, value: i64, len: i64) -> i64
extern def vp_socket_getsockopt(fd: i64, level: i64, optname: i64, value: i64, len: i64) -> i64
extern def vp_socket_fileno(fd: i64) -> i64
extern def vp_socket_getsockopt(fd: i64, level: i64, optname: i64, value: i64, len: i64) -> i64

# Constants from runtime
extern def vp_socket_af_inet() -> i64
extern def vp_socket_af_inet6() -> i64
extern def vp_socket_sock_stream() -> i64
extern def vp_socket_sock_dgram() -> i64
extern def vp_socket_sol_socket() -> i64
extern def vp_socket_so_reuseaddr() -> i64
extern def vp_socket_tcp_nodelay() -> i64
extern def vp_socket_shut_rd() -> i64
extern def vp_socket_shut_wr() -> i64
extern def vp_socket_shut_rdwr() -> i64

# Initialize constants from runtime
AF_INET = vp_socket_af_inet()
AF_INET6 = vp_socket_af_inet6()
SOCK_STREAM = vp_socket_sock_stream()
SOCK_DGRAM = vp_socket_sock_dgram()
SOL_SOCKET = vp_socket_sol_socket()
SO_REUSEADDR = vp_socket_so_reuseaddr()
TCP_NODELAY = vp_socket_tcp_nodelay()
SHUT_RD = vp_socket_shut_rd()
SHUT_WR = vp_socket_shut_wr()
SHUT_RDWR = vp_socket_shut_rdwr()
