# Viper Standard Library - subprocess module
# Spawn and manage external processes

# Module metadata
__name__ = "subprocess"
__version__ = "0.4.7"

from os import path_exists, path_isfile

# ============================================
# Constants
# ============================================

# Standard file descriptors
PIPE = -1
STDOUT = -2
DEVNULL = -3

# Process creation flags (platform-specific)
CREATE_NEW_CONSOLE = 0x00000010
CREATE_NEW_PROCESS_GROUP = 0x00000200

# ============================================
# Exceptions
# ============================================

class SubprocessError(Exception):
    """Base class for subprocess exceptions."""
    pass


class CalledProcessError(SubprocessError):
    """Exception raised when process returns non-zero exit status.

    Attributes:
        returncode: Exit status code
        cmd: Command that was run
        output: Output from the process (if captured)
        stderr: Stderr output (if captured separately)
    """

    def __init__(self, returncode: int, cmd, output=None, stderr=None):
        self.returncode = returncode
        self.cmd = cmd
        self.output = output
        self.stderr = stderr

    def __str__(self) -> str:
        msg = "Command '" + str(self.cmd) + "' returned non-zero exit status " + str(self.returncode)
        if self.output:
            msg = msg + ". Output: " + str(self.output)[:100]
        return msg


class TimeoutExpired(SubprocessError):
    """Exception raised when process times out.

    Attributes:
        cmd: Command that was run
        timeout: Timeout value in seconds
        output: Output collected before timeout (if captured)
        stderr: Stderr output (if captured separately)
    """

    def __init__(self, cmd, timeout: float, output=None, stderr=None):
        self.cmd = cmd
        self.timeout = timeout
        self.output = output
        self.stderr = stderr

    def __str__(self) -> str:
        return "Command '" + str(self.cmd) + "' timed out after " + str(self.timeout) + " seconds"


# ============================================
# CompletedProcess Class
# ============================================

class CompletedProcess:
    """Result of a completed process.

    Returned by run() function.

    Attributes:
        args: Command arguments
        returncode: Exit status
        stdout: Standard output (if captured)
        stderr: Standard error (if captured)
    """

    def __init__(self, args, returncode: int, stdout=None, stderr=None):
        self.args = args
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr

    def __repr__(self) -> str:
        return "CompletedProcess(args=" + repr(self.args) + ", returncode=" + str(self.returncode) + ")"

    def check_returncode(self):
        """Raise CalledProcessError if return code is non-zero."""
        if self.returncode != 0:
            raise CalledProcessError(self.returncode, self.args, self.stdout, self.stderr)


# ============================================
# Popen Class
# ============================================

class Popen:
    """Execute child program in new process.

    Low-level interface for process management.
    For most use cases, prefer run() function.

    Args:
        args: Command to execute (string or list)
        bufsize: Buffering mode (-1=system default, 0=unbuffered, 1=line buffered)
        executable: Program to execute (overrides args[0])
        stdin: stdin handle (PIPE, DEVNULL, file handle, or None)
        stdout: stdout handle (PIPE, DEVNULL, file handle, or None)
        stderr: stderr handle (PIPE, DEVNULL, STDOUT, file handle, or None)
        preexec_fn: Function to call before exec (Unix only)
        close_fds: Close file descriptors on exec
        shell: Run command through shell
        cwd: Working directory
        env: Environment variables
        universal_newlines: Open files in text mode
        startupinfo: Windows-specific startup info
        creationflags: Windows-specific creation flags

    Example:
        p = Popen(['ls', '-l'], stdout=PIPE)
        output, _ = p.communicate()
        print(output)
    """

    def __init__(self, args, bufsize=-1, executable=None,
                 stdin=None, stdout=None, stderr=None,
                 preexec_fn=None, close_fds=True, shell=False,
                 cwd=None, env=None, universal_newlines=False,
                 startupinfo=None, creationflags=0):
        self.args = args
        self.stdin = stdin
        self.stdout = stdout
        self.stderr = stderr
        self.returncode = None
        self.pid = 0
        self._process = None
        self._shell = shell
        self._cwd = cwd
        self._env = env

        # Start the process
        self._start_process(args, shell, cwd, env, executable)

    def _start_process(self, args, shell, cwd, env, executable):
        """Internal: start the process."""
        # Convert args to command string
        if isinstance(args, (list, tuple)):
            cmd = " ".join(args)
        else:
            cmd = args

        # Use shell if requested
        if shell:
            cmd = cmd  # Already a string

        # Start process via runtime
        self._process = vp_subprocess_popen(cmd, shell, cwd, env)
        if self._process:
            self.pid = vp_subprocess_pid(self._process)

    def __enter__(self):
        """Context manager entry."""
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit - ensure process is cleaned up."""
        if self.returncode is None:
            self.kill()
        self.wait()

    def poll(self) -> int:
        """Check if process has terminated.

        Returns:
            Exit code if terminated, None otherwise
        """
        if self._process is None:
            return None

        result = vp_subprocess_poll(self._process)
        if result >= 0:
            self.returncode = result

        return self.returncode

    def wait(self, timeout: float = None) -> int:
        """Wait for process to terminate.

        Args:
            timeout: Maximum time to wait in seconds

        Returns:
            Exit code

        Raises:
            TimeoutExpired: If timeout expires
        """
        if self._process is None:
            return 0

        if timeout is None:
            result = vp_subprocess_wait(self._process, -1.0)
        else:
            result = vp_subprocess_wait(self._process, timeout)
            if result == -2:  # Timeout
                raise TimeoutExpired(self.args, timeout)

        self.returncode = result
        return result

    def communicate(self, input=None, timeout: float = None) -> tuple:
        """Interact with process: send input, read output.

        Args:
            input: Data to send to stdin
            timeout: Maximum time to wait

        Returns:
            Tuple of (stdout_data, stderr_data)

        Raises:
            TimeoutExpired: If timeout expires
        """
        stdout_data = None
        stderr_data = None

        # Send input to stdin
        if input is not None and self.stdin:
            if isinstance(input, str):
                input = input  # Keep as string for runtime
            vp_subprocess_write(self._process, input)

        # Read stdout
        if self.stdout == PIPE or self.stdout is None:
            stdout_data = vp_subprocess_read_output(self._process, False)

        # Read stderr
        if self.stderr == PIPE:
            stderr_data = vp_subprocess_read_output(self._process, True)

        # Wait for process
        self.wait(timeout)

        return (stdout_data, stderr_data)

    def send_signal(self, signal: int):
        """Send signal to process.

        Args:
            signal: Signal number (e.g., 9 for SIGKILL)
        """
        if self._process:
            vp_subprocess_send_signal(self._process, signal)

    def terminate(self):
        """Terminate the process (SIGTERM)."""
        self.send_signal(15)  # SIGTERM

    def kill(self):
        """Kill the process (SIGKILL)."""
        self.send_signal(9)  # SIGKILL

    @property
    def text_mode(self) -> bool:
        """Check if process is in text mode."""
        return True  # Simplified


# ============================================
# Convenience Functions
# ============================================

def run(args, *, stdin=None, input=None, stdout=None, stderr=None,
        shell=False, timeout=None, check=False, universal_newlines=False,
        cwd=None, env=None) -> CompletedProcess:
    """Run command and return result.

    This is the recommended high-level API for running subprocesses.

    Args:
        args: Command to run (string or list)
        stdin: stdin handle (PIPE, DEVNULL, file, or None)
        input: Data to send to stdin
        stdout: stdout handle (PIPE, DEVNULL, file, or None)
        stderr: stderr handle (PIPE, DEVNULL, STDOUT, file, or None)
        shell: Run through shell
        timeout: Maximum execution time in seconds
        check: Raise CalledProcessError if non-zero exit
        universal_newlines: Use text mode
        cwd: Working directory
        env: Environment variables

    Returns:
        CompletedProcess object

    Raises:
        CalledProcessError: If check=True and process fails
        TimeoutExpired: If timeout expires

    Example:
        result = run(['ls', '-l'], capture_output=True)
        print(result.stdout)

        run(['rm', 'file.txt'], check=True)  # Raises if fails
    """
    # Handle capture_output alias (not shown in signature)
    # Would be handled via **kwargs in real implementation

    # Determine stdout/stderr
    capture_stdout = (stdout == PIPE)
    capture_stderr = (stderr == PIPE)

    # Create Popen object
    with Popen(args, stdin=stdin, stdout=stdout, stderr=stderr,
               shell=shell, cwd=cwd, env=env) as process:

        try:
            stdout_data, stderr_data = process.communicate(input, timeout)
        except TimeoutExpired:
            process.kill()
            # Read any output before raising
            stdout_data, stderr_data = process.communicate()
            raise TimeoutExpired(args, timeout, stdout_data, stderr_data)

    # Create result
    result = CompletedProcess(args, process.returncode, stdout_data, stderr_data)

    # Check return code if requested
    if check and process.returncode != 0:
        raise CalledProcessError(process.returncode, args, stdout_data, stderr_data)

    return result


def call(args, *, stdin=None, stdout=None, stderr=None,
         shell=False, timeout=None, cwd=None, env=None) -> int:
    """Run command and return exit code.

    Args:
        args: Command to run
        stdin, stdout, stderr: File handles
        shell: Run through shell
        timeout: Maximum execution time
        cwd: Working directory
        env: Environment variables

    Returns:
        Exit code (0 for success)

    Example:
        ret = call(['make', 'all'])
        if ret != 0:
            print("Build failed")
    """
    result = run(args, stdin=stdin, stdout=stdout, stderr=stderr,
                 shell=shell, timeout=timeout, cwd=cwd, env=env)
    return result.returncode


def check_call(args, *, stdin=None, stdout=None, stderr=None,
               shell=False, timeout=None, cwd=None, env=None) -> int:
    """Run command and return exit code, raising on error.

    Args:
        args: Command to run
        stdin, stdout, stderr: File handles
        shell: Run through shell
        timeout: Maximum execution time
        cwd: Working directory
        env: Environment variables

    Returns:
        Exit code (0 for success)

    Raises:
        CalledProcessError: If command fails

    Example:
        check_call(['make', 'all'])  # Raises if build fails
    """
    result = run(args, stdin=stdin, stdout=stdout, stderr=stderr,
                 shell=shell, timeout=timeout, check=True, cwd=cwd, env=env)
    return result.returncode


def check_output(args, *, stdin=None, stderr=None, shell=False,
                 timeout=None, universal_newlines=False, cwd=None,
                 env=None) -> str:
    """Run command and return output.

    Args:
        args: Command to run
        stdin: stdin handle
        stderr: stderr handle (use STDOUT to capture with stdout)
        shell: Run through shell
        timeout: Maximum execution time
        universal_newlines: Use text mode
        cwd: Working directory
        env: Environment variables

    Returns:
        Command output as string

    Raises:
        CalledProcessError: If command fails
        TimeoutExpired: If timeout expires

    Example:
        output = check_output(['git', 'rev-parse', 'HEAD'])
        commit_hash = output.strip()
    """
    result = run(args, stdin=stdin, stdout=PIPE, stderr=stderr,
                 shell=shell, timeout=timeout, check=True, cwd=cwd, env=env)
    return result.stdout


# ============================================
# Process List Functions
# ============================================

def list_processes() -> [dict]:
    """List all running processes.

    Returns:
        List of dicts with 'pid', 'name', 'status' keys
    """
    return vp_subprocess_list_processes()


def get_process_info(pid: int) -> dict:
    """Get information about a process.

    Args:
        pid: Process ID

    Returns:
        Dict with process information
    """
    return vp_subprocess_get_process_info(pid)


# ============================================
# Utility Functions
# ============================================

def getoutput(cmd: str) -> str:
    """Get output from command (legacy interface).

    Args:
        cmd: Command string

    Returns:
        Command output
    """
    result = run(cmd, shell=True, stdout=PIPE, stderr=STDOUT)
    return result.stdout


def getstatusoutput(cmd: str) -> tuple:
    """Get exit status and output from command.

    Args:
        cmd: Command string

    Returns:
        Tuple of (status, output)
    """
    result = run(cmd, shell=True, stdout=PIPE, stderr=STDOUT)
    return (result.returncode, result.stdout)


# ============================================
# Platform-Specific Helpers
# ============================================

def _mswindows():
    """Check if running on Windows."""
    import sys
    return sys.platform.startswith('win')


def _posix():
    """Check if running on POSIX system."""
    import sys
    return sys.platform in ('linux', 'darwin', 'freebsd')


# ============================================
# Runtime Function Declarations
# ============================================

extern def vp_subprocess_popen(cmd: str, shell: bool, cwd, env)
extern def vp_subprocess_pid(process) -> int
extern def vp_subprocess_poll(process) -> int
extern def vp_subprocess_wait(process, timeout: float) -> int
extern def vp_subprocess_read_output(process, stderr: bool) -> str
extern def vp_subprocess_write(process, data: str)
extern def vp_subprocess_send_signal(process, signal: int)
extern def vp_subprocess_kill(process)
extern def vp_subprocess_list_processes() -> [dict]
extern def vp_subprocess_get_process_info(pid: int) -> dict


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test subprocess functionality."""
    print("Testing subprocess module...")

    # Test run() with simple command
    print("  Testing run()...")
    try:
        result = run(['echo', 'Hello, World!'], stdout=PIPE, stderr=PIPE)
        print("    Output: " + str(result.stdout).strip())
        print("    Return code: " + str(result.returncode))
    except Exception as e:
        print("    Note: " + str(e))

    # Test check_output()
    print("  Testing check_output()...")
    try:
        output = check_output(['echo', 'test output'])
        print("    Output: " + str(output).strip())
    except Exception as e:
        print("    Note: " + str(e))

    # Test Popen
    print("  Testing Popen...")
    try:
        p = Popen(['echo', 'from Popen'], stdout=PIPE, stderr=PIPE)
        stdout, stderr = p.communicate()
        print("    Output: " + str(stdout).strip())
        print("    PID: " + str(p.pid))
        print("    Return code: " + str(p.returncode))
    except Exception as e:
        print("    Note: " + str(e))

    # Test error handling
    print("  Testing error handling...")
    try:
        result = run(['false'], check=True)
    except CalledProcessError as e:
        print("    CalledProcessError caught (expected)")

    print("subprocess tests completed!")
