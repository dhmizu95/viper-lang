# ============================================
# Integer Functions
# ============================================

extern "C" def vp_math_isqrt(n: int) -> int
extern "C" def vp_math_gcd(a: int, b: int) -> int
extern "C" def vp_math_lcm(a: int, b: int) -> int
extern "C" def vp_math_factorial(n: int) -> int
extern "C" def vp_math_comb(n: int, k: int) -> int
extern "C" def vp_math_perm(n: int, k: int) -> int

# Note: BigInt versions are handled directly by the codegen via generate_math_bigint_func
# The wrapper functions below dispatch to either the int runtime or the codegen BigInt path

def gcd(a, b):
    """Greatest common divisor of a and b. Works on int and bigint."""
    # Codegen handles BigInt case directly via generate_math_bigint_func
    # For int case, call the runtime
    return vp_math_gcd(a, b)

def lcm(a, b):
    """Least common multiple of a and b. Works on int and bigint."""
    return vp_math_lcm(a, b)

def factorial(n):
    """Return n! (n factorial). Works on int and bigint."""
    return vp_math_factorial(n)

def comb(n, k):
    """Number of ways to choose k items from n items. Works on int and bigint."""
    return vp_math_comb(n, k)

def perm(n, k):
    """Number of ways to choose k items from n items with order. Works on int and bigint."""
    return vp_math_perm(n, k)

def isqrt(n):
    """Integer square root. Works on int and bigint."""
    return vp_math_isqrt(n)

# ============================================
# Floating Point Utilities
# ============================================

def isfinite(x: float) -> bool:
    """Return True if x is neither an infinity nor a NaN."""
    # Implemented in runtime
    return False

def isinf(x: float) -> bool:
    """Return True if x is a positive or negative infinity."""
    # Implemented in runtime
    return False

def isnan(x: float) -> bool:
    """Return True if x is a NaN (not a number)."""
    # Implemented in runtime
    return False

def isnormal(x: float) -> bool:
    """Return True if x is a normal floating point number."""
    # Implemented in runtime
    return False

def signbit(x: float) -> bool:
    """Return True if the sign bit of x is set."""
    # Implemented in runtime
    return False

def fsum(values: list[float]) -> float:
    """Return an accurate floating point sum of values."""
    total = 0.0
    for v in values:
        total += v
    return total

def prod(values: list[float]) -> float:
    """Calculate the product of all elements in values."""
    result = 1.0
    for v in values:
        result *= v
    return result

def mean(values: list[float]) -> float:
    """Calculate the arithmetic mean of values."""
    if len(values) == 0:
        return 0.0
    return fsum(values) / len(values)

def fmin(x: float, y: float) -> float:
    """Return the minimum of x and y."""
    # Implemented in runtime
    return 0.0

def fmax(x: float, y: float) -> float:
    """Return the maximum of x and y."""
    # Implemented in runtime
    return 0.0

def dist(p: list[float], q: list[float]) -> float:
    """Return the Euclidean distance between two points p and q."""
    if len(p) != len(q):
        return 0.0
    if len(p) == 2:
        return hypot(p[0] - q[0], p[1] - q[1])
    return 0.0

