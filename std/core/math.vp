def sqrt(x: float) -> float:
    """Return the square root of x."""
    return vp_math_sqrt(x)

def ln(x: float) -> float:
    """Return the natural logarithm of x."""
    return vp_math_ln(x)

def floor(x: float) -> float:
    """Return the floor of x as an Integral."""
