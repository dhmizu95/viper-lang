# ============================================
# Floating Point Utilities
# ============================================

def isfinite(x: f64) -> bool:
    """Return True if x is neither an infinity nor a NaN."""
    # Implemented in runtime
    return False

def isinf(x: f64) -> bool:
    """Return True if x is a positive or negative infinity."""
    # Implemented in runtime
    return False

def isnan(x: f64) -> bool:
    """Return True if x is a NaN (not a number)."""
    # Implemented in runtime
    return False

def isnormal(x: f64) -> bool:
    """Return True if x is a normal floating point number."""
    # Implemented in runtime
    return False

def signbit(x: f64) -> bool:
    """Return True if the sign bit of x is set."""
    # Implemented in runtime
    return False

def fsum(values: [f64]) -> f64:
    """Return an accurate floating point sum of values."""
    total = 0.0
    for v in values:
        total += v
    return total

def prod(values: [f64]) -> f64:
    """Calculate the product of all elements in values."""
    result = 1.0
    for v in values:
        result *= v
    return result

def mean(values: [f64]) -> f64:
    """Calculate the arithmetic mean of values."""
    if len(values) == 0:
        return 0.0
    return fsum(values) / len(values)

def fmin(x: f64, y: f64) -> f64:
    """Return the minimum of x and y."""
    # Implemented in runtime
    return 0.0

def fmax(x: f64, y: f64) -> f64:
    """Return the maximum of x and y."""
    # Implemented in runtime
    return 0.0

def dist(p: [f64], q: [f64]) -> f64:
    """Return the Euclidean distance between two points p and q."""
    if len(p) != len(q):
        return 0.0
    if len(p) == 2:
        return hypot(p[0] - q[0], p[1] - q[1])
    return 0.0

