# Viper Standard Library - bisect module
# Binary search algorithms for sorted lists

# Module metadata
__name__ = "bisect"
__version__ = "0.4.7"

# ============================================
# Binary Search Functions
# ============================================

def bisect_right(a: [object], x, lo=0, hi=None) -> int:
    """Find insertion point for x in a to maintain sorted order.

    Returns the rightmost insertion point (after any existing entries of x).

    Args:
        a: Sorted list
        x: Value to insert
        lo: Lower bound index (default 0)
        hi: Upper bound index (default len(a))

    Returns:
        Index where x should be inserted

    Example:
        bisect_right([1, 2, 2, 3], 2) -> 3
    """
    if hi is None:
        hi = len(a)

    while lo < hi:
        mid = (lo + hi) // 2
        if x < a[mid]:
            hi = mid
        else:
            lo = mid + 1

    return lo


def bisect_left(a: [object], x, lo=0, hi=None) -> int:
    """Find insertion point for x in a to maintain sorted order.

    Returns the leftmost insertion point (before any existing entries of x).

    Args:
        a: Sorted list
        x: Value to insert
        lo: Lower bound index (default 0)
        hi: Upper bound index (default len(a))

    Returns:
        Index where x should be inserted

    Example:
        bisect_left([1, 2, 2, 3], 2) -> 1
    """
    if hi is None:
        hi = len(a)

    while lo < hi:
        mid = (lo + hi) // 2
        if a[mid] < x:
            lo = mid + 1
        else:
            hi = mid

    return lo


def bisect(a: [object], x, lo=0, hi=None) -> int:
    """Find insertion point for x in a (alias for bisect_right).

    Args:
        a: Sorted list
        x: Value to insert
        lo: Lower bound index (default 0)
        hi: Upper bound index (default len(a))

    Returns:
        Index where x should be inserted
    """
    return bisect_right(a, x, lo, hi)


# ============================================
# Insert Functions
# ============================================

def insort_right(a: [object], x, lo=0, hi=None):
    """Insert x in a, maintaining sorted order.

    Insert after any existing entries of x (rightmost).

    Args:
        a: Sorted list (modified in place)
        x: Value to insert
        lo: Lower bound index (default 0)
        hi: Upper bound index (default len(a))

    Example:
        lst = [1, 2, 3]
        insort_right(lst, 2)
        # lst is now [1, 2, 2, 3]
    """
    idx = bisect_right(a, x, lo, hi)
    a.insert(idx, x)


def insort_left(a: [object], x, lo=0, hi=None):
    """Insert x in a, maintaining sorted order.

    Insert before any existing entries of x (leftmost).

    Args:
        a: Sorted list (modified in place)
        x: Value to insert
        lo: Lower bound index (default 0)
        hi: Upper bound index (default len(a))

    Example:
        lst = [1, 2, 3]
        insort_left(lst, 2)
        # lst is now [1, 2, 2, 3]
    """
    idx = bisect_left(a, x, lo, hi)
    a.insert(idx, x)


def insort(a: [object], x, lo=0, hi=None):
    """Insert x in a, maintaining sorted order (alias for insort_right).

    Args:
        a: Sorted list (modified in place)
        x: Value to insert
        lo: Lower bound index (default 0)
        hi: Upper bound index (default len(a))
    """
    insort_right(a, x, lo, hi)


# ============================================
# Key Function Support
# ============================================

def bisect_right_key(a: [object], x, lo=0, hi=None, key=None) -> int:
    """Find insertion point using a key function.

    Args:
        a: Sorted list
        x: Value to insert
        lo: Lower bound index
        hi: Upper bound index
        key: Function to extract comparison key

    Returns:
        Insertion index
    """
    if hi is None:
        hi = len(a)

    if key is None:
        return bisect_right(a, x, lo, hi)

    x_key = key(x)

    while lo < hi:
        mid = (lo + hi) // 2
        if x_key < key(a[mid]):
            hi = mid
        else:
            lo = mid + 1

    return lo


def bisect_left_key(a: [object], x, lo=0, hi=None, key=None) -> int:
    """Find insertion point using a key function.

    Args:
        a: Sorted list
        x: Value to insert
        lo: Lower bound index
        hi: Upper bound index
        key: Function to extract comparison key

    Returns:
        Insertion index
    """
    if hi is None:
        hi = len(a)

    if key is None:
        return bisect_left(a, x, lo, hi)

    x_key = key(x)

    while lo < hi:
        mid = (lo + hi) // 2
        if key(a[mid]) < x_key:
            lo = mid + 1
        else:
            hi = mid

    return lo


def insort_right_key(a: [object], x, lo=0, hi=None, key=None):
    """Insert x in a using a key function."""
    idx = bisect_right_key(a, x, lo, hi, key)
    a.insert(idx, x)


def insort_left_key(a: [object], x, lo=0, hi=None, key=None):
    """Insert x in a using a key function."""
    idx = bisect_left_key(a, x, lo, hi, key)
    a.insert(idx, x)


# ============================================
# Utility Functions
# ============================================

def index_of(a: [object], x, lo=0, hi=None) -> int:
    """Find index of x in sorted list a.

    Args:
        a: Sorted list
        x: Value to find
        lo: Lower bound index
        hi: Upper bound index

    Returns:
        Index of first occurrence of x

    Raises:
        ValueError: If x is not in a
    """
    idx = bisect_left(a, x, lo, hi)
    if idx < len(a) and a[idx] == x:
        return idx
    raise ValueError(str(x) + " is not in list")


def count_occurrences(a: [object], x, lo=0, hi=None) -> int:
    """Count occurrences of x in sorted list a.

    Args:
        a: Sorted list
        x: Value to count
        lo: Lower bound index
        hi: Upper bound index

    Returns:
        Number of occurrences of x
    """
    left = bisect_left(a, x, lo, hi)
    right = bisect_right(a, x, lo, hi)
    return right - left


def find_range(a: [object], x, lo=0, hi=None) -> tuple:
    """Find range of indices where x appears in sorted list.

    Args:
        a: Sorted list
        x: Value to find
        lo: Lower bound index
        hi: Upper bound index

    Returns:
        Tuple (start, end) where a[start:end] contains all x values
    """
    left = bisect_left(a, x, lo, hi)
    right = bisect_right(a, x, lo, hi)
    return (left, right)


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test bisect functionality."""
    print("Testing bisect module...")

    # Test bisect_left and bisect_right
    print("  Testing bisect_left/right...")
    lst = [1, 2, 2, 2, 3, 4, 5]

    left = bisect_left(lst, 2)
    right = bisect_right(lst, 2)
    print("    List: " + str(lst))
    print("    bisect_left(lst, 2) = " + str(left))
    print("    bisect_right(lst, 2) = " + str(right))

    # Test insort
    print("  Testing insort...")
    lst2 = [1, 3, 5, 7]
    insort(lst2, 4)
    print("    insort([1, 3, 5, 7], 4) = " + str(lst2))

    # Test with duplicates
    print("  Testing with duplicates...")
    lst3 = [1, 2, 2, 3]
    insort_left(lst3, 2)
    print("    insort_left([1, 2, 2, 3], 2) = " + str(lst3))

    lst4 = [1, 2, 2, 3]
    insort_right(lst4, 2)
    print("    insort_right([1, 2, 2, 3], 2) = " + str(lst4))

    # Test index_of
    print("  Testing index_of...")
    idx = index_of(lst, 3)
    print("    index_of(lst, 3) = " + str(idx))

    # Test count_occurrences
    print("  Testing count_occurrences...")
    count = count_occurrences(lst, 2)
    print("    count_occurrences(lst, 2) = " + str(count))

    # Test find_range
    print("  Testing find_range...")
    start, end = find_range(lst, 2)
    print("    find_range(lst, 2) = (" + str(start) + ", " + str(end) + ")")
    print("    lst[" + str(start) + ":" + str(end) + "] = " + str(lst[start:end]))

    # Test with key function
    print("  Testing with key function...")
    words = ["apple", "banana", "cherry", "date"]
    idx = bisect_left_key(words, "blueberry", key=lambda s: s)
    print("    bisect_left_key(words, 'blueberry') = " + str(idx))

    print("bisect tests completed!")
