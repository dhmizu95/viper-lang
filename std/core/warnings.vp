# Viper Standard Library - warnings module
# Warning message control and filtering

# Module metadata
__name__ = "warnings"
__version__ = "0.4.7"

# ============================================
# Warning Categories
# ============================================

class Warning(Exception):
    """Base class for warning categories."""
    pass


class UserWarning(Warning):
    """Warning about questionable behavior."""
    pass


class DeprecationWarning(Warning):
    """Warning about deprecated features."""
    pass


class PendingDeprecationWarning(Warning):
    """Warning about features pending deprecation."""
    pass


class SyntaxWarning(Warning):
    """Warning about dubious syntax."""
    pass


class RuntimeWarning(Warning):
    """Warning about dubious runtime behavior."""
    pass


class FutureWarning(Warning):
    """Warning about changes in future behavior."""
    pass


class ImportWarning(Warning):
    """Warning about import issues."""
    pass


class UnicodeWarning(Warning):
    """Warning about Unicode issues."""
    pass


class BytesWarning(Warning):
    """Warning about bytes/str mixing."""
    pass


class ResourceWarning(Warning):
    """Warning about resource usage."""
    pass


# ============================================
# Warning Registry
# ============================================

# Global warning registry
_filters = []
_defaultaction = "default"
_once_registry = {}


# ============================================
# Warning Functions
# ============================================

def warn(message, category=Warning, stacklevel=1, source=None):
    """Issue a warning message.

    Args:
        message: Warning message (string or Warning instance)
        category: Warning category class
        stacklevel: Stack frames to skip for location
        source: Object to use as warning source

    Example:
        warnings.warn("deprecated", DeprecationWarning)
    """
    # Get caller info
    import sys
    frame = sys._getframe(stacklevel)
    filename = frame.f_code.co_filename
    lineno = frame.f_lineno
    module = frame.f_code.co_name

    # Create warning instance if message is string
    if isinstance(message, str):
        warning = category(message)
    else:
        warning = message

    # Check filters
    action = _get_action(message, category, filename, lineno, module)

    if action == "ignore":
        return
    elif action == "error":
        raise warning
    elif action == "once":
        # Check if already shown
        key = (str(message), category, filename, lineno)
        if key in _once_registry:
            return
        _once_registry[key] = True
    elif action == "module":
        # Show once per module
        key = (str(message), category, module)
        if key in _once_registry:
            return
        _once_registry[key] = True
    elif action == "once":
        # Show once per location
        key = (str(message), category, filename, lineno)
        if key in _once_registry:
            return
        _once_registry[key] = True

    # Default: always show
    showwarning(warning, category, filename, lineno, source=source)


def warn_explicit(message, category, filename, lineno, module=None,
                  registry=None, module_globals=None, source=None):
    """Issue warning with explicit location info.

    Low-level function used by warn().

    Args:
        message: Warning message
        category: Warning category
        filename: Source filename
        lineno: Line number
        module: Module name
        registry: Warning registry dict
        module_globals: Module globals dict
        source: Source line
    """
    if isinstance(message, str):
        warning = category(message)
    else:
        warning = message

    showwarning(warning, category, filename, lineno, source=source)


# ============================================
# Warning Display
# ============================================

def showwarning(message, category, filename, lineno, file=None, line=None):
    """Display warning message.

    Can be overridden to customize warning output.

    Args:
        message: Warning message
        category: Warning category
        filename: Source filename
        lineno: Line number
        file: Output file (default stderr)
        line: Source line
    """
    if file is None:
        import sys
        file = sys.stderr

    msg = formatwarning(message, category, filename, lineno, line)
    file.write(msg)


def formatwarning(message, category, filename, lineno, line=None) -> str:
    """Format warning message.

    Args:
        message: Warning message
        category: Warning category
        filename: Source filename
        lineno: Line number
        line: Source line

    Returns:
        Formatted warning string
    """
    import os
    basename = os.path.basename(filename) if filename else "<unknown>"

    # Get category name
    if hasattr(category, '__name__'):
        cat_name = category.__name__
    else:
        cat_name = str(category)

    # Format message
    msg = str(message)

    # Build output
    result = basename + ":" + str(lineno) + ": " + cat_name + ": " + msg + "\n"

    return result


def defaultaction(message, category, filename, lineno, file=None, line=None):
    """Default action for warnings - print to stderr."""
    showwarning(message, category, filename, lineno, file, line)


# ============================================
# Warning Filters
# ============================================

def filterwarnings(action, message="", category=Warning, module="",
                   lineno=0, append=False):
    """Insert entry into warning filter list.

    Args:
        action: One of "error", "ignore", "always", "default", "module", "once"
        message: Regex pattern to match message
        category: Warning category class
        module: Regex pattern to match module name
        lineno: Line number (0 = all lines)
        append: Add to end instead of beginning

    Example:
        filterwarnings("ignore", message="deprecated")
        filterwarnings("error", category=DeprecationWarning)
    """
    entry = (action, message, category, module, lineno)

    if append:
        _filters.append(entry)
    else:
        _filters.insert(0, entry)


def simplefilter(action, category=Warning, lineno=0, append=False):
    """Insert simple filter entry.

    Like filterwarnings() but without message/module patterns.

    Args:
        action: Filter action
        category: Warning category
        lineno: Line number
        append: Add to end
    """
    filterwarnings(action, "", category, "", lineno, append)


def resetwarnings():
    """Clear all warning filters."""
    global _filters
    _filters = []
    global _once_registry
    _once_registry = {}


def _get_action(message, category, filename, lineno, module) -> str:
    """Get action for a warning based on filters."""
    # Check filters in order
    for action, msg_pattern, cat, mod_pattern, line_num in _filters:
        # Check category match
        if not issubclass(category, cat):
            continue

        # Check message pattern (simplified - exact match)
        if msg_pattern and msg_pattern not in str(message):
            continue

        # Check module pattern
        if mod_pattern and mod_pattern not in module:
            continue

        # Check line number
        if line_num > 0 and line_num != lineno:
            continue

        return action

    # No filter matched, use default
    return _defaultaction


# ============================================
# Context Manager
# ============================================

class catch_warnings:
    """Context manager for temporarily modifying warning filters.

    Example:
        with catch_warnings():
            simplefilter("ignore")
            # warnings ignored here
    """

    def __init__(self, *args, **kwargs):
        self._saved_filters = None
        self._saved_once = None
        self._record = kwargs.get('record', False)
        self._entered = False

    def __enter__(self):
        """Save current state and enter context."""
        global _filters, _once_registry

        # Save current state
        self._saved_filters = list(_filters)
        self._saved_once = dict(_once_registry)

        # Apply any filters from constructor
        for action, msg, cat, mod, line in self._get_filters():
            filterwarnings(action, msg, cat, mod, line)

        self._entered = True
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Restore saved state."""
        global _filters, _once_registry

        if self._saved_filters is not None:
            _filters = self._saved_filters
        if self._saved_once is not None:
            _once_registry = self._saved_once

        self._entered = False

    def _get_filters(self):
        """Get filters to apply on entry."""
        # Simplified - would handle 'action' parameter
        return []

    def __getitem__(self, item):
        """Access recorded warnings (if record=True)."""
        return None


# ============================================
# Logging Integration
# ============================================

def _showwarning_log(message, category, filename, lineno, file=None, line=None):
    """Show warning using logging module."""
    import logging
    msg = formatwarning(message, category, filename, lineno, line).strip()
    logging.warning(msg)


def showwarning_log(message, category, filename, lineno, file=None, line=None):
    """Redirect warnings to logging."""
    _showwarning_log(message, category, filename, lineno, file, line)


def captureWarnings(capture: bool):
    """Enable/disable warning capture by logging.

    Args:
        capture: True to redirect warnings to logging
    """
    global showwarning
    if capture:
        showwarning = showwarning_log
    else:
        showwarning = showwarning  # Restore default


# ============================================
# Convenience Functions
# ============================================

def deprecated(message: str):
    """Decorator to mark function as deprecated.

    Issues DeprecationWarning when function is called.

    Args:
        message: Deprecation message

    Example:
        @deprecated("Use new_function() instead")
        def old_function():
            pass
    """
    def decorator(func):
        def wrapper(*args, **kwargs):
            warn(message, DeprecationWarning, stacklevel=2)
            return func(*args, **kwargs)

        wrapper.__name__ = func.__name__
        wrapper.__doc__ = func.__doc__
        return wrapper

    return decorator


# ============================================
# Warning Registry Access
# ============================================

def get_warnings() -> list:
    """Get list of all warning filters.

    Returns:
        List of filter tuples
    """
    return list(_filters)


def get_once_warnings() -> dict:
    """Get dictionary of once-shown warnings.

    Returns:
        Dict of warning keys
    """
    return dict(_once_registry)


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test warnings functionality."""
    print("Testing warnings module...")

    # Test basic warning
    print("  Testing warn()...")
    warn("This is a test warning", UserWarning)

    # Test deprecation warning
    print("  Testing DeprecationWarning...")
    warn("old_func is deprecated", DeprecationWarning)

    # Test filter
    print("  Testing filterwarnings()...")
    filterwarnings("ignore", message="ignore this")
    warn("ignore this", UserWarning)  # Should be ignored
    print("    (warning should be ignored above)")

    # Test error filter
    print("  Testing error filter...")
    filterwarnings("error", category=FutureWarning)
    try:
        warn("error warning", FutureWarning)
    except FutureWarning:
        print("    FutureWarning caught as expected")

    # Reset and test again
    resetwarnings()
    print("  After resetwarnings()...")
    warn("after reset", UserWarning)

    # Test catch_warnings
    print("  Testing catch_warnings()...")
    with catch_warnings():
        simplefilter("ignore")
        warn("ignored in context", UserWarning)
    print("    (warning should be ignored above)")

    # Test deprecated decorator
    print("  Testing @deprecated...")

    @deprecated("Use something else")
    def old_func():
        return 42

    result = old_func()
    print("    old_func() returned: " + str(result))

    print("warnings tests completed!")
