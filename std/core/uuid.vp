# Viper Standard Library - uuid module
# UUID generation and handling

# Module metadata
__name__ = "uuid"
__version__ = "0.4.7"

# ============================================
# UUID Class
# ============================================

class UUID:
    """Universally Unique Identifier.

    Represents a 128-bit UUID value.

    Args:
        hex: Hex string (32 chars, with or without hyphens)
        bytes: 16-byte string
        int: 128-bit integer
        version: UUID version (1-5)

    Example:
        u = uuid4()  # Random UUID
        u = UUID(hex='12345678-1234-5678-1234-567812345678')
    """

    def __init__(self, hex=None, bytes=None, int=None, version=None):
        self._version = version
        self._node = None
        self._clock_seq = None
        self._time = None

        if hex is not None:
            self._from_hex(hex)
        elif bytes is not None:
            self._from_bytes(bytes)
        elif int is not None:
            self._int = int
        else:
            self._int = 0

    def _from_hex(self, hex: str):
        """Parse UUID from hex string."""
        # Remove hyphens and convert to lowercase
        hex = hex.replace('-', '').lower()

        if len(hex) != 32:
            raise ValueError("hex string must be 32 characters")

        self._int = int(hex, 16)

        # Extract version from bits
        version_bits = (self._int >> 76) & 0xF
        if version_bits >= 1 and version_bits <= 5:
            self._version = version_bits

    def _from_bytes(self, bytes: str):
        """Parse UUID from bytes."""
        if len(bytes) != 16:
            raise ValueError("bytes must be 16 characters")

        self._int = 0
        for i, byte in enumerate(bytes):
            self._int = (self._int << 8) | ord(byte)

    @property
    def hex(self) -> str:
        """Return UUID as 32-character hex string."""
        return format(self._int, '032x')

    @property
    def int(self) -> int:
        """Return UUID as 128-bit integer."""
        return self._int

    @property
    def bytes(self) -> str:
        """Return UUID as 16-byte string."""
        result = []
        for i in range(15, -1, -1):
            result.append(chr((self._int >> (i * 8)) & 0xFF))
        return "".join(result)

    @property
    def version(self) -> int:
        """Return UUID version."""
        return self._version

    @property
    def variant(self) -> int:
        """Return UUID variant."""
        variant_bits = (self._int >> 124) & 0x7
        if variant_bits <= 1:
            return 0  # NCS
        elif variant_bits == 2 or variant_bits == 3:
            return 2  # RFC 4122
        elif variant_bits == 4:
            return 5  # Microsoft
        else:
            return 7  # Reserved

    @property
    def node(self) -> int:
        """Return node ID (last 48 bits)."""
        return self._int & 0xFFFFFFFFFFFF

    @property
    def time(self) -> int:
        """Return timestamp (for version 1)."""
        if self._version != 1:
            return None
        # Extract time from UUID
        time_low = self._int & 0xFFFFFFFF
        time_mid = (self._int >> 32) & 0xFFFF
        time_hi = (self._int >> 48) & 0x0FFF
        return (time_hi << 48) | (time_mid << 32) | time_low

    @property
    def clock_seq(self) -> int:
        """Return clock sequence (for version 1)."""
        if self._version != 1:
            return None
        return (self._int >> 64) & 0x3FFF

    @property
    def fields(self) -> tuple:
        """Return UUID fields as tuple."""
        time_low = self._int >> 96
        time_mid = (self._int >> 80) & 0xFFFF
        time_hi = (self._int >> 64) & 0xFFFF
        clock_seq = (self._int >> 48) & 0xFFFF
        node = self._int & 0xFFFFFFFFFFFF
        return (time_low, time_mid, time_hi, clock_seq, node)

    def __str__(self) -> str:
        """Return UUID as standard string format."""
        hex_str = self.hex
        return (hex_str[:8] + '-' + hex_str[8:12] + '-' +
                hex_str[12:16] + '-' + hex_str[16:20] + '-' + hex_str[20:])

    def __repr__(self) -> str:
        return "UUID('" + str(self) + "')"

    def __eq__(self, other) -> bool:
        if isinstance(other, UUID):
            return self._int == other._int
        return False

    def __hash__(self) -> int:
        return hash(self._int)

    def __lt__(self, other):
        if isinstance(other, UUID):
            return self._int < other._int
        return NotImplemented

    def __le__(self, other):
        return self == other or self < other

    def __gt__(self, other):
        return not self <= other

    def __ge__(self, other):
        return not self < other


# ============================================
# UUID Generation Functions
# ============================================

def uuid1(node=None, clock_seq=None) -> UUID:
    """Generate UUID version 1 (time-based).

    Uses MAC address and timestamp.

    Args:
        node: 48-bit node ID (default: random)
        clock_seq: 14-bit clock sequence (default: random)

    Returns:
        UUID version 1
    """
    import time

    # Get current time in 100-nanosecond intervals since Oct 15, 1582
    timestamp = int(time.time() * 10000000) + 0x01B21DD213814000

    # Generate random node ID if not provided
    if node is None:
        node = _random_node()

    # Generate random clock sequence if not provided
    if clock_seq is None:
        clock_seq = _random_clock_seq()

    # Build UUID
    time_low = timestamp & 0xFFFFFFFF
    time_mid = (timestamp >> 32) & 0xFFFF
    time_hi = ((timestamp >> 48) & 0x0FFF) | 0x1000  # Version 1

    clock_seq_hi = ((clock_seq >> 8) & 0x3F) | 0x80  # Variant RFC 4122
    clock_seq_low = clock_seq & 0xFF

    uuid_int = (time_low << 96) | (time_mid << 80) | (time_hi << 64)
    uuid_int = uuid_int | (clock_seq_hi << 56) | (clock_seq_low << 48) | node

    return UUID(int=uuid_int, version=1)


def uuid3(namespace, name: str) -> UUID:
    """Generate UUID version 3 (MD5-based).

    Uses MD5 hash of namespace and name.

    Args:
        namespace: Namespace UUID
        name: Name string

    Returns:
        UUID version 3
    """
    # Get namespace bytes
    ns_bytes = namespace.bytes

    # Hash namespace + name
    hash_bytes = _md5_hash(ns_bytes + name)

    # Set version and variant bits
    hash_bytes = hash_bytes[:6] + chr((ord(hash_bytes[6]) & 0x0F) | 0x30)
    hash_bytes = hash_bytes[7:8] + chr((ord(hash_bytes[8]) & 0x3F) | 0x80)
    hash_bytes = hash_bytes[9:]

    return UUID(bytes=hash_bytes, version=3)


def uuid4() -> UUID:
    """Generate UUID version 4 (random).

    Uses random or pseudo-random numbers.

    Returns:
        UUID version 4
    """
    import random

    # Generate 16 random bytes
    bytes_list = []
    for i in range(16):
        bytes_list.append(chr(random.randint(0, 255)))

    bytes_str = "".join(bytes_list)

    # Set version 4 and variant bits
    bytes_str = bytes_str[:6] + chr((ord(bytes_str[6]) & 0x0F) | 0x40)
    bytes_str = bytes_str[7:8] + chr((ord(bytes_str[8]) & 0x3F) | 0x80)
    bytes_str = bytes_str[9:]

    return UUID(bytes=bytes_str, version=4)


def uuid5(namespace, name: str) -> UUID:
    """Generate UUID version 5 (SHA-1-based).

    Uses SHA-1 hash of namespace and name.

    Args:
        namespace: Namespace UUID
        name: Name string

    Returns:
        UUID version 5
    """
    # Get namespace bytes
    ns_bytes = namespace.bytes

    # Hash namespace + name
    hash_bytes = _sha1_hash(ns_bytes + name)[:16]

    # Set version and variant bits
    hash_bytes = hash_bytes[:6] + chr((ord(hash_bytes[6]) & 0x0F) | 0x50)
    hash_bytes = hash_bytes[7:8] + chr((ord(hash_bytes[8]) & 0x3F) | 0x80)
    hash_bytes = hash_bytes[9:]

    return UUID(bytes=hash_bytes, version=5)


# ============================================
# Predefined Namespaces
# ============================================

NAMESPACE_DNS = UUID(hex='6ba7b810-9dad-11d1-80b4-00c04fd430c8')
NAMESPACE_URL = UUID(hex='6ba7b811-9dad-11d1-80b4-00c04fd430c8')
NAMESPACE_OID = UUID(hex='6ba7b812-9dad-11d1-80b4-00c04fd430c8')
NAMESPACE_X500 = UUID(hex='6ba7b814-9dad-11d1-80b4-00c04fd430c8')


# ============================================
# Helper Functions
# ============================================

def _random_node() -> int:
    """Generate random 48-bit node ID."""
    import random
    return random.randint(0, 0xFFFFFFFFFFFF)


def _random_clock_seq() -> int:
    """Generate random 14-bit clock sequence."""
    import random
    return random.randint(0, 0x3FFF)


def _md5_hash(data: str) -> str:
    """MD5 hash (simplified)."""
    # Use hashlib if available
    try:
        import hashlib
        h = hashlib.md5(data)
        return h.digest()
    except:
        # Fallback: simple hash (not cryptographically secure)
        result = []
        for i in range(16):
            result.append(chr((ord(data[i % len(data)]) + i) % 256))
        return "".join(result)


def _sha1_hash(data: str) -> str:
    """SHA-1 hash (simplified)."""
    # Use hashlib if available
    try:
        import hashlib
        h = hashlib.sha1(data)
        return h.digest()
    except:
        # Fallback: simple hash (not cryptographically secure)
        result = []
        for i in range(20):
            result.append(chr((ord(data[i % len(data)]) + i * 2) % 256))
        return "".join(result)


def getnode() -> int:
    """Get hardware node ID (MAC address).

    Returns:
        48-bit node ID
    """
    # Try to get MAC address
    try:
        # Would use system calls to get MAC
        return _random_node()
    except:
        return _random_node()


# ============================================
# Test/Demo
# ============================================

def _test():
    """Test uuid functionality."""
    print("Testing uuid module...")

    # Test uuid4
    print("  Testing uuid4...")
    u1 = uuid4()
    print("    uuid4(): " + str(u1))
    print("    version: " + str(u1.version))
    print("    variant: " + str(u1.variant))

    # Test uuid1
    print("  Testing uuid1...")
    u2 = uuid1()
    print("    uuid1(): " + str(u2))
    print("    version: " + str(u2.version))
    print("    node: " + hex(u2.node))

    # Test uuid3
    print("  Testing uuid3...")
    u3 = uuid3(NAMESPACE_DNS, 'example.com')
    print("    uuid3(NAMESPACE_DNS, 'example.com'): " + str(u3))
    print("    version: " + str(u3.version))

    # Test uuid5
    print("  Testing uuid5...")
    u5 = uuid5(NAMESPACE_DNS, 'example.com')
    print("    uuid5(NAMESPACE_DNS, 'example.com'): " + str(u5))
    print("    version: " + str(u5.version))

    # Test UUID from hex
    print("  Testing UUID from hex...")
    u_hex = UUID(hex='12345678-1234-5678-1234-567812345678')
    print("    UUID(hex='...'): " + str(u_hex))
    print("    int: " + hex(u_hex.int))

    # Test UUID properties
    print("  Testing UUID properties...")
    print("    u1.hex: " + u1.hex)
    print("    u1.bytes length: " + str(len(u1.bytes)))
    print("    u1.fields: " + str(u1.fields))

    # Test comparison
    print("  Testing comparison...")
    u_a = uuid4()
    u_b = uuid4()
    print("    u_a < u_b: " + str(u_a < u_b))
    print("    u_a == u_a: " + str(u_a == u_a))

    # Test hash
    print("  Testing hash...")
    print("    hash(u1): " + str(hash(u1)))

    print("uuid tests completed!")
