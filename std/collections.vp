# Viper Standard Library - collections module extensions
# Additional container datatypes including namedtuple

# Module metadata
__name__ = "collections"
__version__ = "0.4.7"

# ============================================
# namedtuple
# ============================================

def namedtuple(typename: str, field_names):
    """Create a named tuple class.
    
    namedtuple('Point', ['x', 'y']) creates a tuple subclass with
    named fields that can be accessed as attributes.
    
    Example:
        Point = namedtuple('Point', ['x', 'y'])
        p = Point(1, 2)
        print(p.x, p.y)  # 1 2
    """
    # Parse field names (can be string or list)
    if isinstance(field_names, str):
        # Split by whitespace or commas
        if ',' in field_names:
            fields = [f.strip() for f in field_names.split(',')]
        else:
            fields = field_names.split()
    else:
        fields = list(field_names)
    
    # Create the namedtuple class dynamically
    class NamedTupleClass:
        # Class attributes
        _fields = tuple(fields)
        __name__ = typename
        
        def __init__(self, *args):
            if len(args) != len(self._fields):
                raise ValueError(
                    "Expected " + str(len(self._fields)) + 
                    " arguments, got " + str(len(args))
                )
            # Store values in a tuple
            self._values = tuple(args)
        
        def __getitem__(self, index):
            return self._values[index]
        
        def __len__(self):
            return len(self._values)
        
        def __iter__(self):
            for value in self._values:
                yield value
        
        def __eq__(self, other):
            if not isinstance(other, NamedTupleClass):
                return False
            return self._values == other._values
        
        def __repr__(self):
            parts = []
            for i, field in enumerate(self._fields):
                parts.append(field + "=" + repr(self._values[i]))
            return typename + "(" + ", ".join(parts) + ")"
        
        def __hash__(self):
            return hash(self._values)
        
        def _asdict(self):
            """Convert to dictionary."""
            result = {}
            for i, field in enumerate(self._fields):
                result[field] = self._values[i]
            return result
        
        def _replace(self, **kwargs):
            """Create new instance with replaced fields."""
            values = list(self._values)
            for field, value in kwargs.items():
                if field in self._fields:
                    idx = self._fields.index(field)
                    values[idx] = value
            return NamedTupleClass(*values)
        
        @classmethod
        def _make(cls, iterable):
            """Create instance from iterable."""
            return cls(*iterable)
    
    # Add property accessors for each field
    for i, field in enumerate(fields):
        def make_property(idx):
            def getter(self):
                return self._values[idx]
            return property(getter)
        
        setattr(NamedTupleClass, field, make_property(i))
    
    # Set class name
    NamedTupleClass.__name__ = typename
    
    return NamedTupleClass

# ============================================
# OrderedDict
# ============================================

class OrderedDict:
    """Dictionary that maintains insertion order."""
    
    def __init__(self, *args, **kwargs):
        self._keys = []
        self._values = {}
        
        # Initialize from args
        if len(args) > 0:
            if isinstance(args[0], dict):
                for key in args[0]:
                    self[key] = args[0][key]
        
        # Initialize from kwargs
        for key in kwargs:
            self[key] = kwargs[key]
    
    def __setitem__(self, key, value):
        if key not in self._keys:
            self._keys.append(key)
        self._values[key] = value
    
    def __getitem__(self, key):
        return self._values[key]
    
    def __delitem__(self, key):
        self._keys.remove(key)
        del self._values[key]
    
    def __contains__(self, key):
        return key in self._keys
    
    def __len__(self):
        return len(self._keys)
    
    def __iter__(self):
        for key in self._keys:
            yield key
    
    def __repr__(self):
        items = []
        for key in self._keys:
            items.append(repr(key) + ": " + repr(self._values[key]))
        return "OrderedDict({" + ", ".join(items) + "})"
    
    def __eq__(self, other):
        if not isinstance(other, OrderedDict):
            return False
        if len(self) != len(other):
            return False
        for key in self._keys:
            if key not in other._keys or self._values[key] != other._values[key]:
                return False
        return True
    
    def keys(self):
        return self._keys
    
    def values(self):
        return [self._values[key] for key in self._keys]
    
    def items(self):
        return [(key, self._values[key]) for key in self._keys]
    
    def get(self, key, default=None):
        if key in self._keys:
            return self._values[key]
        return default
    
    def pop(self, key, default=None):
        if key in self._keys:
            self._keys.remove(key)
            return self._values.pop(key)
        return default
    
    def popitem(self, last=True):
        if len(self) == 0:
            raise KeyError("popitem(): dictionary is empty")
        
        if last:
            key = self._keys.pop()
        else:
            key = self._keys.pop(0)
        
        value = self._values.pop(key)
        return (key, value)
    
    def clear(self):
        self._keys.clear()
        self._values.clear()
    
    def update(self, other):
        if isinstance(other, dict):
            for key in other:
                self[key] = other[key]
    
    def setdefault(self, key, default=None):
        if key not in self._keys:
            self[key] = default
        return self[key]
    
    def move_to_end(self, key, last=True):
        """Move existing key to end (or beginning if last=False)."""
        if key not in self._keys:
            raise KeyError(key)
        
        self._keys.remove(key)
        
        if last:
            self._keys.append(key)
        else:
            self._keys.insert(0, key)

# ============================================
# defaultdict
# ============================================

class defaultdict:
    """Dictionary with default value factory."""
    
    def __init__(self, default_factory=None, *args, **kwargs):
        self.default_factory = default_factory
        self._dict = {}
        
        # Initialize from args
        if len(args) > 0:
            if isinstance(args[0], dict):
                for key in args[0]:
                    self._dict[key] = args[0][key]
        
        # Initialize from kwargs
        for key in kwargs:
            self._dict[key] = kwargs[key]
    
    def __getitem__(self, key):
        if key not in self._dict:
            if self.default_factory is not None:
                self._dict[key] = self.default_factory()
            else:
                raise KeyError(key)
        return self._dict[key]
    
    def __setitem__(self, key, value):
        self._dict[key] = value
    
    def __delitem__(self, key):
        del self._dict[key]
    
    def __contains__(self, key):
        return key in self._dict
    
    def __len__(self):
        return len(self._dict)
    
    def __iter__(self):
        for key in self._dict:
            yield key
    
    def __repr__(self):
        items = []
        for key in self._dict:
            items.append(repr(key) + ": " + repr(self._dict[key]))
        return "defaultdict(" + repr(self.default_factory) + ", {" + ", ".join(items) + "})"
    
    def keys(self):
        return self._dict.keys()
    
    def values(self):
        return self._dict.values()
    
    def items(self):
        return self._dict.items()
    
    def get(self, key, default=None):
        return self._dict.get(key, default)
    
    def pop(self, key, default=None):
        return self._dict.pop(key, default)
    
    def clear(self):
        self._dict.clear()
    
    def update(self, other):
        self._dict.update(other)
    
    def setdefault(self, key, default=None):
        return self._dict.setdefault(key, default)
    
    def copy(self):
        new_dd = defaultdict(self.default_factory)
        new_dd._dict = self._dict.copy()
        return new_dd

# ============================================
# Counter
# ============================================

class Counter:
    """Dictionary subclass for counting hashable objects."""
    
    def __init__(self, iterable=None, **kwargs):
        self._counts = {}
        
        if iterable is not None:
            if isinstance(iterable, dict):
                for key in iterable:
                    self._counts[key] = iterable[key]
            else:
                for item in iterable:
                    if item in self._counts:
                        self._counts[item] = self._counts[item] + 1
                    else:
                        self._counts[item] = 1
        
        for key in kwargs:
            self._counts[key] = self._counts.get(key, 0) + kwargs[key]
    
    def __getitem__(self, key):
        return self._counts.get(key, 0)
    
    def __setitem__(self, key, value):
        self._counts[key] = value
    
    def __delitem__(self, key):
        del self._counts[key]
    
    def __contains__(self, key):
        return key in self._counts and self._counts[key] > 0
    
    def __len__(self):
        return len(self._counts)
    
    def __iter__(self):
        for key in self._counts:
            yield key
    
    def __repr__(self):
        items = []
        for key in self._counts:
            if self._counts[key] > 0:
                items.append(repr(key) + ": " + repr(self._counts[key]))
        return "Counter({" + ", ".join(items) + "})"
    
    def __add__(self, other):
        result = Counter()
        for key in self._counts:
            result._counts[key] = self._counts[key]
        for key in other._counts:
            result._counts[key] = result._counts.get(key, 0) + other._counts[key]
        return result
    
    def __sub__(self, other):
        result = Counter()
        for key in self._counts:
            result._counts[key] = self._counts[key] - other._counts.get(key, 0)
        # Remove zero and negative counts
        to_remove = [k for k in result._counts if result._counts[k] <= 0]
        for key in to_remove:
            del result._counts[key]
        return result
    
    def __and__(self, other):
        """Intersection: min(c[x], d[x])"""
        result = Counter()
        for key in self._counts:
            if key in other._counts:
                result._counts[key] = min(self._counts[key], other._counts[key])
        return result
    
    def __or__(self, other):
        """Union: max(c[x], d[x])"""
        result = Counter()
        for key in self._counts:
            result._counts[key] = self._counts[key]
        for key in other._counts:
            if key not in result._counts or other._counts[key] > result._counts[key]:
                result._counts[key] = other._counts[key]
        return result
    
    def most_common(self, n=None):
        """Return n most common elements."""
        items = [(k, v) for k, v in self._counts.items() if v > 0]
        # Sort by count descending
        items.sort(key=lambda x: x[1], reverse=True)
        if n is not None:
            return items[:n]
        return items
    
    def elements(self):
        """Return iterator over elements repeating each as many times as its count."""
        for key in self._counts:
            count = self._counts[key]
            for i in range(count):
                yield key
    
    def subtract(self, iterable=None, **kwargs):
        """Subtract counts from iterable or mapping."""
        if iterable is not None:
            if isinstance(iterable, dict):
                for key in iterable:
                    self._counts[key] = self._counts.get(key, 0) - iterable[key]
            else:
                for item in iterable:
                    self._counts[item] = self._counts.get(item, 0) - 1
        
        for key in kwargs:
            self._counts[key] = self._counts.get(key, 0) - kwargs[key]
    
    def total(self):
        """Sum of all counts."""
        total = 0
        for key in self._counts:
            total = total + self._counts[key]
        return total
    
    def clear(self):
        self._counts.clear()
    
    def copy(self):
        new_c = Counter()
        new_c._counts = self._counts.copy()
        return new_c

# ============================================
# deque
# ============================================

class deque:
    """Double-ended queue optimized for appends and pops."""
    
    def __init__(self, iterable=None, maxlen=None):
        self._data = []
        self.maxlen = maxlen
        
        if iterable is not None:
            for item in iterable:
                self.append(item)
    
    def append(self, x):
        """Add x to the right side."""
        self._data.append(x)
        if self.maxlen is not None and len(self._data) > self.maxlen:
            self._data.pop(0)
    
    def appendleft(self, x):
        """Add x to the left side."""
        self._data.insert(0, x)
        if self.maxlen is not None and len(self._data) > self.maxlen:
            self._data.pop()
    
    def pop(self):
        """Remove and return rightmost element."""
        if len(self._data) == 0:
            raise IndexError("pop from an empty deque")
        return self._data.pop()
    
    def popleft(self):
        """Remove and return leftmost element."""
        if len(self._data) == 0:
            raise IndexError("pop from an empty deque")
        return self._data.pop(0)
    
    def extend(self, iterable):
        """Extend right side with elements from iterable."""
        for item in iterable:
            self.append(item)
    
    def extendleft(self, iterable):
        """Extend left side with elements from iterable."""
        for item in iterable:
            self.appendleft(item)
    
    def rotate(self, n=1):
        """Rotate n steps to the right (negative for left)."""
        if len(self._data) == 0:
            return
        n = n % len(self._data)
        if n > 0:
            self._data = self._data[-n:] + self._data[:-n]
        elif n < 0:
            n = -n
            self._data = self._data[n:] + self._data[:n]
    
    def reverse(self):
        """Reverse the deque in place."""
        self._data.reverse()
    
    def __len__(self):
        return len(self._data)
    
    def __getitem__(self, index):
        return self._data[index]
    
    def __setitem__(self, index, value):
        self._data[index] = value
    
    def __delitem__(self, index):
        del self._data[index]
    
    def __iter__(self):
        for item in self._data:
            yield item
    
    def __repr__(self):
        return "deque(" + repr(self._data) + ")"
    
    def __eq__(self, other):
        if not isinstance(other, deque):
            return False
        return self._data == other._data
    
    def clear(self):
        self._data.clear()
    
    def copy(self):
        new_d = deque(maxlen=self.maxlen)
        new_d._data = self._data.copy()
        return new_d
    
    def count(self, x):
        """Count occurrences of x."""
        count = 0
        for item in self._data:
            if item == x:
                count = count + 1
        return count
    
    def index(self, x, start=0, end=None):
        """Find index of x."""
        if end is None:
            end = len(self._data)
        for i in range(start, end):
            if self._data[i] == x:
                return i
        raise ValueError(str(x) + " is not in deque")
    
    def remove(self, x):
        """Remove first occurrence of x."""
        idx = self.index(x)
        del self._data[idx]
