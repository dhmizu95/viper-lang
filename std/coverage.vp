# Viper Standard Library - coverage module
# Code coverage analysis

# Module metadata
__name__ = "coverage"
__version__ = "0.4.7"

# ============================================
# Coverage Data
# ============================================

class Coverage:
    """Code coverage collector and reporter.
    
    Tracks which lines of code have been executed during test runs.
    
    Usage:
        cov = coverage.Coverage()
        cov.start()
        # Run your code
        cov.stop()
        cov.save()
        cov.report()
    """
    
    def __init__(self, data_file=".coverage", source=None, omit=None, 
                 include=None, branch=False, concurrency=None):
        self.data_file = data_file
        self.source = source
        self.omit = omit
        self.include = include
        self.branch = branch
        self.concurrency = concurrency
        
        # Coverage data: {filename: {line_number: count}}
        self.data = {}
        self._enabled = False
        self._current_filename = None
        self._current_line = 0
    
    def start(self):
        """Start collecting coverage data."""
        self._enabled = True
    
    def stop(self):
        """Stop collecting coverage data."""
        self._enabled = False
    
    def erase(self):
        """Erase previously collected coverage data."""
        self.data = {}
    
    def load(self):
        """Load coverage data from file."""
        import json
        try:
            f = open(self.data_file, 'r')
            content = f.read()
            f.close()
            
            # Parse JSON data
            loaded = json.loads(content)
            
            # Convert to proper format
            self.data = {}
            for filename, lines in loaded.items():
                self.data[filename] = {}
                for line_str, count in lines.items():
                    self.data[filename][int(line_str)] = count
        except (IOError, json.JSONDecodeError):
            self.data = {}
    
    def save(self):
        """Save coverage data to file."""
        import json
        
        # Convert data to JSON-serializable format
        save_data = {}
        for filename, lines in self.data.items():
            save_data[filename] = {}
            for line_num, count in lines.items():
                save_data[filename][str(line_num)] = count
        
        # Write JSON
        f = open(self.data_file, 'w')
        f.write(json.dumps(save_data))
        f.close()
    
    def combine(self, data_paths=None):
        """Combine coverage data from multiple files."""
        if data_paths is None:
            data_paths = [self.data_file]
        
        for path in data_paths:
            # Load and merge data
            old_data = self.data
            self.data_file = path
            self.load()
            
            # Merge into old data
            for filename, lines in self.data.items():
                if filename not in old_data:
                    old_data[filename] = {}
                for line_num, count in lines.items():
                    old_data[filename][line_num] = old_data[filename].get(line_num, 0) + count
            
            self.data = old_data
    
    def report(self, file=None, show_missing=True, precision=0):
        """Generate coverage report.
        
        Args:
            file: Output file (default: stdout)
            show_missing: Show missing lines
            precision: Decimal precision for percentages
        """
        if len(self.data) == 0:
            return "No coverage data available"
        
        lines = []
        total_files = 0
        total_lines = 0
        covered_lines = 0
        
        # Header
        lines.append("Name" + " " * 50 + "Stmts   Miss  Cover")
        lines.append("-" * 70)
        
        for filename in sorted(self.data.keys()):
            line_data = self.data[filename]
            
            # Count total lines (max line number as approximation)
            if len(line_data) > 0:
                max_line = max(line_data.keys())
                file_total = max_line
                file_covered = len(line_data)
                file_missing = file_total - file_covered
                file_pct = (file_covered * 100.0) / file_total if file_total > 0 else 0
            else:
                file_total = 0
                file_covered = 0
                file_missing = 0
                file_pct = 0
            
            # Format filename
            name = filename
            if len(name) > 50:
                name = "..." + name[-47:]
            
            lines.append(
                name.ljust(50) + 
                str(file_total).rjust(5) + "  " +
                str(file_missing).rjust(4) + "  " +
                str(round(file_pct, precision)) + "%"
            )
            
            if show_missing and file_missing > 0:
                missing_lines = []
                for i in range(1, file_total + 1):
                    if i not in line_data:
                        missing_lines.append(str(i))
                if len(missing_lines) > 0:
                    lines.append("   Missing: " + ", ".join(missing_lines))
            
            total_files = total_files + 1
            total_lines = total_lines + file_total
            covered_lines = covered_lines + file_covered
        
        # Summary
        lines.append("-" * 70)
        if total_lines > 0:
            total_pct = (covered_lines * 100.0) / total_lines
        else:
            total_pct = 0
        
        lines.append(
            "TOTAL".ljust(50) +
            str(total_lines).rjust(5) + "  " +
            str(total_lines - covered_lines).rjust(4) + "  " +
            str(round(total_pct, precision)) + "%"
        )
        
        report = "\n".join(lines)
        
        if file is not None:
            f = open(file, 'w')
            f.write(report)
            f.close()
        else:
            print(report)
        
        return report
    
    def html_report(self, directory="htmlcov"):
        """Generate HTML coverage report."""
        # Create directory
        import os
        if not os.path.exists(directory):
            os.mkdir(directory)
        
        # Generate HTML for each file
        for filename in self.data.keys():
            html_filename = directory + "/" + filename.replace("/", "_") + ".html"
            self._generate_html_file(filename, html_filename)
        
        # Generate index
        self._generate_html_index(directory)
        
        return directory
    
    def _generate_html_file(self, filename, html_filename):
        """Generate HTML for a single file."""
        line_data = self.data.get(filename, {})
        
        html = ["<!DOCTYPE html>"]
        html.append("<html><head><title>" + filename + "</title>")
        html.append("<style>")
        html.append(".covered { background-color: #dfd; }")
        html.append(".missing { background-color: #fdd; }")
        html.append(".not_executed { background-color: #eee; }")
        html.append("</style></head><body>")
        html.append("<h1>" + filename + "</h1>")
        html.append("<pre>")
        
        # Read source file
        try:
            f = open(filename, 'r')
            source_lines = f.readlines()
            f.close()
        except IOError:
            source_lines = []
        
        # Generate line-by-line HTML
        for i, line in enumerate(source_lines):
            line_num = i + 1
            if line_num in line_data:
                css_class = "covered"
            else:
                css_class = "missing"
            
            html.append(
                "<span class='" + css_class + "'>" +
                str(line_num).rjust(4) + ": " +
                line.replace("<", "&lt;").replace(">", "&gt;") +
                "</span>"
            )
        
        html.append("</pre></body></html>")
        
        # Write HTML
        f = open(html_filename, 'w')
        f.write("\n".join(html))
        f.close()
    
    def _generate_html_index(self, directory):
        """Generate HTML index page."""
        html = ["<!DOCTYPE html>"]
        html.append("<html><head><title>Coverage Report</title>")
        html.append("<style>")
        html.append("table { border-collapse: collapse; }")
        html.append("th, td { border: 1px solid #ccc; padding: 5px; }")
        html.append("</style></head><body>")
        html.append("<h1>Coverage Report</h1>")
        html.append("<table>")
        html.append("<tr><th>File</th><th>Stmts</th><th>Cover</th></tr>")
        
        for filename in sorted(self.data.keys()):
            line_data = self.data[filename]
            if len(line_data) > 0:
                max_line = max(line_data.keys())
                file_total = max_line
                file_covered = len(line_data)
                file_pct = (file_covered * 100.0) / file_total if file_total > 0 else 0
            else:
                file_total = 0
                file_pct = 0
            
            html.append(
                "<tr>" +
                "<td><a href='" + filename.replace("/", "_") + ".html'>" + filename + "</a></td>" +
                "<td>" + str(file_total) + "</td>" +
                "<td>" + str(round(file_pct, 1)) + "%</td>" +
                "</tr>"
            )
        
        html.append("</table></body></html>")
        
        # Write index
        f = open(directory + "/index.html", 'w')
        f.write("\n".join(html))
        f.close()
    
    def xml_report(self, outfile="coverage.xml"):
        """Generate Cobertura XML coverage report."""
        xml = ["<?xml version='1.0' ?>"]
        xml.append("<!DOCTYPE coverage SYSTEM 'http://cobertura.sourceforge.net/xml/coverage-04.dtd'>")
        xml.append("<coverage line-rate='1.0' branches-valid='0' branches-covered='0' complexity='0' version='0'>")
        xml.append("<sources><source>.</source></sources>")
        xml.append("<packages>")
        
        total_lines = 0
        total_covered = 0
        
        for filename in sorted(self.data.keys()):
            line_data = self.data[filename]
            
            if len(line_data) > 0:
                max_line = max(line_data.keys())
                file_total = max_line
                file_covered = len(line_data)
            else:
                file_total = 0
                file_covered = 0
            
            total_lines = total_lines + file_total
            total_covered = total_covered + file_covered
            
            xml.append("<package name=''>")
            xml.append("<classes>")
            xml.append("<class name='" + filename + "' filename='" + filename + "' line-rate='" + 
                      str(file_covered / file_total if file_total > 0 else 0) + "'>")
            xml.append("<lines>")
            
            for line_num in range(1, max_line + 1):
                hits = 1 if line_num in line_data else 0
                xml.append("<line number='" + str(line_num) + "' hits='" + str(hits) + "'/>")
            
            xml.append("</lines>")
            xml.append("</class>")
            xml.append("</classes>")
            xml.append("</package>")
        
        xml.append("</packages>")
        xml.append("</coverage>")
        
        # Write XML
        f = open(outfile, 'w')
        f.write("\n".join(xml))
        f.close()
    
    def analysis(self, filename):
        """Get detailed analysis for a file.
        
        Returns tuple: (num_statements, num_executed, num_missing, missing_lines)
        """
        line_data = self.data.get(filename, {})
        
        if len(line_data) > 0:
            max_line = max(line_data.keys())
            num_statements = max_line
            num_executed = len(line_data)
            num_missing = num_statements - num_executed
            
            missing_lines = []
            for i in range(1, num_statements + 1):
                if i not in line_data:
                    missing_lines.append(i)
        else:
            num_statements = 0
            num_executed = 0
            num_missing = 0
            missing_lines = []
        
        return (num_statements, num_executed, num_missing, missing_lines)

# ============================================
# Coverage Runner
# ============================================

class CoverageRunner:
    """Run code with coverage collection."""
    
    def __init__(self, cov=None):
        if cov is None:
            self.cov = Coverage()
        else:
            self.cov = cov
    
    def run(self, module_name):
        """Run a module with coverage."""
        import importlib
        
        self.cov.start()
        try:
            mod = importlib.import_module(module_name)
            return mod
        finally:
            self.cov.stop()
    
    def runctx(self, code, globals=None, locals=None):
        """Run code string with coverage."""
        if globals is None:
            globals = {}
        if locals is None:
            locals = {}
        
        self.cov.start()
        try:
            exec(code, globals, locals)
        finally:
            self.cov.stop()

# ============================================
# Convenience Functions
# ============================================

def coverage_start():
    """Start coverage collection."""
    global _global_coverage
    _global_coverage = Coverage()
    _global_coverage.start()

def coverage_stop():
    """Stop coverage collection."""
    global _global_coverage
    if '_global_coverage' in dir():
        _global_coverage.stop()

def coverage_save(data_file=".coverage"):
    """Save coverage data."""
    global _global_coverage
    if '_global_coverage' in dir():
        _global_coverage.data_file = data_file
        _global_coverage.save()

def coverage_report():
    """Print coverage report."""
    global _global_coverage
    if '_global_coverage' in dir():
        _global_coverage.report()

# Global coverage instance
_global_coverage = None
