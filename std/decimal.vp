# Decimal module - arbitrary precision decimal arithmetic
# Note: This is a pure Viper implementation. 
# For actual arbitrary precision, use GMP via FFI.

def create_decimal(value_str):
    return {"value": value_str, "scale": 0}

def decimal_from_int(value):
    return {"value": str(value), "scale": 0}

def decimal_from_float(value):
    s = str(value)
    if "." in s:
        scale = len(s.split(".")[1])
        return {"value": s.replace(".", ""), "scale": scale}
    return {"value": s, "scale": 0}

def decimal_add(a, b):
    # Simplified - just convert to float for now
    return float(a["value"]) / (10 ** a["scale"]) + float(b["value"]) / (10 ** b["scale"])

def decimal_sub(a, b):
    return float(a["value"]) / (10 ** a["scale"]) - float(b["value"]) / (10 ** b["scale"])

def decimal_mul(a, b):
    return (float(a["value"]) / (10 ** a["scale'])) * (float(b["value"]) / (10 ** b["scale"]))

def decimal_div(a, b):
    return (float(a["value"]) / (10 ** a["scale"])) / (float(b["value"]) / (10 ** b["scale"]))

def decimal_to_float(d):
    return float(d["value"]) / (10 ** d["scale"])

def decimal_to_string(d):
    value = d["value"]
    scale = d["scale"]
    if scale == 0:
        return value
    if len(value) <= scale:
        return "0." + ("0" * (scale - len(value))) + value
    return value[:len(value)-scale] + "." + value[len(value)-scale:]

def decimal_neg(a):
    return {"value": "-" + a["value"], "scale": a["scale"]}

def decimal_abs(a):
    return {"value": a["value"].lstrip("-"), "scale": a["scale"]}
