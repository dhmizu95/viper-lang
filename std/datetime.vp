# Viper Standard Library - datetime module
# Date and time manipulation

# Module metadata
__name__ = "datetime"
__version__ = "0.4.7"

# ============================================
# Constants
# ============================================

MINYEAR = 1
MAXYEAR = 9999

# Days in months (non-leap year)
_DAYS_IN_MONTH = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

# ============================================
# Helper Functions
# ============================================

def _is_leap_year(year) -> bool:
    """Check if year is a leap year."""
    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)

def _days_in_month(year, month) -> int:
    """Get number of days in month."""
    if month == 2 and _is_leap_year(year):
        return 29
    return _DAYS_IN_MONTH[month]

def _days_in_year(year) -> int:
    """Get number of days in year."""
    if _is_leap_year(year):
        return 366
    return 365

def _day_of_week(year, month, day) -> int:
    """Calculate day of week (0=Monday, 6=Sunday) using Zeller's formula."""
    # Adjust for January and February
    if month < 3:
        month = month + 12
        year = year - 1
    
    q = day
    m = month
    k = year % 100
    j = year // 100
    
    h = (q + (13 * (m + 1)) // 25 + k + k // 4 + j // 4 - 2 * j) % 7
    
    # Convert from Zeller (0=Saturday) to ISO (0=Monday)
    return (h + 5) % 7

# ============================================
# date Class
# ============================================

class date:
    """Date object (year, month, day)."""
    
    def __init__(self, year, month, day):
        if year < MINYEAR or year > MAXYEAR:
            raise ValueError("year must be in " + str(MINYEAR) + ".." + str(MAXYEAR))
        if month < 1 or month > 12:
            raise ValueError("month must be in 1..12")
        if day < 1 or day > _days_in_month(year, month):
            raise ValueError("invalid day for month")
        
        self.year = year
        self.month = month
        self.day = day
    
    def __repr__(self) -> str:
        return "date(" + str(self.year) + ", " + str(self.month) + ", " + str(self.day) + ")"
    
    def __str__(self) -> str:
        return self.isoformat()
    
    def __eq__(self, other) -> bool:
        if not isinstance(other, date):
            return False
        return (self.year == other.year and 
                self.month == other.month and 
                self.day == other.day)
    
    def __lt__(self, other) -> bool:
        if not isinstance(other, date):
            raise TypeError("comparison with non-date")
        if self.year != other.year:
            return self.year < other.year
        if self.month != other.month:
            return self.month < other.month
        return self.day < other.day
    
    def __le__(self, other) -> bool:
        return self == other or self < other
    
    def __gt__(self, other) -> bool:
        return not self <= other
    
    def __ge__(self, other) -> bool:
        return not self < other
    
    def __hash__(self) -> int:
        return hash((self.year, self.month, self.day))
    
    def isoformat(self) -> str:
        """Return ISO 8601 format: YYYY-MM-DD"""
        return (str(self.year).zfill(4) + "-" + 
                str(self.month).zfill(2) + "-" + 
                str(self.day).zfill(2))
    
    def weekday(self) -> int:
        """Return day of week (0=Monday, 6=Sunday)."""
        return _day_of_week(self.year, self.month, self.day)
    
    def isoweekday(self) -> int:
        """Return ISO day of week (1=Monday, 7=Sunday)."""
        return self.weekday() + 1
    
    def timetuple(self):
        """Return time tuple-like object."""
        return _TimeTuple(self.year, self.month, self.day, 0, 0, 0, 
                         self.weekday(), self._ordinal(), 0)
    
    def _ordinal(self) -> int:
        """Convert to ordinal (days since year 1)."""
        # Days from complete years
        y = self.year - 1
        days = y * 365 + y // 4 - y // 100 + y // 400
        
        # Days from complete months
        for m in range(1, self.month):
            days = days + _days_in_month(self.year, m)
        
        # Days in current month
        days = days + self.day
        
        return days
    
    @classmethod
    def today(cls):
        """Return current local date."""
        # Implemented in runtime
        pass
    
    @classmethod
    def fromordinal(cls, n):
        """Create date from ordinal."""
        # Simplified implementation
        year = 1
        remaining = n
        
        while remaining > _days_in_year(year):
            remaining = remaining - _days_in_year(year)
            year = year + 1
        
        month = 1
        while remaining > _days_in_month(year, month):
            remaining = remaining - _days_in_month(year, month)
            month = month + 1
        
        day = remaining
        return cls(year, month, day)
    
    @classmethod
    def fromisoformat(cls, date_string):
        """Parse ISO format date string."""
        # Parse YYYY-MM-DD
        parts = date_string.split('-')
        if len(parts) != 3:
            raise ValueError("invalid ISO format")
        
        year = int(parts[0])
        month = int(parts[1])
        day = int(parts[2])
        
        return cls(year, month, day)
    
    def replace(self, year=None, month=None, day=None):
        """Return new date with replaced fields."""
        return date(
            year if year is not None else self.year,
            month if month is not None else self.month,
            day if day is not None else self.day
        )
    
    def __add__(self, other):
        """Add timedelta to date."""
        if isinstance(other, timedelta):
            return date.fromordinal(self._ordinal() + other.days)
        raise TypeError("can only add timedelta to date")
    
    def __sub__(self, other):
        """Subtract date or timedelta."""
        if isinstance(other, date):
            return timedelta(self._ordinal() - other._ordinal())
        if isinstance(other, timedelta):
            return date.fromordinal(self._ordinal() - other.days)
        raise TypeError("can only subtract date or timedelta")

# ============================================
# time Class
# ============================================

class time:
    """Time object (hour, minute, second, microsecond)."""
    
    def __init__(self, hour=0, minute=0, second=0, microsecond=0):
        if hour < 0 or hour > 23:
            raise ValueError("hour must be in 0..23")
        if minute < 0 or minute > 59:
            raise ValueError("minute must be in 0..59")
        if second < 0 or second > 59:
            raise ValueError("second must be in 0..59")
        if microsecond < 0 or microsecond > 999999:
            raise ValueError("microsecond must be in 0..999999")
        
        self.hour = hour
        self.minute = minute
        self.second = second
        self.microsecond = microsecond
    
    def __repr__(self) -> str:
        return "time(" + str(self.hour) + ", " + str(self.minute) + ", " + str(self.second) + ")"
    
    def __str__(self) -> str:
        return self.isoformat()
    
    def __eq__(self, other) -> bool:
        if not isinstance(other, time):
            return False
        return (self.hour == other.hour and 
                self.minute == other.minute and 
                self.second == other.second and
                self.microsecond == other.microsecond)
    
    def __lt__(self, other) -> bool:
        if not isinstance(other, time):
            raise TypeError("comparison with non-time")
        if self.hour != other.hour:
            return self.hour < other.hour
        if self.minute != other.minute:
            return self.minute < other.minute
        if self.second != other.second:
            return self.second < other.second
        return self.microsecond < other.microsecond
    
    def __le__(self, other) -> bool:
        return self == other or self < other
    
    def __gt__(self, other) -> bool:
        return not self <= other
    
    def __ge__(self, other) -> bool:
        return not self < other
    
    def __hash__(self) -> int:
        return hash((self.hour, self.minute, self.second, self.microsecond))
    
    def isoformat(self) -> str:
        """Return ISO 8601 format: HH:MM:SS.ffffff"""
        result = str(self.hour).zfill(2) + ":" + str(self.minute).zfill(2) + ":" + str(self.second).zfill(2)
        if self.microsecond > 0:
            result = result + "." + str(self.microsecond).zfill(6)
        return result
    
    def replace(self, hour=None, minute=None, second=None, microsecond=None):
        """Return new time with replaced fields."""
        return time(
            hour if hour is not None else self.hour,
            minute if minute is not None else self.minute,
            second if second is not None else self.second,
            microsecond if microsecond is not None else self.microsecond
        )

# ============================================
# datetime Class
# ============================================

class datetime(date):
    """DateTime object (year, month, day, hour, minute, second, microsecond)."""
    
    def __init__(self, year, month, day, hour=0, minute=0, second=0, microsecond=0):
        date.__init__(self, year, month, day)
        self.hour = hour
        self.minute = minute
        self.second = second
        self.microsecond = microsecond
    
    def __repr__(self) -> str:
        return ("datetime(" + str(self.year) + ", " + str(self.month) + ", " + 
                str(self.day) + ", " + str(self.hour) + ", " + str(self.minute) + ", " + 
                str(self.second) + ", " + str(self.microsecond) + ")")
    
    def __str__(self) -> str:
        return self.isoformat()
    
    def __eq__(self, other) -> bool:
        if not isinstance(other, datetime):
            return False
        return (date.__eq__(self, other) and
                self.hour == other.hour and
                self.minute == other.minute and
                self.second == other.second and
                self.microsecond == other.microsecond)
    
    def __lt__(self, other) -> bool:
        if not isinstance(other, datetime):
            raise TypeError("comparison with non-datetime")
        if date.__lt__(self, other):
            return True
        if date.__eq__(self, other):
            if self.hour != other.hour:
                return self.hour < other.hour
            if self.minute != other.minute:
                return self.minute < other.minute
            if self.second != other.second:
                return self.second < other.second
            return self.microsecond < other.microsecond
        return False
    
    def __le__(self, other) -> bool:
        return self == other or self < other
    
    def __gt__(self, other) -> bool:
        return not self <= other
    
    def __ge__(self, other) -> bool:
        return not self < other
    
    def __hash__(self) -> int:
        return hash((self.year, self.month, self.day, 
                    self.hour, self.minute, self.second, self.microsecond))
    
    def isoformat(self) -> str:
        """Return ISO 8601 format: YYYY-MM-DDTHH:MM:SS.ffffff"""
        return date.isoformat(self) + "T" + time.isoformat(time(self.hour, self.minute, self.second, self.microsecond))
    
    def date(self) -> date:
        """Return date part."""
        return date(self.year, self.month, self.day)
    
    def time(self) -> time:
        """Return time part."""
        return time(self.hour, self.minute, self.second, self.microsecond)
    
    def timetuple(self):
        """Return time tuple-like object."""
        return _TimeTuple(self.year, self.month, self.day,
                         self.hour, self.minute, self.second,
                         self.weekday(), self._ordinal(), 0)
    
    def replace(self, year=None, month=None, day=None, 
                hour=None, minute=None, second=None, microsecond=None):
        """Return new datetime with replaced fields."""
        return datetime(
            year if year is not None else self.year,
            month if month is not None else self.month,
            day if day is not None else self.day,
            hour if hour is not None else self.hour,
            minute if minute is not None else self.minute,
            second if second is not None else self.second,
            microsecond if microsecond is not None else self.microsecond
        )
    
    @classmethod
    def now(cls):
        """Return current local datetime."""
        # Implemented in runtime
        pass
    
    @classmethod
    def utcnow(cls):
        """Return current UTC datetime."""
        # Implemented in runtime
        pass
    
    @classmethod
    def fromisoformat(cls, date_string):
        """Parse ISO format datetime string."""
        # Split date and time
        if 'T' in date_string:
            date_part, time_part = date_string.split('T')
        else:
            date_part = date_string
            time_part = "00:00:00"
        
        d = date.fromisoformat(date_part)
        
        # Parse time
        time_parts = time_part.split(':')
        hour = int(time_parts[0]) if len(time_parts) > 0 else 0
        minute = int(time_parts[1]) if len(time_parts) > 1 else 0
        
        second = 0
        microsecond = 0
        if len(time_parts) > 2:
            sec_parts = time_parts[2].split('.')
            second = int(sec_parts[0])
            if len(sec_parts) > 1:
                microsecond = int(sec_parts[1])
        
        return cls(d.year, d.month, d.day, hour, minute, second, microsecond)

# ============================================
# timedelta Class
# ============================================

class timedelta:
    """Duration between two dates/times."""
    
    def __init__(self, days=0, seconds=0, microseconds=0, 
                 milliseconds=0, minutes=0, hours=0, weeks=0):
        # Normalize to days, seconds, microseconds
        total_microseconds = microseconds + milliseconds * 1000
        total_seconds = seconds + total_microseconds / 1000000
        total_seconds = total_seconds + minutes * 60 + hours * 3600
        total_days = days + weeks * 7
        
        self.days = total_days
        self.seconds = int(total_seconds % 86400)
        self.microseconds = int((total_seconds * 1000000) % 1000000)
    
    def __repr__(self) -> str:
        return "timedelta(" + str(self.days) + ", " + str(self.seconds) + ", " + str(self.microseconds) + ")"
    
    def __str__(self) -> str:
        total_seconds = self.days * 86400 + self.seconds
        days_part = ""
        if self.days != 0:
            days_part = str(self.days) + " days, "
        return days_part + str(total_seconds) + " seconds"
    
    def __eq__(self, other) -> bool:
        if not isinstance(other, timedelta):
            return False
        return (self.days == other.days and 
                self.seconds == other.seconds and 
                self.microseconds == other.microseconds)
    
    def __lt__(self, other) -> bool:
        if not isinstance(other, timedelta):
            raise TypeError("comparison with non-timedelta")
        return self.total_seconds() < other.total_seconds()
    
    def __le__(self, other) -> bool:
        return self == other or self < other
    
    def __gt__(self, other) -> bool:
        return not self <= other
    
    def __ge__(self, other) -> bool:
        return not self < other
    
    def __add__(self, other):
        """Add timedelta to another timedelta or date/datetime."""
        if isinstance(other, timedelta):
            return timedelta(
                days=self.days + other.days,
                seconds=self.seconds + other.seconds,
                microseconds=self.microseconds + other.microseconds
            )
        return other.__add__(self)
    
    def __sub__(self, other):
        """Subtract timedelta."""
        if isinstance(other, timedelta):
            return timedelta(
                days=self.days - other.days,
                seconds=self.seconds - other.seconds,
                microseconds=self.microseconds - other.microseconds
            )
        raise TypeError("can only subtract timedelta from timedelta")
    
    def __mul__(self, other):
        """Multiply by number."""
        if isinstance(other, int):
            return timedelta(
                days=self.days * other,
                seconds=self.seconds * other,
                microseconds=self.microseconds * other
            )
        raise TypeError("can only multiply timedelta by int")
    
    def __truediv__(self, other):
        """Divide by number or timedelta."""
        if isinstance(other, int):
            return timedelta(
                days=self.days // other,
                seconds=self.seconds // other,
                microseconds=self.microseconds // other
            )
        if isinstance(other, timedelta):
            return self.total_seconds() / other.total_seconds()
        raise TypeError("can only divide timedelta by int or timedelta")
    
    def total_seconds(self) -> float:
        """Return total duration in seconds."""
        return self.days * 86400 + self.seconds + self.microseconds / 1000000

# ============================================
# Helper Classes
# ============================================

class _TimeTuple:
    """Simple time tuple-like object."""
    
    def __init__(self, year, month, day, hour, minute, second, weekday, yearday, dst):
        self.tm_year = year
        self.tm_mon = month
        self.tm_mday = day
        self.tm_hour = hour
        self.tm_min = minute
        self.tm_sec = second
        self.tm_wday = weekday
        self.tm_yday = yearday
        self.tm_isdst = dst

