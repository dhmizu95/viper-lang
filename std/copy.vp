# Viper Standard Library - copy module
# Shallow and deep copy operations

# Module metadata
__name__ = "copy"
__version__ = "0.4.7"

# ============================================
# Exceptions
# ============================================

class Error(Exception):
    """Base class for copy module exceptions."""
    pass

class CopyError(Error):
    """Exception raised when copy operation fails."""
    pass

# ============================================
# Copy Functions
# ============================================

def copy(x):
    """Create a shallow copy of x.
    
    For mutable containers (list, dict, set), creates a new container
    but the elements are references to the same objects.
    
    For immutable objects (int, str, tuple), returns the same object.
    """
    # Implemented in runtime
    return x

def deepcopy(x, memo=None):
    """Create a deep copy of x.
    
    Recursively copies all nested objects.
    Uses memo dictionary to handle circular references.
    """
    # Implemented in runtime
    if memo is None:
        memo = {}
    return x

# ============================================
# Copy Dispatch
# ============================================

class CopyDispatch:
    """Dispatch table for copy operations."""
    
    def __init__(self):
        self.copy_dispatch = {}
        self.deepcopy_dispatch = {}
    
    def register(self, cls, copy_func=None, deepcopy_func=None):
        """Register copy/deepcopy functions for a class."""
        if copy_func is not None:
            self.copy_dispatch[cls] = copy_func
        if deepcopy_func is not None:
            self.deepcopy_dispatch[cls] = deepcopy_func

# Global dispatch table
_dispatch_table = CopyDispatch()

# ============================================
# Helper Functions
# ============================================

def _copy_immutable(x):
    """Return the same object for immutable types."""
    return x

def _copy_list(x):
    """Create shallow copy of list."""
    result = []
    for item in x:
        result.append(item)
    return result

def _copy_dict(x):
    """Create shallow copy of dict."""
    result = {}
    for key in x:
        result[key] = x[key]
    return result

def _copy_set(x):
    """Create shallow copy of set."""
    result = set()
    for item in x:
        result.add(item)
    return result

def _deepcopy_atomic(x, memo):
    """Deep copy for atomic (immutable) types."""
    return x

def _deepcopy_list(x, memo):
    """Deep copy for list."""
    result = []
    for item in x:
        result.append(deepcopy(item, memo))
    return result

def _deepcopy_dict(x, memo):
    """Deep copy for dict."""
    result = {}
    for key in x:
        new_key = deepcopy(key, memo)
        new_value = deepcopy(x[key], memo)
        result[new_key] = new_value
    return result

def _deepcopy_set(x, memo):
    """Deep copy for set."""
    result = set()
    for item in x:
        result.add(deepcopy(item, memo))
    return result

def _deepcopy_tuple(x, memo):
    """Deep copy for tuple."""
    items = []
    for item in x:
        items.append(deepcopy(item, memo))
    return tuple(items)

# ============================================
# Special Markers
# ============================================

class _EmptyClass:
    """Marker class for missing attributes."""
    pass

missing = _EmptyClass()

def _keep_alive(x, memo):
    """Keep x alive during deepcopy by storing in memo."""
    if memo is not None:
        memo[id(x)] = x
