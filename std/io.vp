# Viper Standard Library - io module
# Core tools for working with streams

# Module metadata
__name__ = "io"
__version__ = "0.4.7"

# ============================================
# Base Classes
# ============================================

class IOBase:
    """Base class for all I/O classes."""
    
    def __init__(self):
        self._closed = False
    
    def close(self):
        """Flush and close the stream."""
        self._closed = True
    
    def is_closed(self) -> bool:
        """Check if stream is closed."""
        return self._closed
    
    def readable(self) -> bool:
        """Return True if stream can be read."""
        return False
    
    def writable(self) -> bool:
        """Return True if stream can be written."""
        return False
    
    def seekable(self) -> bool:
        """Return True if stream supports random access."""
        return False

class RawIOBase(IOBase):
    """Base class for raw (unbuffered) I/O."""
    pass

class BufferedIOBase(IOBase):
    """Base class for buffered I/O."""
    pass

class TextIOBase(BufferedIOBase):
    """Base class for text I/O."""
    
    def read(self, size: int = -1) -> str:
        """Read up to size characters."""
        pass
    
    def write(self, s: str) -> int:
        """Write string to stream."""
        pass

# ============================================
# Implementations
# ============================================

class StringIO(TextIOBase):
    """Text I/O using an in-memory text buffer.
    
    Similar to a file object but operates on strings in memory.
    """
    
    def __init__(self, initial_value: str = "", newline: str = "\n"):
        self._buffer = initial_value
        self._position = 0
        self._newline = newline
        self._closed = False
    
    def read(self, size: int = -1) -> str:
        """Read up to size characters from current position."""
        if self._closed:
            raise ValueError("I/O operation on closed stream")
        
        if size < 0 or size is None:
            result = self._buffer[self._position:]
            self._position = len(self._buffer)
        else:
            result = self._buffer[self._position:self._position + size]
            self._position = self._position + len(result)
        
        return result
    
    def write(self, s: str) -> int:
        """Write string at current position."""
        if self._closed:
            raise ValueError("I/O operation on closed stream")
        
        # Insert at current position
        before = self._buffer[:self._position]
        after = self._buffer[self._position:]
        self._buffer = before + s + after
        self._position = self._position + len(s)
        
        return len(s)
    
    def seek(self, pos: int, whence: int = 0) -> int:
        """Change stream position.
        
        whence: 0=start, 1=current, 2=end
        """
        if self._closed:
            raise ValueError("I/O operation on closed stream")
        
        if whence == 0:
            self._position = pos
        elif whence == 1:
            self._position = self._position + pos
        elif whence == 2:
            self._position = len(self._buffer) + pos
        
        return self._position
    
    def tell(self) -> int:
        """Return current position."""
        return self._position
    
    def getvalue(self) -> str:
        """Return entire buffer contents."""
        return self._buffer
    
    def truncate(self, size: int = None) -> int:
        """Resize stream to given size."""
        if size is None:
            size = self._position
        self._buffer = self._buffer[:size]
        return size
    
    def readable(self) -> bool:
        return True
    
    def writable(self) -> bool:
        return True
    
    def seekable(self) -> bool:
        return True

class BytesIO(BufferedIOBase):
    """Binary I/O using an in-memory bytes buffer.
    
    Similar to StringIO but for bytes.
    """
    
    def __init__(self, initial_bytes: bytes = None):
        if initial_bytes is None:
            self._buffer = []
        else:
            self._buffer = list(initial_bytes)
        self._position = 0
        self._closed = False
    
    def read(self, size: int = -1) -> bytes:
        """Read up to size bytes from current position."""
        if self._closed:
            raise ValueError("I/O operation on closed stream")
        
        if size < 0:
            result = self._buffer[self._position:]
            self._position = len(self._buffer)
        else:
            result = self._buffer[self._position:self._position + size]
            self._position = self._position + len(result)
        
        return bytes(result)
    
    def write(self, b: bytes) -> int:
        """Write bytes at current position."""
        if self._closed:
            raise ValueError("I/O operation on closed stream")
        
        byte_list = list(b)
        
        # Insert at current position
        before = self._buffer[:self._position]
        after = self._buffer[self._position:]
        self._buffer = before + byte_list + after
        self._position = self._position + len(byte_list)
        
        return len(byte_list)
    
    def seek(self, pos: int, whence: int = 0) -> int:
        """Change stream position."""
        if self._closed:
            raise ValueError("I/O operation on closed stream")
        
        if whence == 0:
            self._position = pos
        elif whence == 1:
            self._position = self._position + pos
        elif whence == 2:
            self._position = len(self._buffer) + pos
        
        return self._position
    
    def tell(self) -> int:
        """Return current position."""
        return self._position
    
    def getvalue(self) -> bytes:
        """Return entire buffer contents."""
        return bytes(self._buffer)
    
    def readable(self) -> bool:
        return True
    
    def writable(self) -> bool:
        return True
    
    def seekable(self) -> bool:
        return True

# ============================================
# File Opening
# ============================================

def open(file, mode: str = "r", buffering: int = -1, 
         encoding: str = None, errors: str = None, 
         newline: str = None, closefd: bool = True):
    """Open file and return file object.
    
    mode: 'r' (read), 'w' (write), 'a' (append), 'b' (binary), 't' (text)
    """
    # For now, delegate to built-in open
    # Full implementation would handle all modes and options
    return __builtin_open(file, mode)

# ============================================
# Constants
# ============================================

SEEK_SET = 0  # Start of stream
SEEK_CUR = 1  # Current position
SEEK_END = 2  # End of stream
