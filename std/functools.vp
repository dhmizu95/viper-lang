# Viper Standard Library - functools module
# Higher-order functions and operations on callable objects

# Module metadata
__name__ = "functools"
__version__ = "0.4.7"

# ============================================
# partial
# ============================================

class partial:
    """Create a new function with partial application of arguments."""
    
    def __init__(self, func, *args, **kwargs):
        self.func = func
        self.args = args
        self.kwargs = kwargs
    
    def __call__(self, *args, **kwargs):
        """Call the function with stored and new arguments."""
        # Combine stored args with new args
        new_args = self.args + args
        # Combine stored kwargs with new kwargs (new kwargs take precedence)
        new_kwargs = {}
        for key in self.kwargs:
            new_kwargs[key] = self.kwargs[key]
        for key in kwargs:
            new_kwargs[key] = kwargs[key]
        # Call original function
        return self.func(*new_args, **new_kwargs)

# ============================================
# reduce
# ============================================

def reduce(function, sequence, initial=None):
    """Apply function of two arguments cumulatively to items of sequence.
    
    reduce(f, [x1, x2, x3, x4]) = f(f(f(x1, x2), x3), x4)
    
    If initial is provided, it's prepended to the sequence.
    """
    # Implemented in runtime
    return None

# ============================================
# lru_cache
# ============================================

class lru_cache:
    """Least Recently Used cache decorator.
    
    @lru_cache(maxsize=128)
    def expensive_function(arg):
        ...
    """
    
    def __init__(self, maxsize: int = 128):
        self.maxsize = maxsize
        self.cache = {}
        self.order = []
    
    def __call__(self, func):
        """Decorate a function with LRU caching."""
        def wrapper(*args, **kwargs):
            # Create cache key from args and kwargs
            key = str(args) + str(sorted(kwargs.items()))
            
            # Check cache
            if key in self.cache:
                # Move to end (most recently used)
                self.order.remove(key)
                self.order.append(key)
                return self.cache[key]
            
            # Call function and cache result
            result = func(*args, **kwargs)
            self.cache[key] = result
            self.order.append(key)
            
            # Evict oldest if over maxsize
            if len(self.order) > self.maxsize:
                oldest = self.order.pop(0)
                del self.cache[oldest]
            
            return result
        
        # Copy function metadata
        wrapper.__name__ = func.__name__
        wrapper.__doc__ = func.__doc__
        
        # Add cache info method
        def cache_info():
            return {"hits": 0, "misses": len(self.cache), "maxsize": self.maxsize, "currsize": len(self.cache)}
        wrapper.cache_info = cache_info
        
        # Add cache clear method
        def cache_clear():
            self.cache.clear()
            self.order.clear()
        wrapper.cache_clear = cache_clear
        
        return wrapper

# Convenience decorator with default maxsize
def cache(func):
    """Simple caching decorator (unbounded cache)."""
    return lru_cache(maxsize=None)(func)

# ============================================
# wraps
# ============================================

def wraps(wrapper_func):
    """Decorator factory to copy function metadata.
    
    @wraps(original_func)
    def wrapper(*args, **kwargs):
        ...
    """
    def decorator(func):
        # Copy metadata from wrapper to func
        func.__name__ = wrapper_func.__name__
        func.__doc__ = wrapper_func.__doc__
        func.__module__ = wrapper_func.__module__
        func.__qualname__ = wrapper_func.__qualname__
        func.__annotations__ = wrapper_func.__annotations__
        func.__dict__.update(wrapper_func.__dict__)
        return func
    return decorator

# ============================================
# singledispatch
# ============================================

class singledispatch:
    """Single-dispatch generic function decorator.
    
    @singledispatch
    def process(arg):
        # Default implementation
        ...
    
    @process.register(int)
    def _(arg):
        # int-specific implementation
        ...
    """
    
    def __init__(self, default_func):
        self.default_func = default_func
        self.registry = {}
        self.__doc__ = default_func.__doc__
        self.__name__ = default_func.__name__
        self.__annotations__ = default_func.__annotations__
    
    def __call__(self, arg, *args, **kwargs):
        # Get type of first argument
        arg_type = type(arg)
        
        # Look up registered implementation
        if arg_type in self.registry:
            return self.registry[arg_type](arg, *args, **kwargs)
        
        # Use default implementation
        return self.default_func(arg, *args, **kwargs)
    
    def register(self, type_):
        """Register a type-specific implementation."""
        def decorator(func):
            self.registry[type_] = func
            return func
        return decorator

# ============================================
# total_ordering
# ============================================

def total_ordering(cls):
    """Class decorator to fill in missing comparison methods.
    
    If class defines __eq__ and one of __lt__, __le__, __gt__, __ge__,
    this decorator fills in the rest.
    """
    # Check what methods are defined
    has_eq = hasattr(cls, '__eq__')
    has_lt = hasattr(cls, '__lt__')
    has_le = hasattr(cls, '__le__')
    has_gt = hasattr(cls, '__gt__')
    has_ge = hasattr(cls, '__ge__')
    
    if not has_eq:
        raise ValueError('must define an __eq__ method')
    
    # Generate missing methods
    if has_lt and not has_le:
        cls.__le__ = lambda self, other: self < other or self == other
    
    if has_lt and not has_gt:
        cls.__gt__ = lambda self, other: not (self < other or self == other)
    
    if has_lt and not has_ge:
        cls.__ge__ = lambda self, other: not (self < other)
    
    if has_le and not has_lt:
        cls.__lt__ = lambda self, other: self <= other and not (self == other)
    
    if has_le and not has_gt:
        cls.__gt__ = lambda self, other: not (self <= other)
    
    if has_le and not has_ge:
        cls.__ge__ = lambda self, other: not (self < other)
    
    if has_gt and not has_lt:
        cls.__lt__ = lambda self, other: not (self > other or self == other)
    
    if has_gt and not has_le:
        cls.__le__ = lambda self, other: not (self > other)
    
    if has_gt and not has_ge:
        cls.__ge__ = lambda self, other: not (self < other)
    
    if has_ge and not has_lt:
        cls.__lt__ = lambda self, other: not (self >= other)
    
    if has_ge and not has_le:
        cls.__le__ = lambda self, other: not (self > other)
    
    if has_ge and not has_gt:
        cls.__gt__ = lambda self, other: not (self >= other)
    
    return cls

# ============================================
# cmp_to_key
# ============================================

class KeyWrapper:
    """Wrapper class for cmp_to_key."""
    def __init__(self, obj, cmp_func):
        self.obj = obj
        self.cmp_func = cmp_func
    
    def __lt__(self, other):
        return self.cmp_func(self.obj, other.obj) < 0
    
    def __gt__(self, other):
        return self.cmp_func(self.obj, other.obj) > 0
    
    def __eq__(self, other):
        return self.cmp_func(self.obj, other.obj) == 0
    
    def __le__(self, other):
        return self.cmp_func(self.obj, other.obj) <= 0
    
    def __ge__(self, other):
        return self.cmp_func(self.obj, other.obj) >= 0
    
    def __ne__(self, other):
        return self.cmp_func(self.obj, other.obj) != 0

def cmp_to_key(cmp_func):
    """Convert a comparison function to a key function.
    
    Useful for converting old-style comparison functions to key functions
    for sorted(), min(), max(), etc.
    """
    def key_func(obj):
        return KeyWrapper(obj, cmp_func)
    return key_func
