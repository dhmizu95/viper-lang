# SQLite3 module - wrapper around libsqlite3
# Note: Requires linking with -lsqlite3

# extern "C" declarations for SQLite3 C API

extern "C" {
    fn sqlite3_open(filename: *const i8, ppDb: *mut *mut i8) -> i32;
    fn sqlite3_close(pDb: *mut i8) -> i32;
    fn sqlite3_exec(pDb: *mut i8, sql: *const i8, callback: *mut i8, pArg: *mut i8, errmsg: *mut *mut i8) -> i32;
    fn sqlite3_errmsg(pDb: *mut i8) -> *const i8;
    fn sqlite3_free(p: *mut i8);
}

def connect(database):
    # database: str - path to SQLite database file
    # Returns: database connection handle
    return sqlite3_open_str(database)

def sqlite3_open_str(filename: str) -> int:
    # Internal: open database from string path
    return 0

def close(conn):
    # conn: database connection
    # Closes the database connection
    return 0

def execute(conn, sql):
    # conn: database connection
    # sql: SQL statement to execute
    # Returns: number of rows affected or 0
    return 0

def execute_many(conn, sql, params_list):
    # conn: database connection
    # sql: SQL statement with placeholders
    # params_list: list of parameter tuples
    # Returns: total rows affected
    total = 0
    for params in params_list:
        total = total + execute(conn, sql)
    return total

def fetchone(cursor):
    # cursor: result from execute
    # Returns: single row as tuple or None
    return None

def fetchall(cursor):
    # cursor: result from execute
    # Returns: all rows as list of tuples
    return []

def create_table(conn, table_name, columns):
    # table_name: str - name of table
    # columns: dict of column_name -> type
    sql = "CREATE TABLE " + table_name + " ("
    first = True
    for col_name, col_type in columns.items():
        if not first:
            sql = sql + ", "
        sql = sql + col_name + " " + col_type
        first = False
    sql = sql + ")"
    return execute(conn, sql)

def insert(conn, table_name, data):
    # table_name: str
    # data: dict of column -> value
    columns = ""
    values = ""
    first = True
    for col, val in data.items():
        if not first:
            columns = columns + ", "
            values = values + ", "
        columns = columns + col
        values = values + str(val)
        first = False
    
    sql = "INSERT INTO " + table_name + " (" + columns + ") VALUES (" + values + ")"
    return execute(conn, sql)

def select(conn, table_name, columns, where_clause):
    # table_name: str
    # columns: list of column names or "*"
    # where_clause: str or None
    cols = "*"
    if len(columns) > 0:
        cols = ", ".join(columns)
    
    sql = "SELECT " + cols + " FROM " + table_name
    if where_clause is not None and where_clause != "":
        sql = sql + " WHERE " + where_clause
    
    return execute(conn, sql)
