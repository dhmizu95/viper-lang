# Viper Standard Library - pdb module
# Python Debugger

# Module metadata
__name__ = "pdb"
__version__ = "0.4.7"

# ============================================
# Debugger Class
# ============================================

class Pdb:
    """Interactive debugger.
    
    Provides breakpoint debugging capabilities similar to Python's pdb.
    
    Usage:
        import pdb
        pdb.set_trace()  # Set breakpoint
        
    Commands:
        n(ext) - Execute next line
        s(tep) - Step into function calls
        c(ontinue) - Continue execution until next breakpoint
        b(reak) - Set breakpoint
        w(here) - Print stack trace
        l(ist) - List source code
        p(rint) - Print expression
        q(uit) - Quit debugger
        h(elp) - Show help
    """
    
    def __init__(self, stdin=None, stdout=None, skip=None):
        self.stdin = stdin
        self.stdout = stdout
        self.skip = skip
        
        self.prompt = "(Pdb) "
        self._current_frame = None
        self._breakpoints = []
        self._stepping = False
        self._returning = False
    
    def set_trace(self, frame=None):
        """Start debugging at current frame."""
        import sys
        if frame is None:
            frame = sys._getframe(1)
        
        self._current_frame = frame
        self.cmdloop()
    
    def cmdloop(self):
        """Read-eval-print loop for debugger commands."""
        while True:
            try:
                # Get input
                if self.stdin is not None:
                    line = self.stdin.readline()
                else:
                    line = input(self.prompt)
                
                if len(line) == 0 or line == "\n":
                    # Repeat last command (not implemented)
                    continue
                
                line = line.strip()
                
                if not self.onecmd(line):
                    break
            except EOFError:
                break
            except KeyboardInterrupt:
                print("\nInterrupted")
    
    def onecmd(self, line):
        """Execute single command. Returns True to exit."""
        parts = line.split(None, 1)
        if len(parts) == 0:
            return False
        
        cmd = parts[0].lower()
        args = parts[1] if len(parts) > 1 else ""
        
        if cmd in ('q', 'quit', 'exit'):
            return self.do_quit(args)
        elif cmd in ('n', 'next'):
            return self.do_next(args)
        elif cmd in ('s', 'step'):
            return self.do_step(args)
        elif cmd in ('c', 'continue', 'cont'):
            return self.do_continue(args)
        elif cmd in ('b', 'break'):
            return self.do_break(args)
        elif cmd in ('p', 'print'):
            return self.do_print(args)
        elif cmd in ('l', 'list'):
            return self.do_list(args)
        elif cmd in ('w', 'where'):
            return self.do_where(args)
        elif cmd in ('h', 'help', '?'):
            return self.do_help(args)
        elif cmd == 'r', 'return':
            return self.do_return(args)
        elif len(cmd) == 0:
            return False
        else:
            # Try to evaluate as expression
            return self.do_default(line)
    
    def do_quit(self, args):
        """Quit the debugger."""
        print("Quitting debugger")
        return True
    
    def do_next(self, args):
        """Execute next line, stepping over function calls."""
        self._stepping = True
        self._returning = False
        return False
    
    def do_step(self, args):
        """Step into function calls."""
        self._stepping = True
        self._returning = False
        return False
    
    def do_continue(self, args):
        """Continue execution until next breakpoint."""
        self._stepping = False
        self._returning = False
        return True  # Exit debugger loop
    
    def do_break(self, args):
        """Set breakpoint at line number or function."""
        if len(args) == 0:
            # List all breakpoints
            if len(self._breakpoints) == 0:
                print("No breakpoints set")
            else:
                for i, bp in enumerate(self._breakpoints):
                    print(str(i) + ": " + bp)
            return False
        
        # Parse breakpoint location
        # Format: [filename:]lineno or function
        self._breakpoints.append(args)
        print("Breakpoint set at " + args)
        return False
    
    def do_print(self, args):
        """Print variable value."""
        if len(args) == 0:
            print("Usage: print <expression>")
            return False
        
        # Evaluate expression in current frame context
        try:
            if self._current_frame is not None:
                # Get locals and globals from frame
                result = eval(args, self._current_frame.f_globals, self._current_frame.f_locals)
                print(repr(result))
            else:
                # No frame available, try global eval
                result = eval(args)
                print(repr(result))
        except Exception as e:
            print("Error: " + str(e))
        
        return False
    
    def do_list(self, args):
        """List source code around current line."""
        if self._current_frame is None:
            print("No current frame")
            return False
        
        filename = self._current_frame.f_code.co_filename
        lineno = self._current_frame.f_lineno
        
        # Read source file
        try:
            f = open(filename, 'r')
            lines = f.readlines()
            f.close()
            
            # Show context around current line
            start = max(0, lineno - 5)
            end = min(len(lines), lineno + 5)
            
            for i in range(start, end):
                marker = "->" if i == lineno - 1 else "  "
                print(marker + " " + str(i + 1) + ": " + lines[i].rstrip())
        except IOError:
            print("Could not read source file: " + filename)
        
        return False
    
    def do_where(self, args):
        """Print stack trace."""
        frame = self._current_frame
        if frame is None:
            print("No current frame")
            return False
        
        level = 0
        while frame is not None:
            filename = frame.f_code.co_filename
            lineno = frame.f_lineno
            funcname = frame.f_code.co_name
            
            # Shorten filename
            if "/" in filename:
                filename = filename.split("/")[-1]
            
            print("  " + str(level) + ": " + filename + ":" + str(lineno) + " in " + funcname)
            
            frame = frame.f_back
            level = level + 1
        
        return False
    
    def do_help(self, args):
        """Show help for commands."""
        if len(args) == 0:
            print("Debugger commands:")
            print("  n(ext)     - Execute next line (step over)")
            print("  s(tep)     - Step into function calls")
            print("  c(ontinue) - Continue until next breakpoint")
            print("  b(reak)    - Set breakpoint")
            print("  p(rint)    - Print expression")
            print("  l(ist)     - List source code")
            print("  w(here)    - Print stack trace")
            print("  q(uit)     - Quit debugger")
            print("  h(elp)     - Show this help")
            print("")
            print("Type 'help <command>' for more information")
        else:
            # Show help for specific command
            print("Help for: " + args)
        
        return False
    
    def do_return(self, args):
        """Continue execution until current function returns."""
        self._returning = True
        self._stepping = False
        return False
    
    def do_default(self, line):
        """Handle unrecognized command as expression."""
        try:
            if self._current_frame is not None:
                result = eval(line, self._current_frame.f_globals, self._current_frame.f_locals)
                if result is not None:
                    print(repr(result))
            else:
                result = eval(line)
                if result is not None:
                    print(repr(result))
        except Exception as e:
            print("Error: " + str(e))
        
        return False

# ============================================
# Convenience Functions
# ============================================

def set_trace():
    """Set breakpoint and start debugging."""
    pdb = Pdb()
    pdb.set_trace()

def breakpoint():
    """Built-in breakpoint() calls this."""
    set_trace()

def run(statement, globals=None, locals=None):
    """Run statement under debugger control."""
    if globals is None:
        globals = {}
    if locals is None:
        locals = globals
    
    pdb = Pdb()
    
    # Compile statement
    code = compile(statement, "<debug>", "exec")
    
    # Execute with debugger
    pdb.runctx(code, globals, locals)

def runcall(func, *args, **kwargs):
    """Run function call under debugger control."""
    pdb = Pdb()
    return pdb.runcall(func, *args, **kwargs)

def pm():
    """Start debugger at post-mortem (after exception)."""
    import sys
    
    # Get exception info
    exc_type, exc_value, exc_tb = sys.exc_info()
    
    if exc_tb is None:
        print("No exception to debug")
        return
    
    # Find deepest frame
    tb = exc_tb
    while tb.tb_next is not None:
        tb = tb.tb_next
    
    # Start debugger at that frame
    pdb = Pdb()
    pdb._current_frame = tb.tb_frame
    pdb.cmdloop()

def runctx(statement, globals=None, locals=None):
    """Run statement with given globals/locals under debugger."""
    run(statement, globals, locals)

# ============================================
# Global Debugger Instance
# ============================================

# Create global debugger instance
_run = None

def _get_debugger():
    """Get or create global debugger instance."""
    global _run
    if _run is None:
        _run = Pdb()
    return _run
