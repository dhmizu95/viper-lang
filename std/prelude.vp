# Length of a collection
def len(obj) -> int:
    # Implemented as builtin
    return 0

# Type inspection
def typeof(obj) -> str:
    # Implemented as builtin
    return ""

# Assert statement helper
def assert(condition: bool, message: str = ""):
    if not condition:
        raise AssertionError(message)

# Identity function
def identity(x) -> x:
    return x

# Min/Max
def min(a: int, b: int) -> int:
    if a < b:
        return a
    return b

def max(a: int, b: int) -> int:
    if a > b:
        return a
    return b

# Absolute value for int
def abs(x: int) -> int:
    if x < 0:
        return -x
    return x

# Sum of a list
def sum(items: [int]) -> int:
    total = 0
    for item in items:
        total = total + item
    return total

