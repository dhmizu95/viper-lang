# Shutil module - file operations utilities

def copy(src, dst):
    # Copy file from src to dst
    # Returns: dst
    content = read_file(src)
    write_file(dst, content)
    return dst

def copy2(src, dst):
    # Copy file with metadata
    return copy(src, dst)

def move(src, dst):
    # Move file from src to dst
    # Returns: dst
    content = read_file(src)
    write_file(dst, content)
    delete_file(src)
    return dst

