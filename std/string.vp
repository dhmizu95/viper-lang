# Viper Standard Library - string module
# Common string constants and utilities

# Module metadata
__name__ = "string"
__version__ = "0.4.7"

# Export list
__all__ = [
    "ascii_lowercase", "ascii_uppercase", "ascii_letters",
    "digits", "hexdigits", "octdigits",
    "punctuation", "whitespace", "printable",
    "Template", "Formatter", "capwords"
]

# ============================================
# String Constants
# ============================================

# Lowercase ASCII letters
ascii_lowercase: str = "abcdefghijklmnopqrstuvwxyz"

# Uppercase ASCII letters
ascii_uppercase: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

# All ASCII letters (lowercase + uppercase)
ascii_letters: str = ascii_lowercase + ascii_uppercase

# Decimal digits
digits: str = "0123456789"

# Hexadecimal digits (0-9, a-f, A-F)
hexdigits: str = digits + "abcdefABCDEF"

# Octal digits
octdigits: str = "01234567"

# Punctuation characters
punctuation: str = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"

# Whitespace characters (space, tab, newline, return, vertical tab, form feed)
whitespace: str = " \t\n\r\x0b\x0c"

# Printable characters (digits + letters + punctuation + whitespace)
printable: str = digits + ascii_letters + punctuation + whitespace

# ============================================
# Template Class
# ============================================

class Template:
    """Template string substitution.

    Supports $identifier and ${identifier} syntax.
    Use $$ for literal dollar sign.

    Example:
        t = Template("Hello, $name!")
        result = t.substitute(name="World")  # "Hello, World!"

    Attributes:
        template: The original template string
        delimiter: Character that starts substitutions (default '$')
        idpattern: Regex pattern for identifiers (default: '_a-z][_a-z0-9]*')
        braceidpattern: Pattern for identifiers in ${} (default: same as idpattern)
    """

    # Default pattern for valid identifiers (simplified - letters, digits, underscore)
    _idchars: str = ascii_letters + digits + "_"

    def __init__(self, template: str, delimiter: str = "$",
                 idpattern: str = None, braceidpattern: str = None):
        """Initialize template.

        Args:
            template: Template string
            delimiter: Character starting substitutions (default '$')
            idpattern: Pattern for bare $identifier (None = default)
            braceidpattern: Pattern for ${identifier} (None = use idpattern)
        """
        self.template = template
        self.delimiter = delimiter
        self.idpattern = idpattern
        self.braceidpattern = braceidpattern if braceidpattern else idpattern

    def _find_identifiers(self) -> [str]:
        """Find all identifier names in template."""
        ids = []
        i = 0
        delim_len = len(self.delimiter)

        while i < len(self.template):
            # Check for delimiter
            if self.template[i:i + delim_len] == self.delimiter:
                i = i + delim_len
                if i >= len(self.template):
                    continue

                # Escaped delimiter ($$)
                if self.template[i] == self.delimiter[0]:
                    i = i + 1
                    continue

                # ${identifier} form
                if self.template[i] == '{':
                    i = i + 1
                    start = i
                    while i < len(self.template) and self.template[i] != '}':
                        i = i + 1
                    if i < len(self.template):
                        name = self.template[start:i]
                        if name and name not in ids:
                            ids.append(name)
                    i = i + 1
                    continue

                # $identifier form
                start = i
                while i < len(self.template) and self.template[i] in self._idchars:
                    i = i + 1
                if i > start:
                    name = self.template[start:i]
                    if name not in ids:
                        ids.append(name)
            else:
                i = i + 1

        return ids

    def get_identifiers(self) -> [str]:
        """Return list of identifier names in template."""
        return self._find_identifiers()

    def substitute(self, mapping=None, **kwargs) -> str:
        """Substitute identifiers with values.

        Args:
            mapping: Dictionary or object with substitution values
            **kwargs: Additional keyword arguments

        Returns:
            String with all identifiers substituted

        Raises:
            KeyError: If identifier has no value
            ValueError: If template syntax is invalid
        """
        # Build substitution dictionary
        subs = {}

        # From mapping (dict or object)
        if mapping is not None:
            if hasattr(mapping, 'keys'):
                # Dictionary-like object
                for key in mapping:
                    subs[key] = mapping[key]
            else:
                # Object with attributes
                for key in self._find_identifiers():
                    if hasattr(mapping, key):
                        subs[key] = getattr(mapping, key)

        # From kwargs (override mapping)
        for key in kwargs:
            subs[key] = kwargs[key]

        # Perform substitution
        result = []
        i = 0
        delim_len = len(self.delimiter)

        while i < len(self.template):
            if self.template[i:i + delim_len] == self.delimiter:
                i = i + delim_len
                if i >= len(self.template):
                    result.append(self.delimiter)
                    continue

                # Escaped delimiter
                if self.template[i] == self.delimiter[0]:
                    result.append(self.delimiter)
                    i = i + 1
                    continue

                # ${identifier} form
                if self.template[i] == '{':
                    i = i + 1
                    start = i
                    while i < len(self.template) and self.template[i] != '}':
                        i = i + 1

                    if i >= len(self.template):
                        raise ValueError("Invalid template: unclosed ${")

                    name = self.template[start:i]
                    if name not in subs:
                        raise KeyError("No value provided for '" + name + "'")
                    result.append(str(subs[name]))
                    i = i + 1
                    continue

                # $identifier form
                start = i
                while i < len(self.template) and self.template[i] in self._idchars:
                    i = i + 1

                if i == start:
                    result.append(self.delimiter)
                else:
                    name = self.template[start:i]
                    if name not in subs:
                        raise KeyError("No value provided for '" + name + "'")
                    result.append(str(subs[name]))
            else:
                result.append(self.template[i])
                i = i + 1

        return "".join(result)

    def safe_substitute(self, mapping=None, **kwargs) -> str:
        """Substitute identifiers, leaving missing ones unchanged.

        Like substitute() but doesn't raise errors for missing values.
        Unsubstituted identifiers remain in the output.

        Args:
            mapping: Dictionary or object with substitution values
            **kwargs: Additional keyword arguments

        Returns:
            String with available identifiers substituted
        """
        # Build substitution dictionary
        subs = {}

        if mapping is not None:
            if hasattr(mapping, 'keys'):
                for key in mapping:
                    subs[key] = mapping[key]
            else:
                for key in self._find_identifiers():
                    if hasattr(mapping, key):
                        subs[key] = getattr(mapping, key)

        for key in kwargs:
            subs[key] = kwargs[key]

        # Perform substitution (keep unknown identifiers)
        result = []
        i = 0
        delim_len = len(self.delimiter)

        while i < len(self.template):
            if self.template[i:i + delim_len] == self.delimiter:
                i = i + delim_len
                if i >= len(self.template):
                    result.append(self.delimiter)
                    continue

                # Escaped delimiter
                if self.template[i] == self.delimiter[0]:
                    result.append(self.delimiter)
                    i = i + 1
                    continue

                # ${identifier} form
                if self.template[i] == '{':
                    i = i + 1
                    start = i
                    while i < len(self.template) and self.template[i] != '}':
                        i = i + 1

                    if i >= len(self.template):
                        result.append(self.delimiter + '{')
                        result.append(self.template[start:])
                        break

                    name = self.template[start:i]
                    if name in subs:
                        result.append(str(subs[name]))
                    else:
                        result.append(self.delimiter + '{')
                        result.append(name)
                        result.append('}')
                    i = i + 1
                    continue

                # $identifier form
                start = i
                while i < len(self.template) and self.template[i] in self._idchars:
                    i = i + 1

                if i == start:
                    result.append(self.delimiter)
                else:
                    name = self.template[start:i]
                    if name in subs:
                        result.append(str(subs[name]))
                    else:
                        result.append(self.delimiter)
                        result.append(name)
            else:
                result.append(self.template[i])
                i = i + 1

        return "".join(result)

    def __repr__(self) -> str:
        return "Template('" + self.template + "')"

    def __str__(self) -> str:
        return self.template

    def __eq__(self, other) -> bool:
        if not isinstance(other, Template):
            return False
        return self.template == other.template

# ============================================
# Formatter Class
# ============================================

class Formatter:
    """String formatter (advanced string formatting).

    Supports {field_name} and {field_name:format_spec} syntax.
    Compatible with Python's str.format() mini-language.
    """

    def __init__(self):
        pass

    def format(self, format_string: str, *args, **kwargs) -> str:
        """Format string with arguments.

        Args:
            format_string: String with {field} placeholders
            *args: Positional arguments
            **kwargs: Keyword arguments

        Returns:
            Formatted string
        """
        result = []
        i = 0
        arg_idx = 0
        auto_index = True  # Track if we're using auto-numbering

        while i < len(format_string):
            if format_string[i] == '{':
                # Check for escaped {{
                if i + 1 < len(format_string) and format_string[i + 1] == '{':
                    result.append('{')
                    i = i + 2
                    continue

                # Find closing }
                i = i + 1
                start = i
                while i < len(format_string) and format_string[i] != '}':
                    i = i + 1

                if i >= len(format_string):
                    raise ValueError("Invalid format: unclosed {")

                field = format_string[start:i]
                i = i + 1

                # Parse field name and format spec
                format_spec = ""
                if ':' in field:
                    parts = field.split(':', 1)
                    field = parts[0]
                    format_spec = parts[1]

                # Get value
                if field == '':
                    # Empty field uses auto-numbering
                    if not auto_index:
                        raise ValueError("Cannot switch from manual to auto field numbering")
                    if arg_idx >= len(args):
                        raise IndexError("Not enough arguments")
                    value = args[arg_idx]
                    arg_idx = arg_idx + 1
                elif field[0].isdigit():
                    # Numeric index
                    auto_index = False
                    # Handle attribute/item access
                    field_parts = self._parse_field_name(field)
                    idx = int(field_parts[0])
                    if idx >= len(args):
                        raise IndexError("Argument index out of range")
                    value = args[idx]
                    value = self._get_remaining(value, field_parts[1:])
                else:
                    # Keyword argument
                    auto_index = False
                    field_parts = self._parse_field_name(field)
                    if field_parts[0] not in kwargs:
                        raise KeyError("No value for '" + field_parts[0] + "'")
                    value = kwargs[field_parts[0]]
                    value = self._get_remaining(value, field_parts[1:])

                # Apply format spec if present
                if format_spec:
                    value = self._format_value(value, format_spec)

                result.append(str(value))
            elif format_string[i] == '}':
                # Check for escaped }}
                if i + 1 < len(format_string) and format_string[i + 1] == '}':
                    result.append('}')
                    i = i + 2
                else:
                    raise ValueError("Invalid format: unmatched }")
            else:
                result.append(format_string[i])
                i = i + 1

        return "".join(result)

    def _parse_field_name(self, field_name: str) -> list:
        """Parse field name into parts.

        Returns list like ['name', ('attr', 'attrname'), ('index', 0), ...]
        """
        parts = []
        i = 0
        first = ""

        # Get the base name
        while i < len(field_name) and field_name[i] not in '.[':
            first = first + field_name[i]
            i = i + 1

        parts.append(first)

        # Parse attributes and indices
        while i < len(field_name):
            if field_name[i] == '.':
                i = i + 1
                attr = ""
                while i < len(field_name) and field_name[i] not in '.[':
                    attr = attr + field_name[i]
                    i = i + 1
                parts.append(('attr', attr))
            elif field_name[i] == '[':
                i = i + 1
                key = ""
                while i < len(field_name) and field_name[i] != ']':
                    key = key + field_name[i]
                    i = i + 1
                i = i + 1
                if key.isdigit():
                    parts.append(('index', int(key)))
                else:
                    parts.append(('key', key))

        return parts

    def _get_remaining(self, obj, parts: list):
        """Apply remaining field parts to object."""
        for part in parts:
            if isinstance(part, tuple):
                if part[0] == 'attr':
                    obj = getattr(obj, part[1])
                elif part[0] == 'index':
                    obj = obj[part[1]]
                elif part[0] == 'key':
                    obj = obj[part[1]]
        return obj

    def _format_value(self, value, format_spec: str) -> object:
        """Apply format specification to value."""
        if format_spec == '':
            return value

        # Parse format spec: [[fill]align][sign][#][0][width][,][.precision][type]
        width = 0
        precision = -1
        align = '>'
        fill = ' '
        type_char = ''
        sign = ''
        comma = False
        alt = False

        # Parse alignment
        if format_spec and format_spec[0] in '<>=^':
            align = format_spec[0]
            format_spec = format_spec[1:]
        elif len(format_spec) > 1 and format_spec[1] in '<>=^':
            fill = format_spec[0]
            align = format_spec[1]
            format_spec = format_spec[2:]

        # Parse sign
        if format_spec and format_spec[0] in '+- ':
            sign = format_spec[0]
            format_spec = format_spec[1:]

        # Parse # (alternate form)
        if format_spec and format_spec[0] == '#':
            alt = True
            format_spec = format_spec[1:]

        # Parse 0 (zero padding)
        if format_spec and format_spec[0] == '0':
            fill = '0'
            align = '='
            format_spec = format_spec[1:]

        # Parse width
        width_str = ""
        while format_spec and format_spec[0].isdigit():
            width_str = width_str + format_spec[0]
            format_spec = format_spec[1:]

        if width_str:
            width = int(width_str)

        # Parse comma
        if format_spec and format_spec[0] == ',':
            comma = True
            format_spec = format_spec[1:]

        # Parse precision
        if format_spec and format_spec[0] == '.':
            format_spec = format_spec[1:]
            prec_str = ""
            while format_spec and format_spec[0].isdigit():
                prec_str = prec_str + format_spec[0]
                format_spec = format_spec[1:]
            if prec_str:
                precision = int(prec_str)

        # Parse type
        if format_spec:
            type_char = format_spec[0]

        # Apply formatting based on type
        if isinstance(value, float):
            return self._format_float(value, width, precision, align, fill, type_char, sign, comma)
        elif isinstance(value, int):
            return self._format_int(value, width, align, fill, type_char, sign, comma, alt)
        elif isinstance(value, str):
            return self._format_str(value, width, precision, align, fill)

        return value

    def _format_str(self, value: str, width: int, precision: int,
                    align: str, fill: str) -> str:
        """Format a string value."""
        result = value

        # Apply precision (max length)
        if precision >= 0 and len(result) > precision:
            result = result[:precision]

        # Apply width (padding)
        if width > len(result):
            if align == '<':
                result = result + (fill * (width - len(result)))
            elif align == '^':
                left = (width - len(result)) // 2
                right = width - len(result) - left
                result = (fill * left) + result + (fill * right)
            else:  # '>' or '='
                result = (fill * (width - len(result))) + result

        return result

    def _format_int(self, value: int, width: int, align: str, fill: str,
                    type_char: str, sign: str, comma: bool, alt: bool) -> str:
        """Format an integer value."""
        # Determine base and prefix
        base = 10
        prefix = ""

        if type_char == 'b':
            base = 2
            if alt and value != 0:
                prefix = "0b"
        elif type_char == 'o':
            base = 8
            if alt and value != 0:
                prefix = "0o"
        elif type_char == 'x':
            base = 16
            if alt and value != 0:
                prefix = "0x"
            value = self._to_hex(value, False)
        elif type_char == 'X':
            base = 16
            if alt and value != 0:
                prefix = "0X"
            value = self._to_hex(value, True)
        elif type_char == 'c':
            return chr(value)
        elif type_char == 'n':
            comma = True
        elif type_char == 'd' or type_char == '':
            base = 10
        else:
            base = 10

        if base != 16:
            if value < 0:
                result = str(-value)
                sign_prefix = "-"
            else:
                result = str(value)
                if sign == '+':
                    sign_prefix = "+"
                elif sign == ' ':
                    sign_prefix = " "
                else:
                    sign_prefix = ""
        else:
            result = value

        # Add comma separators
        if comma and isinstance(result, str):
            result = self._add_commas(result)

        result = prefix + sign_prefix + result

        # Apply width
        if width > len(result):
            if align == '=':
                # Sign first, then padding, then value
                result = sign_prefix + (fill * (width - len(result))) + prefix + (result[len(sign_prefix) + len(prefix):] if len(sign_prefix) + len(prefix) <= len(result) else "")
            elif align == '<':
                result = result + (fill * (width - len(result)))
            elif align == '^':
                left = (width - len(result)) // 2
                right = width - len(result) - left
                result = (fill * left) + result + (fill * right)
            else:  # '>'
                result = (fill * (width - len(result))) + result

        return result

    def _to_hex(self, value: int, uppercase: bool) -> str:
        """Convert integer to hex string."""
        if value < 0:
            value = -value
            prefix = "-"
        else:
            prefix = ""

        if value == 0:
            return prefix + "0"

        hex_chars = "0123456789ABCDEF" if uppercase else "0123456789abcdef"
        result = ""
        while value > 0:
            result = hex_chars[value % 16] + result
            value = value // 16

        return prefix + result

    def _add_commas(self, s: str) -> str:
        """Add comma separators to numeric string."""
        if len(s) <= 3:
            return s

        result = []
        count = 0
        for i in range(len(s) - 1, -1, -1):
            if count > 0 and count % 3 == 0:
                result.append(',')
            result.append(s[i])
            count = count + 1

        result.reverse()
        return "".join(result)

    def _format_float(self, value: float, width: int, precision: int,
                      align: str, fill: str, type_char: str,
                      sign: str, comma: bool) -> str:
        """Format a float value."""
        # Handle special values
        if value != value:  # NaN
            return "nan"
        if value == float('inf'):
            return "inf"
        if value == float('-inf'):
            return "-inf"

        # Determine sign
        if value < 0:
            sign_prefix = "-"
            value = -value
        elif sign == '+':
            sign_prefix = "+"
        elif sign == ' ':
            sign_prefix = " "
        else:
            sign_prefix = ""

        # Default precision
        if precision < 0:
            precision = 6

        # Format based on type
        if type_char == 'e' or type_char == 'E':
            result = self._format_scientific(value, precision, type_char)
        elif type_char == 'f' or type_char == 'F' or type_char == '':
            result = self._format_fixed(value, precision)
        elif type_char == 'g' or type_char == 'G':
            if precision == 0:
                precision = 1
            result = self._format_general(value, precision, type_char)
        elif type_char == '%':
            value = value * 100
            result = self._format_fixed(value, precision) + "%"
        else:
            result = self._format_fixed(value, precision)

        result = sign_prefix + result

        # Apply width
        if width > len(result):
            if align == '<':
                result = result + (fill * (width - len(result)))
            elif align == '^':
                left = (width - len(result)) // 2
                right = width - len(result) - left
                result = (fill * left) + result + (fill * right)
            else:  # '>'
                result = (fill * (width - len(result))) + result

        return result

    def _format_fixed(self, value: float, precision: int) -> str:
        """Format float with fixed decimal places."""
        if precision == 0:
            return str(int(round(value)))

        multiplier = 1
        for i in range(precision):
            multiplier = multiplier * 10

        rounded = int(round(value * multiplier))
        int_part = rounded // multiplier
        frac_part = rounded - (int_part * multiplier)

        frac_str = str(frac_part)
        while len(frac_str) < precision:
            frac_str = "0" + frac_str

        return str(int_part) + "." + frac_str

    def _format_scientific(self, value: float, precision: int, type_char: str) -> str:
        """Format float in scientific notation."""
        if value == 0:
            exp = 0
            mantissa = 0.0
        else:
            exp = 0
            mantissa = value
            while mantissa >= 10:
                mantissa = mantissa / 10
                exp = exp + 1
            while mantissa < 1:
                mantissa = mantissa * 10
                exp = exp - 1

        mantissa_str = self._format_fixed(mantissa, precision)

        if type_char == 'E':
            return mantissa_str + "E+" + str(exp).zfill(2) if exp >= 0 else mantissa_str + "E" + str(exp).zfill(3)
        else:
            return mantissa_str + "e+" + str(exp).zfill(2) if exp >= 0 else mantissa_str + "e" + str(exp).zfill(3)

    def _format_general(self, value: float, precision: int, type_char: str) -> str:
        """Format float in general format."""
        if value == 0:
            return "0"

        abs_val = value if value > 0 else -value

        if abs_val >= 10**precision or (abs_val < 0.0001 and abs_val > 0):
            return self._format_scientific(value, precision - 1,
                                          'E' if type_char == 'G' else 'e')
        else:
            result = self._format_fixed(value, precision)
            if '.' in result:
                result = result.rstrip('0').rstrip('.')
            return result

    def parse(self, format_string: str):
        """Parse format string into components.

        Returns iterator of (literal_text, field_name, format_spec, conversion)
        """
        result = []
        i = 0
        literal_start = 0

        while i < len(format_string):
            if format_string[i] == '{':
                if i + 1 < len(format_string) and format_string[i + 1] == '{':
                    i = i + 2
                    continue

                # Save literal text
                result.append((format_string[literal_start:i], None, None, None))

                # Find closing }
                i = i + 1
                start = i
                while i < len(format_string) and format_string[i] != '}':
                    i = i + 1

                field = format_string[start:i]
                format_spec = ""

                if ':' in field:
                    parts = field.split(':', 1)
                    field = parts[0]
                    format_spec = parts[1]

                result.append((None, field, format_spec, None))
                i = i + 1
                literal_start = i
            elif format_string[i] == '}':
                if i + 1 < len(format_string) and format_string[i + 1] == '}':
                    i = i + 2
                    continue
                i = i + 1
            else:
                i = i + 1

        if literal_start < len(format_string):
            result.append((format_string[literal_start:], None, None, None))

        return result

    def vformat(self, format_string: str, args: tuple, kwargs: dict) -> str:
        """Format with explicit args tuple."""
        return self.format(format_string, *args, **kwargs)

    def get_field(self, field_name: str, args: tuple, kwargs: dict) -> tuple:
        """Get field value from args/kwargs.

        Returns (value, used_key)
        """
        parts = self._parse_field_name(field_name)
        used_key = parts[0]

        if used_key == '':
            # Auto-numbering
            value = args[0]
        elif used_key.isdigit():
            value = args[int(used_key)]
        else:
            value = kwargs[used_key]

        value = self._get_remaining(value, parts[1:])
        return (value, used_key)

    def check_unused_args(self, used_args: list, args: tuple, kwargs: dict):
        """Check for unused arguments."""
        # Simplified - just check kwargs
        for key in kwargs:
            if key not in used_args:
                raise KeyError("Unused keyword argument: " + key)

    def _format_field(self, value, format_spec: str) -> str:
        """Format a single field."""
        return self._format_value(value, format_spec)

    def _check_field_access(self, field_name: str):
        """Validate field name syntax."""
        # Simplified validation
        if '..' in field_name:
            raise ValueError("Empty attribute")
        if '[]' in field_name:
            raise ValueError("Empty index")

# ============================================
# Helper Functions
# ============================================

def capwords(s: str) -> str:
    """Capitalize words in string.
    
    Splits on whitespace, capitalizes each word, joins with single space.
    """
    words = s.split()
    result = []
    for word in words:
        if len(word) > 0:
            result.append(word[0].upper() + word[1:].lower())
    return " ".join(result)

# Global formatter instance
_formatter = Formatter()

def format_string(format_string: str, *args, **kwargs) -> str:
    """Format string using Formatter."""
    return _formatter.format(format_string, *args, **kwargs)
