# Statistics module - basic statistical functions

def mean(data):
    if len(data) == 0:
        return 0
    return sum(data) / len(data)

def median(data):
    if len(data) == 0:
        return 0
    
    sorted_data = sorted(data)
    n = len(sorted_data)
    
    if n % 2 == 0:
        return (sorted_data[n // 2 - 1] + sorted_data[n // 2]) / 2
    else:
        return sorted_data[n // 2]

def mode(data):
    if len(data) == 0:
        return None
    
    counts = {}
    for item in data:
        counts[item] = counts.get(item, 0) + 1
    
    max_count = 0
    mode_value = None
    for item, count in counts.items():
        if count > max_count:
            max_count = count
            mode_value = item
    
    return mode_value

def stdev(data):
    if len(data) < 2:
        return 0
    
    avg = mean(data)
    variance = sum((x - avg) ** 2 for x in data) / (len(data) - 1)
    return variance ** 0.5

def variance(data):
    if len(data) < 2:
        return 0
    
    avg = mean(data)
    return sum((x - avg) ** 2 for x in data) / (len(data) - 1)

def sum(data):
    total = 0
    for x in data:
        total = total + x
    return total

def sorted(data):
    result = []
    for x in data:
        result.append(x)
    
    # Simple bubble sort
    n = len(result)
    for i in range(n):
        for j in range(0, n - i - 1):
            if result[j] > result[j + 1]:
                temp = result[j]
                result[j] = result[j + 1]
                result[j + 1] = temp
    
    return result

def min(data):
    if len(data) == 0:
        return None
    min_val = data[0]
    for x in data:
        if x < min_val:
            min_val = x
    return min_val

def max(data):
    if len(data) == 0:
        return None
    max_val = data[0]
    for x in data:
        if x > max_val:
            max_val = x
    return max_val

def range(n):
    result = []
    i = 0
    while i < n:
        result.append(i)
        i = i + 1
    return result
