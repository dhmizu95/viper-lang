# FileInput module - iterate over lines from multiple files

def FileInput(files, inplace, backup):
    # Create a FileInput object
    # files: list of filenames or None for stdin
    # inplace: boolean for in-place editing
    # backup: backup file extension
    return FileInputObj(files)

class FileInputObj:
    def __init__(self, files):
        self.files = files
        self.current_file = None
        self.lineno = 0
        self._close = False
    
    def __iter__(self):
        return self
    
    def next(self):
        if self.current_file is None:
            if self.files is None:
                # Read from stdin
                line = input()
                if line is None:
                    raise StopIteration
                self.lineno = self.lineno + 1
                return line
        
        raise StopIteration
    
    def readline(self):
        return self.next()
    
    def close(self):
        self._close = True

def input(files, inplace, backup):
    # Convenience function to create FileInput
    return FileInput(files, inplace, backup)

def nextline():
    # Get next line from current file or stdin
    return input()

def filename():
    # Get name of current file
    return ""

def lineno():
    # Get current line number
    return 0

def filelineno():
    # Get line number in current file
    return 0

def isstdin(filename):
    # Check if filename is '-'
    return filename == "-"
