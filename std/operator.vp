# Operator module - functional-style operators

def itemgetter(key):
    return lambda obj: obj[key]

def attrgetter(attr):
    return lambda obj: getattr(obj, attr)

def truth_value(x):
    return bool(x)

def is_none(x):
    return x is None

def is_not_none(x):
    return x is not None

def eq(a, b):
    return a == b

def ne(a, b):
    return a != b

def lt(a, b):
    return a < b

def le(a, b):
    return a <= b

def gt(a, b):
    return a > b

def ge(a, b):
    return a >= b

def add(a, b):
    return a + b

def sub(a, b):
    return a - b

def mul(a, b):
    return a * b

def div(a, b):
    return a / b

def mod(a, b):
    return a % b

def pow(a, b):
    return a ** b

def and_(a, b):
    return a and b

def or_(a, b):
    return a or b

def not_(x):
    return not x

def contains(container, item):
    return item in container

def getitem(obj, key):
    return obj[key]

def setitem(obj, key, value):
    obj[key] = value

def delitem(obj, key):
    del obj[key]
