# Benchmark 02: Fibonacci Numbers

def main():
    ITERATIONS = 1000000
    
    a = 0
    b = 1
    count = 0
    i = 0
    
    while i < ITERATIONS:
        temp = a + b
        a = b
        b = temp
        count = count + 1
        i = i + 1
    
    print("Fibonacci iterations: " + str(count))
    print("Final value: " + str(a))
