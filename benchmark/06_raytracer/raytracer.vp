# Benchmark 06: Simple Ray Tracer

def hit_sphere(sx, sy, sz, sr, ox, oy, oz, dx, dy, dz):
    ocx = ox - sx
    ocy = oy - sy
    ocz = oz - sz
    
    a = dx * dx + dy * dy + dz * dz
    b = 2.0 * (ocx * dx + ocy * dy + ocz * dz)
    c = ocx * ocx + ocy * ocy + ocz * ocz - sr * sr
    
    discriminant = b * b - 4.0 * a * c
    if discriminant < 0.0:
        return -1.0
    
    return (-b - sqrt(discriminant)) / (2.0 * a)

def main():
    WIDTH = 50
    HEIGHT = 50
    
    sx0 = 0.0
    sy0 = 0.0
    sz0 = -5.0
    sr0 = 1.0
    sx1 = 2.0
    sy1 = 0.5
    sz1 = -4.0
    sr1 = 0.5
    sx2 = -2.0
    sy2 = 0.0
    sz2 = -6.0
    sr2 = 0.7
    
    total_intensity = 0.0
    y = 0
    
    while y < HEIGHT:
        x = 0
        while x < WIDTH:
            u = (2.0 * x - WIDTH) / HEIGHT
            v = (HEIGHT - 2.0 * y) / HEIGHT
            
            len_sq = u * u + v * v + 1.0
            len_val = sqrt(len_sq)
            dx = u / len_val
            dy = v / len_val
            dz = -1.0 / len_val
            
            intensity = 0.0
            
            t = hit_sphere(sx0, sy0, sz0, sr0, 0.0, 0.0, 0.0, dx, dy, dz)
            if t > 0.001:
                intensity = 0.5
            
            t = hit_sphere(sx1, sy1, sz1, sr1, 0.0, 0.0, 0.0, dx, dy, dz)
            if t > 0.001:
                intensity = 0.7
            
            t = hit_sphere(sx2, sy2, sz2, sr2, 0.0, 0.0, 0.0, dx, dy, dz)
            if t > 0.001:
                intensity = 0.9
            
            total_intensity = total_intensity + intensity
            x = x + 1
        y = y + 1
    
    print("Image size: " + str(WIDTH) + "x" + str(HEIGHT))
    avg = total_intensity / (WIDTH * HEIGHT)
    print("Average intensity: " + str(avg))
