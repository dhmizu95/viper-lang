# Benchmark 13: Regex DNA Matching

def main():
    SEQ_LEN = 10000
    
    bases = "ATGC"
    sequence = ""
    i = 0
    while i < SEQ_LEN:
        sequence = sequence + bases[i % 4]
        i = i + 1
    
    match_count = 0
    i = 0
    while i < SEQ_LEN - 9:
        if sequence[i:i+3] == "ATG":
            stop = sequence[i+6:i+9]
            if stop == "TAA" or stop == "TAG" or stop == "TGA":
                match_count = match_count + 1
        i = i + 1
    
    print("Sequence length: " + str(SEQ_LEN))
    print("Pattern matches found: " + str(match_count))
