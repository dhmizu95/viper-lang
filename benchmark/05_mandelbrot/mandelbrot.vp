# Benchmark 05: Mandelbrot Set

def main():
    WIDTH = 100
    HEIGHT = 100
    MAX_ITER = 50
    
    count = 0
    py = 0
    
    while py < HEIGHT:
        px = 0
        while px < WIDTH:
            x0 = (px - WIDTH / 2) * 4.0 / WIDTH
            y0 = (py - HEIGHT / 2) * 4.0 / HEIGHT
            
            x = 0.0
            y = 0.0
            iter_count = 0
            
            while x * x + y * y <= 4.0 and iter_count < MAX_ITER:
                xtemp = x * x - y * y + x0
                y = 2.0 * x * y + y0
                x = xtemp
                iter_count = iter_count + 1
            
            if iter_count == MAX_ITER:
                count = count + 1
            
            px = px + 1
        py = py + 1
    
    print("Image size: " + str(WIDTH) + "x" + str(HEIGHT))
    print("Points in Mandelbrot set: " + str(count))
