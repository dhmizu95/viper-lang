# Benchmark 96: Cellular Automata (Game of Life)
# Simulation Benchmark - Tests array operations
# Note: Uses reduced grid size for current Viper capabilities

def main():
    SIZE = 100  # Reduced from 4096 for feasibility
    GENERATIONS = 50  # Reduced from 100
    
    print("Running Game of Life on " + str(SIZE) + "x" + str(SIZE) + " grid...")
    
    # Initialize grids
    grid = [[0] * SIZE] * SIZE
    next_grid = [[0] * SIZE] * SIZE
    
    # Seed with random pattern using simple LCG
    seed = 42
    i = 0
    while i < SIZE:
        j = 0
        while j < SIZE:
            seed = (seed * 1103515245 + 12345) % 2147483648
            grid[i][j] = seed % 2
            j = j + 1
        i = i + 1
    
    # Count initial population
    initial_pop = 0
    i = 0
    while i < SIZE:
        j = 0
        while j < SIZE:
            initial_pop = initial_pop + grid[i][j]
            j = j + 1
        i = i + 1
    
    print("Initial population: " + str(initial_pop))
    
    # Run simulation
    gen = 0
    while gen < GENERATIONS:
        i = 1
        while i < SIZE - 1:
            j = 1
            while j < SIZE - 1:
                # Count neighbors
                neighbors = 0
                dx = -1
                while dx <= 1:
                    dy = -1
                    while dy <= 1:
                        if not (dx == 0 and dy == 0):
                            nx = (i + dx + SIZE) % SIZE
                            ny = (j + dy + SIZE) % SIZE
                            neighbors = neighbors + grid[nx][ny]
                        dy = dy + 1
                    dx = dx + 1
                
                # Apply Game of Life rules
                if grid[i][j] == 1:
                    if neighbors == 2 or neighbors == 3:
                        next_grid[i][j] = 1
                    else:
                        next_grid[i][j] = 0
                else:
                    if neighbors == 3:
                        next_grid[i][j] = 1
                    else:
                        next_grid[i][j] = 0
                
                j = j + 1
            i = i + 1
        
        # Copy next_grid to grid
        i = 0
        while i < SIZE:
            j = 0
            while j < SIZE:
                grid[i][j] = next_grid[i][j]
                j = j + 1
            i = i + 1
        
        gen = gen + 1
        
        if (gen + 1) % 10 == 0:
            print("Generation " + str(gen + 1) + "...")
    
    # Count final population
    final_pop = 0
    i = 0
    while i < SIZE:
        j = 0
        while j < SIZE:
            final_pop = final_pop + grid[i][j]
            j = j + 1
        i = i + 1
    
    print("Final population: " + str(final_pop))
