# Prime Sieve Benchmark - Viper (simple prints)
def sieve(n: i64) -> i64:
    is_prime = []
    i = 0
    while i <= n:
        is_prime.append(1)
        i = i + 1

    is_prime[0] = 0
    is_prime[1] = 0

    i = 2
    while i * i <= n:
        if is_prime[i] == 1:
            j = i * i
            while j <= n:
                is_prime[j] = 0
                j = j + i
        i = i + 1

    count = 0
    i = 2
    while i <= n:
        if is_prime[i] == 1:
            count = count + 1
        i = i + 1

    return count

def main():
    print("=== Viper Prime Sieve Benchmark ===")
    
    n = 1000000
    count = sieve(n)
    print("N=1000000:")
    print(count)
    
    n = 2000000
    count = sieve(n)
    print("N=2000000:")
    print(count)
    
    n = 5000000
    count = sieve(n)
    print("N=5000000:")
    print(count)
    
    print("Done!")
