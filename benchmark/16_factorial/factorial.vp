# Benchmark 16: Factorial
# Big Integer Benchmark - Tests arithmetic and iteration
# Note: Uses n=20 due to i64 limits (Viper needs BigInt support for larger)

def factorial(n):
    result = 1
    i = 2
    while i <= n:
        result = result * i
        i = i + 1
    return result

def main():
    N = 20  # Limited by i64 max (would need BigInt for 1,000,000)
    
    print("Computing factorial(" + str(N) + ")...")
    
    result = factorial(N)
    
    print("Factorial(" + str(N) + ") = " + str(result))
    print("Note: Viper needs BigInt support for factorial(1000000)")
