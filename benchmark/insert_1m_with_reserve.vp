# Benchmark: Insert 1M integers with pre-allocation (FASTEST)
# Uses reserve() to pre-allocate capacity, avoiding reallocations

def main():
    lst = []
    lst.reserve(1000000)  # Pre-allocate capacity
    
    i = 0
    while i < 1000000:
        lst.append(i)
        i = i + 1

    print("Inserted 1M integers with reserve()")
