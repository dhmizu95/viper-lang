# Benchmark 17: Fibonacci
# Big Integer Benchmark - Tests arbitrary precision arithmetic and iteration

def fibonacci(n):
    a = 0  # BigInt
    b = 1  # BigInt
    i = 0
    while i < n:
        temp = a + b
        a = b
        b = temp
        i = i + 1
    return a

def main():
    N = 100000  # Using BigInt, can handle large N

    print("Computing Fibonacci(" + str(N) + ")...")

    result = fibonacci(N)

    # Get number of digits
    result_str = str(result)
    digits = len(result_str)
    
    print("Fibonacci(" + str(N) + ") has " + str(digits) + " digits")
