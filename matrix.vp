# Benchmark: Matrix multiplication (100x100 matrices)
def main():
    # Initialize matrices
    size = 100
    
    # Create matrix A with values
    a = []
    i = 0
    while i < size:
        j = 0
        row = []
        while j < size:
            row = row + [(i + j) % 10]
            j = j + 1
        a = a + [row]
        i = i + 1
    
    # Create matrix B with values
    b = []
    i = 0
    while i < size:
        j = 0
        row = []
        while j < size:
            row = row + [(i * j) % 10]
            j = j + 1
        b = b + [row]
        i = i + 1
    
    # Multiply matrices: c = a * b
    c = []
    i = 0
    while i < size:
        j = 0
        row = []
        while j < size:
            sum = 0
            k = 0
            while k < size:
                sum = sum + a[i][k] * b[k][j]
                k = k + 1
            row = row + [sum]
            j = j + 1
        c = c + [row]
        i = i + 1
    
    # Print result checksum
    checksum = 0
    i = 0
    while i < size:
        j = 0
        while j < size:
            checksum = checksum + c[i][j]
            j = j + 1
        i = i + 1
    
    print(checksum)
