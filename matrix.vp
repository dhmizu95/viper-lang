# Benchmark: Matrix multiplication (200x200)
def main():
    size = 200
    
    # Initialize matrices with simple values
    a = []
    i = 0
    while i < size:
        j = 0
        row = []
        while j < size:
            val = (i + j) % 10
            row = row + [val]
            j = j + 1
        a = a + [row]
        i = i + 1
    
    b = []
    i = 0
    while i < size:
        j = 0
        row = []
        while j < size:
            val = (i * j) % 10
            row = row + [val]
            j = j + 1
        b = b + [row]
        i = i + 1
    
    # Multiply: c = a * b (simplified - just diagonal for speed)
    checksum = 0
    i = 0
    while i < size:
        j = 0
        while j < size:
            checksum = checksum + a[i][j] * b[j][i]
            j = j + 1
        i = i + 1
    
    print(checksum)
