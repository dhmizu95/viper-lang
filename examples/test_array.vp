# Test file for fixed-size array type

def test_array_elements():
    # Create array with elements
    arr = [1, 2, 3, 4, 5]
    
    # Access array elements
    print(arr[0])  # Should print: 1
    print(arr[1])  # Should print: 2
    print(arr[4])  # Should print: 5

def test_array_repeat():
    # Create array with repeated value syntax: [value; size]
    zeros = [0; 5]
    print(zeros[0])  # Should print: 0
    print(zeros[4])  # Should print: 0
    
    ones = [1; 3]
    print(ones[0])  # Should print: 1
    print(ones[2])  # Should print: 1

def test_array_modify():
    # Modify array elements
    arr = [10, 20, 30]
    arr[1] = 99
    print(arr[1])  # Should print: 99

def test_array_sum():
    # Use array in loop
    arr = [1, 2, 3, 4, 5]
    total = 0
    i = 0
    while i < 5:
        total = total + arr[i]
        i = i + 1
    print(total)  # Should print: 15

def main():
    print("=== Array Elements Test ===")
    test_array_elements()
    
    print("=== Array Repeat Test ===")
    test_array_repeat()
    
    print("=== Array Modify Test ===")
    test_array_modify()
    
    print("=== Array Sum Test ===")
    test_array_sum()
    
    print("All array tests completed!")
