# Benchmark: Find prime numbers up to 10 million
def is_prime(n: i64) -> i64:
    if n < 2:
        return 0
    if n == 2:
        return 1
    if n % 2 == 0:
        return 0
    i = 3
    while i * i <= n:
        if n % i == 0:
            return 0
        i = i + 2
    return 1

def main():
    count = 0
    i = 0
    while i < 10000000:
        if is_prime(i):
            count = count + 1
        i = i + 1
    print(count)
