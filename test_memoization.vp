@lru_cache(maxsize=None)
def fib(n):
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

@lru_cache(maxsize=256)
def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

# Test 3 parameters
@lru_cache(maxsize=128)
def sum_three(a, b, c):
    return a + b + c

def main():
    # Test basic memoization
    print("fib(10) =", fib(10))
    print("fib(10) again =", fib(10))  # Should be cached
    
    # Test factorial
    print("factorial(10) =", factorial(10))
    
    # Test 3 parameters
    print("sum_three(1, 2, 3) =", sum_three(1, 2, 3))
    print("sum_three(1, 2, 3) again =", sum_three(1, 2, 3))  # Should be cached
    
    # Test large Fibonacci (BigInt)
    print("fib(75) =", fib(75))
    print("fib(75) again =", fib(75))  # Should be cached
    
    print("All tests passed!")
