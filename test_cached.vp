@lru_cache(maxsize=None)
def fib_cached(n):
    if n <= 1:
        return n
    return fib_cached(n - 1) + fib_cached(n - 2)

def main():
    # Test cached version with large n (should be instant)
    result = fib_cached(40)
    print("fib_cached(40) =", result)
    
    # Call again (should be instant cache hit)
    result2 = fib_cached(40)
    print("fib_cached(40) again =", result2)
    
    print("Success!")
